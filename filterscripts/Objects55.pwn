#include <a_samp.inc>
#include <streamer.inc>


new dynObj;
//coaster
#define TUBE            (0)
#define COVER           (1)
#define LIGHT           (2)
#define SUPPORT         (3)

#define TBR_RED         (0)
#define TBR_GREEN       (1)
#define TBR_BLUE        (2)
#define TBR_YELLOW      (3)
#define TBR_PURPLE      (4)

#define FREEROAM_WORLD 0..10
#define DUEL_WORLD 11
#define DEAGLE_DM 12
#define AFK_WORLD 13
#define DERBY_EVENT 11
#define CAGEFIGHT_EVENT 15
#define BIKEPARKOUR_WORLD 16
#define SANCHEZPARKOUR_WORLD 17
#define SKYDIVE_WORLD 18
#define PARKOUR_WORLD 19
#define HAYCLIMB_WORLD 12
#define QUADPARKOUR_WORLD 21
#define MONSTERPARKOUR_WORLD 22

Func_TubeConnector(index, direction, tubetype, tubecolor, modelid, Float:X, Float:Y, Float:Z, Float:RX, Float:RY, Float:RZ, Float:distance)//, support_dir=0)
{
        dynObj = CreateDynamicObject(modelid, X, Y, Z, RX, RY, RZ,-1,-1,-1, distance);
        switch(tubecolor)
        {
                case 0: SetDynamicObjectMaterial(dynObj, 0, 19659, "MatTubes", "RedDirt1");
                case 1: SetDynamicObjectMaterial(dynObj, 0, 19659, "MatTubes", "GreenDirt1");
                case 2: SetDynamicObjectMaterial(dynObj, 0, 19659, "MatTubes", "BlueDirt1");
                case 3: SetDynamicObjectMaterial(dynObj, 0, 19659, "MatTubes", "YellowDirt1");
                case 4: SetDynamicObjectMaterial(dynObj, 0, 19659, "MatTubes", "PurpleDirt1");
        }
        #pragma unused direction, index, tubetype
        //CallRemoteFunction("OnTubeImported", "ddddddffffffd", tube, index, direction, tubetype, tubecolor, modelid, X, Y, Z, RX, RY, RZ, support_dir); //DELETE THIS LINE ON YOUR SCRIPT, KEEP IN THIS FILE
        return dynObj;
}

//end


public OnFilterScriptExit()
{
	DestroyAllDynamicObjects();
}
stock CreateDynamicObject_BP(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, worldid = -1)
{
    CreateDynamicObject(modelid, Float:(x+1000.0), Float:(y+1000.0), Float:(z+1000.0), Float:rx, Float:ry, Float:rz, worldid);
}

