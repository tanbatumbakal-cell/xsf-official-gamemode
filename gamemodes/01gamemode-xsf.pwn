CMD:endduel(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	new targetid;

	if(sscanf(params, "k<player_name>", targetid))
		return Error(playerid, "/endduel <player>");

	if(!IsPlayerConnected(targetid))
		return Error(playerid, "That player is not connected.");

	if(InDuel[targetid] == -1)
		return Error(playerid, "That player is not in a duel.");

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "LB2_E"%s(%i) has ended the duel.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "LB2_E"The duel has been canceled by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	EndDuel(targetid);
	return true;
}

IsVehicleOccupied(vehid)
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(IsPlayerInAnyVehicle(i))
	    {
	        if(GetPlayerVehicleID(i) == vehid)
	        {
	            return 1;
			}
		}
	}
	return 0;
}

forward RespawnVehiclesAuto();
public RespawnVehiclesAuto()
{
	for(new vehid=0; vehid<MAX_VEHICLES; vehid++)
	{
		if(!IsVehicleOccupied(vehid))
		{
		    SetVehicleToRespawn(vehid);
		}
	}
 	foreach(new ii : Player)
	{
		if(!IsPlayerInAnyVehicle(ii))
		{
			RemoveComponents(ii, true);
			DestroyVehicle(pSpawnVehicle[ii]);
			pSpawnVehicle[ii] = -1;
		}
	}
	return 1;
}

CMD:rv(playerid) return cmd_respawnvehicles(playerid);
CMD:respawnvehicles(playerid)
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	RespawnVehiclesAuto();

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has respawned all unoccupied vehicles.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"All vehicles have been respawned by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has respawned all unoccupied vehicles.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}
CMD:rvcnr(playerid)
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");


	for(new itt=0; itt<MAX_VEHICLES; itt++)
	{
		new vehs;
		foreach(new ii : Player)
		{
			if(GetPlayerVehicleID(ii) == itt || PlayerVehicle[ii][0] == itt || PlayerVehicle[ii][1] == itt)
			{
				vehs = 1;
			}
		}
		if(!vehs)
		{
			for(new iit = 0; iit < sizeof(veh_cnr); iit++)
			{
				if(veh_cnr[iit] == itt) SetVehicleToRespawn(itt);
			}
		}
		vehs = 0;
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has respawned all unoccupied CnR vehicles.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"All CnR vehicles have been respawned by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has respawned all unoccupied CnR vehicles.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}

CMD:respawnpvs(playerid)
{
	if(pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");

	foreach(new ii : Player)
	{
		if(!IsPlayerInAnyVehicle(ii))
		{
			DestroyDynamic3DTextLabel(PV_3DLabel[ii][0]);
			DestroyVehicle(PlayerVehicle[ii][0]);
			PlayerVehicle[ii][0] = -1;

			DestroyDynamic3DTextLabel(PV_3DLabel[ii][1]);
			DestroyVehicle(PlayerVehicle[ii][1]);
			PlayerVehicle[ii][1] = -1;
		}
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has respawned all unoccupied private vehicles.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"All private vehicles have been respawned by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has respawned all unoccupied private vehicles.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}

CMD:autofix(playerid)
{
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't enable autofix while in a DM!");
		return true;
	}
	if(doingStunt[playerid] != 0)
	{
		Error(playerid, "You can't toggle autofix in this area!");
		return true;
	}
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You can't toggle autofix in an event!");
	if(pAutoFix[playerid] == 1)
	{
		pAutoFix[playerid] = 0;
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "RED_E"disabled "LB2_E"autofix");
	}
	else
	{
		pAutoFix[playerid] = 1;
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "LG_E"enabled "LB2_E"autofix.");
	}
	if(pLogged[playerid] == true)
	{
		format(query, sizeof(query), "UPDATE players SET autofix=%d WHERE reg_id=%d", pAutoFix[playerid], pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return true;
}
CMD:allowgoto(playerid) return cmd_toggoto(playerid);
CMD:toggoto(playerid)
{
	if(pGoTo[playerid] == 1)
	{
		pGoTo[playerid] = 0;
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "LG_E"allowed "LB2_E"players to teleport to you.");
	}
	else
	{
		pGoTo[playerid] = 1;
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "RED_E"disabled "LB2_E"players from teleporting to you.");
	}
	if(pLogged[playerid] == true)
	{
		format(query, sizeof(query), "UPDATE players SET goto=%d WHERE reg_id=%d", pGoTo[playerid], pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return true;
}
CMD:pmsoff(playerid) return cmd_togpms(playerid);
CMD:togpm(playerid) return cmd_togpms(playerid);
CMD:nopm(playerid) return cmd_togpms(playerid);
CMD:togpms(playerid)
{
	if(GetPVarInt(playerid, "PMsDisabled") == 1)
	{
		DeletePVar(playerid, "PMsDisabled");
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "LG_E"enabled "LB2_E"private messages.");
	}
	else
	{
		SetPVarInt(playerid, "PMsDisabled", 1);
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have "RED_E"disabled "LB2_E"private messages.");
	}
	format(query, sizeof(query), "UPDATE players SET togpms = %i WHERE reg_id = %i", GetPVarInt(playerid, "PMsDisabled"), pRegID[playerid]);
	MySQL_updateQuery(query);
	PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
	return true;
}
