function ResetPlayerVariables(playerid)
{
	_admBanID[playerid] = 0;
    format(_admBanReason[playerid], 80, "");
    lottCount[playerid] = 0;
    HG_CurrentSpectator[playerid] = -1;
    if(admin3D[playerid] != Text3D:-1) 
    	DestroyDynamic3DTextLabel(admin3D[playerid]);

	SetPVarInt(playerid, "ParticipatingHG", 0);
	oldHColors[playerid] = 0;
	TogAnn[playerid] = true;
	PMSound[playerid] = true;

	
	
    HideTD[playerid] = 0;
	pGTag[playerid][0] = EOS;
	togTag[playerid] = true;
 	LastTag[playerid] = false;
	pDrunkLevelLast[playerid] = 0;
 	pFPS[playerid] = 0;
    pEventDialog[playerid] = false;
	PUBG_Kills[playerid] = 0;
	PUBG_Deaths[playerid] = 0;
	PUBG_KP[playerid] = 0;
	PUBG_RP[playerid] = 0;
	PUBG_Wins[playerid] = 0;
	LastLoginRequest[playerid] = 0;
	// sarah's
	vSayTick[playerid] = 0;
	cShopTick[playerid] = 0;
	DamageVar[playerid] = 0;
	pWelcome[playerid] = 0;
	SetPVarInt(playerid, "killerID", -1);

	return 1;
}

function OnCommandCheck(playerid)
{
	//tmp is admin name
	//Query is reason
	if(!MySQL_rowCount()) return 1;
	cache_get_field_content(0, "Name", tmp);
	cache_get_field_content(0, "Reason", query, 25);
	pBlocked[playerid] = cache_get_field_content_int(0, "Time");
	format(str, sizeof(str), ""SERVER_INITIALS" "RED_E"Your commands were blocked by %s for %d seconds [Reason: %s]", tmp, pBlocked[playerid], query);
	SendClientMessage(playerid, -1, str);
	SetPVarInt(playerid, "OfflineBlocked", 1);
	return 1;
}

forward OnUserDataLoad(playerid);
public OnUserDataLoad(playerid)
{
	GetPlayerIp(playerid, PlayerIP, 16);
	if(!MySQL_rowCount())
	{
		GameTextForPlayer(playerid, " ", 1000, 3); // Hides Gametext
		HideConnectTD(playerid, false);
		SetPlayerInterior(playerid, 14);
		SetPlayerCameraPos(playerid, -1484.6588,1640.4684,1060.6719);
		SetPlayerCameraLookAt(playerid, -1425.3961,1598.7845,1052.5313);
		SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"This account is not registered. Register your account to gain access to more commands and features!");
		ShowRegisterDialog(playerid);

		format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has connected 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
		format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has connected 1(IP: %s)", pName[playerid], playerid, PlayerIP);
		IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
		/*format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has joined the server. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
		format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has joined the server. 1(IP: %s)", pName[playerid], playerid, PlayerIP);
		IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);*/
		//format(tmp, sizeof(tmp), "[Join] %s (%d) has joined the server. (%s)", pName[playerid], playerid, PlayerIP);
	}
	else
	{
		// User exists
		pRegID[playerid] = cache_get_field_content_int(0, "reg_id");
		autoLogin[playerid] = cache_get_field_content_int(0, "autoLogin");
		new p_PmDisabled, p_HitSound, p_PassChange;
		new p_Armor, p_bstoggle;
		new jailed_reason[60];
		new IP[16];
		cache_get_field_content(0, "IP", IP);
		if(IP[0] != 0 && !strcmp(IP, PlayerIP) && autoLogin[playerid] == 1)
		{
			pLogged[playerid] = true;
			pAdmin[playerid] = cache_get_field_content_int(0, "adminlevel"); 
			pTotalHours[playerid] = cache_get_field_content_int(0, "hours");
			pTotalMinutes[playerid] = cache_get_field_content_int(0, "minutes");
			pTotalSeconds[playerid] = cache_get_field_content_int(0, "seconds");
			pInfo[playerid][pKills] = cache_get_field_content_int(0, "kills");
			pInfo[playerid][pDeaths] = cache_get_field_content_int(0, "deaths");
			pCash[playerid] = cache_get_field_content_int(0, "money");
			pScore[playerid] = cache_get_field_content_int(0, "score");
			pPremium[playerid] = cache_get_field_content_int(0, "premium");
			pInfo[playerid][pSaveSkin] = cache_get_field_content_int(0, "saveskin");

			pSpawnPlace[playerid] = cache_get_field_content_int(0, "spawnplace");
			pCookies[playerid] = cache_get_field_content_int(0, "cookies");
			pInfo[playerid][pEventsWon] = cache_get_field_content_int(0, "events_won");
			pInfo[playerid][pRacesWon] = cache_get_field_content_int(0, "races_won");
			pInfo[playerid][pMBFound] = cache_get_field_content_int(0, "MB_found");
			BankMoney[playerid] = cache_get_field_content_int(0, "bmoney");
			reactionsWon[playerid] = cache_get_field_content_int(0, "rtests");
			pArrests[playerid] = cache_get_field_content_int(0, "arrests");
			TotalKillStreak[playerid] = cache_get_field_content_int(0, "killstreak");
			pDuelsWon[playerid] = cache_get_field_content_int(0, "duels_won");

			pFallouts[playerid] = cache_get_field_content_int(0, "fallouts");
			pGroupID[playerid] = cache_get_field_content_int(0, "group_id");
			PUBG_Kills[playerid] = cache_get_field_content_int(0, "pubg_kills");
			PUBG_Deaths[playerid] = cache_get_field_content_int(0, "pubg_deaths");
			PUBG_RP[playerid] = cache_get_field_content_int(0, "pubg_rankpoints");
			new event = cache_get_field_content_int(0, "togevent");
			if(event) pEventDialog[playerid] = true;
			else pEventDialog[playerid] = false;
			PUBG_KP[playerid] = cache_get_field_content_int(0, "pubg_killpoints");
			PUBG_Wins[playerid] = cache_get_field_content_int(0, "pubg_wins");
			pGroupRank[playerid] = cache_get_field_content_int(0, "group_rank");
			pDerbys[playerid] = cache_get_field_content_int(0, "derby_wins");
			pCookieJars[playerid] = cache_get_field_content_int(0, "cookiejars");
			mathsWon[playerid] = cache_get_field_content_int(0, "maths");
			pReportPoints[playerid] = cache_get_field_content_int(0, "report_points");
			Helper[playerid] = cache_get_field_content_int(0, "helper");

			oldHColors[playerid] = cache_get_field_content_int(0, "oldHColors");
			admOnTime[playerid] = cache_get_field_content_int(0, "admOnTime");
			gSpawnPos[playerid][0] = cache_get_field_content_float(0, "gSpawnX");
			gSpawnPos[playerid][1] = cache_get_field_content_float(0, "gSpawnY");
			gSpawnPos[playerid][2] = cache_get_field_content_float(0, "gSpawnZ");
	   		pSpawnPos[playerid][0] = cache_get_field_content_float(0, "pSpawnX");
			pSpawnPos[playerid][1] = cache_get_field_content_float(0, "pSpawnY");
			pSpawnPos[playerid][2] = cache_get_field_content_float(0, "pSpawnZ");
			pSpawnPos[playerid][3] = cache_get_field_content_float(0, "pSpawnA");
			pmhidden[playerid] = cache_get_field_content_int(0, "pmhidden");
			cache_get_field_content(0, "reg_time", pRegDate[playerid], 20);
			cache_get_field_content(0, "last_time", pLastDate[playerid], 20);
			cache_get_field_content(0, "description", pDescription[playerid], 40 );




			pInfo[playerid][pSeePMs] = cache_get_field_content_int(0, "seepms");
			speedBreak[playerid] = cache_get_field_content_int(0, "keyflip");
			SavedVehicle[playerid] = cache_get_field_content_int(0, "savedvehicle");
			speedBoost[playerid] = cache_get_field_content_float(0, "speedboost");
			pWheels[playerid] = cache_get_field_content_int(0, "wheels");
			pColor[playerid] = cache_get_field_content_int(0, "color") ;
			pGoTo[playerid] = cache_get_field_content_int(0, "goto");
			pAutoFix[playerid] = cache_get_field_content_int(0, "autofix");
			GOD[playerid] = cache_get_field_content_int(0, "god");
			pBounce[playerid] = cache_get_field_content_int(0, "bounce");
			Speedo[playerid] = cache_get_field_content_int(0, "speedo");
			pAutoTune[playerid] = cache_get_field_content_int(0, "autotune");
			pSuperJump[playerid] = cache_get_field_content_int(0, "superman");
			pHidden[playerid] = cache_get_field_content_int(0, "hidden");
			pWeaponSet[playerid] = cache_get_field_content_int(0, "weapon_set");
			pTime[playerid] = cache_get_field_content_int(0, "time");
			pWeather[playerid] = cache_get_field_content_int(0, "weather");
			premiumExpired[playerid] = cache_get_field_content_int(0, "v_expired");
			pChatColor[playerid] = cache_get_field_content_int(0, "chat_color");
			hideMSG[playerid] = cache_get_field_content_int(0, "hideMSGs");
			autoLogin[playerid] = cache_get_field_content_int(0, "autoLogin");
			duelsOFF[playerid] = cache_get_field_content_int(0, "duels_off");
			pMute[playerid] = cache_get_field_content_int(0, "Muted");
			pJail[playerid] = cache_get_field_content_int(0, "Jailed");
			pIDColor[playerid] = cache_get_field_content_int(0, "id_color");
			houseID[playerid] = cache_get_field_content_int(0, "house_id");
			pLevel[playerid] = GetLevel(pScore[playerid]);

			cache_get_field_content(0, "plate", pPlate[playerid], 32);
			cache_get_field_content(0, "country", pCountry[playerid], 43);
			cache_get_field_content(0, "email", pEmail[playerid], 2);
			cache_get_field_content(0, "JailedReason", jailed_reason, 77);

			foreach(new i : Houses) 
			{
				if(hInfo[i][HouseID] == houseID[playerid]) 
				{
					houseID[playerid] = i;
					break;
				}
			}


			pTakedowns[playerid] = cache_get_field_content_int(0, "takedowns");
			pRobberies[playerid] = cache_get_field_content_int(0, "robberies");
			pPlayerRobberies[playerid] = cache_get_field_content_int(0, "probberies");
			pTimesArrested[playerid] = cache_get_field_content_int(0, "times_arrested");
			pCopKills[playerid] = cache_get_field_content_int(0, "cop_kills");
			specOFF[playerid] = cache_get_field_content_int(0, "specoff");
			p_PmDisabled = cache_get_field_content_int(0, "togpms");
			p_HitSound = cache_get_field_content_int(0, "hitsound");
			p_PassChange = cache_get_field_content_int(0, "passchanged");
			p_Armor = cache_get_field_content_int(0, "TogArmour");
			pTogCountry[playerid] = cache_get_field_content_int(0, "togcorty");
			p_bstoggle = cache_get_field_content_int(0, "bschat");

			//assign into the respective pvars
			SetPVarString(playerid, "JailedReason", jailed_reason);
			SetPVarInt(playerid, "PMsDisabled", p_PmDisabled);
			SetPVarInt(playerid, "togArmour", p_Armor);
			SetPVarInt(playerid, "HitSound", p_HitSound);
			SetPVarInt(playerid, "PasswordChange", p_PassChange);
			SetPVarInt(playerid, "BSChat", p_bstoggle);
			

			if(Helper[playerid] == 2) 
			pMapper[playerid] = 1;
			else if(Helper[playerid] == 3) 
			pDeveloper[playerid] = 1;

			if(pColor[playerid] != 0)
			{
				SetPlayerColor(playerid, pColor[playerid]);
				pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
			}
			else
			{
				SetPlayerColor(playerid, PlayerColors[playerid]);
				pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
			}
			if(pChatColor[playerid] != 0) pChatColor[playerid] = StripAlpha(pChatColor[playerid]);
			if(pIDColor[playerid] != 0) pIDColor[playerid] = StripAlpha(pIDColor[playerid]);
		}
		else
		{
			GameTextForPlayer(playerid, " ", 1000, 3); // Hides Gametext
			if(autoLogin[playerid] == 0)
			{
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"This account requires a manual login, enter your password in the dialog below to login.");
				format(line, sizeof(line), ""WHITE_E"Welcome to xTreme Stunt Freeroam, "YELLOW_E"%s\n\n"RED_E"This account requires a manual login.\n"WHITE_E"Enter your password below to login.\n\n"RED_E"Note:\n- "WHITE_E"You can auto log the next time you connect using /autologin.\n"RED_E"- "WHITE_E"If this is not your account please quit and change your name.", pName[playerid]);
				ShowPlayerDialog(playerid, 5, DIALOG_STYLE_PASSWORD, ""LB_E"Login", line , "Login", "");
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"This account is registered, enter your password in the dialog below to login.");
				format(line, sizeof(line), ""WHITE_E"Welcome to xTreme Stunt Freeroam, "YELLOW_E"%s\n\n"RED_E"This account is registered.\n"WHITE_E"Enter your password below to login\n\n"RED_E"Note:\n- "WHITE_E"You will not be able to spawn until you login.\n"RED_E"- "WHITE_E"If this is not your account please quit and change your name.", pName[playerid]);
				ShowPlayerDialog(playerid, 5, DIALOG_STYLE_PASSWORD, ""LB_E"Login", line , "Login", "");
			}
			format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has connected from %s. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
			format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has connected from %s. 1(IP: %s)", pName[playerid], playerid, PlayerIP);
			IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
			/*format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has joined the server. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
			format(tmp, sizeof(tmp), "02[Join] 03%s(%d) has joined the server. 1(IP: %s)", pName[playerid], playerid, PlayerIP);
			IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);*/
		}
	}

	if(Iter_Count(Player) > 20)
	{
		SendDeathMessage(INVALID_PLAYER_ID, playerid, 200);

		foreach(new i : Player) {
			if(pAdmin[i]> 0 && GetPVarInt(i, "AGetIP")) {
				/*format(str, sizeof(str), ""LG_E"<> "LB_E"%s(%i) "LB2_E"has joined the server. "GREY2_E"[%d/420]", pName[playerid], playerid, Iter_Count(Player));
				SendClientMessage(i, COLOR_LB, str);
				format(str, sizeof(str), "%i", playerid);
				cmd_getip(i, str);
				new isps[128], country[50];
			    GetPlayerCountry(playerid,country);

			    GetPlayerCity(playerid,isps);
				format(str, sizeof(str), "Server: "WHITE_E"%s is from "ORANGE_E"%s"WHITE_E" and their ISP is "ORANGE_E"%s",pName[playerid],country,isps);
				SendClientMessage(i, COLOR_RED, str);*/
				format(str, sizeof(str), "%i", playerid);
				cmd_getip(i, str);

			}
		}
	}
	else
	{
		format(str, sizeof(str), ""LG_E"<> "LB_E"%s(%i) "LB2_E"has joined the server. "GREY2_E"[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		SendClientMessageToAllEx(playerid, COLOR_LB, str);

		foreach(new i : Player) {
			if(pAdmin[i] > 0 && GetPVarInt(i, "AGetIP")) {
				format(str, sizeof(str), "%i", playerid);
				cmd_getip(i, str);
			}
		}
	}
	// Check if user is banned
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT user_banner,ban_reason,ban_time,ban_timestamp,bIP FROM bans WHERE bIP='%e' OR user_banned='%e'", PlayerIP, pName[playerid]);
	MySQL_query(query, true, "CheckBan", "i", playerid);
	PUBG_OnPlayerConnect(playerid);
	return 1;
}



function ForcePasswordChangeDelay(playerid)
{
	// if(GetPVarInt(playerid, "PasswordChange") == 0)
	// {
	// 	ShowPlayerDialog(playerid, 198, DIALOG_STYLE_PASSWORD, ""WHITE_E"Change your password (breached)", ""WHITE_E"Our database has been compromised, hackers gained access to hashed passwords + emails.\nInsert your current password to continue:", "Continue", "Exit");
	// 	InfoTD_MSG(playerid, 3000, "~g~~h~Insert your current password!");
	// 	Error(playerid, "Due to a leak of our database, we are forcing password changes on all of our users. Thanks for understanding.");
	// }
	return 1;
}

OnUserLogin(playerid)
{
	SetTimerEx("ForcePasswordChangeDelay", 7000, false, "i", playerid);
	if(Helper[playerid] != 0)
	{
		if(Helper[playerid] == 1)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Helper {%06x}%s(%i) "YELLOW_E"has been auto-logged in.", pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
		if(pMapper[playerid] == 1)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Mapper {%06x}%s(%i) "YELLOW_E"has been auto-logged in.", pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
		if(pDeveloper[playerid] == 1)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Developer {%06x}%s(%i) "YELLOW_E"has been auto-logged in.", pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
	}
	else if(pAdmin[playerid] != 0 || pPremium[playerid] != 0)
	{
		if(pHidden[playerid] == 0)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"%s {%06x}%s(%i) "YELLOW_E"has been auto-logged in.", GetPlayerAdminLevelName(playerid), pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);

			/*if(!strcmp(pName[playerid], "Gabie", false))
				SendBotMsg("Oh shit it's Gabie, run for your lives, kids!");*/
		}
		if(premiumExpired[playerid] != 0)
		{
			if(gettime() > premiumExpired[playerid])
			{
				format(query, sizeof(query), "UPDATE players SET premium=0,v_expired=0,chat_color=0,id_color=0,speedboost=1.3 WHERE reg_id=%d", pRegID[playerid]);
				MySQL_updateQuery(query);
				pPremium[playerid] = 0;
				pChatColor[playerid] = 0;
				pIDColor[playerid] = 0;
				speedBoost[playerid] = 1.3;
				Info(playerid, "Your premium membership has been expired today! You can renew on our site at serverserver.com!");
			}
		}
	}
	format(str, sizeof(str), ""RED_E"*** "LB2_E"Welcome back {%06x}%s, "LB2_E"you have been automatically logged in!", pColor[playerid], pName[playerid]);
	SendClientMessage(playerid, COLOR_LB, str);
	if(pTotalHours[playerid] == 0) format(str, sizeof(str), ""RED_E"*** "LB2_E"You have been online for "LB_E"%d minutes, %d seconds.", pTotalMinutes[playerid], pTotalSeconds[playerid]);
	else format(str, sizeof(str), ""RED_E"*** "LB2_E"You have been online for "LB_E"%d hours, %d minutes, %d seconds.", pTotalHours[playerid], pTotalMinutes[playerid], pTotalSeconds[playerid]);
	SendClientMessage(playerid, COLOR_LB, str);

	format(tmp, sizeof(tmp), "02[Join]03 %s(%d) has joined the server. 11(Logged in as a %s) 1[%d/420]", pName[playerid], playerid, GetPlayerAdminLevelName(playerid), Iter_Count(Player));
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
	format(tmp, sizeof(tmp), "02[Join]03 %s(%d) has joined the server. 11(Logged in as a %s) 1(IP: %s)", pName[playerid], playerid, GetPlayerAdminLevelName(playerid), PlayerIP);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

	format(str, sizeof(str), "~w~Welcome back, ~r~~h~%s~w~!~n~~w~You are logged in as %s!", pName[playerid], GetPlayerAdminLevelName(playerid));
	InfoTD_MSG(playerid, 5200, str);
	format(query, sizeof(query), "UPDATE players SET active=1 WHERE reg_id=%d", pRegID[playerid]);
	MySQL_updateQuery(query);

	if(pGroupID[playerid] != -1 && pAdmin[playerid] < 6)
	{

		format(str, sizeof(str), ""GROUP"%s %s(%d) from your group has logged in.", GetGroupRank(pGroupID[playerid],pGroupRank[playerid]) , pName[playerid], playerid);
		SendGroupMessage(playerid, str);
	}

	if(!strcmp(pName[playerid], "[MH]NSV[V]")) {
		SendClientMessage(playerid, COLOR_WHITE, ""ORANGE_E"ChumLee: "WHITE_E"[MH]NSV[V]");
	}

	// Set player custom Time/Weather
	if(pTime[playerid] != -1) SetPlayerTime(playerid, pTime[playerid], 0);
	if(pWeather[playerid] != -1) SetPlayerWeather(playerid, pWeather[playerid]);
	// Give Score/Money
	pLevel[playerid] = GetLevel(pScore[playerid]);
	SetPlayerScore(playerid, pScore[playerid]);
	SetPlayerMoney(playerid, pCash[playerid]);
	LoadTag(playerid);
}

OnUserManualLogin(playerid)
{
	SetTimerEx("ForcePasswordChangeDelay", 7000, false, "i", playerid);
	if(Helper[playerid]!=0)
	{
		if(Helper[playerid] == 1)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Helper {%06x}%s(%i) "YELLOW_E"has been logged in.", pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
		if(pMapper[playerid] == 1)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Mapper {%06x}%s(%i) "YELLOW_E"has been logged in.", pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
 		if(pHidden[playerid] == 0)
		{
			if(pDeveloper[playerid] == 1)
			{
				format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"Community Developer {%06x}%s(%i) "YELLOW_E"has been logged in.", pColor[playerid], pName[playerid], playerid);
				SendClientMessageToAll(COLOR_YELLOW, str);
			}
		}
	}
	else if(pAdmin[playerid] != 0 || pPremium[playerid] != 0)
	{
		if(pHidden[playerid] == 0)
		{
			format(str, sizeof(str), ""RED_E"[server] "YELLOW_E"%s {%06x}%s(%i) "YELLOW_E"has been logged in.", GetPlayerAdminLevelName(playerid), pColor[playerid], pName[playerid], playerid);
			SendClientMessageToAll(COLOR_YELLOW, str);

		}
		if(premiumExpired[playerid] != 0)
		{
			if(gettime() > premiumExpired[playerid])
			{
				format(query, sizeof(query), "UPDATE players SET premium=0,v_expired=0,chat_color=0,id_color=0,speedboost=1.3 WHERE reg_id=%d", pRegID[playerid]);
				MySQL_updateQuery(query);
				pPremium[playerid] = 0;
				pChatColor[playerid] = 0;
				pIDColor[playerid] = 0;
				speedBoost[playerid] = 1.3;
				Info(playerid, "Your premium membership has been expired today! You can renew on our site at serverserver.com!");
			}
		}
	}
	if(pTotalHours[playerid] == 0)
	{
		format(line, sizeof(line), ""WHITEP_E"You have successfully logged in!\n\n"dot"Name: %s\n"dot"IP: %s\n"dot"Online time: %d minutes.", pName[playerid], PlayerIP, pTotalMinutes[playerid]);
	}
	else format(line, sizeof(line), ""WHITEP_E"You have successfully logged in!\n\n"dot"Name: %s\n"dot"IP: %s\n"dot"Online time: %d hours and %d minutes.", pName[playerid], PlayerIP,  pTotalHours[playerid], pTotalMinutes[playerid]);
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""GREEN_E"Logged In!", line, "OK", "");


	format(str, sizeof(str), ""RED_E"*** "LB2_E"Welcome back {%06x}%s"LB2_E", you have successfully logged in!", pColor[playerid], pName[playerid]);
	SendClientMessage(playerid, COLOR_LB, str);
	if(pTotalHours[playerid] == 0)
	{
		format(str, sizeof(str), ""RED_E"*** "LB2_E"You have been online for "LB_E"%d minutes, %d seconds.", pTotalMinutes[playerid], pTotalSeconds[playerid]);
	}
	else format(str, sizeof(str), ""RED_E"*** "LB2_E"You have been online for "LB_E"%d hours, %d minutes, %d seconds.", pTotalHours[playerid], pTotalMinutes[playerid], pTotalSeconds[playerid]);
	SendClientMessage(playerid, COLOR_LB, str);
	format(str, sizeof(str), "5,9>>3,0 %s(%i) has logged in as a %s.", pName[playerid], playerid, GetPlayerAdminLevelName(playerid));
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "~w~Welcome back, ~r~~h~%s~w~!~n~~w~You are logged in as %s!", pName[playerid], GetPlayerAdminLevelName(playerid));
	InfoTD_MSG(playerid, 5200, str);
	// Set player custom Time/Weather
	if(pTime[playerid] != -1) SetPlayerTime(playerid, pTime[playerid], 0);
	if(pWeather[playerid] != -1) SetPlayerWeather(playerid, pWeather[playerid]);

	if(pInfo[playerid][pSaveSkin] != 999)
	{
		// Enable spectating so the default spawn selection shit does not show
		TogglePlayerSpectating(playerid, true);
		SetSpawnInfo(playerid, 0, pInfo[playerid][pSaveSkin], 324.2835,2549.4883,17.0000,181.596, 0, 0, 0, 0, 0, 0);
		TogglePlayerSpectating(playerid, false);
		HideConnectTD(playerid, false);
	}
	// Give Score/Money
	pLevel[playerid] = GetLevel(pScore[playerid]);
	
	LoadTag(playerid);
}

ShowRegisterDialog(playerid)
{
	format(line, sizeof(line), ""WHITEP_E"Welcome to server "RED_E":: "WHITEP_E"xTreme Stunt Freeroam, "YELLOW_E"%s\n\n"WHITE_E"You are not registered yet on this server.\nEnter your password below to register.\nYou can also continue without reigstering however your stats won't be saved!\n\n"RED_E"Info:\n- "WHITE_E"Your password must contain at least 4 characters\n"RED_E"- "WHITE_E"Remember your password, you will need it for your next login", pName[playerid]);
	ShowPlayerDialog(playerid, 4, DIALOG_STYLE_PASSWORD, ""LB2_E"Register your account", line, "Register", "Continue");
}

public OnPlayerDisconnect(playerid, reason)
{
	
	/*if(GetPVarInt(playerid, "nameChanged"))
	{
		GetPlayerName(playerid, PlayerName, 24);
		strdel(PlayerName, 0, 5);
		SetPlayerName(playerid, PlayerName);
		DeletePVar(playerid, "nameChanged");
	}*/

	if(Iter_Contains(LotteryIter, playerid)) {
		Iter_Remove(LotteryIter, playerid);
	}

	if(GetPVarInt(playerid, "ParticipatingHG") == 1 && mode_Alive > 0)
	{
	    SetPVarInt(playerid, "ParticipatingHG", 0);
	    SetPVarInt(playerid, "HGDead", 0);
	    canUseKey[playerid] = true;
	}

	if(admin3D[playerid] != Text3D:0xFFFF) DestroyDynamic3DTextLabel(admin3D[playerid]);
	if(IsBombPlanter == playerid && CSEvent) IsBombPlanter = BombPlanterSelect(), SendClientMessage(playerid, -1, ""RED_E"*You have been choosed to plant the bomb.");
	if(ChaseBonus)
	{
		if(ChasePlayer == playerid)
		{
			ChaseBonus = false;
			ChasePlayer = INVALID_PLAYER_ID;
			ChasePrice = 0;
			format(str, sizeof(str), "["SERVER_INITIALS" Chase]: %s (Id: %d) has left the server. Good luck next time!", pName[ChasePlayer], ChasePlayer);
			SendClientMessageToAll(-1, str);

			format(str, sizeof(str), "~r~Chase is over! ~g~%s(%d) left the server.", pName[ChasePlayer], ChasePlayer);
			TextDrawSetString(InfoTD2, str);
			foreach(new ii : Player)
			{
				if(Speedo[ii] == 1) PlayerTextDrawHide(ii, vSpeed[ii]), TextDrawHideForPlayer(ii, vSpeedBox);
				SetPlayerColor(ii, pColor[ii]);
			}
			TextDrawShowForAll(InfoTD2);
			SetTimer("HideInfoTD", 6000, false);
		}
	}
	EventDialogPlayer = false;

	DestroyDynamic3DTextLabel(admin3D[playerid]);

	if(GetPVarInt(playerid, "FullHidden")) cmd_fullhide(playerid, "");
	if(GetPVarInt(playerid, "PayGatesCreated") == 1)
		UnBlockPayNSpray(playerid); //remove the created objects if they are created.
	// Remove the player from the sscanf system
	//SSCANF_Leave(playerid);

	rektPlayers[playerid] = 0;
	 // Check if name needs to be changed.
	GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	/*if(AFK[playerid] == 1)
	{
		AFK[playerid] = 0;
		strdel(PlayerName, 0, 5);
		SetPlayerName(playerid, PlayerName);
	}*/
	if(GetPVarInt(playerid, "pBugged"))
	{
		format(str, sizeof(str), "unbanip %s", pIP[playerid]);
		SendRconCommand(str);
		SendRconCommand("reloadbans");
		printf("p bugged");
	}
	// Save the player stats.
	SavePlayerStats(playerid);

	// Update DM Textdraw
	if(InDM[playerid] != 0)
	{
		CheckDM(playerid);
		UpdateDMText();
	}

	// Remove the player's custom vehicle
	RemoveComponents(playerid, true);
	if((vID = pSpawnVehicle[playerid]) != -1)
	{
		foreach(new ii : Player)
		{
			if(IsPlayerInVehicle(ii, vID))
			{
				RemovePlayerFromVehicle(ii);
				format(str, sizeof(str), "Server: "GREY_E"%s(%i) who spawned this %s has left.", PlayerName, playerid, vehName[GetVehicleModel(vID) - 400]);
				SendClientMessage(ii, COLOR_RED, str);
			}
		}
		DestroyVehicle(vID);
		pSpawnVehicle[playerid] = -1;
	}
	// Destroy Private Vehicle
	if(PlayerVehicle[playerid][0] != -1 || PlayerVehicle[playerid][1] != -1)
	{
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][0]);
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][1]);

		if(IsValidVehicle(PlayerVehicle[playerid][0])) DestroyVehicle(PlayerVehicle[playerid][0]), PlayerVehicle[playerid][0] = -1;
		if(IsValidVehicle(PlayerVehicle[playerid][1])) DestroyVehicle(PlayerVehicle[playerid][1]), PlayerVehicle[playerid][1] = -1;
	}
	if(GetPVarInt(playerid, "killCamSpectator"))
	{
		new watcherid = GetPVarInt(playerid, "killCamSpectator");
		KillTimer(killCamTimer[watcherid]);
		TogglePlayerSpectating(watcherid, 0);
		hideKillCam(watcherid);
		killCamON[watcherid] = false;
		DeletePVar(playerid, "killCamSpectator");
	}
	// Perform some checks.
	foreach(new ii : Player)
	{
		if(GetPVarInt(ii, "lastPMer") == playerid)
		{
			SetPVarInt(ii, "lastPMer", -1);
		}
		if(ignore[ii][playerid] == 1)
		{
			ignore[ii][playerid] = 0;
		}
		if(pSpectating[ii] == playerid)
		{
			format(str, sizeof(str), "- AS - "RED_E"%s(%i) has disconnected, you will be respawned.", PlayerName, playerid);
			SendClientMessage(ii, COLOR_YELLOW, str);
			TogglePlayerSpectating(ii, 0);

			if(InDM[ii] != 13 || InDM[ii] != SawnDM::ID)
			{
				Streamer_ToggleItemUpdate(ii, STREAMER_TYPE_OBJECT, 1);
			}
		}
	}

	// Kill some timers.
	if(pInfo[playerid][pRainbow] == 1) KillTimer(RainbowTimer[playerid]);
	if(RobberyCount[playerid] != 0)	KillTimer(RobberyTimer[playerid]);

	// Remove Attached Objects
	RemoveItems(playerid);

	// Reset House Interior
	if(GetPVarInt(playerid, "HousePreview") == 1)
	{
		new h = GetPVarInt(playerid, "LastHouseCP");
		hInfo[h][HouseInterior] = GetPVarInt(playerid, "OldHouseInt");
		DestroyHouseEntrance(h, TYPE_INT);
		CreateCorrectHouseExitCP(h);
		IsInHouse{playerid} = 0;
		foreach(new ii : Player)
		{
			if(GetPVarInt(ii, "LastHouseCP") == h && IsInHouse{ii} == 1)
			{
				SetPlayerHouseInterior(ii, h);
			}
		}
	}

	// Desroy some 3D Text Labels.
	if(GOD[playerid] == 1 && god3D[playerid] != Text3D:-1)
	{
		DestroyDynamic3DTextLabel(god3D[playerid]);
	}
	if(GetPVarInt(playerid, "tagCreated"))
	{
		DestroyDynamic3DTextLabel(clan3D[playerid]);
	}
	//Delete3DTextLabel(AFK3D[playerid]);
	if(admin3D[playerid] != Text3D:-1) DestroyDynamic3DTextLabel(admin3D[playerid]);

	// Delete Texrdraws
	HidePlayerTextDraws_OPDC(playerid);
	PlayerTextDrawDestroy(playerid, InfoTD[playerid]);
	PlayerTextDrawDestroy(playerid, vTD[playerid]);
	PlayerTextDrawDestroy(playerid, vSpeed[playerid]);

	// Disconnect Message
	Iter_Remove(Player, playerid);

	iTemp = ((GetTickCount() - pJoinTick[playerid]) / 1000);
	if(iTemp >= 3)
	{
		new ii = gettime();
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO activity (reg_id,name,IP,jointime,leavetime) VALUES (%d,'%e','%e',%d,%d)", pRegID[playerid], pName[playerid], pIP[playerid], (ii - iTemp), ii);
		MySQL_updateQuery(query);
	}

	switch(reason)
	{
		case 0:
		{
			tmp = "timed out";
			format(str, sizeof(str), "02[Crash] 03%s(%d) has timed out. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
		case 1:
		{
			tmp = "left the server";
			format(str, sizeof(str), "02[Quit] 03%s(%d) has left the server. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
		case 2:
		{
			tmp = "been kicked/banned";
			format(str, sizeof(str), "02[Quit] 03%s(%d) has been kicked/banned. 1[%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
	}
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	switch(reason)
	{
		case 0:
		{
			tmp = "timed out";
			format(str, sizeof(str), "**[Connection]** %s (%d) has timed out. [%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
		case 1:
		{
			tmp = "left the server";
			format(str, sizeof(str), "**[Connection]** %s (%d) has left the server. [%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
		case 2:
		{
			tmp = "been kicked/banned";
			format(str, sizeof(str), "**[Connection]** %s (%d) has been kicked/banned. [%d/420]", pName[playerid], playerid, Iter_Count(Player));
		}
	}
	//DCC_SendChannelMessage(Channel_Echo, str);

	

	if(doingStunt[playerid] != 99)
	{
		if(Iter_Count(Player) > 20)
		{
			SendDeathMessage(INVALID_PLAYER_ID, playerid, 201);
		}
		else
		{
			format(str, sizeof(str), ""RED_E"<> "LB_E"%s(%i) "LB2_E"has %s. "GREY2_E"[%d/420]", PlayerName, playerid, tmp, Iter_Count(Player));
			SendClientMessageToAll(COLOR_LB, str);
		}
	}

	//remove roadblocks
	if(pblock[playerid] != 0)
	{
		for(new r = 0; r < pblock[playerid]; r++)
		{
			DestroyDynamicObject(block[r][playerid]);
			block[r][playerid] = INVALID_OBJECT_ID;
		}
	}

	// Remove player from race.
	if(RaceParticipant[playerid] != 0)
	{
		Participants --;
		if(RaceStart == 1 && Participants == 0)
		{
			format(str, sizeof(str), ""RACE" The last participator in race '%s' has left, race has ended.", CRaceName);
			SendClientMessageToAll(COLOR_WHITEP, str);
			format(str, sizeof(str), "2,9RACE7,0 The last participator in race '%s' has left, race has been ended.", CRaceName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			endrace();
		}
		RaceParticipant[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
	}
	if(RaceBuilders[playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		for(new i = 0; i < BCurrentCheckpoints; i++)
		{
			BRaceCheckpoints[i][0] = 0.0;
			BRaceCheckpoints[i][1] = 0.0;
			BRaceCheckpoints[i][2] = 0.0;
		}
		RaceBuilders[playerid] = 0;
		RaceBuilt = 0;
	}
	if(ParkourBuilders[playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		for(new i = 0; i < pBCurrentCheckpoints; i++)
		{
			pBRaceCheckpoints[i][0] = 0.0;
			pBRaceCheckpoints[i][1] = 0.0;
			pBRaceCheckpoints[i][2] = 0.0;
		}
		ParkourBuilders[playerid] = 0;
		ParkourBuilt = 0;
	}
	if(snowOn[playerid]) // xMAS
	{
		DeleteSnow(playerid);
	}
	//if(GetPVarInt(playerid, "RedTeam") == 1) RedCount--;
	//else if(GetPVarInt(playerid, "BlueTeam") == 1) BlueCount--;

	/*if(bounty[playerid] > 0)
	{
		// Give bountys back
		foreach(new ii : Player)
		{
			if(GetPVarInt(ii, "hitAmount") != -1)
			{
				new cashback = GetPVarInt(ii, "hitAmount");
				GivePlayerCash(ii, cashback);
				format(str, sizeof(str), ""RED_E"[HIT] "WHITEP_E"%s(%d) has disconnected, you have received back %s.", pName[playerid], playerid, ToCurrency(bounty[playerid]));
				SendClientMessage(ii, COLOR_WHITEP, str);
			}
			SetPVarInt(ii, "hitMan", -1);
			DeletePVar(ii, "hitAmount");
		}
	}*/

	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
	{
		if(InDerby[playerid] == 1)
		{
			DerbyPlayers--;
			SetTimer("EndDerbyCheck", 1000, 0);
			format(str,sizeof(str),""EVENT" "DARK_E"Player %s has been eliminated! (Left Server)", PlayerName);
			SendEventMessage(COLOR_DARK, str);
		}
		else
		{
			SetTimer("EndEventCheck", 1000, 0);
			NumEventPlayers--;
			format(str,sizeof(str),""EVENT" "DARK_E"Player %s has been eliminated! (Left Server)", PlayerName);
			SendEventMessage(COLOR_DARK, str);
		}
		InEvent[playerid] = 0;
	}
	if(doingStunt[playerid] == 18) // Fallout
	{
		RemoveFromFallout(playerid);
	}
	if(doingStunt[playerid] == 33) // LMS
	{
		RemoveFromLMS(playerid);
		LMS_LoseGame();
	}
	cAFK[playerid] = 0;
	pRegID[playerid] = 0;
	if(doingStunt[playerid] == 19) // Derby
	{
		RemoveFromDerby(playerid);
	}
	if(pGroupID[playerid] != -1 && pAdmin[playerid] < 6)
	{

		format(str, sizeof(str), ""GROUP" %s %s(%d) from your group has disconnected.", GetGroupRank(pGroupID[playerid],pGroupRank[playerid]), pName[playerid], playerid);
		SendGroupMessage(playerid, str);
	}
	UpdateDMText();
	PUBG_OnPlayerDisconnect(playerid,reason);
	new string[128];
	if(GetPVarType(playerid, "Music"))
	{
 		DestroyDynamicObject(GetPVarInt(playerid, "Music"));
   		DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "MusicLabel"));
	    if(GetPVarType(playerid, "MusicArea"))
	    {
			format(string, sizeof(string), ""SERVER_INITIALS" %s(%d) has been disconnected, Musicbox removed!", GetName(playerid) , playerid);
      		foreach(new i : Player)
			{
        		if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "MusicArea")))
          		{
            		StopAudioEx(i);
            		SetPVarInt(playerid,"Music",0);
              		SendClientMessage(i, COLOR_PURPLE, string);
				}
			}
		}
	}
	return true;
}

function HideConnectTD(playerid, bool:ShowTextD)
{
	TextDrawHideForPlayer(playerid, ConnectTD[0]);
	TextDrawHideForPlayer(playerid, ConnectTD[1]);
	TextDrawHideForPlayer(playerid, ConnectTD[2]);
	TextDrawHideForPlayer(playerid, ConnectTD[3]);
	TextDrawHideForPlayer(playerid, ConnectTD[4]);
	TextDrawHideForPlayer(playerid, ConnectTD[5]);
	TextDrawHideForPlayer(playerid, ConnectTD[6]);
	TextDrawHideForPlayer(playerid, ConnectTD[7]);
	TextDrawHideForPlayer(playerid, ConnectTD[9]);
	TextDrawHideForPlayer(playerid, ConnectTD[10]);
	TextDrawHideForPlayer(playerid, ConnectTD[11]);
	TextDrawHideForPlayer(playerid, xmasTD[0]);
	TextDrawHideForPlayer(playerid, xmasTD[1]);


	if(pSpawned[playerid] == 0 && ShowTextD == true)
	{
		TextDrawShowForPlayer(playerid, wTD);
		TextDrawShowForPlayer(playerid, wTD1);
		TextDrawShowForPlayer(playerid, wTD2);
		TextDrawShowForPlayer(playerid, wTD3);
		TextDrawShowForPlayer(playerid, wTD4);
		TextDrawShowForPlayer(playerid, wTD5);
		TextDrawShowForPlayer(playerid, wTD6);
		TextDrawShowForPlayer(playerid, wTD7);
		TextDrawShowForPlayer(playerid, wTD8);
		TextDrawShowForPlayer(playerid, wTD9);
	}
	return 1;
}
public OnPlayerRequestClass(playerid, classid)
{
	// Hide Connect Textdraws.
	TextDrawHideForPlayer(playerid, letterbox[0]);
	TextDrawHideForPlayer(playerid, letterbox[1]);
	TextDrawHideForPlayer(playerid, letterbox[2]);
	TextDrawHideForPlayer(playerid, letterbox[3]);
	SetTimerEx("HideConnectTD", 3000, false, "ib", playerid, true);


	TextDrawShowForPlayer(playerid, Server_TD[0]);
	TextDrawShowForPlayer(playerid, Server_TD[1]);
	TextDrawShowForPlayer(playerid, Server_TD[2]);
	TextDrawShowForPlayer(playerid, Server_TD[3]);
	TextDrawShowForPlayer(playerid, Server_TD[4]);
	TextDrawShowForPlayer(playerid, Server_TD[5]);
	TextDrawShowForPlayer(playerid, Server_TD[6]);
	TextDrawShowForPlayer(playerid, SEv2Box);
	TextDrawShowForPlayer(playerid, DMTextdraw);

	//Skin saving enabled, skip class selection..
	if(pInfo[playerid][pSaveSkin] != 999)
	{
		// Enable spectating so the default spawn selection shit does not show
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "YELLOW_E"You have skin saving enabled, class selection being skipped..");
		TogglePlayerSpectating(playerid, true);
		SetSpawnInfo(playerid, 0, pInfo[playerid][pSaveSkin], 324.2835,2549.4883,17.0000,181.596, 0, 0, 0, 0, 0, 0);
		TogglePlayerSpectating(playerid, false);
		HideConnectTD(playerid, false);


		return 1;
	}

	// Load class selection..
	if(GetPVarInt(playerid, "CamMoved") == 0)
	{
		Streamer_UpdateEx(playerid, -1451.9629,1574.2770,1057.7589);
		SetPVarInt(playerid, "CamMoved", 1);
		SetPlayerInterior(playerid, 14);
		SetPlayerPos(playerid, -1451.9629,1574.2770,1057.7589);
		SetPlayerFacingAngle(playerid, 129.6340);
