	// Connect to MySQL
	/*if(mysql_ping(1) != 0)
	{
		print("================ [ERROR] ================");
		print("Connection to MySQL failed.");
		SendRconCommand("exit");
		return 1;
	}*/



	//PLEASE ONLY CHANGE SERVER_CONFIG.pwn, DO NOT EDIT MANUALLY!!
	mysql_connect(MYSQL_HOST, MYSQL_USER, MYSQL_DB, MYSQL_PASS);  





	// Reset active row
	MySQL_updateQuery("UPDATE players SET active=0 WHERE active=1");

	// Reaction Test
	xChars = "1+1=fish";

	// AlDuelz stuff.
	new AL_Actor[6];
