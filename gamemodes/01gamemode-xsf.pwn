function RemoveFromDeathmatch(playerid)
{
	RemovePlayerFromDM(playerid);
	pSpawned[playerid] = 1;
	SetPlayerHealth(playerid, 98);
	SendClientMessage(playerid, COLOR_GREY2, ""SERVER_INITIALS" "GREY2_E"You have left the deathmatch.");
	TogglePlayerControllable(playerid, true);
	LoadPlayerPosition(playerid);
	DeletePVar(playerid, "hackWarns");
	return 1;
}

GodModeLabel(playerid, bool:show)
{
	if(GOD[playerid] == 1 && god3D[playerid] != Text3D:-1)
	{
		if(show == true)
		{
			UpdateDynamic3DTextLabelText(god3D[playerid], 0xFFFF8288, "Godmode {41FF00}ON");
			TextDrawShowForPlayer(playerid, godTD);
		}
		else
		{
			UpdateDynamic3DTextLabelText(god3D[playerid], -1, " ");
			TextDrawHideForPlayer(playerid, godTD);
		}
	}
}

SendToDM(playerid)
{
		if(playerSpectated[playerid] != 0)
		{
			hour = GetPlayerVirtualWorld(playerid);
			minute = GetPlayerInterior(playerid);
			format(str, sizeof(str), ""SERVER_INITIALS" %s(%i) has respawned.", pName[playerid], playerid);
			foreach(new ii : Player)
			{
				if(pSpectating[ii] == playerid)
				{
					PlayerSpectatePlayer(ii, playerid);
					SetPlayerVirtualWorld(ii, hour);
					SetPlayerInterior(ii, minute);
					SendClientMessage(ii, COLOR_YELLOW, str);
				}
			}
		}
		ResetPlayerWeapons(playerid);
		GodModeLabel(playerid, false);
		if(InDM[playerid] != 16 && InDM[playerid] != 18 && pSpectating[playerid] == -1)
		{
			SetPlayerHealth(playerid, 9999);
			SetTimerEx("ResetHealth", 2000, false, "i", playerid);
		}
		if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour"))
		{
			SetPlayerArmour(playerid, 98.0);
		}
		switch(InDM[playerid])
		{
			case 1:
			{
				switch(random(7))
				{
					case 0: SetPlayerPosition(playerid, -1131.6479, 1029.1998, 1345.7306, 255.3691, 10);
					case 1: SetPlayerPosition(playerid, -975.3635, 1089.3511, 1344.9720, 88.6975, 10);
					case 2: SetPlayerPosition(playerid, -1009.2294, 1078.9606, 1343.2344, 81.4908, 10);
					case 3: SetPlayerPosition(playerid, -1042.9960, 1040.1443, 1342.2969, 323.6997, 10);
					case 4: SetPlayerPosition(playerid, -1096.5231, 1022.0341, 1343.5490, 320.9030, 10);
					case 5: SetPlayerPosition(playerid, -1131.8911, 1094.6980, 1345.7910, 270.4559, 10);
					case 6: SetPlayerPosition(playerid, -973.5475, 1023.6379, 1345.0494, 93.4210, 10);
				}
                if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in Battlefield.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /leave to exit the deathmatch.");
				switch(GetPVarInt(playerid, "BFWeaps"))
				{
					case 1: // Weapon Set 1
					{
						GivePlayerWeapon(playerid, 4, 1); // Knife
						GivePlayerWeapon(playerid, 31, 600); // M4
						GivePlayerWeapon(playerid, 24, 300); // Deagle
						GivePlayerWeapon(playerid, 27, 150); // Combat
						GivePlayerWeapon(playerid, 29, 800); // MP5

					}
					case 2: // Weapon Set 2
					{
						GivePlayerWeapon(playerid, 8, 1); // Katana
						GivePlayerWeapon(playerid, 30, 500); // Ak
						GivePlayerWeapon(playerid, 24, 300); // Deagle
						GivePlayerWeapon(playerid, 26, 150); // Sawnoff
						GivePlayerWeapon(playerid, 32, 800); // TEC

					}
					case 3: // Weapon Set 3
					{
						GivePlayerWeapon(playerid, 9, 1); // Chainsaw
						GivePlayerWeapon(playerid, 31, 500); // M4
						GivePlayerWeapon(playerid, 33, 500); // Country Rifle
						GivePlayerWeapon(playerid, 23, 300); // Silenced 9MM
						GivePlayerWeapon(playerid, 27, 150); // Combat
						GivePlayerWeapon(playerid, 32, 800); // TEC-9

					}
					case 4: // Weapon Set 4
					{
						GivePlayerWeapon(playerid, 6, 1); // Shovel
						GivePlayerWeapon(playerid, 30, 500); // AK
						GivePlayerWeapon(playerid, 34, 500); // Sniper Rifle
						GivePlayerWeapon(playerid, 24, 300); // Deagle
						GivePlayerWeapon(playerid, 26, 150); // Sawnoff
						GivePlayerWeapon(playerid, 28, 400); // Uzi

					}
				}
				InDM[playerid] = 1;
			}
			case 2:
			{
				switch(random(7))
