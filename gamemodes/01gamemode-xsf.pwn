	SendClientMessageToAll(COLOR_WHITEP, str);

	format(str, sizeof(str), "~b~Race ~y~%s ~b~is starting. Type ~g~/join ~b~to race!", CRaceName);
	TextDrawSetString(InfoTD2, str);
