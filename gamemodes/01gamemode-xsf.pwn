ToCurrency(cCash)
{
	new szStr[16];
	format(szStr, sizeof(szStr), "%i", cCash);

	for(new iLen = strlen(szStr) - 3; iLen > 0; iLen -= 3)
	{
		strins(szStr, ",", iLen);
	}
	return szStr;
}



SendPlayerPM(p1, p2, msg[])
{
	// Decide about multi-line PMs
	new i = -1;
	if(strlen(msg) > 70)
	{
		i = strfind(msg, " ", false, 60);
		if(i > 80 || i == -1) i = 70;

		// store the second line text
		line = " ";
		strcat(line, msg[i]);

		// delete the rest from msg
		msg[i] = EOS;
	}
	// Anti-Advertisement
	new dotCount, numCount;
	for(new ii = 0; ii < strlen(msg); ii++)
	{
		if(msg[ii] == '.')
		{
			dotCount++;
		}
		else if(msg[ii] >= '0' && msg[ii] <= '9')
		{
			numCount++;
		}
	}
	if(dotCount >= 2 && numCount >= 7)
	{
		if(strfind(msg, "samp.serverserver.com") == -1)
		{
			format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (msg: %s)", pName[p1], p1, msg);
			SendAdminMessage(COLOR_RED, str);
			SendClientMessage(p1, COLOR_RED, ""GREY2_E"Server: "RED_E"You are not allowed to advertise other servers here!");
			format(str, sizeof(str), "4Server:2 %s(%d) has attempted to advertise! (msg: %s)", pName[p1], p1, msg);
			IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str), "**[Admin]** %s (%i) has attempted to advertise! (msg: %s)", pName[p1], p1, msg);
			//DCC_SendChannelMessage(Channel_Staff, str);
			return 1;
		}
	}
	if(strfind(LastText[p1], msg, false) != -1)
	{
		RepeatMsg[p1]++;
		if(RepeatMsg[p1] >= 2 && pAdmin[p1] == 0)
		{
			SendClientMessage(p1, COLOR_GREY, ""RED_E"Server: "GREY2_E"Do not repeat your message.");
			return true;
		}
	}
	else RepeatMsg[p1] = 0;
	strmid(LastText[p1], msg, 0, strlen(msg), sizeof(LastText[]));

	// Anti-Caps
	if(GetPVarType(p1, "Caps")) UpperToLower(msg);
	format(str, sizeof(str), ""RED_E"* "LB_E"PM from {%06x}%s(%i): "LB_E"%s", pColor[p1], pName[p1], p1, msg);
	SendClientMessage(p2, COLOR_LB, str);
	if(i != -1) SendClientMessage(p2, 0x15D4EDFF, line);

	format(str, sizeof(str), ""RED_E"* "LB_E"PM to {%06x}%s(%i): "LB_E"%s", pColor[p2], pName[p2], p2, msg);
	SendClientMessage(p1, COLOR_LB, str);
	if(i != -1) SendClientMessage(p1, 0x15D4EDFF, line);

	format(str, sizeof(str), "~g~~h~PM from ~y~%s(%i)", pName[p1], p1);
	InfoTD_MSG(p2, 3500, str);
	format(str, sizeof(str), "~g~~h~PM sent to ~b~~h~%s(%i)!", pName[p2], p2);
	InfoTD_MSG(p1, 3500, str);

	TextDrawShowForPlayer(p1, CheckTD);
	TextDrawShowForPlayer(p2, NewMsgTD);
	SetTimerEx("hideMsgTD", 3500, false, "i", p2);
	SetTimerEx("hideCheck", 3500, false, "i", p1);

	if(GetPVarInt(p2, "FirstPM") == 0)
	{
		SendClientMessage(p2, COLOR_LB, ""ORANGE_E"* "LB2_E"Use "ORANGE_E"@<text> "LB2_E"to quickly reply to messages.");
		SetPVarInt(p2, "FirstPM", 1);
	}
	format(str, sizeof(str), ""RED_E"PM: "DARK_E"%s(%i) -> %s(%i): "GREY_E"%s", pName[p1], p1, pName[p2], p2, msg);
	foreach(new ii : Player)
	{
		if(ii == p2 || ii == p1) continue;
		if(pAdmin[ii] >= 3 && pInfo[ii][pSeePMs] == 1 && pAdmin[p1] != 6)
		{
			SendClientMessage(ii, COLOR_GREY, str);
			if(i != -1) SendClientMessage(ii, COLOR_GREY, line);
		}
	}
	if(pAdmin[p1] != 6)
	{
		format(str, sizeof(str), "4PM:2 %s(%i) to %s(%i):1 %s", pName[p1], p1, pName[p2], p2, msg);
		IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		if(i != -1) IRC_GroupSay(ircGroup, IRC_aCHANNEL, line);

		format(str, sizeof(str), "**[Private Message]** %s (%i) -> %s(%i): %s", pName[p1], p1, pName[p2], p2, msg);
		//DCC_SendChannelMessage(Channel_Staff, str);
		//if(i != -1) //DCC_SendChannelMessage(Channel_Staff, line);
	}

	format(str, sizeof(str), ""RED_E"%s(%i): "WHITE_E"%s", pName[p1], p1, msg);
	for(new ir = 1; ir < MAX_PMS - 1; ir++)
	{
		PMs[p2][ir] = PMs[p2][ir + 1];
	}
	PMs[p2][MAX_PMS - 1] = str;

	if(PMSound[p1]) PlayerPlaySound(p1, 1057, 0.0, 0.0, 0.0);
	if(PMSound[p2]) PlayerPlaySound(p2, 1057, 0.0, 0.0, 0.0);
	SetPVarInt(p2, "lastPMer", p1);
	if(GetPVarInt(p1, "PMsDisabled") == 1)
	{
		SendClientMessage(p1, COLOR_LRED, ""SERVER_INITIALS" "LRED_E"Your private messages are disabled, type /togpm to enable them.");
	}
	if(cAFK[p2] >= 10)
	{
		format(str, sizeof(str), ""RED_E"> "YELLOW_E"%s(%d) is currently AFK and may not have received your message.", pName[p2], p2);
		SendClientMessage(p1, COLOR_YELLOW, str);
		SetPVarInt(p2, "recivedPM", 1);
	}
	return 1;
}

GameTimeConvert(seconds)
{
	new etmp[16];
	new minutes = floatround(seconds / 60);
	seconds -= minutes * 60;
	format(etmp, sizeof(etmp), "%i:%02i", minutes, seconds);
	return etmp;
}

GetDistance(Float:xPos, Float:yPos, Float:zPos, Float:xPos2, Float:yPos2, Float:zPos2)
{
	xPos -= xPos2;
	yPos -= yPos2;
	zPos -= zPos2;
	return floatround(floatpower((xPos * xPos) + (yPos * yPos) + (zPos * zPos), 0.5));
}

