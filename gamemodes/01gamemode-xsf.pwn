	    case 9852: // lottery
	    {
	        if(!response) return 1;
	        if(response)
			{
				switch(listitem)
				{
			        case 0:
					{
						new currentTime = gettime();
				        if(LotteryInfo[ticketsBought] == 0 || LotteryInfo[lotteryActive] == 0) {
					        if(LotteryInfo[lastFinished]+1800 <= currentTime) {
					            if(pCash[playerid] >= 100000) {

					                /* CHECKING HOW MANY TICKETS */

									if(lottCount[playerid] < 3) {
									    lottCount[playerid]++;
						                LotteryInfo[ticketsBought]++;
						                LotteryInfo[lotteryValue] += 100000;
						                GivePlayerCash(playerid, -100000);
						                LotteryInfo[lotteryActive] = 1;
						                LotteryInfo[lastStarted] = gettime();
						                LotteryInfo[LotteryTime] = 120;
						                SendClientMessage(playerid, -1, "{FF0000}[LOTTERY]: {FFFFFF}You took part in the lottery; /lottery for more information.");
						                SendClientMessageToAll(playerid, "{FF0000}NEW LOTTERY STARTED: /lottery");
						                LotteryInfo[LotteryTimer] = SetTimer("LotteryFinish",1000, true);
						                Iter_Add(LotteryIter, playerid);
									}
									else Error(playerid, "You cannot buy any more tickets!");
								}
								else Error(playerid, "You do not have enough money to afford this! (100'000$)");
							}
							else {
								new tempStr[128];
								new timeLeft = (LotteryInfo[lastFinished]+1800) - currentTime;
								format(tempStr, sizeof tempStr, "ERROR: You may start a new lottery again in %i seconds.", timeLeft);
								SendClientMessage(playerid, -1, tempStr);
							}

						}
						else {
						    if(pCash[playerid] >= 100000) {
						        if(lottCount[playerid] < 3) {
					                LotteryInfo[ticketsBought]++;
					                Iter_Add(LotteryIter, playerid);
					                LotteryInfo[lotteryValue] += 100000;
					                GivePlayerCash(playerid, -100000);
									lottCount[playerid]++;
					                SendClientMessage(playerid, -1, "{FF0000}[LOTTERY]: {FFFFFF}You took part in the lottery; /lottery for more information.");
				                }
				                else Error(playerid, "You cannot buy any more tickets!");
							}
							else Error(playerid, "You do not have enough money to afford this! (100'000$)");
						}
					}
					case 1:
					{
					    new available[30];
						new availability = (LotteryInfo[lastFinished]+1800) - gettime();
						if(availability <= 0) {
							format(available, sizeof available, "{00C71B}Available");
						}
						else {
							format(available, sizeof available, "{FF0000}Not available");
						}

					    new lotString[512];
						if(LotteryInfo[lotteryActive] == 1) {

						    format(lotString, sizeof lotString, "{20C4FA}xTreme Stunt Freeroam {FFFFFF}lottery information,\n\n{20C4FA}Tickets bought: {FFFFFF}%i\n{20C4FA}Current win value: {FFFFFF}%i$\n{20C4FA}Time left:{FFFFFF} %i seconds\n\n{20C4FA}Last winner: {FFFFFF}%s\n{20C4FA}Last winning value: {FFFFFF}%i$",
						    LotteryInfo[ticketsBought],
						    LotteryInfo[lotteryValue],
						    LotteryInfo[LotteryTime],
						    LotteryInfo[lastWinner],
							LotteryInfo[lastWinningValue]);
							ShowPlayerDialog(playerid, 9854, DIALOG_STYLE_MSGBOX, "Lottery info", lotString, "Close", "");
						}
						else {
						    format(lotString, sizeof lotString, "{20C4FA}xTreme Stunt Freeroam {FFFFFF}lottery information,\n\n{20C4FA}Tickets bought: {FFFFFF}%i\n{20C4FA}Current win value: {FFFFFF}%i$\n{20C4FA}Next lottery: %s\n\n{20C4FA}Last winner: {FFFFFF}%s\n{20C4FA}Last winning value: {FFFFFF}%i$",
						    LotteryInfo[ticketsBought],
						    LotteryInfo[lotteryValue],
						    available,
						    LotteryInfo[lastWinner],
							LotteryInfo[lastWinningValue]);
							ShowPlayerDialog(playerid, 9854, DIALOG_STYLE_MSGBOX, "Lottery info", lotString, "Close", "");
						}
					}
				}
				return 1;
			}
	    }
