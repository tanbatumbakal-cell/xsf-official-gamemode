				strcat(line3, "\n"IVORY_E"/dive\t\t"RED_E"» "WHITE_E"Throw yourself 500 feet.\n"IVORY_E"/irc\t\t"RED_E"» "WHITE_E"Send a message to the IRC channel.\n"IVORY_E"/ircpm\t\t"RED_E"» "WHITE_E"Send a PM to a player on the IRC channel.\n"IVORY_E"/answer\t"RED_E"» "WHITE_E"Answer a math question.\n"IVORY_E"/bug\t\t"RED_E"» "WHITE_E"Report a bug.\n"IVORY_E"/cookiehelp\t"RED_E"» "WHITE_E"Information on the cookie(karma) system.");
