CMD:fightstyles(playerid)
{
	if(GetLevel(pScore[playerid]) < 3) return Error(playerid, "You must be an Casual or above in order to use this command, Please take a look on /ranks.");
	ShowPlayerDialog(playerid, 164, DIALOG_STYLE_LIST, ""YELLOW_E"Fighting Styles:", "Normal\nBoxing\nKung Fu\nKneehead\nGrabKick\nElbow", "Select", "Cancel");
	return 1;
}

CMD:letterbox(playerid)
{
	if(GetPVarInt(playerid, "letterbox") == 0)
	{
		SetPVarInt(playerid, "letterbox", 1);
		TextDrawShowForPlayer(playerid,letterbox[0]);
		TextDrawShowForPlayer(playerid,letterbox[1]);
		SendClientMessage(playerid, COLOR_YELLOW, "Server: Type /letterbox again to remove the textdraw.");
	}
	else
	{
		DeletePVar(playerid, "letterbox");
		TextDrawHideForPlayer(playerid,letterbox[0]);
		TextDrawHideForPlayer(playerid,letterbox[1]);
	}
	return 1;
}
CMD:spawnhere(playerid)
{
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't save your position in a DM zone!");
	if(doingStunt[playerid] != 0)
		return Error(playerid, "You can't save your position in this area!");

	if (IsPlayerInAnyVehicle(playerid))
	{
		GetVehiclePos(GetPlayerVehicleID(playerid), SpawnPos[playerid][sX], SpawnPos[playerid][sY], SpawnPos[playerid][sZ]);
		GetVehicleZAngle(GetPlayerVehicleID(playerid), SpawnPos[playerid][sA]);
	}
	else
	{
		GetPlayerPos(playerid, SpawnPos[playerid][sX], SpawnPos[playerid][sY], SpawnPos[playerid][sZ]);
		GetPlayerFacingAngle(playerid, SpawnPos[playerid][sA]);
	}

	SpawnPos[playerid][SpawnSavedPos] = 1;
	SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"Your spawn position is now saved, you will spawn here on your next spawn.");
	return 1;
}
CMD:ramps(playerid) return cmd_ramp(playerid);
CMD:ramp(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't enable ramp spawning in a DM zone!");
	if(doingStunt[playerid] != 0)
		return Error(playerid, "You can't enable ramp spawning in this area!");
	if(GetPlayerState(playerid)== PLAYER_STATE_DRIVER)
	{
		if(GetPVarInt(playerid, "Ramped") == 0)
		{
			SetPVarInt(playerid, "Ramped", 1);
			SendClientMessage(playerid, COLOR_GREEN, ""SERVER_INITIALS" "GREEN_E"You have turned ramp spawning on!");
			Info(playerid, "Press the 'Fire (CTRL by default)' key whilst in a vehicle to spawn a ramp.");
			Info(playerid, "If you wish to disable ramp spawning, type /ramp again.");
		}
		else
		{
			DeletePVar(playerid, "Ramped");
			SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "RED_E"You have turned ramp spawning OFF!");
		}
	}
	else Error(playerid, "You must be the driver of a vehicle to enable ramp spawning!");
	return 1;
}

