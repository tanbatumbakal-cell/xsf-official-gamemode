CMD:togmusic(playerid)
{
	if(GetPVarInt(playerid, "enMusic") == 0)
	{
	    SetPVarInt(playerid, "enMusic", 1);
	    SendClientMessage(playerid, -1, "{FF0000}[MUSIC PLAYER] {FFFFFF}Player has been activated, the next song will automatically play!");
	}
	else if(GetPVarInt(playerid, "enMusic") == 1)
	{
	    SetPVarInt(playerid, "enMusic", 0);
	    SendClientMessage(playerid, -1, "{FF0000}[MUSIC PLAYER] {FFFFFF}Player has been disabled!");
	}
	return 1;
}

CMD:togdmads(playerid)
{
	if(dmMessages[playerid] == 0)
	{
	    dmMessages[playerid] = 1;
	    SendClientMessage(playerid, -1, "{FF0000}DM advertisements have been activated.");
	}
	else if(dmMessages[playerid] == 1)
	{
	    dmMessages[playerid] = 0;
	    SendClientMessage(playerid, -1, "{FF0000}DM advertisements have been disabled.");
	}
	return 1;
}

CMD:dms(playerid) return cmd_dm(playerid);
CMD:dm(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] == 13) return Error(playerid, "Leave the CnR minigame before joining a DM! "RED_E"/leave.");
	new line7[1700];
	strcat(line7, ""YELLOW_E"BattleField\t\t"LB_E"[/bf]\n"YELLOW_E"Rocket DM\t\t"LB_E"[/rocket]\n"YELLOW_E"War Zone\t\t"LB_E"[/war]\n"YELLOW_E"Tank DM\t\t"LB_E"[/tankdm]\n"YELLOW_E"Minigun DM\t\t"LB_E"[/mini]\n"YELLOW_E"Ship DM\t\t"LB_E"[/shipdm]");
	strcat(line7, "\n"YELLOW_E"UnderWater DM\t"LB_E"[/uwdm]\n"YELLOW_E"DM Island\t\t"LB_E"[/dmisland]\n"YELLOW_E"Minigun DM 2\t\t"LB_E"[/mini2]\n"YELLOW_E"Field DM\t\t"LB_E"[/fielddm]");
	strcat(line7, "\n"ORANGE_E"Team Deathmatch\t"RED_E"[/tdm]\n"ORANGE_E"Team Deathmatch 2\t"RED_E"[/tdm2]\n"ORANGE_E"One-Shot DM\t\t"RED_E"[/odm] \n"ORANGE_E"One-Shot DM 2\t\t"RED_E"[/odm2]\n"ORANGE_E"Sniper DM\t\t"RED_E"[/sniper]\n"ORANGE_E"Sniper DM2\t\t"RED_E"[/sniper2]\n"ORANGE_E"Castle DM\t\t"RED_E"[/castle]\n"ORANGE_E"Cops and Robbers\t"RED_E"[/cnr]\n"ORANGE_E"DSS DM\t\t"RED_E"[/dss]\n"ORANGE_E"Deagle DM\t\t"RED_E"[/ddm]\n"ORANGE_E"Sawnoff DM\t\t"RED_E"[/sawndm]\n"RED_E"Back");
	ShowPlayerDialog(playerid, 30, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"DM Zones", line7, "Select", "Back");
	return true;
}
CMD:tdm(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] == 13) return Error(playerid, "Leave the CnR minigame before joining a DM! "RED_E"/leave.");
	new line2[200];
	new blues, reds;
	foreach(new ii : Player)
	{
		if(GetPVarInt(ii, "BlueTeam") != 0) blues++;
		if(GetPVarInt(ii, "RedTeam") != 0) reds++;
	}
	format(line2, 200, ""RED_E"Red Team\t\t"WHITE_E"(Players: %i)\n"BLUE_E"Blue Team\t\t"WHITE_E"(Players: %i)", reds, blues);
	ShowPlayerDialog(playerid, 133, DIALOG_STYLE_LIST, ""YELLOW_E"Choose your team", line2, "Select", "Exit");
	return true;
}
CMD:tdm2(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] == 13) return Error(playerid, "Leave the CnR minigame before joining a DM! "RED_E"/leave.");
	new line2[200];
	new blues, reds;
	foreach(new ii : Player)
	{
		if(GetPVarInt(ii, "BlueTeam2") != 0) blues++;
		if(GetPVarInt(ii, "RedTeam2") != 0) reds++;
	}
	format(line2, 200, ""RED_E"Red Team\t\t"WHITE_E"(Players: %i)\n"BLUE_E"Blue Team\t\t"WHITE_E"(Players: %i)", reds, blues);
	ShowPlayerDialog(playerid, 135, DIALOG_STYLE_LIST, ""YELLOW_E"Choose your team", line2, "Select", "Exit");
	return true;
}

CMD:cnr(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	new line2[600];
	new cops, robbers;
	foreach(new ii : Player)
	{
		if(GetPVarInt(ii, "Cop") != 0) cops++;
		if(GetPVarInt(ii, "Robber") != 0) robbers++;
	}
	format(str, sizeof(str), ""dot""LB_E"Cops\t\t"GREY_E"LVPD\t\t\t"WHITE_E"(Players: %i)\n"dot""ORANGE_E"Robbers\t"GREY_E"LV Mafia\t\t"WHITE_E"(Players: %i)\n", cops, robbers);
	strcat(line2, str);
	strcat(line2, ""dot"{FF5000}Pro Robbers\t"GREY_E"Pro Mafia\n"dot""PURPLE_E"Army\t\t"GREY_E"Army Task Force\n"dot""BLUE_E"Swat\t\t"DARK_E"LVPD Commanders\n"dot""RED_E"Elite Robbers\t"DARK_E"Mafia Commanders");
	ShowPlayerDialog(playerid, 507, DIALOG_STYLE_LIST, ""ORANGE_E"Choose your side", line2, "Select", "Exit");
	return true;
}
CMD:cnrhelp(playerid)
{
	new line3[800];
	if(GetPVarInt(playerid, "Cop") != 0)
	{
		strcat(line3, ""LB2_E"You have joined the Las Venturas Police Department!\n\n"BLUE_E"Cop Help:\n"WHITE_E"Your mission is to protect the streets of Las Venturas by eliminating any crime.\nSuspects are shown as "ORANGE_E"orange"WHITE_E" on your map radar. The most wanted suspects are shown in darker orange.");
		strcat(line3, "\nType "RED_E"/ar (MMB) "WHITE_E"to arrest any criminal nearby, you and the suspect must be on foot.\nYou get more score and money by arresting rather than takedowns.\nType "PINK_E"/tpm "WHITE_E"to teamchat with your team members.\nType "LB2_E"/bk "WHITE_E"to to request backup at anytime.\n\nType /cnrhelp to open this box up at anytime, Good luck soldiers!");
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""BLUE_E"Cop Help", line3, "Close", "");
	}
	else if(GetPVarInt(playerid, "Robber") != 0)
	{
		strcat(line3, ""ORANGE_E"You have joined the Las Venturas Mafia!\n\n"BLUE_E"Criminal Help:\n"WHITE_E"Your job is to cause mayhem in the streets of Las Venturas\nYou must do your best to evade any cops while your at it.\nThe cops are marked as "LB_E"blue"WHITE_E" on your map radar.\nThe elite Swat team is marked as "BLUE_E"darkblue "WHITE_E"on your map radar.\n");
		strcat(line3, "\n"WHITE_E"You can enter some shops and "RED_E"/rob "WHITE_E"the store for cash.\nType "PINK_E"/tpm "WHITE_E"to teamchat with your team members.\n\nType /cnrhelp to open this box up at anytime, Good luck boys!");
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""RED_E"Criminal Help", line3, "Close", "");
	}
	else Error(playerid, "You must be in a /CnR minigame to use this command!");
	return true;
}
CMD:footer(playerid) return cmd_textdraws(playerid);
CMD:textdraw(playerid) return cmd_textdraws(playerid);
CMD:textdraws(playerid)
{
	if(GetPVarInt(playerid, "TDDisabled") == 1)
	{
		TextDrawShowForPlayer(playerid, msgTD);

		TextDrawShowForPlayer(playerid, Server_TD[0]);
		TextDrawShowForPlayer(playerid, Server_TD[1]);
		TextDrawShowForPlayer(playerid, Server_TD[2]);
		TextDrawShowForPlayer(playerid, Server_TD[3]);
		TextDrawShowForPlayer(playerid, Server_TD[4]);
		TextDrawShowForPlayer(playerid, Server_TD[5]);
		TextDrawShowForPlayer(playerid, Server_TD[6]);
		//TextDrawShowForPlayer(playerid, SEv2TD4);
		//TextDrawShowForPlayer(playerid, TeleTD);
		TextDrawShowForPlayer(playerid, SEv2Box);
		TextDrawShowForPlayer(playerid, DMTextdraw);
		ShowPlayerMSGBox(playerid);
		if(GOD[playerid] == 1)TextDrawShowForPlayer(playerid, godTD);
		SetPVarInt(playerid, "TDDisabled", 0);
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"You have enabled server textdraws.");
	}
	else
	{
		TextDrawHideForPlayer(playerid, msgTD);
		TextDrawHideForPlayer(playerid, helpTD);
		TextDrawHideForPlayer(playerid, Server_TD[0]);
		TextDrawHideForPlayer(playerid, Server_TD[1]);
		TextDrawHideForPlayer(playerid, Server_TD[2]);
		TextDrawHideForPlayer(playerid, Server_TD[3]);
		TextDrawHideForPlayer(playerid, Server_TD[4]);
		TextDrawHideForPlayer(playerid, Server_TD[5]);
		TextDrawHideForPlayer(playerid, Server_TD[6]);
		//TextDrawHideForPlayer(playerid, SEv2TD4);
		//TextDrawHideForPlayer(playerid, TeleTD);
		TextDrawHideForPlayer(playerid, SEv2Box);
		TextDrawHideForPlayer(playerid, DMTextdraw);
		if(GOD[playerid] == 1) TextDrawHideForPlayer(playerid, godTD);
		HidePlayerMSGBox(playerid);
		SetPVarInt(playerid, "TDDisabled", 1);
		SendClientMessage(playerid, COLOR_RED,""SERVER_INITIALS" "RED_E"You have disabled server textdraws.");
	}
	return true;
}

CMD:togann(playerid, params[])
{
	if(TogAnn[playerid])
	{
		TogAnn[playerid] = false;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have disabled the Admin-Announce");
	}
	else
	{
		TogAnn[playerid] = true;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREEN_E"You have enabled the Admin-Announce");
	}
	return 1;
}
CMD:pmsound(playerid, params[])
{
	if(PMSound[playerid])
	{
		PMSound[playerid] = false;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have disabled the PM Sound");
	}
	else
	{
		PMSound[playerid] = true;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREEN_E"You have enabled the PM Sound");
	}
	return 1;
}

CMD:myskin(playerid, params[]) return cmd_skin(playerid, params);
CMD:changeskin(playerid, params[]) return cmd_skin(playerid, params);
CMD:skins(playerid, params[]) return cmd_skin(playerid, params);
CMD:skin(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		Error(playerid, "You must be on foot to change your skin!");
		return true;
	}
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 )
	{
		Error(playerid, "This command can't be used in an event or an deathmatch!");
		return true;
	}

	new skin;
	if(sscanf(params, "d", skin))
	{
		ShowModelSelectionMenu(playerid, skinlist, "Choose your skin");
		Info(playerid, "You can also use /skin <ID>");
		return true;
	}
	if(GetPlayerSkin(playerid) == skin)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"You are already using skin ID %d!", skin);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	if(!IsValidSkin(skin))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Skin %d is an invalid skin!", skin);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(pAdmin[playerid] < 1 && skin == 211 || skin == 217)
	{
		return Error(playerid, "You can't choose this skin (Admins Only)");
 	}
	if(skin > 311)
		return Error(playerid, "Your skin ID cannot be beyond 311!");
	if(InDM[playerid] == 13)
	{
		if(GetPVarInt(playerid, "Cop") != 0) return Error(playerid, "You can't change your skin as a cop!");
		if(skin == 265 || skin == 266 || skin == 267 || skin == 280 || skin == 281 || skin == 282 || skin == 283 || skin == 284 || skin == 285 || skin == 286 || skin == 287 || skin == 288)
			return Error(playerid, "You can't choose a cop skin as a robber!");
	}
	if(InDM[playerid] == 13) SetPVarInt(playerid, "CnRSkin", skin);
	new oldskin = GetPlayerSkin(playerid);
	SetPlayerSkin(playerid, skin);
	pInfo[playerid][pSaveSkin] = skin;
	format(str, sizeof(str), "Server: "GREY2_E"You have changed your skin to %d (skin before: %d)", skin, oldskin);
	SendClientMessage(playerid, COLOR_RED, str);
	SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Use /saveskin to save your selected skin!");
	return true;
}
