	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i) && pHidden[i] == 0)
		{
			reaction[i][E_playerid] = i;
			reaction[i][E_rec] = reactionsWon[i];
		}
		else
		{
			reaction[i][E_playerid] = -1;
			reaction[i][E_rec] = -1;
		}
	}

	SortDeepArray(reaction, E_rec, .order = SORT_DESC);

	for(new i = 0; i < 20; i++)
	{
		if(reaction[i][E_rec] != -1 && reaction[i][E_rec] != 0)
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) "WHITEP_E"%s(%d) "RED_E"|| "LB_E"Reactions Won: %i\n", i + 1, pName[reaction[i][E_playerid]], reaction[i][E_playerid], reaction[i][E_rec]);
			strcat(finstring, tmp);
		}
		else
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) ----\n", i + 1);
			strcat(finstring, tmp);
		}
	}
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server - "WHITE_E"Top Reaction Wins", finstring, "Close", "");
	return 1;
}
