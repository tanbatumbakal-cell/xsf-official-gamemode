{
	justSpawnedVehicle[playerid] = false;
}*/
RemoveComponents(playerid, bool:neon=false)
{
	//printf("DEBUG: Remove Components called on %s(%d)", pName[playerid], playerid);
	// Remove any extra customizations.
	/*if(GetPVarInt(playerid, "CustomCar"))
	{
		for(new iit = 0; iit < sizeof(sObjects); iit++)
		{
			if(IsValidDynamicObject(sObjects[iit][playerid]))  DestroyDynamicObject(sObjects[iit][playerid]);
		}
		DeletePVar(playerid, "CustomCar");
	}*/
	if(neon == true)
	{
		if(GetPVarType(playerid, "Neon")) // Neon
		{
			DestroyDynamicObject(NeonObject[0][playerid]);
			DestroyDynamicObject(NeonObject[1][playerid]);
			DeletePVar(playerid, "Neon");
		}
		if(Siren[playerid] == 1) if(IsValidDynamicObject(SirenObject[playerid])) DestroyDynamicObject(SirenObject[playerid]); // Remove Siren
	}
}
