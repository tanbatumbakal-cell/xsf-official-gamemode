CMD:vips(playerid) return cmd_premiums(playerid);
CMD:premiums(playerid)
{
	new count;
	new line3[1300];
	foreach(new ii : Player)
	{
		if(pPremium[ii] > 0 && pHidden[ii] == 0)
		{
			count++;
		}
	}
	if(count == 0)
		return SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no premium members online.");

	new displayed;

	format(str, sizeof(str), ""WHITE_E"Premium Members: %d", count);
	format(line3, sizeof(line3), ""WHITE_E"There are %d premium members online:\n", count);


	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, sizeof(PlayerName));
		if(pPremium[ii] > 0 && pHidden[ii] == 0)
		{
			switch(pPremium[ii])
			{
				case 1: tmp = "Level 1";
				case 2: tmp = "Level 2";
				case 3: tmp = ""RED_E"VIP";
			}

			if(displayed == 0)
			{
				format(line3, sizeof(line3), "%s\n"LG_E"%s (ID: %i) "LB_E"(%s"LB_E")", line3, PlayerName, ii, tmp);
			}
			else
			{
				format(line3, sizeof(line3), "%s\n"LG_E"%s (ID: %i) "LB_E"(%s"LB_E")", line3, PlayerName, ii, tmp);
			}

			displayed += 1;
		}
	}
	format(line3, sizeof(line3), "%s\n\n\n"WHITE_E"Want to be featured on this list? Read more in /premium.", line3);

	ShowPlayerDialog(playerid, 16, DIALOG_STYLE_MSGBOX, str, line3, "Close", "");
	return true;
}
CMD:force(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/force <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	SetPlayerHealth(otherid, 0.0);
	ForceClassSelection(otherid);

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has forced %s(%i) into class selection.", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been forced to the class selection by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);
	format(str, sizeof(str), "4Server:3 %s(%i) has forced %s(%i) to class selection", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:settempname(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");

	new time;

	if(sscanf(params, "k<player_name>s[24]I(600)", otherid, tmp, time))
	{
		Usage(playerid, "/settempname <ID/Current name> <name> (<time>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(AFK[otherid] == 1) return Error(playerid, "Player is currently AFK!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(strlen(tmp) < 3) return Error(playerid, "New name can't be shorter than 4 characters!");
	if(strlen(tmp) > 20) return Error(playerid, "New name can't be longer than 20 characters!");
	SavePlayerStats(otherid);
	if(SetPlayerName(otherid, tmp) != 1)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i)'s name has not been changed to \"%s\". Please double check the name!", giveplayer, otherid, tmp);
		SendClientMessage(playerid, COLOR_GREY, str);
		return true;
	}

	format(str, sizeof(str), "Server: "GREY_E"%s(%i) has changed your name to \"%s\".", pName[playerid], playerid, tmp);
	SendClientMessage(otherid, COLOR_RED, str);
	format(str, sizeof(str), "Server: "GREY_E"You have changed %s(%i)'s name to \"%s\" their name will change back in %i seconds.", giveplayer, otherid, tmp, time);
	SendClientMessage(playerid, COLOR_RED, str);

	Info(otherid, "This namechange is temporary and will not save!");

	format(str, sizeof(str), "4Server:3 %s(%i) has changed %s(%i)'s name to '%s'", pName[playerid], playerid, giveplayer, otherid, tmp);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	new newname[24];
	if(GetPVarInt(otherid, "TempNickChangeTime") > gettime())
		SetPVarString(otherid, "OldNick", pName[otherid]);

	SetPVarInt(otherid, "TempNickChangeTime", gettime()+time);
	GetPlayerName(otherid, newname, sizeof(newname));
	pName[otherid] = newname;
	return true;
}

CMD:a(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		if(!IsPlayerAdmin(playerid))
			return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params))
	{
		Usage(playerid, "/a <text>");
		return true;
	}

	// Decide about multi-line msgs
	new i = -1;
	if(strlen(params) > 70)
	{
		i = strfind(params, " ", false, 60);
		if(i > 80 || i == -1) i = 70;

		// store the second line text
		line = " ";
		strcat(line, params[i]);

		// delete the rest from msg
		params[i] = EOS;
	}

	if(strcmp("XeonTM", pName[playerid]) && strcmp("Xeon[rK]", pName[playerid])) format(str, sizeof(str), ""RED_E"[Admin Chat] "LG_E"%s(%i): "LB_E"%s", pName[playerid], playerid, params);
	else format(str, sizeof(str), ""RED_E"[Admin Chat] "LG_E"Xeon™(%i): "LB_E"%s", playerid, params);

	SendAdminMessage(COLOR_LB, str);
	if(i != -1) SendAdminMessage(COLOR_LB, line);
	format(str, sizeof(str), "4[Admin Chat]3 %s(%i):2 %s", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	if(i != -1) IRC_GroupSay(ircGroup, IRC_aCHANNEL, line);
	//format(str, sizeof(str), "**[Admin Chat]** %s(%i): %s", pName[playerid], playerid, params);
	//DCC_SendChannelMessage(Channel_Staff, str);
	return true;
}

