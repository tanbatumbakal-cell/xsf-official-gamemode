CMD:weaponset(playerid)
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be logged in to update your weapon set!");

	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't update your weapon set while in a DM!");
		return 1;
	}
	if(doingStunt[playerid] != 0)
	{
		Error(playerid, "You can't update your weapon set in this area!");
		return true;
	}
	if(InDuel[playerid] != -1)
	{
		Error(playerid, "You can't update your weapon set while in a duel!");
		return 1;
	}
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
	{
		Error(playerid, "You can't purchase weapons while in an event!");
		return 1;
	}
	if(GOD[playerid] == 1 && InDM[playerid] == 0)
		return Error(playerid, "You can't purchase weapons with godmode enabled, type /god to disable it.");
	new wString[1028];
	strcat(wString, ""dot"Weapon Set 1 "LG_E"($550,000)  "GREY_E"[Knife/M4/Deagle/MP5/Combat Shotgun]\n"dot"Weapon Set 2 "LG_E"($500,000)  "GREY_E"[Katana/AK/Deagle/TEC-9/Sawnoff Shotgun]");
	strcat(wString, "\n"dot"Weapon Set 3 "LG_E"($600,000)  "GREY_E"[Chainsaw/M4/cRifle/Silenced 9mm/TEC-9/Shotgun]\n"dot"Weapon Set 4 "LG_E"($700,000)  "GREY_E"[Shovel/AK/Sniper/Deagle/Uzi/Sawnoff Shotgun]\n"dot"Default Weapons");
	ShowPlayerDialog(playerid, WEAPON_DIALOG+7, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Weapon Sets (Permanent)", wString, "Select", "Cancel");
	if(pPremium[playerid] == 3) SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"As a VIP player you can purchase weaponsets for free.");
	return true;
}

CMD:dmplayers(playerid)
{
	new string[100] , mainstring[2000] , count = 0;
	if(pLogged[playerid] == false) return Error(playerid, "You must be logged in to view the DM stats!");
	new dmname[90];
	format(mainstring, sizeof(mainstring), "Name\tWhere\n");
	foreach(new i : Player)
	{
		if(InDM[i] != 0)
		{
 			switch(InDM[i])
 			{
 			    case 0: dmname = "Battlefield (/bf)";
 			    case 1: dmname = "DM Island (/dmisland)";
 			    case 3: dmname = "Minigun DM 2 (/mini2)";
 			    case 4: dmname = "Rocket DM (/rocket)";
 			    case 5: dmname = "War (/war)";
 			    case 6: dmname = "Tank DM (/tank)";
 			    case 7: dmname = "Minigun DM (/mini)";
 			    case 8: dmname = "Ship DM (/shipdm)";
 			    case 9: dmname = "Underwater DM (/uwdm)";
 			    case 10: dmname = "Team Deathmatch (/tdm)";
				case 11: dmname = "Minigun DM 3 (/mini3)";
				case 13: dmname = "CnR (/cnr)";
				case 15: dmname = "Field DM (/fdm)";
				case 16: dmname = "One Shot DM (/odm)";
				case 17: dmname = "Sniper DM (/sniper)";
				case 18: dmname = "One Shot DM 2 (/odm2)";
				case 19: dmname = "Team Deathmatch 2 (/tdm2)";
				case 21: dmname = "Castle DM (/castledm)";
				case 22: dmname = "Event (/je)";
				case 50: dmname = "Deagle, Sniper, Shotgun (/dss)";
				case 800: dmname = "Sniper DM 2 (/sniperdm2)";
				case SawnDM::ID: dmname = "Sawn off DM (/sawn)";
				case DeagleDM::ID: dmname = "Deagle DM (/ddm)";
				default: dmname = "Deathmatch";
 			}
		    format(string,sizeof(string),"{FF0000}%s(%d)\t"LG_E"%s\n" , GetName(i) , i , dmname);
		    strcat(mainstring,string);
		    count ++;
		}
	}
	if(count != 0) ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_TABLIST_HEADERS, ""ORANGE_E"server: "WHITE_E"Deathmatch Players", mainstring, "Okay", "");
	else Error(playerid,"No players were found in deathmatch");
	return 1;
}
CMD:cookieshop(playerid) return cmd_cshop(playerid);
CMD:shop(playerid) return cmd_cshop(playerid);
CMD:cshop(playerid)
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be logged in to view the cookieshop!");

	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 || eInfo[playerid][inPUBG] == 1)
	{
		Error(playerid, "You can't purchase items while in an event!");
		return 1;
	}

	if(InDuel[playerid] != -1) return Error(playerid, "You cannot purchase items whilst dueling!");
	if(gettime() > cShopTick[playerid])
	{
        cShopTick[playerid] = gettime()+30;
		new wString[1600];
		strcat(wString, ""dot"+50percent Health\t\t\t"LG_E"Price: 5 cookies\n"dot"Full Health\t\t\t"LG_E"Price: 10 cookies\n"dot"Buy Armour\t\t\t"LG_E"Price: 20 cookies\n"dot"Buy Jetpack\t\t\t"LG_E"Price: 20 cookies\n"dot"Buy Name Change\t\t"LG_E"Price: 650 cookies\n"dot"Reset KDR (Kills/Deaths)\t"LG_E"Price: 1500 cookies");
		strcat(wString, "\n"dot"Temporary Premium (Level 1)\t"LG_E"Price: 300 cookies "GREY_E"(One Connect)\n"dot"Temporary Premium (Level 2)\t"LG_E"Price: 500 cookies "GREY_E"(One Connect)\n"dot"Temporary VIP\t\t\t"LG_E"Price: 1200 cookies "GREY_E"(One Connect)");
		strcat(wString, "\n"dot"Premium (Level 2) "LB_E"(7 Days)\t"LG_E"Price: 4000 cookies\n"dot""RED_E"VIP "LB_E"(7 Days)\t\t\t"LG_E"Price: 12000 cookies");
		ShowPlayerDialog(playerid, COOKIE_DIALOG, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Cookie Shop", wString, "Select", "Cancel");
	}
	else
	{
	    format(str, sizeof(str), ""RED_E"ERROR: "GREY3_E"Please wait %d seconds before using /cshop again", cShopTick[playerid]-gettime());
	    SendClientMessage(playerid,-1,str);
	}
	return true;
}
