		for(new ii = 0; ii < 4; ii++) ApplyActorAnimation(serveri_Bitches[ii], "BAR", "dnk_stndF_loop", 4.1, 1, 0, 0, 1, 0);
		for(new ii = 0; ii < 7; ii++) ApplyActorAnimation(serveri_Dancing[ii], "DANCING", "dance_loop", 4.1, 1, 0, 0, 1, 0);
		for(new ii = 0; ii < 6; ii++) ApplyActorAnimation(serveri_Siting[ii], "PED","SEAT_down", 4.1, 0, 1, 1, 1, 1);
	}

	// Part III (Checkpoints)
	serveri_CP[4] = CreateDynamicCP(948.8795,1770.6375,1395.5178, 4.0, -1, -1, -1, 40.0);

	serveri_CP[0] = CreateDynamicCP(928.8619, 1712.5627, 1395.4980, 4.0, -1, -1, -1, 40.0);
	serveri_CP[1] = CreateDynamicCP(932.4051, 1716.1498, 1395.4980, 4.0, -1, -1, -1, 40.0);
	serveri_CP[2] = CreateDynamicCP(939.2830, 1712.7633, 1395.4980, 4.0, -1, -1, -1, 40.0);
	serveri_CP[3] = CreateDynamicCP(935.6843, 1705.8818, 1395.4980, 4.0, -1, -1, -1, 40.0);

	lsbank = CreateDynamicCP(2527.2336,-1523.2710,24.0118, 1.5, -1, -1, -1, 75.0);
	
	// Nerf House
	new nid = 0;
	nid = CreateVehicle(541, 1529.5405, 2831.8469, 10.4392, 90.3835, 0, 0, 30); // BulletPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(411, 1530.1404, 2836.2957, 10.4613, 89.9966, 0, 0, 30); // infernusPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(415, 1529.0978, 2840.6375, 10.3816, 91.0568, 0, 0, 30); // CheetahPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(451, 1529.4889, 2845.1448, 10.5274, 89.3998, 0, 0, 30); // TurismoPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(579, 1529.5846, 2849.6865, 10.7505, 91.2850, 0, 0, 30); // HuntleyPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(522, 1529.6870, 2854.4910, 10.3838, 90.7138, 0, 0, 30); // NRGPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(471, 1529.2559, 2858.6765, 10.3029, 91.3850, 0, 0, 30); // QuadPos
	SetVehicleNumberPlate(nid, "N15M"), CreateDynamic3DTextLabel("{3C3C3C}Nerf15\n "WHITE_E"Vehicle", -1, 0.0, 0.0, 0.0, 100.0, .attachedvehicle = nid);
	nid = CreateVehicle(571, 1529.0391, 2863.2222, 10.1040, 89.9709, 0, 0, 30); // KartPos
