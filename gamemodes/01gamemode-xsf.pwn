		case 135: //TDM 2Dialog
		{
			if(doingStunt[playerid] != 0) return Error(playerid, "Teleport out of this stunt area before joining TDM!");
			if(response)
			{
				if(InDM[playerid] == 0) SavePlayerPosition(playerid);
