			pHidden[playerid] = cache_get_field_content_int(0, "hidden");
			pWeaponSet[playerid] = cache_get_field_content_int(0, "weapon_set");
			pTime[playerid] = cache_get_field_content_int(0, "time");
			pWeather[playerid] = cache_get_field_content_int(0, "weather");
			premiumExpired[playerid] = cache_get_field_content_int(0, "v_expired");
			pChatColor[playerid] = cache_get_field_content_int(0, "chat_color");
			hideMSG[playerid] = cache_get_field_content_int(0, "hideMSGs");
			autoLogin[playerid] = cache_get_field_content_int(0, "autoLogin");
			duelsOFF[playerid] = cache_get_field_content_int(0, "duels_off");
			pMute[playerid] = cache_get_field_content_int(0, "Muted");
			pJail[playerid] = cache_get_field_content_int(0, "Jailed");
			pIDColor[playerid] = cache_get_field_content_int(0, "id_color");
			houseID[playerid] = cache_get_field_content_int(0, "house_id");
			
			cache_get_field_content(0, "plate", pPlate[playerid], 32);
			cache_get_field_content(0, "country", pCountry[playerid], 43);
			cache_get_field_content(0, "email", pEmail[playerid], 2);
			cache_get_field_content(0, "JailedReason", jailed_reason, 77);

			foreach(new i : Houses) {
			    if(hInfo[i][HouseID] == houseID[playerid]) {
			        houseID[playerid] = i;
			        break;
				}
			}
			
			
			pTakedowns[playerid] = cache_get_field_content_int(0, "takedowns");
			pRobberies[playerid] = cache_get_field_content_int(0, "robberies");
			pPlayerRobberies[playerid] = cache_get_field_content_int(0, "probberies");
			pTimesArrested[playerid] = cache_get_field_content_int(0, "times_arrested");
			pCopKills[playerid] = cache_get_field_content_int(0, "cop_kills");
			specOFF[playerid] = cache_get_field_content_int(0, "specoff");
			p_PmDisabled = cache_get_field_content_int(0, "togpms");
			p_HitSound = cache_get_field_content_int(0, "hitsound");
			p_PassChange = cache_get_field_content_int(0, "passchanged");
			p_Armor = cache_get_field_content_int(0, "TogArmour");
			pTogCountry[playerid] = cache_get_field_content_int(0, "togcorty");
			p_bstoggle = cache_get_field_content_int(0, "bschat");

			//assign into the respective pvars
			SetPVarString(playerid, "JailedReason", jailed_reason);
			SetPVarInt(playerid, "PMsDisabled", p_PmDisabled);
			SetPVarInt(playerid, "togArmour", p_Armor);
			SetPVarInt(playerid, "HitSound", p_HitSound);
			SetPVarInt(playerid, "PasswordChange", p_PassChange);
			SetPVarInt(playerid, "BSChat", p_bstoggle);

            if(Helper[playerid] == 2) 
            	pMapper[playerid] = 1;
			else if(Helper[playerid] == 3) 
				pDeveloper[playerid] = 1;

			SetPlayerScore(playerid, pScore[playerid]);
			SetPlayerMoney(playerid, pCash[playerid]);
			
            LoadPlayerChallengeStats(playerid);

			MySQL_LoadPlayerToys(playerid);
			MySQL_LoadPlayerVehicle(playerid);
			MySQL_LoadPlayerGroup(playerid);
			MySQL_LoadPlayerAchivements(playerid);
			MySQL_LoadPlayerHouse(playerid);

			if(pColor[playerid] != 0)
			{
				SetPlayerColor(playerid, pColor[playerid]);
				pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
			}
			else
			{
				SetPlayerColor(playerid, PlayerColors[playerid]);
				pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
			}
			if(pChatColor[playerid] != 0) pChatColor[playerid] = StripAlpha(pChatColor[playerid]);
			if(pIDColor[playerid] != 0) pIDColor[playerid] = StripAlpha(pIDColor[playerid]);

			// Update IP
			GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET IP='%e',active=1 WHERE reg_id=%d", PlayerIP, pRegID[playerid]);
			MySQL_updateQuery(query);

			foreach(new ii : Player)
			{
				if(pRegID[playerid] == pRegID[ii] && ii != playerid)
				{
					if(pSpawned[playerid] == 0)
					{
						SendClientMessage(playerid, COLOR_RED, "Server: You have an account that's already on the server!");
						format(str, sizeof(str), "2Server:3 %s(%i)4 has been kicked for having an account that's already on the server.", pName[playerid], playerid);
						IRC_GroupSay(ircGroup, IRC_aCHANNEL, str), IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
						KickEx(playerid);
						return 1;
					}
				}
			}

			if(!strcmp(pEmail[playerid], "")) cmd_email(playerid);
			OnUserManualLogin(playerid);

			// Check if account name is banned.
			GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
			mysql_format(g_SQL_handle, query, sizeof(query), "SELECT user_banner,ban_reason,ban_time,ban_timestamp FROM bans WHERE user_banned='%e' AND (ban_time>UNIX_TIMESTAMP() OR ban_time=0)", PlayerName);
			MySQL_query(query, true, "CheckManualBan", "i", playerid);
		}
	}
	return true;
}

forward CheckUserRegistration(playerid, password[]);
public CheckUserRegistration(playerid, password[])
{
	GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));

	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO players(name,pass,IP,reg_time,last_time, passchanged) VALUES('%e',SHA1('%e'),'%e',CURRENT_TIMESTAMP(),CURRENT_TIMESTAMP(), 1)", PlayerName, password, PlayerIP);
	MySQL_query(query, false, "OnPlayerRegister", "is", playerid, password);
	return 1;
}

forward OnPlayerRegister(playerid, passwd[]);
public OnPlayerRegister(playerid, passwd[])
{
	if(pLogged[playerid] == true)
		return Error(playerid, "You are already registered and logged in!");

	pWelcomeR[playerid] = 1;
	pRegID[playerid] = cache_insert_id();
	pLogged[playerid] = true;
	pRegs++;

	GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	format(str, sizeof str, ""RED_E"[server] {%06x}%s(%i) "GREEN_E"has registered, making the server have a total of "LB2_E"%s "GREEN_E"players registered.", pColor[playerid], PlayerName, playerid, ToCurrency(pRegID[playerid]));
	SendClientMessageToAll(COLOR_GREEN, str);
	format(str, sizeof(str), "5,9- RegServ -3,0 %s(%i) has registered making the server have a total of %s players registered.", PlayerName, playerid, ToCurrency(pRegID[playerid]));
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	RegisteredPlayers = pRegID[playerid];

	SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"You are now registered and have been auto logged in!");

	new nStr[700];
	new rStr[800];
	format(nStr, sizeof(nStr), ""WHITE_E"Thank you %s for registering here at xTreme Stunt Freeroam!\nYou can also register on our website at serverserver.com.\n\n"DARK_E"Benefits of registering:\n"dot"All of your stats are now saved (/stats)\n"dot"You now have access to all commands (/cmds)", PlayerName);
	strcat(rStr, nStr);
	format(nStr, sizeof(nStr), "\n"dot"You can now purchase houses and private vehicles.\n"dot"All your attached objects are saved (/toys)\n"dot"You can now access your user control panel (/settings)\n"dot"Remember your password ("LB_E"%s"WHITE_E") and set your /email to receive important news.\n\nYou are now logged in and received "GREEN_E"$"WHITE_E"50,000 as a bonus for registering.", passwd);
	strcat(rStr, nStr);

	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"server "ORANGE_E":: "WHITE_E"xTreme Stunt Freeraom", rStr, "OK", "");

	format(str, sizeof(str), "~b~~h~~h~Welcome to server, ~w~%s~b~~h~!~n~~b~~h~~h~You have successfully registered and logged in!", pName[playerid]);
	InfoTD_MSG(playerid, 5500, str);
	GivePlayerCash(playerid, 50000);

	MySQL_CreatePlayerAchivements(playerid);
	SetTimerEx("SendWelcomeMessage", 3000, false, "i", playerid);
	cmd_email(playerid);
	return true;
}
forward SendWelcomeMessage(playerid);
public SendWelcomeMessage(playerid)
{
	// Send Random Bot Message
	switch(random(9))
	{
		case 0:
		{
			format(str, sizeof(str), "Hey %s, welcome to server!", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 1:
		{
			format(str, sizeof(str), "hey %s!", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 2:
		{
			format(str, sizeof(str), "Welcome %s, be sure to follow the /rules!", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 3:
		{
			format(str, sizeof(str), "hey %s, how are you?", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 4:
		{
			format(str, sizeof(str), "hey %s, be sure to check out our awesome /teleports!", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 5:
		{
			format(str, sizeof(str), "Hey %s, how are you today?", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 6:
		{
			format(str, sizeof(str), "Sup %s!", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 7:
		{
			format(str, sizeof(str), "Whats up %s?", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
		case 8:
		{
			format(str, sizeof(str), "Hey %s.", pName[playerid]);
			SendBotMsgToPlayer(playerid, str);
		}
	}
}



/* LOTTERY SYSTEM */



forward LotteryFinish();
public LotteryFinish() {
	LotteryInfo[LotteryTime]--;
	if(LotteryInfo[LotteryTime] <= 0)
	{
		new winnerID = Iter_Random(LotteryIter), canceled = 0;
		if(IsPlayerConnected(winnerID)) {
		    new tempStr[150], tempPlayerName[24];
			GetPlayerName(winnerID, tempPlayerName, sizeof tempPlayerName);
		    format(tempStr, sizeof tempStr, "{FF0000}[LOTTERY] {FFFFFF}Winner of the server Lottery is %s[%i] - %i$! Congratulations!", tempPlayerName, winnerID, LotteryInfo[lotteryValue]);
			SendClientMessageToAll(-1, tempStr);
			GivePlayerCash(winnerID, LotteryInfo[lotteryValue]);
			format(LotteryInfo[lastWinner], 24, tempPlayerName);

		}
		else {
		    foreach(new i : LotteryIter) {
				SendClientMessage(i, -1, "{FF0000}[LOTTERY] {FFFFFF}You have been refunded due to lottery cancellation.");
		        GivePlayerCash(i, 100000);
		        canceled = 1;
			}
		}
		if(canceled == 1) {
		    format(LotteryInfo[lastWinner], 24, "{FF0000}Canceled");
		    SendClientMessageToAll(-1, "{FF0000}[LOTTERY] {FFFFFF}server Lottery has been canceled due to winner leaving the game!");
		}
		foreach(new i : Player) {
		    lottCount[i] = 0;
		}

		LotteryInfo[lastWinningValue] = LotteryInfo[lotteryValue];
		LotteryInfo[lastFinished] = gettime();
		LotteryInfo[lotteryActive] = 0;
		LotteryInfo[ticketsBought] = 0;
		LotteryInfo[lotteryValue] = 0;
		Iter_Clear(LotteryIter);
		LotteryInfo[LotteryTime] = 120;
		KillTimer(LotteryInfo[LotteryTimer]);
	}
	return 1;
}

CMD:lottery(playerid, params[]) {

	SendClientMessage(playerid, -1, "{FF0000}[INFORMATION] {FFFFFF}Buying a lottery ticket costs 100'000$! You can only buy a maximum of 3 tickets!");
	ShowPlayerDialog(playerid, 9852, DIALOG_STYLE_LIST, "Lottery", "Buy ticket\nLottery info", "Choose", "Close");
	
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	printf("[OnDialogResponse]: %s(%d) has used dialog id: %d Listitem: %d", pName[playerid], playerid, dialogid, listitem);

	if(GetPVarInt(playerid, "spoof") > gettime())
		return 1;

	switch(dialogid)
	{
	    case CHALLENGE_DIALOG_1:
	    {
	        if(response)
	        {
	            new longstr[900];
	            switch(listitem)
	            {
	            
		            case 0:
		            {
		            	format(longstr, sizeof(longstr), "{FF0000}Hayclimb Statistics:\n"LB_E"> Hayclimb 1: "WHITE_E"%d\n"LB_E"> Hayclimb 2: "WHITE_E"%d\n"LB_E"> Hayclimb 3: "WHITE_E"%d\n"LB_E"> Hayclimb 4: "WHITE_E"%d\n"LB_E"> Hayclimb 5: "WHITE_E"%d\n"LB_E"> Hayclimb 6: "WHITE_E"%d\n"LB_E"> Hayclimb 7: "WHITE_E"%d\n"LB_E"> Hayclimb 8: "WHITE_E"%d",HayclimbChallenge[playerid],\
						Hayclimb2Challenge[playerid] , Hayclimb3Challenge[playerid] , Hayclimb4Challenge[playerid] , Hayclimb5Challenge[playerid] , Hayclimb6Challenge[playerid] , Hayclimb7Challenge[playerid] , Hayclimb8Challenge[playerid]);
	     				ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Challenge Statistics",longstr, "Close", "");
					}
		            case 1:
		            {
