CMD:siren(playerid)
{
    if(doingStunt[playerid] == 19) return Error(playerid,"You can't use this command at the moment.");
	if(pLogged[playerid] == true && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new Float:x, Float:y, Float:z, Float:rotation;
		new vid = GetPlayerVehicleID(playerid);
		vv = GetVehicleModel(vid);
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, rotation);
		DestroyVehicle(vid);
		vid = CreateVehicle(vv, x, y, z, rotation, 1, 1, 0, 1);
		SetVehicleVirtualWorld(vid, GetPlayerVirtualWorld(playerid));
		PutPlayerInVehicle(playerid, vid, 0);
	}
	else Error(playerid, "You must be logged in and be a driver in a vehicle to enable sirens!");
	return 1;
}
