///ANTI FAKE KILL TIMER FUNCTIONS
forward KickTimer(playerid);
public KickTimer(playerid)
{
	Kick(playerid);
	return 1;
}
forward ResetDamage(playerid);
public ResetDamage(playerid)
{
    DamageVar[playerid] = 0;
    return 1;
}



public OnPlayerDeath(playerid, killerid, reason)
{
	if(eInfo[playerid][inPUBG] == 1)
	{
		return PUBG_OnPlayerDeath(playerid,killerid,reason);
	}
	if(GetPVarInt(playerid, "BadSports")) return 1;
	if(GetPVarInt(playerid, "ParticipatingHG") == 1 && mode_Alive > 0)
	{
	    SetPVarInt(playerid, "ParticipatingHG", 0);
	    SetPVarInt(playerid, "HGDead", 0);
	    SendClientMessage(playerid, -1, "{FF0000}Unfortunately, you could not survive the hunger games .");
	    canUseKey[playerid] = true;
	    UpdateDMText();
	}

	if(InEvent[playerid] && CSEvent)
	{
		SetPlayerColor(playerid, GetPVarInt(playerid, "oldColor"));
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerTeam(playerid, 255);
		InEvent[playerid] = false;
		SpawnPlayer(playerid);
		if(IsBombPlanter == playerid) IsBombPlanter = BombPlanterSelect();
		SendClientMessage(IsBombPlanter, -1, ""RED_E"*You have been choosed to plant the bomb.");
	}
	DeleteSnow(playerid);
	if(killerid == INVALID_PLAYER_ID && GetPVarInt(playerid, "killerID") != -1)
		killerid = GetPVarInt(playerid, "killerID"),  reason = GetPVarInt(playerid, "killerWeapon");

	SetPVarInt(playerid, "killerID", -1);

	if(DamageVar[playerid] == 1)
	{
		SetTimerEx("ResetDamage", 10, false, "i", playerid);
	}

	if(InDerby[playerid] != 0)
	{
		RemovePlayerFromEvent(playerid);
		SetTimer("EndDerbyCheck", 1000, 0);
		format(str,sizeof(str),""PINK_E"[DERBY] "DARK_E"%s(%i) has been eliminated in the derby!", pName[playerid], playerid);
		SendEventMessage(COLOR_DARK, str);
		SendClientMessage(playerid, COLOR_PINK, "[DERBY] "GREY_E"You have been eliminated in the derby, you will now respawn..");
	}
	if(doingStunt[playerid] > 0)
	{
		DisableRemoteVehicleCollisions(playerid,0);
		if(doingStunt[playerid] == 18) // Fallout
		{

			format(str, sizeof(str), ""FALLOUT" %s(%d) has been eliminated!", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_WHITEP, str);
			GameTextForPlayer(playerid, "~r~~h~You have been eliminated!", 3000, 3);
			RemoveFromFallout(playerid);
		}
		else if(doingStunt[playerid] == 19) // Derby
		{
			if(IsDerbyRunning && DerbyWinner[playerid])
			{
				format(str,sizeof(str),""DERBY" "WHITEP_E"%s(%d) has been eliminated! (Vehicle Destroyed)", pName[playerid], playerid);
				SendDerbyMessage(COLOR_WHITEP, str);
				bDerbyPlayers--;
				DerbyWinner[playerid] = false;
				if(pSpawnVehicle[playerid] != -1)
				{
					DestroyVehicle(pSpawnVehicle[playerid]);
					pSpawnVehicle[playerid] = -1;
				}
				if(bDerbyPlayers == 1 || bDerbyPlayers == 0) CheckDerby();
			}
		}
	}

	if(doingStunt[playerid] == 0) pInfo[playerid][pDeaths] ++;
	if(killerid != INVALID_PLAYER_ID)
	{
	    if(ParticipatingWar[killerid] == 1)
		{
		    if(pGroupID[playerid] != pGroupID[killerid]) {
		    	warStats[pGroupID[killerid]]++;
		    }
		}

		if(ChaseBonus)
		{
			if(ChasePlayer == playerid)
			{
				format(str, sizeof(str), ""RED_E"["SERVER_INITIALS" "RED_E"Chase]: %s (%d) is DEAD!, Big thanks to our protector %s (%d), Good job!", pName[playerid], playerid, pName[killerid], killerid);
				SendClientMessageToAll(-1, str);
				format(str, sizeof(str), ""RED_E"["SERVER_INITIALS" "RED_E"Chase]: %s (%d) has been rewarded by $%s, for killing the terrorist.", pName[killerid], killerid, ToCurrency(ChasePrice));
				SendClientMessageToAll(-1, str);

				GivePlayerCash(killerid, ChasePrice);

				format(str, sizeof(str), "~r~Chase is over! ~g~%s(%d) was killed.", pName[playerid], playerid);
				TextDrawSetString(InfoTD2, str);
				foreach(new ii : Player)
				{
					if(Speedo[ii] == 1) PlayerTextDrawHide(ii, vSpeed[ii]), TextDrawHideForPlayer(ii, vSpeedBox);
					SetPlayerColor(ii, GetPVarInt(ii, "oldColor"));
				}
				TextDrawShowForAll(InfoTD2);
				SetTimer("HideInfoTD", 6000, false);
				KillTimer(ChaseTimer);
				ChasePrice = 0;
				ChaseBonus = false;
				ChasePlayer = INVALID_PLAYER_ID;
			}
		}

		TextDrawShowForPlayer(playerid, letterbox[0]);
		TextDrawShowForPlayer(playerid, letterbox[1]);
		GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
		pSpawned[playerid] = 0;
		GetPlayerName(killerid, giveplayer, sizeof(giveplayer));
		SetPlayerWorldBounds(playerid, 20000.0, -20000.0, 20000.0, -20000.0);
		SetPlayerWantedLevel(playerid, 0);
		if(pSpectating[playerid] != -1) TogglePlayerSpectating(playerid, 0);

		if(Speedo[playerid] == 1)
		{
			PlayerTextDrawHide(playerid, vSpeed[playerid]);
			TextDrawHideForPlayer(playerid, vSpeedBox);
		}
		if(playerSpectated[playerid] != 0)
		{
			format(str, sizeof(str), "- AS - "YELLOW_E"%s(%i) died, you will return spectating when the player respawns.", pName[playerid], playerid);
			foreach(new ii : Player)
			{
				if(pSpectating[ii] == playerid)
				{
					SendClientMessage(ii, COLOR_RED, str);
				}
			}
		}
		
		if(DamageVar[playerid] == 0)
		{
			SendClientMessage(playerid, COLOR_RED, "ANTI CHEAT: You Have Been Kicked For Fake Killing!");
			SetTimerEx("KickTimer", 20, 0, "i", playerid);
		}
		if(killerid == playerid)
		{
			SendClientMessage(playerid, COLOR_RED, "ANTI CHEAT: You Have Been Kicked For Fake Killing!");
			SetTimerEx("KickTimer", 20, 0, "i", playerid);
		}


		if(reason == 4 && GOD[playerid] == 1 && InDM[playerid] == 0)
		{
			SendClientMessage(killerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"You are not allowed kill players with godmode using a knife!");
			SetPlayerHealth(killerid, 0);
		}
		pInfo[killerid][pKills] ++;
		new str_query[100];
		if(pLogged[killerid]) {
			format(str_query, sizeof(str_query), "UPDATE players SET kills = %d WHERE reg_id = %d", pInfo[killerid][pKills], pRegID[killerid]);
			MySQL_updateQuery(str_query);
		}
		if(pLogged[playerid]) {
			format(str_query, sizeof(str_query), "UPDATE players SET deaths = %d WHERE reg_id = %d", pInfo[playerid][pDeaths], pRegID[playerid]);
			MySQL_updateQuery(str_query);
		}
		
		if(pInfo[killerid][pKills] >= 150)
		{
			if(pAch1[killerid] == 0)
			{
				pAch1[killerid] = 1;
				format(query, sizeof(query), "UPDATE achievements SET a1=1 WHERE reg_id=%d", pRegID[killerid]);
				MySQL_updateQuery(query);
				GivePlayerAchievement(killerid, "Grim Reaper", "Congrats you killed 150 players!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
			}
		}

		if(pInfo[playerid][pDeaths] >= 50)
		{
			if(pAch13[playerid] == 0)
			{
				pAch13[playerid] = 1;
				format(query, sizeof(query), "UPDATE achievements SET a13=1 WHERE reg_id=%d", pRegID[playerid]);
				MySQL_updateQuery(query);
				GivePlayerAchievement(playerid, "Rest In Peace", "Congrats you've died 50 times!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
			}
		}
		format(str, sizeof(str), "~r~~h~You have killed ~y~%s~r~!~n~~w~+~g~$~w~1000~w~ and +1 score", PlayerName);

		InfoTD_MSG(killerid, 3500, str);
		GivePlayerCash(killerid, 1000);
		GivePlayerScore(killerid, 1);
		vID = GetPlayerVehicleID(killerid);

		if(InEvent[playerid] != 0)
		{
			SetTimer("EndEventCheck", 1000, 0);
			if(CageFightOn == 1) NumEventPlayers--;
			InEvent[playerid] = 0;
			InDM[playerid] = 0;
			canUseKey[playerid] = true;
			if(killerid != INVALID_PLAYER_ID) format(str,sizeof(str),""EVENT" "DARK_E"%s(%i) has been eliminated by %s(%i)", pName[playerid], playerid, giveplayer, killerid);
			else format(str,sizeof(str),""EVENT" "DARK_E"%s(%i) has been eliminated by Hiself", pName[playerid], playerid);

			SendEventMessage(COLOR_DARK, str);
			if(killerid != INVALID_PLAYER_ID) format(str,sizeof(str),""EVENT" "WHITEP_E"You have been eliminated by "LIME_E"%s(%i)!", giveplayer, killerid);
			else format(str,sizeof(str),""EVENT" "DARK_E"%s(%i) has been eliminated by "LIME_E"Hiself", pName[playerid], playerid);
        	UpdateGroupScore(pGroupID[killerid], 1);
			SendClientMessage(playerid, COLOR_GREY, str);
		}
		if(killStreak[playerid] >= 5)
		{
			format(str, sizeof(str), ""RED_E"* "WHITEP_E"%s(%i) has ended %s(%i) killstreak of "WHITE_E"%d.", giveplayer, killerid, PlayerName, playerid, killStreak[playerid]);
			SendClientMessageToAll(COLOR_WHITEP, str);
			SendClientMessage(killerid, COLOR_GREEN, "> "PINK_E"You have earned a cookie for ending a players killstreak.");
			GivePlayerCookie(killerid, 1);
		}
		if(doingStunt[playerid] == 33 && doingStunt[killerid] == 33)
		{
			LMS_Players--;
			doingStunt[playerid] = 0;
			InDM[playerid] = 0;
			format(str,sizeof(str),""LMS" %s(%i) has been eliminated by %s(%i)", pName[playerid], playerid, giveplayer, killerid);
			SendLMSMessage(COLOR_DARK, str);
			format(str,sizeof(str),""LMS" You have been eliminated by %s(%i)!", giveplayer, killerid);
			SendClientMessage(playerid, COLOR_GREY, str);

			LMS_LoseGame();
		}
		if(doingStunt[playerid] == 20 && doingStunt[killerid] == 20)
		{
			if(pAdmin[killerid] == 0)
			{
				format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s(%i) has been jailed for dming inside the club.", giveplayer, killerid);
				SendClientMessageToAll(COLOR_GREY2, str);
				format(str, sizeof(str), "3%s(%i)2 has been jailed for club dming.", giveplayer, killerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				SendClientMessage(killerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have been jailed for 20 seconds for killing someone while in the club.");
				pJail[killerid] = 20;
				JailPlayer(killerid);
				doingStunt[killerid] = 0;
			}
		}
		if(InDM[playerid] != 0 && InDM[killerid] != 0)
		{
			switch(reason)
			{
				case 0: tmp = "Unarmed";
				case 1: tmp = "Brass Knuckles";
				case 2: tmp = "Golf Club";
				case 3: tmp = "Night Stick";
				case 4:
				{
					tmp = "Knife";
					if(pAch15[killerid] == 0)
					{
						pAch15[killerid] = 1;
						format(query, sizeof(query), "UPDATE achievements SET a15=1 WHERE reg_id=%d", pRegID[killerid]);
						MySQL_updateQuery(query);
						GivePlayerAchievement(killerid, "Silent Killer", "Congrats you have knifed a player!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
					}
				}
				case 5: tmp = "Baseball Bat";
				case 6: tmp = "Shovel";
				case 7: tmp = "Pool Cue";
				case 8: tmp = "Katana";
				case 9: tmp = "Chainsaw";
				case 10: tmp = "Dildo";
				case 11: tmp = "Dildo";
				case 12: tmp = "Vibrator";
				case 13: tmp = "Vibrator";
				case 14: tmp = "Flowers";
				case 15: tmp = "Cane";
				case 22: tmp = "Pistol";
				case 23: tmp = "Silenced Pistol";
				case 24: tmp = "Desert Eagle";
				case 25: tmp = "Shotgun";
				case 26: tmp = "Sawn-off Shotgun";
				case 27: tmp = "Combat Shotgun";
				case 28: tmp = "MAC-10";
				case 29: tmp = "MP5";
				case 30: tmp = "AK-47";
				case 31:
				{
					if(GetPlayerState(killerid) == PLAYER_STATE_DRIVER)
					{
						switch(GetVehicleModel(vID))
						{
							case 447: tmp = "Sea Sparrow Machine Gun";
							default: tmp = "M4";
						}
					}
					else tmp = "M4";
				}
				case 32: tmp = "TEC-9";
				case 33: tmp = "Rifle";
				case 34: tmp = "Sniper Rifle";
				case 37: tmp = "Fire";
				case 38:
				{
					if(GetPlayerState(killerid) == PLAYER_STATE_DRIVER)
					{
						switch(GetVehicleModel(vID))
						{
							case 425: tmp = "Hunter Machine Gun";
							default: tmp = "Minigun";
						}
					}
					else tmp = "Minigun";
				}
				case 41: tmp = "Spraycan";
				case 42: tmp = "Fire Extinguisher";
				case 49: tmp = "Vehicle Collision";
				case 50:
				{
					if(GetPlayerState(killerid) == PLAYER_STATE_DRIVER)
					{
						switch(GetVehicleModel(vID))
						{
							case 417, 425, 447, 465, 469, 487, 488, 497, 501, 548, 563: tmp = "Helicopter Blades";
							default: tmp = "Vehicle Collision";
						}
					}
					else tmp = "Vehicle Collision";
				}
				case 51:
				{
					if(GetPlayerState(killerid) == PLAYER_STATE_DRIVER)
					{
						switch(GetVehicleModel(vID))
						{
							case 425: tmp = "Hunter Rockets";
							case 432: tmp = "Rhino Turret";
							case 520: tmp = "Hydra Rockets";
							default: tmp = "Explosion";
						}
					}
					else tmp = "Explosion";
				}
				default: tmp = "Unknown";
			}
			format(str, sizeof(str), ""RED_E"[%s] "DARK_E"%s(%i) killed %s(%i) ("GREY_E"%s"DARK_E")", GetDMName(playerid), giveplayer, killerid, pName[playerid], playerid, tmp);
			foreach(new ii : Player)
			{
				if(InDM[ii] == InDM[playerid] && MessagesNotices[ii])
				{
					SendClientMessage(ii, COLOR_DARK, str);
				}
			}
			format(str, sizeof(str), "5[%s] 12%s(%i)1 killed 12%s(%i)1 (%s)", GetDMName(playerid), giveplayer, killerid, pName[playerid], playerid, tmp);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			format(str, sizeof(str), "~g~Wonderful, ~w~you killed ~r~~h~%s~w~!~n~~w~+~g~$~w~4000~w~ and +1 score", pName[playerid]);
			InfoTD_MSG(killerid, 3500, str);

			//format(str, sizeof(str), "~r~~h~%s~w~ has killed you! ~y~~n~You will now respawn back in this DM.", giveplayer);
			//InfoTD_MSG(playerid, 3000, str);
            
			GivePlayerCash(killerid, 3000);
			if(GetPVarInt(killerid, "Cop") != 0 && GetPVarInt(playerid, "Robber") != 0)
			{
				format(str, sizeof(str), ""DARK_E"[CnR] "LIME_E"Suspect %s(%d) has been taken down by Officer %s(%d).", pName[playerid], playerid, giveplayer, killerid);
				SendCNRMessage(COLOR_GREY2, str);
				format(str, sizeof(str), "4CNR:3 Suspect %s(%i) has been taken down by Officer %s(%d)", pName[playerid], playerid, giveplayer, killerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				format(str, sizeof(str), ""RED_E"- CnR -  "GREY_E"You have been taken down by Officer %s(%d)", giveplayer, killerid);
				SendClientMessage(playerid, COLOR_GREY, str);
				if(GetPVarInt(playerid, "cnrMsgSent") == 0)
				{
					SetPVarInt(playerid, "cnrMsgSent", 1);
					format(str, sizeof(str), "> "GREY_E"You can earn more score and money by arresting the player! (/ar)", giveplayer, killerid);
					SendClientMessage(killerid, COLOR_YELLOW, str);
				}
				SetPVarInt(playerid, "InStore", 0);
				GameTextForPlayer(killerid, "~g~~h~Suspect Takedown!", 3500, 3);
				GivePlayerCash(killerid, 4000);
				GivePlayerScore(killerid, 1);
				SendClientMessage(killerid, COLOR_GREEN, ""RED_E"- CnR - "GREEN_E"You have received 1 score and $4000 for a takedown!");
				pTakedowns[killerid]++;
				format(query, sizeof(query), "UPDATE players SET takedowns=takedowns+1 WHERE reg_id=%d", pRegID[killerid]);
				MySQL_updateQuery(query);
				// Check if achievement was completed
				if(pTakedowns[killerid] >= 50)
				{
					if(pAch24[killerid] == 0)
					{
						pAch24[killerid] = 1;
						format(query, sizeof(query), "UPDATE achievements SET a24=1 WHERE reg_id=%d", pRegID[killerid]);
						MySQL_updateQuery(query);
						GivePlayerAchievement(killerid, "Pro Cop", "Congrats you took down 50 criminals!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
					}
				}
			}
			else if(GetPVarInt(killerid, "Robber") != 0 && GetPVarInt(playerid, "Cop") != 0)
			{
				GivePlayerCash(killerid, 5000);
				new wanted = GetPlayerWantedLevel(killerid) + 1;
				SetPlayerWantedLevel(killerid, wanted);
				GivePlayerScore(killerid, 1);
				SendClientMessage(killerid, COLOR_GREEN, ""RED_E"- CnR -  "GREEN_E"You have received 1 score and $5000 for killing an officer!");
				pCopKills[killerid]++;
				
				format(query, sizeof(query), "UPDATE players SET cop_kills=cop_kills+1 WHERE reg_id=%d", pRegID[killerid]);
				MySQL_updateQuery(query);
				// Check if achievement was completed
				if(pCopKills[killerid] >= 100)
				{
					if(pAch27[killerid] == 0)
					{
						pAch27[killerid] = 1;
						format(query, sizeof(query), "UPDATE achievements SET a27=1 WHERE reg_id=%d", pRegID[killerid]);
						MySQL_updateQuery(query);
						GivePlayerAchievement(killerid, "Ruthless", "Congrats you have killed 100 cops!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
					}
				}
			}
			else UpdateGroupScore(pGroupID[killerid], 1);
			if(pGroupID[killerid] != -1)
			{
				UpdateGroupScore(pGroupID[killerid], 1);
			}


			// KillCam
			if(killCam[playerid] == 1 && InDM[playerid] != 7)
			{
				killCamON[playerid] = true;
				TogglePlayerSpectating(playerid, 1);
				PlayerSpectatePlayer(playerid, killerid);
				killCamCounter[playerid] = 15;
				UpdateKillCam(playerid, killerid);
				showKillCam(playerid);
				SetPVarInt(killerid, "killCamSpectator", playerid);
				killCamTimer[playerid] = SetTimerEx("killCamCD", 1000, true, "ii", playerid, killerid);
			}
		}
		else
		{
		    UpdateGroupScore(pGroupID[killerid], 1);
			format(str, sizeof(str), "~r~~h~%s~w~ has killed you!", giveplayer);
			InfoTD_MSG(playerid, 3000, str);

			if(IsPlayerInAnyVehicle(killerid))
			{
				// Anti-Driveby for Spawns
				if(IsPlayerInRangeOfPoint(killerid, 70.0, 376.6497, 2506.7773, 16.6647)
				|| IsPlayerInRangeOfPoint(killerid, 70.0, -2629.5991, 1357.5739, 7.1000)
				|| IsPlayerInRangeOfPoint(killerid, 70.0, -1208.9193, 26.1246, 13.9543)
				|| IsPlayerInRangeOfPoint(killerid, 70.0, 2155.2126, 1677.7125, 10.2580)) // AA, SF, SFAIR, LV
				{
					GetPlayerPos(killerid, POS[0], POS[1], POS[2]);
					SetPlayerPos(killerid, POS[0], POS[1], POS[2] + 10);
					new failz = GetPVarInt(killerid, "sKills") + 1;
					SetPVarInt(killerid, "sKills", failz);
					if(GetPVarInt(killerid, "sKills") == 3)
					{
						format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has been kicked for excessive driveby.", pName[killerid], killerid);
						SendClientMessageToAll(COLOR_GREY, str);
						format(str, sizeof(str), "4Server:3 %s(%i) has been kicked for excessive driveby.", pName[killerid], killerid);
						IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
						KickEx(killerid);
						return true;
					}
					SendClientMessage(killerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"You are not allowed to driveby players near spawnzone, you have been warned!");
					InfoTD_MSG(killerid, 4000, "~r~~h~Do not driveby near spawnzones!");
				}
				// Anti-HeliKill
				else switch(GetVehicleModel(vID))
				{
					case 487, 488, 497, 469, 548, 476, 464, 465, 501:
					{
						GetPlayerPos(killerid, POS[0], POS[1], POS[2]);
						SetPlayerPos(killerid, POS[0], POS[1], POS[2] + 10);
						SetVehicleToRespawn(vID);
						if(pSpawnVehicle[killerid] != -1)
						{
							DestroyVehicle(pSpawnVehicle[killerid]);
							pSpawnVehicle[killerid] = -1;
						}
						new failz = GetPVarInt(killerid, "vKills") + 1;
						SetPVarInt(killerid, "vKills", failz);
						if(GetPVarInt(killerid, "vKills") == 3)
						{
							format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has been kicked for excessive vehicle killing.", pName[killerid], killerid);
							SendClientMessageToAll(COLOR_GREY, str);
							format(str, sizeof(str), "4Server:3 %s(%i) has been kicked for excessive vehicle killing.", pName[killerid], killerid);
							IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
							KickEx(killerid);
							return true;
						}
						SendClientMessage(killerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"You are not allowed to kill players using this aircraft, you have been warned!");
						InfoTD_MSG(killerid, 4000, "~r~~h~Do not kill players using this vehicle!");
					}
				}
			}
			if(IsPlayerInAnyVehicle(killerid))
			{
				if(GetPlayerState(killerid) == PLAYER_STATE_PASSENGER)
				{
					if(!hasDriver(vID))
					{
						GetPlayerPos(killerid, POS[0], POS[1], POS[2]);
						SetPlayerPos(killerid, POS[0], POS[1], POS[2] + 10);
						SetVehicleToRespawn(vID);
						if(pSpawnVehicle[killerid] != -1)
						{
							DestroyVehicle(pSpawnVehicle[killerid]);
							pSpawnVehicle[killerid] = -1;
						}

						SendClientMessage(killerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"You are not allowed to kill players from an unoccpied vehicle, you have been warned!");
						InfoTD_MSG(killerid, 4000, "~r~~h~Do not kill players from an unoccupied vehicle!");
					}
				}
			}
		}
		killStreak[killerid] ++;
		KillStreak(killerid);
		if(bounty[playerid] > 0 && GetPVarInt(playerid, "Hitman") != killerid)
		{
			format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%d) "DARK_E"has earned a bounty of "LG_E"$%s "DARK_E"for killing %s(%d).", pColor[killerid], pName[killerid], killerid, ToCurrency(bounty[playerid]), pName[playerid], playerid);
			SendClientMessageToAll(COLOR_DARK, str);

			if(pAch16[killerid] == 0)
			{
				pAch16[killerid] = 1;
				format(query, sizeof(query), "UPDATE achievements SET a16=1 WHERE reg_id=%d", pRegID[killerid]);
				MySQL_updateQuery(query);
				GivePlayerAchievement(killerid, "Hitman", "Congrats you completed a hit!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
			}
			format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"You earned a bounty of "LG_E"$%d "LB2_E"for killing %s.", bounty[playerid], pName[playerid]);
			SendClientMessage(killerid, COLOR_LB, str);
			GivePlayerCash(killerid, bounty[playerid]);
			bounty[playerid] = 0;
			SetPVarInt(playerid, "Hitman", -1);
			new hits = GetPVarInt(playerid, "hits") - 1;
			SetPVarInt(playerid, "hits", hits);
		}
	}

	switch(random(8))
	{
		case 0: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~b~C~h~L~h~U~h~C~w~K ~b~C~h~L~h~U~h~C~w~K, ~r~Y~h~O~r~U~h~'R~h~E ~r~FU~h~C~r~K~h~E~r~D", 3500, 3);
		case 1: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~r~I~h~C~h~E~h~D", 3500, 3);
		case 2: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~r~RE~h~ST ~h~IN ~h~PEA~h~CE", 3500, 3);
		case 3: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~r~T~h~A~h~S~h~T~h~E ~r~T~h~H~h~E ~r~CO~h~CK", 3500, 3);
		case 4: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~r~N~h~O ~h~C~h~A~h~K~h~E ~y~F~h~O~h~R ~h~Y~h~O~h~U", 3500, 3);
		case 5: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~b~C~h~L~h~U~h~C~w~KITY FU~b~~h~~h~~h~C~b~~h~~h~K~b~~h~E~b~D", 3500, 3);
		case 6: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~b~L~h~O~h~L ~w~U ~b~~h~~h~~h~D~b~~h~I~h~E~b~~h~D", 3500, 3);
		case 7: GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~r~S~h~E~h~E ~h~Y~h~O~w~U ~r~~h~~h~~h~IN ~r~~h~H~h~EA~r~~h~V~h~~h~E~h~N", 3500, 3);
	}
	killStreak[playerid] = 0;
	pLastVehicle[playerid] = 0;
	LastSeat[playerid] = 0;
	SetPVarInt(playerid, "InStore", 0);
	RemoveComponents(playerid, true);
	if(pSpawnVehicle[playerid] != -1)
	{
		DestroyVehicle(pSpawnVehicle[playerid]);
		pSpawnVehicle[playerid] = -1;
	}
	if(GetPVarInt(playerid, "killCamSpectator"))
	{
		new watcherid = GetPVarInt(playerid, "killCamSpectator");
		KillTimer(killCamTimer[watcherid]);
		TogglePlayerSpectating(watcherid, 0);
		hideKillCam(watcherid);
		killCamON[watcherid] = false;
		DeletePVar(playerid, "killCamSpectator");
	}
	// Remove player from race.
	if(RaceParticipant[playerid] != 0)
	{
		Participants --;
		if(Participants == 0)
		{
			format(str, sizeof(str), ""RACE" The last participator in race '%s' has died, race has ended.", CRaceName);
			SendClientMessageToAll(COLOR_WHITEP, str);
			format(str, sizeof(str), "2,9RACE7,0 The last participator in race '%s' has died, race has been ended.", CRaceName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			endrace();
		}
		RaceParticipant[playerid] = 0;
		canUseKey[playerid] = true;
		HidePlayerRaceTextdraws(playerid);
		DisablePlayerRaceCheckpoint(playerid);
		DisableRemoteVehicleCollisions(playerid, 0);
	}
	if(ParkourParticipant[playerid] != 0)
	{
		pParticipants --;
		if(pParticipants == 0)
		{
			format(str, sizeof(str), ""PARKOUR" The last participator in parkour '%s' has died, parkour has ended.", CParkourName);
			SendClientMessageToAll(COLOR_LIME, str);
			format(str, sizeof(str), "2,9PARKOUR7,0 The last participator in parkour '%s' has died, parkour has been ended.", CParkourName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			endparkour();
		}
		ParkourParticipant[playerid] = 0;
		doingStunt[playerid] = 0;
		canUseKey[playerid] = true;
		HidePlayerParkourTextdraws(playerid);
		DisablePlayerRaceCheckpoint(playerid);
	}
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
	{
		SetTimer("EndEventCheck", 1000, 0);
		if(CageFightOn == 1) NumEventPlayers--;
		InEvent[playerid] = 0;
		canUseKey[playerid] = true;
		format(str,sizeof(str),""EVENT" "DARK_E"%s(%i) has been eliminated.", pName[playerid], playerid);
		SendEventMessage(COLOR_DARK, str);
	}

	if(doingStunt[playerid] == 33)
	{
		LMS_Players--;
		doingStunt[playerid] = 0;
		InDM[playerid] = 0;
		format(str,sizeof(str),""LMS" %s(%i) has been eliminated.", pName[playerid], playerid);
		SendLMSMessage(COLOR_DARK, str);
		LMS_LoseGame();
	}
	if(killerid != INVALID_PLAYER_ID)
	{
		SendDeathMessage(killerid, playerid, reason);
		GetWeaponName(reason, str, sizeof(str));
		format(str, sizeof(str), "**[Death]** %s (%d) has been killed by %s (%d) using %s", pName[playerid], playerid, pName[killerid], killerid, str);
		//DCC_SendChannelMessage(Channel_Echo, str);
	}
	else
	{
		format(str, sizeof(str), "**[Death]** %s (%d) has died.", pName[playerid], playerid);
		//DCC_SendChannelMessage(Channel_Echo, str);
	}
	return true;
}

public OnGameModeExit()
{
	MATERIAL_OnGameModeExit();
	KillTimer(Livemaptimer);
	djson_GameModeExit();

	//DCC_SendChannelMessage(Channel_Staff, "**[Server]** Global gamemode unloading..");
    RemovePlaylist(gEveryonesPlaylist);

	Destroy_TextDraws(); // Destroy Textdraws
	foreach(new ii : Player) // Save Player Stats
	{
		if(pLogged[ii] == true) 
			SavePlayerStats(ii);
	}
	IRC_QuitBots(); // Disconnect IRC Bots
	mysql_close(g_SQL_handle); // Close mySQL

	UnloadHouses(); // Unload houses
	DestroyAllDynamic3DTextLabels();
	DestroyAllDynamicMapIcons();
	DestroyAllDynamicCPs();
	DestroyAllDynamicPickups();

	// Exit the server
	getdate(year, month, day); gettime(hour, minute, second);
	printf("==================================================");
	printf("|        Unloaded on: %d/%d/%d at %d:%d:%d        |", year, month, day, hour, minute, second);
	printf("==================================================");
	printf("|                 server unloaded!					  |");
	printf("==================================================");
 	PUBG_OnGameModeExit();
	return true;
}


forward MoveCamera(playerid);
public MoveCamera(playerid)
{
	InterpolateCameraPos(playerid, 181.9085, 1898.6005, 36.5099, 2128.9543, 1282.5223, 19.6593, 20000, CAMERA_MOVE);
	InterpolateCameraLookAt(playerid, 182.7841, 1898.1091, 36.2798, 2129.9568, 1282.5790, 19.8092, 20000, CAMERA_MOVE);
	return 1;
}

public OnPlayerConnect(playerid)
{
	#include "removebuildings.inc"

	new dateprint[3],timeprint[3];
	gettime(timeprint[0], timeprint[1], timeprint[2]);
	getdate(dateprint[0], dateprint[1], dateprint[2]);
	printf("\nTime: %02d-%02d-%04d %02d:%02d:%02d\n", dateprint[2], dateprint[1], dateprint[0], timeprint[0], timeprint[1], timeprint[2]);


	ResetPlayerVariables(playerid);
	DestroyDynamic3DTextLabel(admin3D[playerid]);
	new fSmallName[24];
	GetPlayerName(playerid, fSmallName, 24);
	if(stringContainsIP(fSmallName) || strfind(".com", fSmallName, true) != -1 || strfind(".net", fSmallName, true) != -1 || strfind("SFSE", fSmallName, true) != -1) {
	   return Kick(playerid);
	}

	UpdateDMText();
	SetTimerEx("MoveCamera", 2000, false, "i", playerid);
	PlayAudioStreamForPlayer(playerid, "http://xsfserver.com/server-introb60.mp3");
	for(new l; l < 10; l++) SendClientMessage(playerid, COLOR_GREY2, "\n");
	//SendClientMessage(playerid, -1, ""SERVER_INITIALS" "YELLOW_E"Checking your files, Hold on..");
	SendClientMessage(playerid, 0xE65555FF, "----------------------------------------------------------------------------------------------------");
	SendClientMessage(playerid, COLOR_SBLUE, "{FF0000}*** "SBLUE_E"Welcome to server "RED_E":: "SBLUE_E"xTreme Stunt Freeroam!");
	SendClientMessage(playerid, COLOR_SBLUE, "{FF0000}*** "SBLUE_E"Teleports: "LB_E"/tele {FF0000}|| "SBLUE_E"Commands: "LB_E"/cmds {FF0000}|| "SBLUE_E"Rules: "LB_E"/rules");
	SendClientMessage(playerid, COLOR_SBLUE, "{FF0000}*** "SBLUE_E"          www.serverserver.com");
	//SendClientMessage(playerid, COLOR_SBLUE, "{FF0000}*** "SBLUE_E"We wish everyone a Merry Christmas and a Happy New Year! ");
	SendClientMessage(playerid, 0xE65555FF, "----------------------------------------------------------------------------------------------------");
	GetPlayerName(playerid, PlayerName, 24);
    SetPVarInt(playerid, "Lasttimeused", 0);
	format(str, sizeof(str), "**[Connection]** %s (%d) has joined the server. [%d/420]", PlayerName, playerid, Iter_Count(Player));
	//DCC_SendChannelMessage(Channel_Echo, str);


	//if(IsPlayerNPC(playerid)) return true;
	GetPlayerName(playerid, PlayerName, 24);

	// Add to SSCANF and foreach system
	Iter_Add(Player, playerid);
	SetPVarInt(playerid, "dialogID", -1); // ANTI DIALOG
	
	// Check for map stealer
	gpci(playerid, str, sizeof(str));
	if(!strcmp(str, DISALLOWED_ADDRESS, true ))
	{
		BanEx(playerid, "Raksamp Client");
	}

	SetPVarInt(playerid, "dialogID", -1);
	// Check for a possible connection flood
	new cIP[16];
	GetPlayerIp(playerid, cIP, 16);
	format(str, sizeof str, "proxy.mind-media.com/block/proxycheck.php?ip=%s", cIP);
	HTTP(playerid, HTTP_GET, str, "", "OnProxyDetect");

	if(strcmp(ipCheck, cIP, false) == 0 && ( GetTickCount() - IPtime ) < 4000)
	{
		IPfound++;
		if(IPfound > 3)
		{
			format(str, 100, "banip %s", cIP);
			SendRconCommand(str);
			SendClientMessage(playerid, COLOR_PINK, "Connection rejected!");
			SendClientMessage(playerid, COLOR_RED, "A possible connection flood has been detected. You have been banned for connection flood!");
			format(str, sizeof(str), ""GREY_E"Anti-Cheat: "RED_E"%s(%i) has been auto banned for connection flood!", PlayerName, playerid);
			SendClientMessageToAll(COLOR_RED, str);
			format(tmp, sizeof(tmp), "4AUTO-BAN: 3%s(%i) has been banned for connection flood!", PlayerName, playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
			BanEx(playerid, "Connection Flood");
			printf("conncetion rejected");
			IPfound = 0;
			return 1;
		}
	}
	else IPfound = 0;

	format(ipCheck, 16, "%s", cIP);
	IPtime = GetTickCount();
	pJoinTick[playerid] = IPtime;

	// Reset all player variables
	ResetVariables(playerid);

	ShowLoginTextdraw(playerid);

	pIP[playerid] = cIP;
	pName[playerid] = PlayerName;

	// Continue..
	PlayerPlaySound(playerid, 1132, 0, 0, 0);

	CreatePlayerTextDraws(playerid);
	InfoTD_MSG(playerid, 3500, "~w~Loading...");


	LoadPlayerAnimationLibrary(playerid);

	// Set Player Color
	SetPlayerColor(playerid, PlayerColors[playerid]);
	pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
	

	// Check most players online.
	if(Iter_Count(Player) > joinPlayerCount) joinPlayerCount = Iter_Count(Player);
	totalPlayersJoined++;

	// Load User Data
	new cQuery[800];
	
	mysql_format(g_SQL_handle, cQuery, sizeof(cQuery), "SELECT * FROM players WHERE name='%e' LIMIT 1", PlayerName);
	MySQL_query(cQuery, true, "OnUserDataLoad", "i", playerid);

	mysql_format(g_SQL_handle, cQuery, sizeof(cQuery), "SELECT * FROM CommandsBlock WHERE Name='%e' LIMIT 1", PlayerName);
	MySQL_query(cQuery, true, "OnCommandCheck", "i", playerid);
	return true;
}

