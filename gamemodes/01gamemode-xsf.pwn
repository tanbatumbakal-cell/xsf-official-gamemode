	return 1;
}
public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	switch(hittype)
	{
		case 0:
		{
			if( !( -1000.0 <= fX <= 1000.0 ) || !( -1000.0 <= fY <= 1000.0 ) || !( -1000.0 <= fZ <= 1000.0 ) ) // a valid offset, it's impossible that a offset bigger than 1000 is legit (also less than -1000.0 is impossible, not used by this hack, but still, let's check for it, just for the future, who knows what hacks will appear). The object with biggest offset is having ~700-800 radius.
			{
				return 0; // let's desynchronize that bullet, so players won't crash
			}
		}
		case BULLET_HIT_TYPE_VEHICLE:
		{
			if(InDM[playerid] == 13  || InDM[playerid] == 10)
			{
				foreach(new i : Player)
				{
					if(IsPlayerInVehicle(i, hitid) && GetPlayerTeam(i) == GetPlayerTeam(playerid))
					{
						GameTextForPlayer(playerid, "~r~Don't shoot teammates vehicles~w~!", 2500, 5);
						RepairVehicle(hitid);
						return 0;
					}
				}
			}
		}
	}
	if(!IsPlayerAdmin(playerid) && pAdmin[playerid] == 0 && IsPlayerConnected(playerid))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && weaponid == 24)
		{
			AutoCbug[playerid] ++;
			if(gettime() > GetPVarInt(playerid, "Autocbug"))
			{
				SetPVarInt(playerid, "AutoCbug", gettime() + 1);
				AutoCbug[playerid] = 0;
			}
			else
			{
				if(AutoCbug[playerid] > 4)
				{
					format(str, sizeof(str), ""RED_E"[Anti-Cheat]: %s (ID:%d) is suspect of using Auto C-Bug.", pName[playerid], playerid);
					SendAdminMessage(-1, str);
					AutoCbug[playerid] = 0;
				}
			}
		}
	}
 	PUBG_OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ);
		/*case BULLET_HIT_TYPE_PLAYER:
		{
			if((InDM[playerid] == 13 && InDM[hitid] == 13) || (InDM[playerid] == 10 && InDM[hitid] == 10))
			{
				if(GetPlayerTeam(hitid) == GetPlayerTeam(playerid))
				{
					GameTextForPlayer(playerid, "~r~Don't shoot teammates~w~!", 2500, 5);
					return 0;
				}
			}

			if(hitid != INVALID_PLAYER_ID && pSpawned[hitid] && !GOD[hitid]) {
				DamageVar[hitid] = 1;
				new Float:x, Float:y, Float:z;
				GetPlayerPos(playerid, x, y, z);

				//new Float:distance = VectorSize(x-fX,y-fY,z-fZ);
				new Float:damage = g_sDefaultWeaponInfo[weaponid][wepDamage];
				new Float:HP;
				new Float:armour_optd;
				GetPlayerArmour(hitid, armour_optd);
				GetPlayerHealth(hitid, HP);

				if(armour_optd != 0.0) {
					if(armour_optd - damage <= 0.0)
						SetPlayerArmour(hitid, 0.0);
					else
						SetPlayerArmour(hitid, (armour_optd - damage));
					damage -= armour_optd;
				}
				if(HP - damage <= 0.0) SetPVarInt(hitid, "killerID", playerid), SetPVarInt(hitid, "killerWeapon", weaponid);
				if(damage && !armour_optd) {
					if(HP - damage <= 0.0)
						SetPlayerHealth(hitid, 0.0);
					else
						SetPlayerHealth(hitid, HP - damage);
				}
		}*/
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	if(playerSpectated[playerid] != 0)
	{
		/*foreach(new ii : Player)
