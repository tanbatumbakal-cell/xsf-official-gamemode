CMD:givejetpack(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/givejetpack <ID>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(GetPlayerState(otherid) == PLAYER_STATE_DRIVER)
		return Error(playerid, "Player is in a vehicle and can't be given a jetpack!");

	if(InDM[otherid] != 0)
		return Error(playerid, "Player is currently in a DM!");

	if(doingStunt[otherid]!= 0)
		return Error(playerid, "You can't give the player a jetpack in their location!");

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have given %s(%i) a jetpack!", pName[otherid], otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has given you a jetpack!", pName[playerid], playerid);
	SendClientMessage(otherid, COLOR_GREY, str);

	SetPlayerSpecialAction(otherid, SPECIAL_ACTION_USEJETPACK);
	return true;
}

CMD:slap(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	new Float:height;
	if(sscanf(params, "k<player_name>F(9.0)", otherid, height))
	{
		Usage(playerid, "/slap <ID> (<HEIGHT>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(height > 9.0 && pAdmin[playerid] < 5)
		return Error(playerid, "The slap height is too high, maximum of 9.");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	GetPlayerPos(otherid, POS[0], POS[1], POS[2]);
	SetPlayerPos(otherid, POS[0], POS[1], POS[2] + height);
	if(IsPlayerInAnyVehicle(otherid)) OnPlayerExitVehicle(otherid, GetPlayerVehicleID(otherid));

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have slapped %s(%i).", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	AdminCommandLog("SLAP", playerid, otherid, "");
	PlayerPlaySound(otherid, 1130, 0.0, 0.0, 0.0);
	return true;
}

CMD:reward(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new score, money;
	if(sscanf(params, "k<player_name>ii", otherid, score, money))
	{
		Usage(playerid, "/reward <ID/Name> <score> <money>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(otherid == playerid)
		return Error(playerid, "You can't reward yourself!");

	if(score > 5 && pAdmin[playerid] < 5)
		return Error(playerid, "You can't reward more than 5 score!");
	if(score < 1)
		return Error(playerid, "You can't reward anyone less than 1 score!");
	if(money > 10000 && pAdmin[playerid] < 5)
		return Error(playerid, "You can't reward more than $10,000!");
	if(money < 1)
		return Error(playerid, "You can't reward anyone less than $1!");

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "LB_E"%s(%i) has rewarded %s(%i) with "LG_E"$"LB_E"%d and %d score.", pName[playerid], playerid, pName[otherid], otherid, money, score);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "LB_E"%s(%d) has been rewarded with "LG_E"$"LB_E"%d and %d score by an Administrator.", pName[otherid], otherid, money, score);
	SendClientMessageToAll(COLOR_LB, str);

	format(str, sizeof(str), "4Server: 2Administrator %s(%d) has rewarded %s(%i) with $%d and %d score.",  pName[playerid], playerid, pName[otherid], otherid, money, score);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	SendClientMessage(otherid, COLOR_GREEN, ""SERVER_INITIALS" "GREEN_E"You have also received 1 report point!");
	SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Player has also received 1 report point.");
	pReportPoints[otherid]++;
	format(query, sizeof(query), "UPDATE players SET report_points=report_points+1 WHERE reg_id=%d", pRegID[otherid]);
	MySQL_updateQuery(query);
	GivePlayerCash(otherid, money);
	GivePlayerScore(otherid, score);
	GameTextForPlayer(otherid, "~g~~h~Rewarded!", 4000, 5);
	return true;
}

CMD:givecar(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	new sVehicle[32], spawnModel;
	if(sscanf(params, "k<player_name>s[32]", otherid, sVehicle))
	{
		Usage(playerid, "/givecar <ID/Name> <vehicleID/Name>");
		return 1;
	}
	if(InDM[otherid] != 0)
	{
		Error(playerid, "You can't give that player a vehicle while they are in an DM!");
		return true;
	}
	if(InEvent[otherid] != 0)
	{
		Error(playerid, "You can't give that player a vehicle while they are in an event!");
		return true;
	}
	if(!IsNumeric(sVehicle))
	{
		spawnModel = GetVehicleModelIDFromName(sVehicle);
	}
	else spawnModel = strval(sVehicle);

	if(spawnModel < 400 || spawnModel > 611 )
	{
		return Error(playerid, "You've entered an invalid vehicle ID/Name!");
	}
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"You have gave %s(%i) a %s.", giveplayer, otherid, vehName[spawnModel - 400]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"%s(%i) has given you a %s.", pName[playerid], playerid, vehName[spawnModel - 400]);
	SendClientMessage(otherid, COLOR_YELLOW, str);

	if(!IsPlayerInAnyVehicle(playerid)) SpawnPlayerVehicle(otherid, spawnModel, false);
	return true;
}
CMD:caps(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/caps <ID>");
		SendClientMessage(playerid, COLOR_YELLOW2, "Function: Will disable caps for the player, type again to enable caps.");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	iTemp = GetTickCount();
	if((iTemp - pLastCapsed[otherid]) < 5000)
	{
		Error(playerid, "Player has recently been caps'd, please wait before using this command on them again.");
		return true;
	}
	pLastCapsed[otherid] = iTemp;

	if(!GetPVarType(otherid, "Caps"))
	{
		// Disable Caps
		SetPVarInt(otherid, "Caps", 1);
		if(pHidden[playerid] == 0)
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has disabled %s(%i) caps in chat.", pName[playerid], playerid, pName[otherid], otherid);
			format(tmp, sizeof(tmp), ""SERVER_INITIALS" "RED_E"%s(%i) has disabled your caps in chat.", pName[playerid], playerid);
		}
		else
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%d) caps have been disabled by an Administrator.", pName[otherid], otherid);
			format(tmp, sizeof(tmp), ""SERVER_INITIALS" "RED_E"Your caps has been disabled by an admin.");
		}
		SendClientMessageToAll(COLOR_RED, str);


		SendClientMessage(otherid, COLOR_GREY, tmp);

		format(str, sizeof(str), "4Server: 2%s(%i) has disabled %s(%i) caps in chat.", pName[playerid], playerid, pName[otherid], otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	else
	{
		// Enable Caps
		DeletePVar(otherid, "Caps");

		if(pHidden[playerid] == 0)
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"%s(%i) has enabled %s(%i) caps in chat.", pName[playerid], playerid, pName[otherid], otherid);
			format(tmp, sizeof(tmp), ""SERVER_INITIALS" "GREEN_E"%s(%i) has enabled your caps in chat.", pName[playerid], playerid);
		}
		else
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"%s(%d) caps have been enabled by an Administrator.", pName[otherid], otherid);
			format(tmp, sizeof(tmp), ""SERVER_INITIALS" "GREEN_E"Your caps have been enabled by an admin.");
		}
		SendClientMessageToAll(COLOR_GREEN, str);


		SendClientMessage(otherid, COLOR_RED, tmp);
		format(str, sizeof(str), "4Server: 2%s(%i) has enabled %s(%i) caps in chat.", pName[playerid], playerid, pName[otherid], otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	AdminCommandLog("CAPS", playerid, otherid, "");
	return true;
}
CMD:cuff(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	new seconds = 0;

	if(sscanf(params, "k<player_name>I(60)", otherid, seconds))
	{
		Usage(playerid, "/cuff <ID> (<seconds>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(seconds < 1 || seconds > 600)
		return Error(playerid, "You need to specify the amount of seconds between 1 and 600!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	SetPlayerSpecialAction(otherid, SPECIAL_ACTION_CUFFED);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have cuffed %s(%i).", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	SendClientMessage(playerid, COLOR_GREY, "Server: "GREY2_E"Type /uncuff to uncuff the player.");
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has cuffed you for %i seconds.", pName[playerid], playerid, seconds);
	SendClientMessage(otherid, COLOR_GREY, str);
	SetPVarInt(otherid, "cuffedTime", gettime()+seconds);
	return true;
}
CMD:uncuff(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/uncuff <ID>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	SetPlayerSpecialAction(otherid, SPECIAL_ACTION_NONE);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have uncuffed %s(%i).", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has uncuffed you.", pName[playerid], playerid);
	SendClientMessage(otherid, COLOR_GREY, str);
	DeletePVar(otherid, "cuffedTime");
	return true;
}
CMD:throw(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/throw <ID>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

