forward OnLabelsLoad();
public OnLabelsLoad()
{
	if(!MySQL_rowCount()) return print("[Labels]: 0 3DText has been created.");

	/*
		Table Structure:

		- Text 			(String 250 char)
		- X    			(Float)
		- Y	   			(Float)
		- Z    			(Float)
		- VW		    (Int)
		- Reg 			(Int)
		- Owner 		(String 25 char)

		Query: CREATE TABLE IF NOT EXISTS `labels` (Text VARCHAR(250), X FLOAT, Y FLOAT, Z FLOAT, VW INT, Reg INT, Owner VARCHAR(25))
	*/

	new rows = MySQL_rowCount();
	for(new i = 0; rows > i; i++)
	{
		if(rows > MAX_LABELS)
		{
			printf("[Labels]: Maximum labels limit was reached (%d/%d), cannot create more.", rows, MAX_LABELS);
			break;
		}

		cache_get_field_content(i, "Text", TextInfo[i][Input]);
		TextInfo[i][TX] = cache_get_field_content_float(i,"X");
		TextInfo[i][TY] = cache_get_field_content_float(i, "Y");
		TextInfo[i][TZ] = cache_get_field_content_float(i, "Z");
		TextInfo[i][VW] = cache_get_field_content_int(i, "VW");
		TextInfo[i][Owner] = cache_get_field_content_int(i, "Reg");
		cache_get_field_content(i, "Owner", TextInfo[i][OwnerName]);
		TextInfo[i][Label] = Create3DTextLabel(TextInfo[i][Input], -1, TextInfo[i][TX], TextInfo[i][TY], TextInfo[i][TZ], 100.0, TextInfo[i][VW]);
	}
	return true;
}

CMD:vlabel(playerid, params[])
{
	if(pPremium[playerid] != 3 && pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	new string[250], color;
	if(sscanf(params, "is[250]", color, string)) return Usage(playerid, "/vlabel <1 - 6> <text> (1:Red, 2:Green, 3:Blue, 4:White, 5:Yellow, 6:Purple)");
	if(GetUserLabels(playerid) >= 3 && pAdmin[playerid] == 0 && pDeveloper[playerid] == 0) return Error(playerid, "Maximum number of slots per player was already reached. You can't create more");
	if(GetEmptyLabelSlot() == -1) return Error(playerid, "Maximum number of labels was already reached. Cannot create more");
	if(strlen(string) > 25) return Error(playerid, "Maximum characters count is 25");
	if(GetPlayerVirtualWorld(playerid) != 0 && pAdmin[playerid] == 0) return Error(playerid, "You must be in main world in order to use this command.");
	if(color > 6 || color < 1) return Error(playerid, "Please choose an valid color.");
	new
		i = GetEmptyLabelSlot(),
		Float:x,
		Float:z,
		Float:y
	;

	GetPlayerPos(playerid, x, y, z);
	switch(color)
	{
		case 1: str = RED_E;
		case 2: str = GREEN_E;
		case 3: str = BLUE_E;
		case 4: str = WHITE_E;
		case 5: str = YELLOW_E;
		case 6: str = PURPLE_E;
	}
	strcat(str, string);
	TextInfo[i][TX] = x;
	TextInfo[i][TY] = y;
	TextInfo[i][TZ] = z;
	TextInfo[i][VW] = GetPlayerVirtualWorld(playerid);
	TextInfo[i][Label] = Create3DTextLabel(TextInfo[i][Input], -1, TextInfo[i][TX], TextInfo[i][TY], TextInfo[i][TZ], 100.0, TextInfo[i][VW]);
	TextInfo[i][Owner] = pRegID[playerid];
	format(TextInfo[i][OwnerName], 25, pName[playerid]);

	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `labels` (Text, X, Y, Z, VW, Reg, Owner) VALUES ('%e', %f, %f, %f, %d, %d, '%e')", str, TextInfo[i][TX], TextInfo[i][TY], TextInfo[i][TZ], TextInfo[i][VW], TextInfo[i][Owner], TextInfo[i][OwnerName]);
	MySQL_updateQuery(query);
	return true;
}

CMD:delabel(playerid, params[])
{
	if(pPremium[playerid] == 0 && pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");
	if(GetPlayerVirtualWorld(playerid) != 0 && pAdmin[playerid] == 0) return Error(playerid, "You must be in main world in order to use this command.");
	new Float:radius;
	if(sscanf(params, "f", radius)) return Usage(playerid, "/delabel [radius] (0.0 - 100.0)");
	if((radius > 100 || radius < 0) && pAdmin[playerid] < 5) return Error(playerid, "Radius range is between 0 and 100.");
	new found = 0;
	for(new i = 0; MAX_LABELS > i; i++)
	{
		if((TextInfo[i][Owner] != pRegID[playerid]) && pAdmin[playerid] == 0) continue;
		if(!IsPlayerInRangeOfPoint(playerid, radius, TextInfo[i][TX], TextInfo[i][TY], TextInfo[i][TZ])) continue;
		if(TextInfo[i][Label] == Text3D:0xFFFF) continue;
		found++;

		TextInfo[i][TX] = 0.0;
		TextInfo[i][TY] = 0.0;
		TextInfo[i][TZ] = 0.0;
		TextInfo[i][VW] = 0;
		TextInfo[i][Owner] = INVALID_PLAYER_ID;
		TextInfo[i][OwnerName] = EOS;

		Delete3DTextLabel(TextInfo[i][Label]);
		TextInfo[i][Label] = Text3D:0xFFFF;

		mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM `labels` WHERE `Text` = '%e'",TextInfo[i][Input]);
		MySQL_updateQuery(query);
	}
	if(found == 0) return Error(playerid, "There's no label near you, please go near one and try again.");
	format(str, sizeof(str), ""SERVER_INITIALS""RED_E" %d labels were deleted.", found);
	SendClientMessage(playerid, -1, str);
	return true;
}

CMD:mylabels(playerid)
{
	if(pPremium[playerid] == 0 && pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");

	new string[1024], found = 0;
	for(new i = 0; MAX_LABELS > i; i++)
	{
		if(TextInfo[i][Owner] == pRegID[playerid])
		{
			format(string, sizeof(string), "%s%d\t %s\n", string, i, TextInfo[i][Input]);
			found++;
		}
	}
	if(found == 0) return Error(playerid, "You don't own any labels yet. use /vlabel to create some of them!");
	format(string, sizeof(string), ""RED_E"Id\t "RED_E"Text\n%s", string);
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_TABLIST_HEADERS, ""RED_E"server: "WHITEP_E"Labels", string, "Close", "");
	return true;
}

CMD:vlabels(playerid)
{
	if(pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");

	new string[6000], found = 0;
	for(new i = 0; MAX_LABELS > i; i++)
	{
		if(TextInfo[i][Label] != Text3D:0xFFFF)
		{
			format(string, sizeof(string), "%s%d\t %s\t %d\t %s\n", string, i, TextInfo[i][OwnerName], TextInfo[i][Owner], TextInfo[i][Input]);
			found++;
		}
	}
	if(found == 0) return Error(playerid, "There's no labels created yet.");
	format(string, sizeof(string), ""RED_E"Id\t "RED_E"Owner\t "RED_E"RegId\t "RED_E"Text\n%s", string);
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_TABLIST_HEADERS, ""RED_E"server: "WHITEP_E"Labels", string, "Close", "");
	return true;
}

CMD:dr(playerid, params[])
{
	if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	new Float:radius;
	if(sscanf(params, "f", radius)) return Usage(playerid, "/dr <radius>");
	if(radius > 100) return Error(playerid, "Maximum disarm range is 100 meters");

	new Float:x, Float:y, Float:z, players;
	GetPlayerPos(playerid, x, y, z);

	foreach(new ii : Player)
	{
		if(ii == playerid) continue;
		if(!IsPlayerInRangeOfPoint(ii, radius, x, y, z)) continue;
		ResetPlayerWeapons(ii);
		players++;
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"Admin %s(%d) has disarmed all players within %0.1f radius "GREY2_E"[Total players: %d]", pName[playerid], playerid, radius, players);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"An Administrator has disarmed all players within %0.1f radius "GREY2_E"[Total players: %d]", radius, players);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server: 2Admin %s(%d) has disarmed all players within %0.1fm radius [Total Players: %d]", pName[playerid], playerid, radius, players);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:giveweaponr(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	new weaponID, weaponName[20],
		ammo_a,
		Float:radius;

	if(sscanf(params, "fdd",radius, weaponID, ammo_a))
	{
		Usage(playerid, "/giveweaponr <radius> <Weapon ID> <ammo>");
		return true;
	}

	if(radius > 100) return Error(playerid, "Maximum disarm range is 100 meters");
	if(ammo_a < 0 || ammo_a > 99999)
	{
		Error(playerid, "Invalid ammo provided!");
		return true;
	}

	if(weaponID < 0 && weaponID > 47)
	{
		if(weaponID == 20)
		{
			Error(playerid, "Invalid weapon ID provided!");
			return true;
		}
		Error(playerid, "Invalid weapon ID provided!");
		return true;
	}
	new Float:x, Float:y, Float:z, players;
	GetPlayerPos(playerid, x, y, z);

	foreach(new ii : Player)
	{
		if(ii == playerid) continue;
		if(!IsPlayerInRangeOfPoint(ii, radius, x, y, z)) continue;
		GivePlayerWeapon(ii, weaponID, ammo_a), SetPVarInt(ii, "givenByAdmin", 1);
		players++;
	}

	GetWeaponName(weaponID, weaponName, sizeof(weaponName));


	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "WHITEP_E"%s(%i) has given a %s with %d ammo within %0.1fm radius "GREY2_E"[Total players: %d]", pName[playerid], playerid, weaponName, ammo_a , radius , players);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "WHITEP_E"An Administrator has given a %s with %d ammo within %0.1fm radius "GREY2_E"[Total players: %d].", weaponName, ammo_a , radius , players);
	SendClientMessageToAll(COLOR_WHITE, str);

	return true;
}

CMD:toggor(playerid, params[])
{
	if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	new Float:radius;
	if(sscanf(params, "f", radius)) return Usage(playerid, "/toggor <radius>");
	if(radius > 100) return Error(playerid, "Maximum disarm range is 100 meters");

	new Float:x, Float:y, Float:z, players;
	GetPlayerPos(playerid, x, y, z);

	foreach(new ii : Player)
	{
		if(ii == playerid) continue;
		if(!IsPlayerInRangeOfPoint(ii, radius, x, y, z)) continue;
		pGoTo[ii] = 1;
		players++;
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"Admin %s(%d) has disabled teleport for all players within %0.1fm radius "GREY2_E"[Total players: %d]", pName[playerid], playerid, radius, players);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"An Administrator disabled teleport for all players within %0.1fm radius "GREY2_E"[Total players: %d]", radius, players);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server: 2Admin %s(%d) has disabled teleport for players within %0.1fm radius [Total Players: %d]", pName[playerid], playerid, radius, players);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

GetEmptyLabelSlot()
{
	new found = -1;
	for(new i = 0; MAX_LABELS > i; i++)
	{
		if(TextInfo[i][Label] == Text3D:0xFFFF)
		{
			found = i;
			break;
		}
	}
	return found;
}

GetUserLabels(playerid)
{
	new found = 0;
	for(new i = 0; MAX_LABELS > i; i++)
	{
		if(TextInfo[i][Owner] == pRegID[playerid] && TextInfo[i][Label] != Text3D:0xFFFF)
		{
			found++;
		}
	}
	return found;
}

GetLevel(score)
{
    if(score >= 0 && score <= 499 || score < 0)  return 0;
    if(score >= 500 && score <= 999)  return 1;
    if(score >= 1000 && score <= 2499)  return 2;
    if(score >= 2500 && score <= 4999)  return 3;
    if(score >= 5000 && score <= 7499)  return 4;
    if(score >= 7500 && score <= 9999)  return 5;
    if(score >= 10000 && score <= 19999)  return 6;
    if(score >= 20000 && score <= 29999)  return 7;
    if(score >= 30000 && score <= 39999)  return 8;
    if(score >= 40000 && score <= 49999)  return 9;
    if(score >= 50000 && score <= 74999)  return 10;
    if(score >= 75000 && score <= 99999)  return 11;
    if(score >= 100000 && score <= 149999)  return 12;
	if(score >= 150000 && score <= 199999)  return 13;
	if(score >= 200000 && score <= 249999)  return 14;
	if(score >= 250000 && score <= 999999999)  return 15;
	return true;
}


GivePlayerLevelRewards(playerid, level)
{
	switch(level)
	{
		case 1:	pCookies[playerid] += 25;
		case 2:	pCookies[playerid] += 50;
		case 3:	pCookies[playerid] += 75;
		case 4: pCookies[playerid] += 150;
		case 5:	pCookies[playerid] += 250;
		case 6: pCookies[playerid] += 500;
		case 7: // Premium Member 1 (One Connect)
		{
			pCookies[playerid] += 1000;

			if(pPremium[playerid] >= 1) return true;
			pPremium[playerid] = 1;
			SetPVarInt(playerid, "tempPremium", 1);
		}
		case 8:	pCookies[playerid] += 1250;
		case 9: // Premium Member 1 for 7 days
		{
			pCookies[playerid] += 1500;

			if(pPremium[playerid] >= 1) return true;
			iTemp = gettime() + 86400 * 7;
			format(query, sizeof(query), "UPDATE players SET premium=1,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
			MySQL_updateQuery(query);
			premiumExpired[playerid] = iTemp;
			pPremium[playerid] = 1;
		}
		case 10: pCookies[playerid] += 2000;
		case 11: // Premium Member 2 for 7 days
		{
			pCookies[playerid] += 2500;

			if(pPremium[playerid] >= 2) return true;
			iTemp = gettime() + 86400 * 7;
			format(query, sizeof(query), "UPDATE players SET premium=2,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
			MySQL_updateQuery(query);
			premiumExpired[playerid] = iTemp;
			pPremium[playerid] = 2;
		}
		case 12: pCookies[playerid] += 3000;
		case 13: // VIP for one connect
		{
			pCookies[playerid] += 4000;

			if(pPremium[playerid] == 3) return true;
			pPremium[playerid] = 3;
			SetPVarInt(playerid, "tempPremium", 1);
		}
		case 14: // VIP for seven days
		{
			pCookies[playerid] += 5000;

			if(pPremium[playerid] == 3) return true;
			iTemp = gettime() + 86400 * 7;
			format(query, sizeof(query), "UPDATE players SET premium=3,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
			MySQL_updateQuery(query);
			premiumExpired[playerid] = iTemp;
			pPremium[playerid] = 3;
		}
		case 15: pCookies[playerid] += 6000;

	}
	return true;
}

