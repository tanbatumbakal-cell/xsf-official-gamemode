			else
			{
				format(str, sizeof(str), ""PARKOUR" Race record is %d minutes and %02d.%03d seconds by "YELLOW_E"'%s' "LIME_E"made on %s", pmin, psec, pms, TopParkourName, tmp);
				SendClientMessageToAll(COLOR_LIME, str);
			}
		}
		format(str, sizeof(str), "2,9PARKOUR7,0 Race record is %d:%02d.%03d by %s made on %s", pmin, psec, pms, TopParkourName, tmp);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	else
	{
		format(str, sizeof(str), ""PARKOUR" Parkour "YELLOW_E"'%s' "LIME_E"has no record time yet! Be the first one to make it!", CParkourName);
		SendClientMessageToAll(COLOR_LIME, str);
		format(str, sizeof(str), "2,9PARKOUR7,0 There is no record on parkour '%s'!", CParkourName);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}

	ParkourStart = 0;
	ParkoursReady = 0;
	ParkourActive = 1;
	pRanking = 1;
	return true;
}

LoadRace(temp[])
{
	format(raceName, sizeof(raceName), "%s.yr", temp);

	if(!fexist(raceName)) 
		return false; // Race name doesn't exist

	LCurrentCheckpoint = -1;

	new i;
	new File:raceFile = fopen(raceName, io_read);
	fread(raceFile, tmp, sizeof(tmp));
	strtok(tmp, i);        // yRace Version..
	strtok(tmp, i); 		// the person who created the race
	Airrace = strval(strtok(tmp, i)); 	// read off airrace
	i = 0;

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT regid,holder,ms,time FROM `racetimes` WHERE `race` = '%e'", temp);
	MySQL_query(query, true, "RaceDataLoad", "s", temp);

	while(fread(raceFile, tmp, sizeof(tmp), false))
	{
		LCurrentCheckpoint ++;
		i = 0;
		RaceCheckpoints[LCurrentCheckpoint][0] = floatstr(strtok(tmp, i));
		RaceCheckpoints[LCurrentCheckpoint][1] = floatstr(strtok(tmp, i));
		RaceCheckpoints[LCurrentCheckpoint][2] = floatstr(strtok(tmp, i));
	}
	fclose(raceFile);
	format(CRaceName, sizeof(CRaceName), "%s", temp);
	return true;
}

LoadParkour(temp[])
{
	format(ParkourName, sizeof(ParkourName), "%s.yp", temp);

	if(!fexist(ParkourName)) return false; // Race name doesn't exist

	pLCurrentCheckpoint = -1;

	new i;
	new File:ParkourFile = fopen(ParkourName, io_read);
	fread(ParkourFile, tmp, sizeof(tmp));
	strtok(tmp, i);        // yRace Version..
	strtok(tmp, i); 		// the person who created the race
	pAirrace = strval(strtok(tmp, i)); 	// read off airrace
	i = 0;

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT regid,holder,ms,time FROM `parkourtimes` WHERE `parkour` = '%e'", temp);
	MySQL_query(query, true, "ParkourDataLoad", "s", temp);

	while(fread(ParkourFile, tmp, sizeof(tmp), false))
	{
		pLCurrentCheckpoint ++;
		i = 0;
		parkourCheckpoints[pLCurrentCheckpoint][0] = floatstr(strtok(tmp, i));
		parkourCheckpoints[pLCurrentCheckpoint][1] = floatstr(strtok(tmp, i));
		parkourCheckpoints[pLCurrentCheckpoint][2] = floatstr(strtok(tmp, i));
	}
	fclose(ParkourFile);
	format(CParkourName, sizeof(CParkourName), "%s", temp);
	return true;
}

function RaceDataLoad(rname[])
{
	if(!MySQL_rowCount())
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE `racetimes` SET regid=-1,holder='NONE' WHERE `race` = '%e'", rname);
		MySQL_updateQuery(query);
		TopRacerID = -1;
		race_RecordMS = 0;
	}
	else
	{
		TopRacerID = cache_get_field_content_int(0, "regid");
		cache_get_field_content(0, "holder", TopRacerName, 25);
		race_RecordMS =cache_get_field_content_int(0, "ms");
		race_RecordMadeAt =cache_get_field_content_int(0, "time");

		if(TopRacerID == -1)
		{
			TopRacerID = -1;
			race_RecordMS = 0;
		}
	}
	return 1;
}

function ParkourDataLoad(pname[])
{
	if(!MySQL_rowCount())
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE `parkourtimes` SET regid=-1,holder='NONE' WHERE `parkour` = '%e'", pname);
		MySQL_updateQuery(query);
		TopParkourID = -1;
		Parkour_RecordMS = 0;
	}
	else
	{
		TopParkourID = cache_get_field_content_int(0, "regid");
		cache_get_field_content(0, "holder", TopParkourName, 25);
		Parkour_RecordMS = cache_get_field_content_int(0, "ms");
		Parkour_RecordMadeAt = cache_get_field_content_int(0, "time");

		if(TopParkourID == -1)
		{
			TopParkourID = -1;
			Parkour_RecordMS = 0;
		}
	}
	return 1;
}

function RaceRotation()
{
	if(Iter_Count(Player) == 0)
	{
		printf("RaceRotation: RaceRotation can't run - zero players online!");
		return true;
	}

	if(RaceActive == 1 || RaceStart == 1 || Participants > 0)
	{
		printf("RaceRotation: Race '%s' is already in process!", CRaceName);
		return true;
	}

	new File:f, templine[32], RaceFile[] = "yrace.rr", idx, rracenames[58][58], rraces = -1;
	f = fopen(RaceFile, io_read);
	while(fread(f, templine, sizeof(templine), false))
	{
		idx = 0;
		rraces++;
		rracenames[rraces] = strtok(templine, idx);
	}
	fclose(f);
	RRotation ++;
	if(RRotation > rraces) RRotation = 0;
	if(!LoadRace(rracenames[RRotation]))
	{
		printf("LoadRace(): Error loading race %s!", rracenames[RRotation]);
		//RaceRotation(); // Call the rotation again.
		return true;
	}
	printf("RaceRotation: LoadRace(%s) successful", rracenames[RRotation]);
	RaceActive = 1;
	foreach(new i : Player)
	{
		RacePosition[i] = 0;
	}
	SetTimer("startrace", 1000, false);
	return true;
}

function ParkourRotation()
{
	if(Iter_Count(Player) == 0)
	{
		printf("RaceRotation: RaceRotation can't run - zero players online!");
		return true;
	}

	if(ParkourActive == 1 || ParkourStart == 1 || pParticipants > 0)
	{
		printf("ParkourRotation: Race '%s' is already in process!", CParkourName);
		return true;
	}

	new File:f, templine[32], parkourFile[] = "yparkour.rr", idx, pnames[58][58], praces = -1;
	f = fopen(parkourFile, io_read);
	while(fread(f, templine, sizeof(templine), false))
	{
		idx = 0;
		praces++;
		pnames[praces] = strtok(templine, idx);
	}
	fclose(f);
	pRotation ++;
	if(pRotation > praces) pRotation = 0;
	if(!LoadParkour(pnames[pRotation]))
	{
		printf("LoadParkour(): Error loading parkour %s!", pnames[pRotation]);
		return true;
	}
	printf("ParkourRotation: LoadParkour(%s) successful", pnames[pRotation]);
	ParkourActive = 1;
	foreach(new i : Player)
	{
		ParkourPosition[i] = 0;
	}
	SetTimer("startparkour", 1000, false);
	return true;
}


// Ban System
function CheckBan(playerid)
{
	if(MySQL_rowCount())
	{
		new Reason[40];
		new banTime_Int, banDate, banTime[30], banIP[16];
		cache_get_field_content(0, "user_banner", PlayerName, 25);
		cache_get_field_content(0, "ban_reason", Reason, 40);
		banTime_Int = cache_get_field_content_int(0, "ban_time");
		banDate = cache_get_field_content_int(0, "ban_timestamp");
		cache_get_field_content(0, "bIP", banIP);

		new currentTime = gettime();
		if(banTime_Int == 0)
		{
			banTime = "Permanent";
		}
		else
		{
			if(currentTime >= banTime_Int) // Unban the player.
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM bans WHERE bIP = '%e'", banIP);
				MySQL_updateQuery(query);
				SetPVarInt(playerid, "PlayerUnbanned", 1);
			}
			else
			{
				new tmp_banTime = banTime_Int - gettime();
				if(tmp_banTime > 86400)
				{
					tmp_banTime = tmp_banTime/86400;
					format(banTime, sizeof(banTime), "%d days left.", tmp_banTime);
				}
				else banTime = "Few hours";
			}
		}
		if(!GetPVarType(playerid, "PlayerUnbanned"))
		{
			localtime(banDate, tmParam);
			strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);

			pLogged[playerid] = false; // Don't save banned player stats.
			doingStunt[playerid] = 99;
			//printf("DEBUG: Ban Getting Called on %s", pName[playerid]);
			GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));
			format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s(%i) has been auto-kicked for ban evading.", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_GREY2, str);
			format(str, sizeof(str), "2Server:3 %s(%i)4 has been auto-kicked for ban evading.", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_aCHANNEL, str), IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			HideConnectTD(playerid, false);
			InfoTD_MSG(playerid, 5000, "~r~~h~You are banned from this server!");
			for(new l; l < 20; l++) SendClientMessage(playerid, COLOR_DARK, "\n");
			SendClientMessage(playerid, COLOR_RED, "You are banned from this server!");
			format(line, sizeof(line), ""RED_E"You are banned from this server!\n\n"LB2_E"Ban Info:\n"RED_E"Name: "GREY2_E"%s\n"RED_E"IP: "GREY2_E"%s\n"RED_E"Admin: "GREY2_E"%s\n"RED_E"Ban Date: "GREY2_E"%s\n"RED_E"Ban Reason: "GREY2_E"%s\n"RED_E"Ban Time: "GREY2_E"%s\n\n"WHITE_E"Feel that you were wrongfully banned? Appeal at serverserver.com/forums", pName[playerid], PlayerIP, PlayerName, tmp, Reason, banTime);
			ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""RED_E"BANNED", line, "Exit", "");
			KickEx(playerid);
			return 1;
		}
	}

	GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));
	mysql_format(g_SQL_handle, str, sizeof(str), "SELECT * FROM `BadSports` WHERE `IP` = '%e' OR `Name` = '%e'", PlayerIP, pName[playerid]);
	MySQL_query(str, true, "OnPlayerBadSportCheck", "i", playerid);

	if(pLogged[playerid] == true)
	{
		foreach(new ii : Player)
		{
			if(pRegID[playerid] == pRegID[ii] && ii != playerid)
			{
				if(pSpawned[playerid] == 0)
				{
					SendClientMessage(playerid, COLOR_RED, "Server: You have an account that's already on the server!");
					format(str, sizeof(str), "2Server:3 %s(%i)4 has been kicked for having an account that's already on the server.", pName[playerid], playerid);
					IRC_GroupSay(ircGroup, IRC_aCHANNEL, str), IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
					KickEx(playerid);
					return 1;
				}
			}
		}
		OnUserLogin(playerid);

		LoadPlayerChallengeStats(playerid);
		MySQL_LoadPlayerToys(playerid);
		MySQL_LoadPlayerVehicle(playerid);
		MySQL_LoadPlayerGroup(playerid);
		MySQL_LoadPlayerAchivements(playerid);
		MySQL_LoadPlayerHouse(playerid);
	}
	return 1;
}

MySQL_LoadPlayerHouse(playerid)
{
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT hID,hbuyer,hprice FROM soldhouses WHERE name='%e'", pName[playerid]);
	MySQL_query(query, true, "LoadPlayerHouse", "i", playerid);
}

function LoadPlayerHouse(playerid)
{
	if(MySQL_rowCount())
	{
		new houseid, housebuyer[24], hprice;
		houseid = cache_get_field_content_int(0, "hID");
		cache_get_field_content(0, "hbuyer", housebuyer);
		hprice = cache_get_field_content_int(0, "hprice");

		GivePlayerCash(playerid, hprice);
		ShowInfoBox(playerid, ""ORANGE_E"Your house (ID: %d) has been purchased!\n\n"WHITEP_E"%s has purchased your house for "GREEN_E"$"WHITE_E"%s", houseid, housebuyer, ToCurrency(hprice));
		format(query, sizeof(query), "UPDATE players SET house_id=-1 WHERE house_id=%d", hInfo[houseid][HouseID]);
		MySQL_updateQuery(query);
		if(houseID[playerid] == houseid) houseID[playerid] = -1;
		if(GetOwnedHouses(playerid) == 0)
		{
			if(pSpawnPlace[playerid] == 6)
			{
				format(query, sizeof(query), "UPDATE players SET spawnplace=-1 WHERE reg_id=%d", pRegID[playerid]);
				MySQL_updateQuery(query);
			}
		}
		// Get rid of info
		mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM soldhouses WHERE name='%e'", pName[playerid]);
		MySQL_updateQuery(query);
	}
}

forward CheckManualBan(playerid);
public CheckManualBan(playerid)
{
	if(MySQL_rowCount())
	{
		new Reason[40];
		new banTime_Int, banDate, banTime[30];
		cache_get_field_content(0,"user_banner", giveplayer);
		cache_get_field_content(0,"ban_reason", Reason);
		banTime_Int = cache_get_field_content_int(0, "ban_timestamp");
		banDate = cache_get_field_content_int(0, "ban_time");

		if(banTime_Int == 0)
		{
			banTime = "Permanent";
		}
		else
		{
			new tmp_banTime = banTime_Int - gettime();
			if(tmp_banTime > 86400)
			{
				tmp_banTime = tmp_banTime/86400;
				format(banTime, sizeof(banTime), "%d days left.", tmp_banTime);
			}
			else banTime = "Few hours";
		}

		localtime(banDate, tmParam);
		strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);

		// DEBUG
		pLogged[playerid] = false; // Don't save banned player stats.
		doingStunt[playerid] = 99;
		printf("DEBUG: Ban Getting Called on %s", pName[playerid]);
		GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));
		format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s(%i) has been auto-kicked for ban evading.", pName[playerid], playerid);
		SendClientMessageToAll(COLOR_GREY2, str);
		format(str, sizeof(str), "2Server:3 %s(%i)4 has been auto-kicked for ban evading.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_aCHANNEL, str), IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
		HideConnectTD(playerid, false);
		InfoTD_MSG(playerid, 5000, "~r~~h~You are banned from this server!");
		for(new l; l < 20; l++) SendClientMessage(playerid, COLOR_DARK, "\n");
		SendClientMessage(playerid, COLOR_RED, "You are banned from this server!");
		format(line, sizeof(line), ""RED_E"You are banned from this server!\n\n"LB2_E"Ban Info:\n"RED_E"Name: "GREY2_E"%s\n"RED_E"IP: "GREY2_E"%s\n"RED_E"Admin: "GREY2_E"%s\n"RED_E"Ban Date: "GREY2_E"%s\n"RED_E"Ban Reason: "GREY2_E"%s\n"RED_E"Ban Time: "GREY2_E"%s\n\n"WHITE_E"Feel that you were wrongfully banned? Appeal at serverserver.com/forums", pName[playerid], PlayerIP, giveplayer, tmp, Reason, banTime);
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""RED_E"BANNED", line, "Exit", "");

		// Update Banned IP
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE bans SET bIP ='%e' WHERE user_banned='%e'", PlayerIP, pName[playerid]);
		MySQL_updateQuery(query);
		KickEx(playerid);
		return true;
	}
	return true;
}
CMD:baninfo(playerid, params[]) return cmd_baninfo(playerid, params);
CMD:checkban(playerid, params[])
{
	if(sscanf(params, "s[24]", tmp))
	{
		Usage(playerid, "/checkban <ban name/IP>");
		return true;
	}
	if(strfind(tmp, "%", true) != -1) return Error(playerid, "Invalid characters in ban name!");

	new dotCount, numCount;
	for(new i = 0; i < strlen(tmp); i++)
	{
		if(tmp[i] == '.')
		{
			dotCount++;
		}
		else if(tmp[i] >= '0' && tmp[i] <= '9')
		{
			numCount++;
		}
	}
	
	if(dotCount > 2 && numCount > 7) // IP
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM bans WHERE bIP = '%e'", tmp);
	}
	else mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM bans WHERE user_banned = '%e'",tmp ); // Name
	MySQL_query(query, true, "CheckPlayerBanned", "is", playerid, tmp);
	return true;
}

function CheckPlayerBanned(adminid, BannedName[])
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), ""RED_E"[ERROR] "GREY_E"No player with name or IP '%s' was found on the ban list.", BannedName);
		SendClientMessage(adminid, COLOR_GREY, str);
	}
	else
	{
		new BannedPlayer[24], Reason[40];
		new banTime_Int, banTime[15], banIP[16];
		new dateBanned;
		cache_get_field_content(0, "user_banner", PlayerName);
		cache_get_field_content(0, "ban_reason", Reason);
		cache_get_field_content(0, "user_banned", BannedPlayer);
		dateBanned = cache_get_field_content_int(0, "ban_timestamp");
		banTime_Int = cache_get_field_content_int(0, "ban_time");
		cache_get_field_content(0, "bIP", banIP);

		if(banTime_Int == 0)
		{
			banTime = "Permanent";
		}
		else
		{
			new tmp_banTime = banTime_Int - gettime();
			if(tmp_banTime > 86400)
			{
				tmp_banTime = tmp_banTime/86400;
				format(banTime, sizeof(banTime), "%d days left.", tmp_banTime);
			}
			else banTime = "Few hours";
		}
		localtime(dateBanned, tmParam);
		strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);

		SendClientMessage(adminid, COLOR_RED, "Ban Info:");
		if(pAdmin[adminid] != 0)
		{
			format(line, sizeof(line), "Player: %s || Admin: %s || Ban Date: %s || Ban IP: %s || Time Left: %s", BannedPlayer, PlayerName, tmp, banIP, banTime);
			SendClientMessage(adminid, COLOR_WHITEP, line);
			format(line, sizeof(line), "Ban Reason: %s", Reason);
			SendClientMessage(adminid, COLOR_WHITEP, line);
		}
		else
		{
			format(line, sizeof(line), "Player: %s || Admin: %s || Ban Date: %s || Time Left: %s", BannedPlayer, PlayerName, tmp, banTime);
			SendClientMessage(adminid, COLOR_WHITEP, line);
			format(line, sizeof(line), "Ban Reason: %s", Reason);
			SendClientMessage(adminid, COLOR_WHITEP, line);
		}
	}
	return true;
}

forward OnUnbanQueryData(adminid, BannedName[]);
public OnUnbanQueryData(adminid, BannedName[])
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "[ERROR] "GREY_E"No player named '%s' was found on the ban list.", BannedName);
		SendClientMessage(adminid, COLOR_WHITE, str);
	}
	else
	{
		new banIP[16];
		cache_get_field_content(0, "bIP", banIP, 16);
		mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM bans WHERE bIP = '%e'", banIP);
		MySQL_updateQuery(query);

		format(str, sizeof(str), "4Server:3 %s(%i) has unbanned %s from the server.", pName[adminid], adminid, BannedName);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		if(pHidden[adminid] == 0)
			format(str, sizeof(str), ""SERVER_INITIALS" "GREY2_E"%s(%i) has unbanned %s from the server.", pName[adminid], adminid, BannedName);
		else
			format(str, sizeof(str), ""SERVER_INITIALS" "GREY2_E"%s has been unbanned by an Administrator", BannedName);
		SendClientMessageToAll(COLOR_GREY, str);

		format(str, sizeof(str), ""SERVER_INITIALS" "GREY2_E"You have unbanned %s (IP: %s) from the server.", BannedName, banIP);
		SendClientMessage(adminid, COLOR_WHITE, str);
	}
	return true;
}

function changeWeather()
{
	foreach(new ii : Player)
	{
		if(pTime[ii] == -1 && pWeather[ii] == -1)
		{
			switch(TW_Update)
			{
				case 0: // Dawn
				{
					SetPlayerTime(ii, 6, 0);
					SetPlayerWeather(ii, 1);
					TW_Update = 1;
				}
				case 1: // Day
				{
					SetPlayerTime(ii, 10, 0);
					SetPlayerWeather(ii, 24);
					TW_Update = 0;
				}
			}
			SendClientMessage(ii, COLOR_LB, ""RED_E"Server: "LB2_E"The weather has been automatically changed!");
		}
	}
	return true;
}

