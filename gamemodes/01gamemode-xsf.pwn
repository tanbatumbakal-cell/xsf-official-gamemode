function PlayerBuyVehicle(playerid, vprice, vmodel, id)
{
	if(pLogged[playerid] == false)
    {
        Error(playerid, "You must be logged in to access your private vehicle menu!");
		return true;
    }
	if(pCash[playerid] < vprice)
	{
		Error(playerid, "You can't afford this vehicle!");
		ShowCarBuyMenu(playerid);
		return 1;
	}
	if(id == 1 && pPremium[playerid] != 3) return Error(playerid, "You must be vip if you want to buy two PV, take a look on /donate");
	if(BoughtVehicle[playerid][0] == true && BoughtVehicle[playerid][1] == true) return Error(playerid, "You have already purchased two private vehicles!");
	if(pTotalHours[playerid] < 3) return ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Private Vehicle Shop", "{F6F6F6}You must have at least a total of 3 hours of online time to purchase a private vehicle! (/stats)", "OK", "");
	//justSpawnedVehicle[playerid] = true;
	if(PlayerVehicle[playerid][id] != -1)
	{
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][id]);
		DestroyVehicle(PlayerVehicle[playerid][id]);
		PlayerVehicle[playerid][id] = -1;
	}
	PlayerInfoVeh[playerid][id][Model] = vmodel;
	PlayerInfoVeh[playerid][id][Price] = vprice;
	BoughtVehicle[playerid][id] = true;
	if(GetPVarInt(playerid, "PVShop") == 1) // Wangs
	{
		PlayerVehicle[playerid][id] = CreateVehicle(vmodel, -1969.1082,273.3000,34.9787,4.9537, 1, 0, -1);
		PutPlayerInVehicle(playerid, PlayerVehicle[playerid][id], 0);
		SetPlayerCameraPos(playerid, -1975.342285, 280.272521, 36.069160);
		SetPlayerCameraLookAt(playerid, -1971.656250, 276.896545, 36.196685);
	}
	else // Ottos
	{
		PlayerVehicle[playerid][id] = CreateVehicle(vmodel, -1657.6149,1214.6348,20.8833,340.1943, 1, 0, -1);
		PutPlayerInVehicle(playerid, PlayerVehicle[playerid][id], 0);
		SetPlayerCameraPos(playerid, -1651.590576, 1217.556518, 22.178741);
		SetPlayerCameraLookAt(playerid, -1656.007812, 1215.320556, 21.479473);
	}
	SetTimerEx("ShowColorDialog", 800, false, "i", playerid);
	GivePlayerCash(playerid, -PlayerInfoVeh[playerid][id][Price]);

	return 1;
}
function ShowColorDialog(playerid)
{
	ShowPlayerDialog(playerid, CARBUY_DIALOG+7, DIALOG_STYLE_LIST, ""GREEN_E"Choose your car color", "Black\nWhite\nRed\nBlue\nGreen\nYellow\nPink\nBrown\nGrey\nGold", "Next", "");
}
// PV CreateVehicle
CreateFinalCar(playerid, id)
{
	new vlabel[100];
	if(PlayerVehicle[playerid][id] != -1)
	{
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][id]);
		DestroyVehicle(PlayerVehicle[playerid][id]);
		PlayerVehicle[playerid][id] = -1;
	}
	format(PlayerInfoVeh[playerid][id][Owner], 24, pName[playerid]);
	//justSpawnedVehicle[playerid] = true;
	format(vlabel, sizeof(vlabel), "{%06x}%s's\n"WHITE_E"Vehicle", pColor[playerid], pName[playerid]);
	PlayerVehicle[playerid][id] = CreateVehicle(PlayerInfoVeh[playerid][id][Model], 1826.9821, -1383.8724, 19.3348, 180.0407, PlayerInfoVeh[playerid][id][Color1], PlayerInfoVeh[playerid][id][Color2], -1);
	PV_3DLabel[playerid][id] = CreateDynamic3DTextLabel(vlabel, -1, 0.0, 0.0, 0.0, 30.0, INVALID_PLAYER_ID, PlayerVehicle[playerid][id], 0, -1, -1, -1, 45.0);


	format(tmp, sizeof(tmp), "~y~~h~Purchased vehicle for ~g~$%d~y~!", PlayerInfoVeh[playerid][id][Price]);
	InfoTD_MSG(playerid, 4000, tmp);

	SetVehicleNumberPlate(PlayerVehicle[playerid][id], PlayerInfoVeh[playerid][id][Plate]);
	SetVehicleToRespawn(PlayerVehicle[playerid][id]);

	TogglePlayerControllable(playerid, true);
	PutPlayerInVehicle(playerid, PlayerVehicle[playerid][id], 0);
	//SetTimerEx("spawnedV", 3000, false, "i", playerid);
	if(GetPVarInt(playerid, "PVShop") == 1) // Wangs
	{
		SetPlayerVehiclePosition(playerid, -1981.2803,285.6966,34.8096,88.1494);
	}
	else SetPlayerVehiclePosition(playerid, -1644.7314,1213.2747,6.9067,226.3120);
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Private Vehicle Purchased!",
	""WHITE_E"Congrats you have purchased your private vehicle!\n\n"RED_E"- "WHITE_E"This vehicle will Permanently be saved and will be your till you sell it.\n"RED_E"- "WHITE_E"All your modifications to this vehicle will save (use /cc to change carcolor)\n"RED_E"- "WHITE_E"Use "LB_E"/pv "WHITE_E"to access your private vehicle menu.\n\nHave fun with your new car!", "Close", "");

	MySQL_CreateBuyVehicle(playerid, id);
	return 1;
}
//
ModVehicleColor(playerid, id)
{
	new color1,
		color2;

	color1 = PlayerInfoVeh[playerid][id][Color1] != 0 ? PlayerInfoVeh[playerid][id][Color1] : 0;
	color2 = PlayerInfoVeh[playerid][id][Color2] != 0 ? PlayerInfoVeh[playerid][id][Color2] : 0;

	ChangeVehicleColor(PlayerVehicle[playerid][id], color1, color2);
	return 1;
}
