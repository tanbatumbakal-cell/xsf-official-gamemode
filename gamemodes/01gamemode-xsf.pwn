CMD:serverstats(playerid) return cmd_uptime(playerid);
CMD:uptime(playerid)
{
	localtime(serverStartTime, tmParam);
	strftime(tmp, sizeof(tmp), "%B %d %Y, %H:%M", tmParam);
	new line2[700];
	new line3[700];

	format(line2, sizeof(line2), "\
		{FF4545}Statistics for the past %s.\n\n\
		"LB_E"Most players online: "WHITE_E"%d\n\
		"LB_E"Total players joined: "WHITE_E"%s\n\
		"LB_E"New players registered: "WHITE_E"%s\n\
		"LB_E"Queries sent: "WHITE_E"%s", Uptime(), joinPlayerCount, ToCurrency(totalPlayersJoined), ToCurrency(pRegs), ToCurrency(mysqlQueries)
	);
	strcat(line2, line3);

	format(line3, sizeof(line3), "\
		\n"LB_E"Chat messages sent: "WHITE_E"%s\n\
		"LB_E"Teleports used: "WHITE_E"%s\n\
		"LB_E"Record player count: "WHITE_E"351\n", ToCurrency(msgsSent), ToCurrency(telesUsed)
	);
	strcat(line2, line3);

	format(line3, sizeof(line3), "\
		"LB_E"Server up since: "WHITE_E"%s\n\n\
		{FF4545}Streamer plugin statistics:\n\
		"LB_E"Total objects: "WHITE_E"%s\n\
		"LB_E"Total map icons: "WHITE_E"%d\n\
		"LB_E"Total pickups: "WHITE_E"%d\n\
		"LB_E"Total checkpoints: "WHITE_E"%d\n\
		"LB_E"Total 3D text labels: "WHITE_E"%d\n\
		\n\
		{FDFEFF}Objects visible to you: {3C75E6}%d\n",
		tmp, ToCurrency(CountDynamicObjects()), CountDynamicMapIcons(), CountDynamicPickups(), CountDynamicCPs(), CountDynamic3DTextLabels(),
		Streamer_CountVisibleItems(playerid, STREAMER_TYPE_OBJECT)
	);
	strcat(line2, line3);

	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Server Statistics", line2, "OK", "");
	return 1;
}

CMD:addparkourrecord(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "s[40]", tmp))
	{
		Usage(playerid, "/addparkourrecord <parkourname>");
		return true;
	}
	mysql_format(g_SQL_handle,query, sizeof(query), "INSERT INTO `parkourtimes`(parkour) VALUES('%e')", tmp);
	MySQL_updateQuery(query);
	mysql_format(g_SQL_handle, str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"You have added "LB2_E"'%e' "GREEN_E"to the parkour record list.", tmp);
	SendClientMessage(playerid, COLOR_GREEN, str);
	return 1;
}
CMD:addracerecord(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "s[40]", tmp))
	{
		Usage(playerid, "/addracerecord <racename>");
		return true;
	}
	
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `racetimes`(race) VALUES('%e')", tmp);
	MySQL_updateQuery(query);
	format(str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"You have added "LB2_E"'%s' "GREEN_E"to the race record list.", tmp);
	SendClientMessage(playerid, COLOR_GREEN, str);
	return 1;
}
CMD:syncfooter(playerid)
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	SyncFooter();
	SendClientMessage(playerid, COLOR_GREY2, ""RED_E"> "GREY_E"You have sync'd the footer textdraw.");
	return true;
}

SyncFooter()
{
	// Syncs the DM footer textdraw
	BattleField = 0;
	FieldDM = 0;
	OneShotDM = 0;
	Rocket = 0;
	WarDM = 0;
	Mini = 0;
	TDM = 0;
	CnR = 0;
	DssDM = 0;
	DeagleDM::playerCount = 0;
	SawnDM::playerCount = 0;

	foreach(new ii : Player)
	{
		if(InDM[ii] == 1) BattleField++;
		if(InDM[ii] == 4) Rocket++;
		if(InDM[ii] == 5) WarDM++;
		if(InDM[ii] == 7) Mini++;
		if(InDM[ii] == 10) TDM++;
		if(InDM[ii] == 13) CnR++;
		if(InDM[ii] == 15) FieldDM++;
		if(InDM[ii] == 16) OneShotDM++;
		if(InDM[ii] == 50) DssDM++;
		if(InDM[ii] == DeagleDM::ID) DeagleDM::playerCount++;
		if(InDM[ii] == SawnDM::ID) SawnDM::playerCount++;
	}

	UpdateDMText();
}

