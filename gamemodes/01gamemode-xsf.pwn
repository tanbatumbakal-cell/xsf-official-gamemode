CMD:oreward(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new score, money;
	if(sscanf(params, "sii", giveplayer, score, money))
	{
		Usage(playerid, "/oreward <Name> <score> <money>");
		return true;
	}

	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);
		if(strfind(PlayerName, giveplayer, true) != -1)
		{
			Error(playerid, "Player is online, you can use /oreward on them.");
			return true;
		}
	}

	if(!strcmp(pName[playerid], giveplayer))
		return Error(playerid, "You can't reward yourself!");

	if(score > 5 && pAdmin[playerid] < 5)
		return Error(playerid, "You can't reward more than 5 score!");
	if(score < 1)
		return Error(playerid, "You can't reward anyone less than 1 score!");
	if(money > 10000 && pAdmin[playerid] < 5)
		return Error(playerid, "You can't reward more than $10,000!");
	if(money < 1)
		return Error(playerid, "You can't reward anyone less than $1!");

	

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE name='%e'", giveplayer);
	MySQL_query(query, true, "OfflineReward", "isii", playerid, giveplayer, score, money);
	return true;
}

function OfflineReward(playerid, rewarded_account[], score, money)
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "[SEARCHING] "GREY_E"Account '%s' does not exist.", rewarded_account);
		SendClientMessage(playerid, COLOR_WHITE, str);
	}
	else
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "LB_E"%s(%i) has offline-rewarded %s with "LG_E"$"LB_E"%d and %d score.", pName[playerid], playerid, rewarded_account, money, score);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "LB_E"%s has been offline-rewarded with "LG_E"$"LB_E"%d and %d score by an Administrator.", rewarded_account, money, score);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2Administrator %s(%d) has offline-rewarded %s with $%d and %d score.",  pName[playerid], playerid, rewarded_account, money, score);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Player has also received 1 report point.");
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET report_points=report_points+1, score=score+%d, money=money+%d WHERE name='%e'", score, money, rewarded_account);
		MySQL_updateQuery(query);
	}
}


StopAudioEx(playerid)
{
	DeletePVar(playerid, "pAudioStream");
    StopAudioStreamForPlayer(playerid);
}
PlayAudioEx(playerid, url[], Float:posX = 0.0, Float:posY = 0.0, Float:posZ = 0.0, Float:distance = 50.0, usepos = 0)
{
	if(GetPVarType(playerid, "pAudioStream")) StopAudioStreamForPlayer(playerid);
	else SetPVarInt(playerid, "pAudioStream", 1);
    PlayAudioStreamForPlayer(playerid, url, posX, posY, posZ, distance, usepos);
}

ChallengeCompleted(playerid)
{
	SavePlayerChallengeStats(playerid);
	PlayerPlaySound(playerid, 1149,0,0,0);
}


