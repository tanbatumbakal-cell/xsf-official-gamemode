// Require: CREATE TABLE `CommandsBlock` (`Name` VARCHAR(24), `Admin` VARCHAR(24), `Reason` VARCHAR(60), `Time` INT, `Date` INT)
CMD:oblockcmds(playerid, params[])
{
	if(pAdmin[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");

	new reason[60], timeSec;
	if(sscanf(params, "s[24]is[60]", giveplayer, timeSec, reason)) return Usage(playerid, "/blockcmds <name> <time in seconds> <reason>");

	foreach(new ii : Player)
	{
		if(strfind(giveplayer, pName[ii], true) != -1)
		{
			Error(playerid, "Player is online, you can use /blockcmds on them.");
			return true;
		}
	}


	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM players WHERE name='%e'", giveplayer);
	MySQL_query(query, true, "OfflineBlockCommands", "sisii", giveplayer, playerid, reason, gettime(), timeSec);
	return true;
}

forward OfflineBlockCommands(name[], adminid, reason[], date, time);
public OfflineBlockCommands(name[], adminid, reason[], date, time)
{
	if(!MySQL_rowCount()) return Error(adminid, "This account doesn't exists");
	else
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM CommandsBlock WHERE Name='%e'", name);
		MySQL_query(query, true, "OnBlockCommandsQueryData", "sisii", name, adminid, reason, date, time);
		return 1;
	}
}

forward OnBlockCommandsQueryData(name[], adminid, reason[], date, time);
public OnBlockCommandsQueryData(name[], adminid, reason[], date, time)
{
	if(MySQL_rowCount()) Error(adminid, "This account already has commands blocked. use /oblocklist for more info.");
	else
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO CommandsBlock (`Name`, `Admin`, `Reason`, `Time`, `Date`) VALUES ('%e', '%e', '%e', '%d', '%d')", name, pName[adminid], reason, time, date);
		MySQL_updateQuery(query);

		if(pHidden[adminid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has offline-blocked %s's commands for %d seconds. "GREY2_E"[Reason: %s]", pName[adminid], adminid, name, time, reason);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s's commands have been offline-blocked by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", name, time, reason);

		SendClientMessageToAll(-1, str);
	}
	return true;
}

forward OfflineUnBlockCommands(adminid, name[]);
public OfflineUnBlockCommands(adminid, name[])
{
	if(!MySQL_rowCount()) return Error(adminid, "- Account not offline-bocked, Continue..");
	else
	{
		mysql_format(g_SQL_handle, str, sizeof(str), "DELETE FROM `CommandsBlock` WHERE `Name` = '%e'", name);
		MySQL_updateQuery(str);
		if(pHidden[adminid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has offline-unblocked %s's commands.", pName[adminid], adminid, name);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s's commands have been offline-unblocked commands by an Administrator.", name);

		SendClientMessageToAll(-1, str);
		return 1;
	}
}

CMD:oblockcheck(playerid, params[])
{
	new thename[MAX_PLAYER_NAME];
	if(pAdmin[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "s[24]", thename)) return Usage(playerid, "/oblockcheck [name]");
	
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM `CommandsBlock` WHERE `Name` = '%e'", thename);
	MySQL_query(query, true, "OnPlayerCMDBlockCheck", "i", playerid);
	return 1;
}

forward OnPlayerCMDBlockCheck(playerid);
public OnPlayerCMDBlockCheck(playerid)
{
	if(!MySQL_rowCount()) return Error(playerid, "No such offline-block record was found.");
	cache_get_field_content(0, "Name", str);
	cache_get_field_content(0, "Admin", giveplayer);
	cache_get_field_content(0, "Reason", tmp);
	new z_time = cache_get_field_content_int(0, "Time");
	format(query, sizeof(query), "Name: %s\nAdmin: %s\nReason: %s\nTime: %d", str, giveplayer, tmp, z_time);
	ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_LIST, ""RED_E"server: "WHITE_E"Command Blocked List", query, "OK", "");
	return 1;
}


CMD:chase(playerid, params[])
{
	if(pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");
	if(ChaseBonus) return OnChasedPlayerEscape();
	else
	{
		if(sscanf(params, "k<player_name>i", ChasePlayer, ChasePrice)) return Usage(playerid, "/chase <playerid> <prize max = $10,000,000>");
		if(!IsPlayerConnected(ChasePlayer)) return Error(playerid, "This player is not connected!");
		if(ChasePrice > 10000000 || ChasePrice < 0) return Error(playerid, "Maximum prize value is $10,000,000");
		if(InDM[ChasePlayer] || InEvent[ChasePlayer] || doingStunt[ChasePlayer] || RaceParticipant[ChasePlayer]) return Error(playerid, "Chased player should be in freeroam mod");
		SpawnPlayer(ChasePlayer);
		GodModeLabel(ChasePlayer, true);
		ChaseBonus = true;
		SendClientMessage(ChasePlayer, -1, ""SERVER_INITIALS" "RED_E"You are being chased by the whole server, HURRY UP RUN!!!");
		format(str, sizeof(str), ""RED_E"["SERVER_INITIALS" "RED_E"Chase]: %s (%d) was detected as Terrorist, Malicious Unity, WE MUST KILL them NOW!!", pName[ChasePlayer], ChasePlayer);
		SendClientMessageToAll(-1, str);
		format(str, sizeof(str), ""RED_E"["SERVER_INITIALS" "RED_E"Chase]: The first one who manages to kill them, will win $%s, Good luck everyone!", ToCurrency(ChasePrice));
		SendClientMessageToAll(-1, str);
		SetPlayerWantedLevel(ChasePlayer, 6);

		format(str, sizeof(str), "~g~Chase is started! ~r~Chased player is %s (%d).", pName[ChasePlayer], ChasePlayer);
		TextDrawSetString(InfoTD2, str);
		foreach(new ii : Player)
		{
			if(InDM[ii] != 0) continue;
			if(Speedo[ii] == 1) PlayerTextDrawHide(ii, vSpeed[ii]), TextDrawHideForPlayer(ii, vSpeedBox);
			SetPVarInt(ii, "oldColor", GetPlayerColor(ii));
			SetPlayerColor(ii, COLOR_WHITE);
		}
		TextDrawShowForAll(InfoTD2);
		SetTimer("HideInfoTD", 6000, false);
		if(GOD[ChasePlayer]) cmd_god(ChasePlayer);
		SetPlayerHealth(ChasePlayer, 97);
		SetPlayerColor(ChasePlayer, COLOR_RED);
		ChaseTimer = SetTimer("OnChasedPlayerEscape", 90*1000, false);
	}
	return true;
}

forward OnChasedPlayerEscape();
public OnChasedPlayerEscape()
{
	SendClientMessage(ChasePlayer, -1, ""SERVER_INITIALS" Good job! You escaped from the whole server, just wow.");

	format(str, sizeof(str), ""RED_E"["SERVER_INITIALS" "RED_E"Chase]: %s (%d) has managed to escape from ya'all, Good luck next time.", pName[ChasePlayer], ChasePlayer);
	SendClientMessageToAll(-1, str);

	format(str, sizeof(str), "~r~Chase is over! ~g~%s(%d) managed to escape.", pName[ChasePlayer], ChasePlayer);
	TextDrawSetString(InfoTD2, str);
	TextDrawSetString(InfoTD2, str);
	foreach(new ii : Player)
	{
		if(Speedo[ii] == 1) PlayerTextDrawHide(ii, vSpeed[ii]), TextDrawHideForPlayer(ii, vSpeedBox);
		SetPlayerColor(ii, GetPVarInt(ii, "oldColor"));
	}
	TextDrawShowForAll(InfoTD2);
	SetTimer("HideInfoTD", 6000, false);
	KillTimer(ChaseTimer);
	ChasePrice = 0;
	ChaseBonus = false;
	ChasePlayer = INVALID_PLAYER_ID;
	return 1;
}

