function SendBetMsg(color, string2[])
{
	foreach(new i : Player)
	{
		if(IsPlayerConnected(i))
		{
			if(pMutedBet[i] == 0)
			{
				SendClientMessage(i, color, string2);
			}
		}
	}
	return 1;
}

CMD:togbet(playerid, params[])
{
	if(pMutedBet[playerid] == 0)
	{
		pMutedBet[playerid] = 1;
		SendClientMessage(playerid, COLOR_GREY, "You have disabled /bet notifications.");
	}
	else
	{
		pMutedBet[playerid] = 0;
		SendClientMessage(playerid, COLOR_GREY, "You have enabled /bet notifications.");
	}
	return 1;
}

CMD:togtag(playerid, params[])
{
	if(togTag[playerid])
	{
		togTag[playerid] = false;
		SendClientMessage(playerid, COLOR_GREY, "You have disabled your group tag.");
	}
	else
	{
		togTag[playerid] = true;
		SendClientMessage(playerid, COLOR_GREY, "You have enabled your group tag.");
	}
	format(query, sizeof(query), "UPDATE players SET `TogTag` = %d WHERE reg_id=%d",togTag[playerid] ? (0) : (1), pRegID[playerid]);
	MySQL_updateQuery(query);
	return 1;
}
CMD:toghcolors(playerid, params[])
{
	if(oldHColors[playerid] == 0)
	{
		oldHColors[playerid] = 1;
		SendClientMessage(playerid, COLOR_GREY, "You have enabled new helper colors");
	}
	else
	{
		oldHColors[playerid] = 0;
		SendClientMessage(playerid, COLOR_GREY, "You have disabled new helper colors");
	}
	format(query, sizeof(query), "UPDATE players SET `oldHColors` = %d WHERE reg_id=%d",oldHColors[playerid] , pRegID[playerid]);
	MySQL_updateQuery(query);
	return 1;
}
CMD:lasttag(playerid, params[])
{
