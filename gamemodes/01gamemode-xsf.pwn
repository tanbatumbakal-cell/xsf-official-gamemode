{
	if(pLogged[playerid] == true)
	{
		SavePlayerStats(playerid);
		SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have successfully saved your stats.");
		format(str, sizeof(str), "4* 3%s(%i) has manually saved their stats.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	else Error(playerid, "You must be logged in to save your stats!");
