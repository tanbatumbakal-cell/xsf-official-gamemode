					{
						case 0: SetPlayerPosition(playerid,-3730.8162,-730.0809,13.7681,10.6914);
						case 1: SetPlayerPosition(playerid,-3725.8818,-729.7451,10.8853,280.9352);
					}
					TogglePlayerControllable(playerid, false);
					SetTimerEx("unfreezePlayer", 2000, false, "i", playerid);
					SetPlayerSkin(playerid, 285);
