CMD:cookiehelp(playerid)
{
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Cookie System", ""LB2_E"Cookies are similar to karma!\n\n"YELLOW_E"Commands:\n"WHITE_E"/givecookie <playerid> - "LB2_E"Give someone a cookie.\n"WHITE_E"/cookies <playerid> - "LB2_E"Check the smount of cookies a player has.\n\
	"WHITE_E"/sellcookies <id> <cookies> <price> - "LB2_E"Sell cookies to another player.\n\n"WHITEP_E"You can purchase special items using your cookies in /cshop!\n", "OK", "");
	return 1;
}

CMD:givecookies(playerid, params[]) return cmd_givecookie(playerid, params);
CMD:givecookie(playerid, params[])
{
	new cookies;
	if(sscanf(params, "k<player_name>d", otherid, cookies))
	{
		Usage(playerid, "/givecookie <ID/Name> <amount>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(otherid == playerid)
		return Error(playerid, "You can't send yourself cookies!");
	if(pCookies[playerid] < cookies)
		return Error(playerid, "You don't have sufficient cookies to make this transaction!");
	if(cookies > 100 && pAdmin[playerid] != 5)
		return Error(playerid, "You can't send more than 100 cookies at once!");
	if(cookies < 1 && pAdmin[playerid] != 5)
		return Error(playerid, "You can't send anyone less than 1 cookie.");
	if(AFK[otherid] == 1)
		return Error(playerid, "You can't send cookies to people that are AFK!");

	GivePlayerCookie(playerid, -cookies);
	GivePlayerCookie(otherid, cookies);
	if(cookies == 1)
	{
		format(str, 128, ""SERVER_INITIALS" "GREEN_E"You have sent %s(%d) 1 cookie. (Cookies Left: %d)", pName[otherid], otherid, pCookies[playerid]);
		SendClientMessage(playerid, COLOR_GREEN, str);
		format(str, 128, ""SERVER_INITIALS" "GREEN_E"%s(%d) has sent you 1 cookie. (Total Cookies: %d)", pName[playerid], playerid, pCookies[otherid]);
		SendClientMessage(otherid, COLOR_GREEN, str);
	}
	else
	{
		format(str, 128, ""SERVER_INITIALS" "GREEN_E"You have sent %s(%d) %d cookies. (Cookies Left: %d)", pName[otherid], otherid, cookies, pCookies[playerid]);
		SendClientMessage(playerid, COLOR_GREEN, str);
		format(str, 128, ""SERVER_INITIALS" "GREEN_E"%s(%d) has sent you %d cookies (Total Cookies: %d).", pName[playerid], playerid, cookies, pCookies[otherid]);
		SendClientMessage(otherid, COLOR_GREEN, str);
	}
	format(str, sizeof(str), "4Server:3 %s(%i) has sent %s(%i) %d cookies.", pName[playerid], playerid, pName[otherid], otherid, cookies);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return 1;
}
CMD:sellcookies(playerid, params[]) return cmd_sellcookie(playerid, params);
CMD:sellcookie(playerid, params[])
{
	new cookies, price;
	if(sscanf(params, "k<player_name>dd", otherid, cookies, price))
	{
		Usage(playerid, "/sellcookies <ID/Name> <cookies> <price>");
		return true;
	}
	if(GetPVarInt(playerid, "sellingCookies") == 1)
		return Error(playerid, "You are currently selling cookies to someone, type /cancel to remove the offer.");

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(otherid == playerid)
		return Error(playerid, "You can't sell yourself cookies!");
	if(pCookies[playerid] < cookies)
		return Error(playerid, "You don't have sufficient cookies to make this transaction!");
	if(pCash[otherid] < price)
		return Error(playerid, "The other player does not have enough money to make this transaction!");
	if(cookies < 1)
		return Error(playerid, "You can't sell anyone less than 1 cookie.");
	if(cookies > 10000)
		return Error(playerid, "You can't sell more than 10000 cookies at once.");
	if(price > 30000000)
		return Error(playerid, "You can't make a transaction more than 30m!");
	if(price < 1)
		return Error(playerid, "You can't sell your cookies for less than $1.");
	if(ignore[otherid][playerid] == 1)
	    return Error(playerid, "Player has disabled cookie sale notifications from you.");
