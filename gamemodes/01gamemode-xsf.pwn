CMD:tban(playerid, params[]) return cmd_tempban(playerid, params);
CMD:tempban(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new ban_time;
	if(sscanf(params, "k<player_name>ds[60]", otherid, datez, tmp))
	{
		Usage(playerid, "/tempban <ID/Name> <time (in days)> <reason> ");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(ban_time < 0) Error(playerid, "Please input a valid ban time.");
	if(otherid == playerid)
		return Error(playerid, "You are not able to ban yourself!");
	if(GetPVarInt(otherid, "pRemoved")) return Error(playerid, "Player has already been removed from the server.");
	if(pAdmin[otherid] > pAdmin[playerid])
	{
		format(str, sizeof(str), "** "RED_E"%s(%i) has just tried to ban you!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_GREY2, str);
		Error(playerid, "You are not able to ban a admin with a higher level than you!");
		return true;
	}
	SetPlayerPosition(otherid, 405.1100,2474.0784,35.7369,360.0000);
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	GetPlayerIp(otherid, PlayerIP, sizeof(PlayerIP));

	if(!strcmp(tmp, "ab", true)) tmp = "Airbreak";
	else if(!strcmp(tmp, "ad", true)) tmp = "Advertising";
	else if(!strcmp(tmp, "ads", true)) tmp = "Advertising";
	else if(!strcmp(tmp, "hh", true)) tmp = "Health Hacks";
	else if(!strcmp(tmp, "wh", true)) tmp = "Weapon Hacks";
	else if(!strcmp(tmp, "sh", true)) tmp = "Speed Hacks";
	else if(!strcmp(tmp, "mh", true)) tmp = "Money Hacks";
	else if(!strcmp(tmp, "rh", true)) tmp = "Ram Hacks";
	else if(!strcmp(tmp, "ah", true)) tmp = "Ammo Hacks";
	SetPVarInt(otherid, "pRemoved", 1);
	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has temp-banned %s(%i) for %d days. "GREY2_E"[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, datez, tmp);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been temp-banned by an Administrator for %d days. "GREY2_E"[Reason: %s]", giveplayer, otherid, datez, tmp);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server: 2%s(%i) has temp-banned %s(%i) for %d days. 1[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, datez, tmp);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	BanPlayerMSG(otherid, playerid, tmp);
	if(datez != 0)
	{
		format(str, sizeof(str), ""RED_E"Server: "GREY2_E"This is a "RED_E"TEMP-BAN "GREY2_E"that will last for %d days.", datez);
		SendClientMessage(otherid, COLOR_GREY2, str);
	}
	ban_time = gettime() + (datez * 86400);
	if(pLogged[otherid] == true)
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%e', '%e', '%e', '%e', UNIX_TIMESTAMP(), %d)", giveplayer, PlayerIP, pName[playerid], tmp, ban_time);
	}
	else mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%e__', '%e', '%e', '%e', UNIX_TIMESTAMP(), %d)", giveplayer, PlayerIP, pName[playerid], tmp, ban_time);
	MySQL_updateQuery(query);
	KickEx(otherid);
	return true;
}

CMD:offlineban(playerid, params[]) return cmd_oban(playerid, params);
CMD:oban(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new player[24];
	if(sscanf(params, "s[24]D(0)s[50]", player, datez, tmp))
	{
		Usage(playerid, "/oban <ban name> <time in days (0 for permanent ban)> <reason>");
		SendClientMessage(playerid, COLOR_YELLOW2, "FUNCTION: Will ban a player while they're offline. If time isn't specified it will be a perm ban.");
		return true;
	}
	if(strlen(tmp) > 50) return Error(playerid, "Reason must be shorter than 50 characters.");

	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);

		if(strfind(PlayerName, player, true) != -1)
		{
			Error(playerid, "Player is online, you can use /ban on them.");
			return true;
		}
	}

	

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT ip FROM players WHERE name='%e'", player);
	MySQL_query(query, true, "OnOBanQueryData", "issi", playerid, player, tmp, datez);
	return true;
}

forward OnOBanQueryData(adminid, NameToBan[], banReason[], banTime);
public OnOBanQueryData(adminid, NameToBan[], banReason[], banTime)
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "[SEARCHING] "GREY_E"Account '%s' does not exist.", NameToBan);
		SendClientMessage(adminid, COLOR_WHITE, str);
	}
	else
	{
		cache_get_field_content(0, "ip", PlayerIP);
		mysql_format(g_SQL_handle, query, sizeof(query), "SELECT * FROM bans WHERE user_banned='%e'", NameToBan);
		MySQL_query(query, true, "OnOBanQueryDataFinish", "issis", adminid, NameToBan, banReason, banTime, PlayerIP);
	}
	return true;
}

function OnOBanQueryDataFinish(adminid, NameToBan[], banReason[], banTime, PlayerIPx[])
{
	if(MySQL_rowCount() > 0)
	{
		format(str, sizeof(str), "[ERROR] "GREY_E"Account '%s' is already banned.", NameToBan);
		SendClientMessage(adminid, COLOR_WHITE, str);
		cmd_checkban(adminid, NameToBan);
	}
	else
	{
		if(banTime != 0)
		{
			banTime = gettime() + (datez * 86400);
			format(str, sizeof(str), "- AS - "RED_E"You have temp-banned %s (IP: %s) from the server.", NameToBan, PlayerIPx);
			SendClientMessage(adminid, COLOR_YELLOW, str);
			format(str, sizeof(str), "4Server:3 %s(%i) has temp-banned %s from the server.", pName[adminid], adminid, NameToBan);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			if(pHidden[adminid] == 0)
				format(str, sizeof(str), "- AS - "RED_E"%s(%i) has temp-banned %s from the server.", pName[adminid], adminid, NameToBan);
			else
				format(str, sizeof(str), "- AS - "RED_E"%s has been temp-banned by an Administrator.", NameToBan);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}
		else
		{
			format(str, sizeof(str), "- AS - "RED_E"You have banned %s (IP: %s) from the server.", NameToBan, PlayerIPx);
			SendClientMessage(adminid, COLOR_YELLOW, str);
			format(str, sizeof(str), "4Server:3 %s(%i) has banned %s from the server.", pName[adminid], adminid, NameToBan);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			if(pHidden[adminid] == 0)
				format(str, sizeof(str), "- AS - "RED_E"%s(%i) has banned %s from the server.", pName[adminid], adminid, NameToBan);
			else
				format(str, sizeof(str), "- AS - "RED_E"%s has been banned by an Administrator.", NameToBan);
			SendClientMessageToAll(COLOR_YELLOW, str);
		}

		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%e', '%e', '%e', '%e', UNIX_TIMESTAMP(), %d)", NameToBan, PlayerIPx, pName[adminid], banReason, banTime);
		MySQL_updateQuery(query);
	}
	return 1;
}
CMD:unban(playerid, params[])
{
	if(pAdmin[playerid] < 1 && Helper[playerid] != 3)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "s[24]", tmp))
	{
		Usage(playerid, "/unban <ban name>");
		return true;
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT user_banned,bIP FROM bans WHERE user_banned = '%e'", tmp);
	MySQL_query(query, true, "OnUnbanQueryData", "is", playerid, tmp);
	return true;
}

CMD:freeze(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/freeze <ID/Name>");
		return true;
	}
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(Freezed[otherid]) return Error(playerid, "This player is already frozen.");
	TogglePlayerControllable(otherid, false);
	Freezed[otherid] = true;

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has frozen %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been frozen by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server:3 %s(%i) has frozen %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:aka(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/aka <ID/Name>");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(pAdmin[otherid] == 6)
	{
		Error(playerid, "You can't AKA the server owner!");
		format(str, 90, "*** "RED_E"%s(%i) tried to AKA you!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_YELLOW, str);
		return 1;
	}
	GetPlayerIp(otherid, PlayerIP, sizeof(PlayerIP));
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE IP='%e'", PlayerIP);
	MySQL_query(query, true, "CheckPlayerIP", "is", playerid, PlayerIP);
	return true;
}

function CheckPlayerIP(playerid, zplayerIP[])
{
	new rows = MySQL_rowCount();
	if(!rows)
	{
		Error(playerid, "No other accounts from this IP!");
	}
	else
	{
		datez = 0;
		line = "";
		format(line, sizeof(line), "Names matching IP: %s:\n\n", zplayerIP);
		for(new i = 0; i != rows; i++)
		{
			// Get the name  ache and append it to the dialog content
			cache_get_field_content(i, "name", str);
			strcat(line, str);
			datez ++;

			if(datez == 5)
				strcat(line, "\n"), datez = 0;
			else
				strcat(line, "\t\t");
		}

		tmp = "{ACB5BA}Aliases for {70CAFA}", strcat(tmp, zplayerIP);
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, tmp, line, "Close", "");
	}
	return 1;
}

CMD:akaip(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(isnull(params))
	{
		Usage(playerid, "/akaip <IP>");
		return true;
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE IP='%e'", params);
	MySQL_query(query, true, "CheckPlayerIP2", "is", playerid, params);
	return true;
}

function CheckPlayerIP2(playerid, zplayerIP[])
{
	new rows = MySQL_rowCount();
	if(!rows)
	{
		Error(playerid, "No other accounts from this IP!");
	}
	else
	{
		datez = 0;
		line = "";
		format(line, sizeof(line), "Names matching IP: %s:\n\n", zplayerIP);
		for(new i = 0; i != rows; i++)
		{
			// Get the name from the cache and append it to the dialog content
			cache_get_field_content(i, "name", str, 25);
			strcat(line, str);
			datez ++;

			if(datez == 5)
				strcat(line, "\n"), datez = 0;
			else
				strcat(line, "\t\t");
		}

		tmp = "{ACB5BA}Aliases for {70CAFA}", strcat(tmp, zplayerIP);
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, tmp, line, "Close", "");
	}
	return 1;
}
CMD:unfreeze(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/unfreeze <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(!Freezed[otherid]) return Error(playerid, "This player is not frozen.");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	TogglePlayerControllable(otherid, true);
	Freezed[otherid] = false;

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has unfrozen %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been unfrozen by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server:3 %s(%i) has unfrozen %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:seepms(playerid)
{
	if(pAdmin[playerid] < 4)
		return Error(playerid, "You are not authorized to use this command!");

	if(pInfo[playerid][pSeePMs] == 0)
	{
		pInfo[playerid][pSeePMs] = 1;
		SendClientMessage(playerid, COLOR_GREEN, ""SERVER_INITIALS" "LG_E"You have enabled 'See PMs' feature.");
	}
	else
	{
		pInfo[playerid][pSeePMs] = 0;
		SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "RED_E"You have disabled 'See PMs' feature.");
	}
	format(query, sizeof(query), "UPDATE players SET seepms=%d WHERE reg_id=%d", pInfo[playerid][pSeePMs], pRegID[playerid]);
	MySQL_updateQuery(query);
	return true;
}

CMD:makeadmin(playerid, params[]) return cmd_setlevel(playerid, params);
CMD:setlevel(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		if(!IsPlayerAdmin(playerid))
			return Error(playerid, "You are not authorized to use this command!");

	new alevel;
	if(sscanf(params, "k<player_name>d", otherid, alevel))
	{
		Usage(playerid, "/setlevel <ID/Name> <level 0 - 4>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(alevel > 5)
		return Error(playerid, "Level can't be higher than 4!");
	if(alevel < 0)
		return Error(playerid, "Level can't be lower than 0!");
	if(pAdmin[playerid] == 4)
	{
		if(alevel > 4)
			return Error(playerid, "You can't promote yourself or other players to owner or management!");
	}

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(pLogged[otherid] == false)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) isn't logged in!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(pAdmin[otherid] == alevel)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) is already level %d!", giveplayer, otherid, alevel);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	new levelstr[12];
	levelstr = (alevel > pAdmin[otherid]) ? ("promoted") : ("demoted");

	switch(alevel)
	{
		case 0:
		{
			tmp = "Regular Player";
			pHidden[otherid] = 0;
			format(query, sizeof(query), "UPDATE players SET hidden=0 WHERE reg_id=%d", pRegID[otherid]);
			MySQL_updateQuery(query);
			if(admin3D[otherid] != Text3D:-1) DestroyDynamic3DTextLabel(admin3D[otherid]);
		}
	    case 1: tmp = "Admin";
	    case 2: tmp = "Admin";
	    case 3: tmp = "Admin";
		case 4: tmp = "Lead Admin";
		case 5: tmp = "Manager";
		case 6: tmp = "Owner";
	}

	format(query, sizeof(query), "UPDATE players SET adminlevel=%d WHERE reg_id=%d", alevel, pRegID[otherid]);
	MySQL_updateQuery(query);

	pAdmin[otherid] = alevel;
	SendClientMessageToAll(COLOR_LB, " ");
	format(str, sizeof(str), ""YELLOW_E"- AS - "SBLUE_E"%s(%i) has %s %s(%i) to %s.", pName[playerid], playerid, levelstr, giveplayer, otherid, tmp);
	SendClientMessageToAll(COLOR_SBLUE, str);
	SendClientMessageToAll(COLOR_LB, " ");
	format(str, sizeof(str), "4Server: 2%s(%i) has %s %s(%i) to %s.", pName[playerid], playerid, levelstr, giveplayer, otherid, tmp);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "~y~~h~You have been %s to %s!", levelstr, tmp);
	InfoTD_MSG(otherid, 5000, str);
	AdminCommandLog("SETLEVEL", playerid, otherid, tmp);
	DestroyDynamic3DTextLabel(admin3D[otherid]);
	Set3DALabel(otherid);
	return true;
}

function Set3DALabel(playerid)
{
		if(pPremium[playerid] == 3 && pAdmin[playerid] == 0 && Helper[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{00f9ff}VIP", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		// Still have to add it to the function

		if(Helper[playerid] == 1 && pAdmin[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Helper", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(Helper[playerid] == 2 && pAdmin[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Mapper", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(Helper[playerid] == 3 && pAdmin[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Developer", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 1 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 2 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 3 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 4 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{f6d300}Lead Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 5 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{0045ff}Manager", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 6 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{ea0000}Owner", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
}
CMD:makehelper(playerid, params[])
{
	if(pAdmin[playerid] < 4) return Error(playerid, "You are not authorized to use this command!");

	new alevel;
	if(sscanf(params, "k<player_name>d", otherid, alevel))
	{
		Usage(playerid, "/makehelper <ID/Name> <0, 3>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(alevel > 3)
		return Error(playerid, "Level can't be higher than 1!");
	if(alevel < 0)
		return Error(playerid, "Level can't be lower than 0!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(pLogged[otherid] == false)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) isn't logged in!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(Helper[otherid] == alevel)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) is already level %d!", giveplayer, otherid, alevel);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	switch(alevel)
	{
		case 0:
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "SBLUE_E"%s(%i) has removed %s(%d)'s Helper status.", pName[playerid], playerid, giveplayer, otherid);
			SendClientMessageToAll(COLOR_SBLUE, str);
			format(str, sizeof(str), "4Server: 2%s(%i) has removed %s(%d)'s Helper status.", pName[playerid], playerid, giveplayer, otherid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			DestroyDynamic3DTextLabel(admin3D[playerid]);
			admin3D[playerid] = Text3D:-1;
			pDeveloper[playerid] = 0;
			pMapper[playerid] = 0;
		}
		case 1:
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "SBLUE_E"%s(%i) has given %s(%d) Helper status.", pName[playerid], playerid, giveplayer, otherid);
			SendClientMessageToAll(COLOR_SBLUE, str);
			format(str, sizeof(str), "4Server: 2%s(%i) has given %s(%d) Helper status.", pName[playerid], playerid, giveplayer, otherid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			pDeveloper[playerid] = 0;
			pMapper[playerid] = 0;
		}
		case 2:
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "SBLUE_E"%s(%i) has given %s(%d) Mapper status.", pName[playerid], playerid, giveplayer, otherid);
			SendClientMessageToAll(COLOR_SBLUE, str);
			format(str, sizeof(str), "4Server: 2%s(%i) has given %s(%d) Mapper status.", pName[playerid], playerid, giveplayer, otherid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			pMapper[otherid]=1;
			pDeveloper[playerid] = 0;
		}
		case 3:
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "SBLUE_E"%s(%i) has given %s(%d) Developer status.", pName[playerid], playerid, giveplayer, otherid);
			SendClientMessageToAll(COLOR_SBLUE, str);
			format(str, sizeof(str), "4Server: 2%s(%i) has given %s(%d) Developer status.", pName[playerid], playerid, giveplayer, otherid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			pDeveloper[otherid]=1;
			pMapper[otherid]=1;
		}
	}

	format(query, sizeof(query), "UPDATE players SET helper=%d WHERE reg_id=%d", alevel, pRegID[otherid]);
	MySQL_updateQuery(query);

	new levelstr[20];
	if(Helper[otherid] > alevel) levelstr = "demoted";
	else levelstr="promoted";

	Helper[otherid] = alevel;
	DestroyDynamic3DTextLabel(admin3D[otherid]);
	Set3DALabel(otherid);

	switch(Helper[otherid])
	{
		case 0: tmp = "Regular Player";
		case 1: tmp = "Helper";
		case 2: tmp = "Mapper";
		case 3: tmp = "Developer";
	} 
	return true;
}
CMD:omakehelper(playerid, params[])
{
	if(pAdmin[playerid] < 4) return Error(playerid, "You are not authorized to use this command!");

	new playername[25],leveltomake;
	if(sscanf(params, "si", playername,leveltomake))
	{
		Usage(playerid, "/omakehelper <Full Name> <0, 3>");
		return true;
	}

	foreach(new i: Player)
	{
		if(strcmp(playername, pName[i], false) == 0)
		{
			return Error(playerid, "That player is currently online. Please use /makehelper.");
		}
	}


	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id, helper FROM players WHERE Name = '%e'", playername);
	mysql_tquery(g_SQL_handle, query, "ProcessOfflineHelper", "isi", playerid, playername,leveltomake);
	return true;
}
forward ProcessOfflineHelper(playerid, playername[],leveltomake);
public ProcessOfflineHelper(playerid, playername[],leveltomake)
{
	if(!cache_num_rows()) return Error(playerid, "That account does not exist.");

	new premium = cache_get_field_content_int(0, "helper");
	new id = cache_get_field_content_int(0, "reg_id");
	if(leveltomake == 1)
	{
		if(premium == 1) return Error(playerid, "This user is already a helper.");

		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET helper = 1 WHERE reg_id = %i", id);
		mysql_tquery(g_SQL_handle, query);



		format(str, sizeof(str), ""RED_E"[OFFLINE]** "LG_E"%s(%i) "LB_E"has given "YELLOW_E"helper"LB_E" to "LG_E"%s", pName[playerid], playerid, playername);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2[OFFLINE] %s(%i) has given helper to %s(%i)", pName[playerid], playerid, playername);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	else if(leveltomake == 0)
	{
		if(premium == 0) return Error(playerid, "This user is a regular player already.");

		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET helper = 0 WHERE reg_id = %i", id);
		mysql_tquery(g_SQL_handle, query);



		format(str, sizeof(str), ""RED_E"[OFFLINE]** "LG_E"%s(%i) "LB_E"has removed "YELLOW_E"helper"LB_E" from "LG_E"%s", pName[playerid], playerid, playername);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2[OFFLINE] %s(%i) has removed helper from %s(%i)", pName[playerid], playerid, playername);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	}
	return true;
}
