CMD:saverace(playerid, params[])
{
	if(pAdmin[playerid] < 3)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(RaceBuilders[playerid] == 0)
	{
		SendClientMessage(playerid, COLOR_RED, "You are not building a race!");
		return true;
	}
	if(BCurrentCheckpoints < 2)
	{
		Error(playerid, "You need atleast 2 checkpoints to save!");
		return true;
	}

	if(sscanf(params, "s[90]", str))
	{
		Usage(playerid, "/saverace <name>");
		return true;
	}

	if(strlen(str) > 30)
	{
		Error(playerid, "Race name can't be longer than 30 characters!");
		return true;
	}
	if(!IsValidChar(str))
	{
		Error(playerid, "Race name contains invalid characters!");
		return true;
	}

	format(raceName, sizeof(raceName), "%s.yr", str);
	if(fexist(raceName))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Race '%s' already exists!", str);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}


	new File:raceFile = fopen(raceName, io_write);
	format(tmp, sizeof(tmp), "YRACE 0 %d %f\n", BAirrace, BCPsize);
	fwrite(raceFile, tmp);
	for(new ii = 0; ii < BCurrentCheckpoints; ii++)
	{
		POS[0] = BRaceCheckpoints[ii][0];
		POS[1] = BRaceCheckpoints[ii][1];
		POS[2] = BRaceCheckpoints[ii][2];
		format(tmp, sizeof(tmp), "%f %f %f\n", POS[0], POS[1], POS[2]);
		fwrite(raceFile, tmp);
	}
	fclose(raceFile);
	DisablePlayerRaceCheckpoint(playerid);
	format(str, sizeof(str), ""SERVER_INITIALS" Your race '%s' has been saved.", str);
	SendClientMessage(playerid, COLOR_GREEN, str);
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `racetimes`(race) VALUES('%e')", str);
	MySQL_updateQuery(query);
	RaceBuilders[playerid] = 0;
	RaceBuilt = 0;
	return true;
}

CMD:saveparkour(playerid, params[])
{
	if(pAdmin[playerid] < 2)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(ParkourBuilders[playerid] == 0)
	{
		SendClientMessage(playerid, COLOR_RED, "You are not building a parkour!");
		return true;
	}
	if(pBCurrentCheckpoints < 2)
	{
		Error(playerid, "You need atleast 2 checkpoints to save!");
		return true;
	}

	if(sscanf(params, "s[90]", str))
	{
		Usage(playerid, "/saveparkour <name>");
		return true;
	}

	if(strlen(str) > 30)
	{
		Error(playerid, "Parkour name can't be longer than 30 characters!");
		return true;
	}
	if(!IsValidChar(str))
	{
		Error(playerid, "Parkour name contains invalid characters!");
		return true;
	}

	format(ParkourName, sizeof(ParkourName), "%s.yp", str);
	if(fexist(ParkourName))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Parkour '%s' already exists!", str);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}


	new File:ParkourFile = fopen(ParkourName, io_write);
	format(tmp, sizeof(tmp), "YRACE 0 %d %f\n", pBAirrace, pBCPsize);
	fwrite(ParkourFile, tmp);
	for(new ii = 0; ii < pBCurrentCheckpoints; ii++)
	{
		POS[0] = pBRaceCheckpoints[ii][0];
		POS[1] = pBRaceCheckpoints[ii][1];
		POS[2] = pBRaceCheckpoints[ii][2];
		format(tmp, sizeof(tmp), "%f %f %f\n", POS[0], POS[1], POS[2]);
		fwrite(ParkourFile, tmp);
	}
	fclose(ParkourFile);
	DisablePlayerRaceCheckpoint(playerid);
	format(tmp, sizeof(tmp), ""SERVER_INITIALS" Your parkour '%s' has been saved.", str);
	SendClientMessage(playerid, COLOR_GREEN, tmp);
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `parkourtimes`(parkour) VALUES('%e')", str);
	MySQL_updateQuery(query);
	ParkourBuilders[playerid] = 0;
	ParkourBuilt = 0;
	return true;
}

CMD:loadrace(playerid, params[])
{
	if(pAdmin[playerid] == 0)
		if(pPremium[playerid] != 3)
			if(Helper[playerid] == 0)
				return Error(playerid, "You are not authorized to use this command!");

	if(pAdmin[playerid] < 2) {
		if(GetPVarInt(playerid, "loadRaceCooldown") > gettime()) {
			new seconds = GetPVarInt(playerid, "loadRaceCooldown") - gettime();
			new minutes = seconds / 60;

			if (seconds > 60)
				seconds -= (minutes * 60);

			format(str, sizeof(str), ""RED_E"ERROR: "GREY3_E"Your usage of this command is currently on a %i minute and %i second cooldown!", minutes, seconds);
			return SendClientMessage(playerid, COLOR_GREY2, str);
		}
	}
	if(RaceActive == 1)
	{
		Error(playerid, "A race is already active!");
		return true;
	}
	if(isnull(params))
	{
		new line2[3000];
		strcat(line2, ""LB2_E"RaceToLV\n"LB2_E"CrazyTaxi\n"LB2_E"Drag_Race\n"LB2_E"QuadRace\n"LB2_E"Monster_Rally\n"LB2_E"RaceTrack\n"LB2_E"downChilliad\n"LB2_E"RaceMap\n"LB2_E"KartTrack\n"LB2_E"Vinewood_Madness\n"LB2_E"SFDrag\n"LB2_E"SFDrag2\n"LB2_E"SlideRace\n"LB2_E"LV_Kart\n"LB2_E"Jeep_Rally\n"LB2_E"AllAroundLV\n"LB2_E"SF_Sprint\n"LB2_E"SF_Circuit");
		strcat(line2, "\n"LB2_E"LV_Drag\n"LB2_E"TunnelRace\n"LB2_E"Sandking_Rally\n"LB2_E"BanditoRally\n"LB2_E"SqualloRally\n"LB2_E"SF_Drift\n"LB2_E"LV_Drift\n"LB2_E"PizzaBoy\n"LB2_E"Country\n"LB2_E"\
		"LB2_E"Bigfoot\n"LB2_E"Bone\n"LB2_E"Tierra\n"LB2_E"Catalina\n"LB2_E"Quarry\n"LB2_E"Madness\n"LB2_E"LSmadness\n"LB2_E"Rock\n"LB2_E"Flint\n"LB2_E"Graveyard\n"LB2_E"UpDown\n"LB2_E"Chinarun\n"LB2_E"UpChilliad\n"LB2_E"Skyfall\n"LB2_E"GoingtoSF\n"LB2_E"Cesar");
		strcat(line2, "\n"LB2_E"Badlands\n"LB2_E"NFS\n"LB2_E"Drag\n"LB2_E"Drag2\n"LB2_E"County\n"LB2_E"LsDrag\n"LB2_E"Boatrace\n"LB2_E"Smuggler\n"LB2_E"CountryRun\n"LB2_E"Mexico\n"LB2_E"8Track\n"LB2_E"DirtRace\n"LB2_E"Bandit\n"LB2_E"Liberty\n"LB2_E"LVDrag2\n"LB2_E"LsDrag2\n"LB2_E"Beach2\n"LB2_E"Circuit_LS\n"LB2_E"Canal\n"LB2_E"NP2");
		strcat(line2, "\n"LB2_E"Roamer\n"LB2_E"VettelCircle\n"LB2_E"Fierro\n"LB2_E"ShortDrag\n"LB2_E"Detour\n"LB2_E"Ascension\n"LB2_E"VagosCircuit\n"LB2_E"CarparkShowdown\n"LB2_E"AlleyFreestyle\n"LB2_E"Meltdown\n"LB2_E"RaceInChina\n"LB2_E"Speedster\n"LB2_E"TrollBridge\n"LB2_E"MissionaryHillGP\n"LB2_E"Wallrider\n"LB2_E"GapTheBridge");
		ShowPlayerDialog(playerid, 163, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Race List (76 Races)", line2, "Start", "Close");
		return true;
	}

	if(!LoadRace(params))
	{
		format(str, sizeof(str), "ERROR: "GREY_E"Race %s is invalid!", params);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	format(str, sizeof(str), "Server: "GREY2_E"Race '%s' is starting..", params);
	SendClientMessage(playerid, COLOR_RED, str);
	RaceActive = 1;
	if(pAdmin[playerid] < 2)
		SetPVarInt(playerid, "loadRaceCooldown", gettime() + 90);
	SetTimer("startrace", 1000, false);
	return true;
}

CMD:loadparkour(playerid, params[])
{
	if(pAdmin[playerid] == 0)
		if(pPremium[playerid] != 3)
			if(Helper[playerid] == 0)
				return Error(playerid, "You are not authorized to use this command!");

	if(pAdmin[playerid] < 2) {
		if(GetPVarInt(playerid, "loadParkourCooldown") > gettime()) {
			new seconds = GetPVarInt(playerid, "loadParkourCooldown") - gettime();
			new minutes = seconds / 60;

			if (seconds > 60)
				seconds -= (minutes * 60);

			format(str, sizeof(str), ""RED_E"ERROR: "GREY3_E"Your usage of this command is currently on a %i minute and %i second cooldown!", minutes, seconds);
			return SendClientMessage(playerid, COLOR_GREY2, str);
		}
	}
	if(ParkourActive == 1)
	{
		Error(playerid, "A parkour is already active!");
		return true;
	}
	if(isnull(params))
	{
		new line2[1500];
		strcat(line2, ""LB2_E"Grove\n"LB2_E"Kinciad\n"LB2_E"Factory\n"LB2_E"Chinarun\n"LB2_E"Troll3\n"LB2_E"Niagara\n"LB2_E"SfSprint\n"LB2_E"BridgeSprint\n"LB2_E"Parkour5\n"LB2_E"Cicling\n"LB2_E"Stamina\n"LB2_E"KeyboardBreaker\n"LB2_E"Grove Street\n"LB2_E"Castle walls\n"LB2_E"KeyboardBreaker2\n"LB2_E"GoldClub\n"LB2_E"GetToPizza\n"LB2_E"BeFirst");
		strcat(line2, "\n"LB2_E"Troll4\n"LB2_E"Troll5\n"LB2_E"Swim\n"LB2_E"Hayclimb\n"LB2_E"AroundTheBar\n"LB2_E"ChilliadExtra\n"LB2_E"1Million\n"LB2_E"AA_Race\n");
		ShowPlayerDialog(playerid, 165, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Parkour list (24 Races)", line2, "Start", "Close");
		return true;
	}

	if(!LoadParkour(params))
	{
		format(str, sizeof(str), "ERROR: "GREY_E"Parkour %s is invalid!", params);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	format(str, sizeof(str), "Server: "GREY2_E"Parkour '%s' is starting..", params);
	SendClientMessage(playerid, COLOR_RED, str);
	ParkourActive = 1;
	if(pAdmin[playerid] < 2)
		SetPVarInt(playerid, "loadParkourCooldown", gettime() + 300);
	SetTimer("startparkour", 1000, false);
	return true;
}

CMD:startrace(playerid, params[])
{
	if(pAdmin[playerid] < 1)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}

	if(LCurrentCheckpoint == 0)
	{
		Error(playerid, "No race loaded (/loadrace)!");
		return true;
	}

	if(RaceActive == 1)
	{
		if(RaceStart == 1)
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"Race '%s' has already started!", CRaceName);
			SendClientMessage(playerid, COLOR_RED, str);
		}
		else
		{
			if(pHidden[playerid] == 0)
				format(str, sizeof(str), ""YELLOW_E"- AS - "ORANGE_E"%s(%i) has started the race "LB_E"'%s'", pName[playerid], playerid, CRaceName);
			else
				format(str, sizeof(str), ""YELLOW_E"- AS - "ORANGE_E"Race "LB_E"'%s' "ORANGE_E"has been started by an Administrator.", CRaceName);
			SendClientMessageToAll(COLOR_LB, str);
			mscd = 6;
		}
	}
	return 1;
}

CMD:startparkour(playerid, params[])
{
	if(pAdmin[playerid] < 1)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}

	if(pLCurrentCheckpoint == 0)
	{
		Error(playerid, "No parkour loaded (/parkour)!");
		return true;
	}

	if(ParkourActive == 1)
	{
		if(ParkourStart == 1)
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"Parkour '%s' has already started!", CParkourName);
			SendClientMessage(playerid, COLOR_RED, str);
		}
		else
		{
			if(pHidden[playerid] == 0)
				format(str, sizeof(str), ""YELLOW_E"- AS - "ORANGE_E"%s(%i) has started the parkour "LB_E"'%s'", pName[playerid], playerid, CParkourName);
			else
				format(str, sizeof(str), ""YELLOW_E"- AS - "ORANGE_E"Parkour "LB_E"'%s' "ORANGE_E"has been started by an Administrator.", CParkourName);
			SendClientMessageToAll(COLOR_LB, str);
			pmscd = 6;
		}
	}
	return 1;
}

CMD:parkourlist(playerid) {
	new count = 0;
	str = "";
	foreach(new i : Player) {
		if(doingStunt[i] == 88) {
			format(str, sizeof(str), "%s%s(%i)\n", str, pName[i], i);
			count++;
		}
	}

	if(!count)
		ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_LIST, "server - Parkour List", "There are currently no participants in the parkour!", "Ok", "");

	else
		ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_LIST, "server - Parkour List", str, "Ok", "");

	return 1;
}

CMD:deleterace(playerid, params[])
{
	if(pAdmin[playerid] < 3)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}

	if(sscanf(params, "s[90]", tmp))
	{
		Usage(playerid, "/deleterace <race name>");
		return true;
	}

	format(raceName, sizeof(raceName), "%s.yr", tmp);
	if(!fexist(raceName))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"The race '%s' doesn't exist!", tmp);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	fremove(raceName);
	format(str, sizeof(str), ""SERVER_INITIALS" The race '%s' has been deleted.", tmp);
	SendClientMessage(playerid, COLOR_GREEN, str);
	return 1;
}

CMD:deleteparkour(playerid, params[])
{
	if(pAdmin[playerid] < 2)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}

	if(sscanf(params, "s[90]", tmp))
	{
		Usage(playerid, "/deleteparkour <parkour name>");
		return true;
	}

	format(ParkourName, sizeof(ParkourName), "%s.yp", tmp);
	if(!fexist(raceName))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"The parkour '%s' doesn't exist!", tmp);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	fremove(ParkourName);
	format(str, sizeof(str), ""SERVER_INITIALS" The parkour '%s' has been deleted.", tmp);
	SendClientMessage(playerid, COLOR_GREEN, str);
	return 1;
}

CMD:racers(playerid)
{
	if(RaceActive == 0)
		return Error(playerid, "There is no race active!");

	Participants = 0;
	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] == 0) continue;
		Participants = Participants + 1;
	}

	format(str, sizeof(str), ""SERVER_INITIALS" Showing a list of total %d racer(s) in '%s':", Participants, CRaceName);
	SendClientMessage(playerid, COLOR_WHITE, str);

	Participants = 0;
	new racertmp[18];
	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] == 0) continue;
		switch(RaceParticipant[ii])
		{
			case 1: racertmp = "joined";
			case 2: racertmp = "arrived to start";
			case 3: racertmp = "ready";
			case 4: racertmp = "racing";
			case 5: racertmp = "finished";
		}
		Participants++;
		format(str, sizeof(str), "%d. %s(%i) (%s)", Participants, pName[ii], ii, racertmp);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	return true;
}
Float:Angle2D(Float:PointAx, Float:PointAy, Float:PointBx, Float:PointBy)
{
	new Float:Anglex;
	Anglex = atan2(PointAy < PointBy ? PointBy - PointAy : PointAy - PointBy, PointAx < PointBx ? PointBx - PointAx : PointAx - PointBx);
	Anglex = PointAx < PointBx ? 270.0 + Anglex : 90.0 - Anglex;
	Anglex = PointAy < PointBy ? Anglex : 180.0 - Anglex;
	return Anglex < 0.0 ? Anglex + 360.0 : Anglex;
}
CMD:race(playerid) return cmd_join(playerid);
CMD:join(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(RaceBuilders[playerid] != 0)
	{
		Error(playerid, "You are currently building a race, can't join. Use /clearrace to exit build mode.");
		return true;
	}
	else if(RaceParticipant[playerid] > 0)
	{
		Error(playerid, "You've already joined the race!");
		return true;
	}
	else if(RaceActive == 1 && RaceStart == 1)
	{
		Error(playerid, "The race has already started, can't join.");
		return true;
	}
	else if(RacersReady == 1)
	{
		Error(playerid, "The race countdown has started already, can't join.");
		return true;
	}
	else if(RaceActive == 0)
	{
		Error(playerid, "There is no race you can join!");
		return true;
	}
	if(Participants >= 20)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "ORANGE_E"Sorry the race is full, you can no longer join.. wait for the next one!");
		return 1;
	}
	if(InDM[playerid] != 0)
	{
 		Error(playerid, "You can't join a race while in a DM! Type /leave to exit.");
 		return true;
	}
	if(doingStunt[playerid] != 0)
	{
 		Error(playerid, "You can't join a race in this area! Type /leave to exit.");
 		return true;
	}
	// Close any open dialogs.
	ClosePlayerDialog(playerid);
	SavePlayerPosition(playerid);
	new AlreadyCalled;
	if(IsPlayerInAnyVehicle(playerid))
 	{
 		vID = GetPlayerVehicleID(playerid);
 		if(!IsValidRaceVehicle(GetVehicleModel(vID)) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 		{
			Error(playerid, ""ORANGE_E"You can't join the race in this vehicle!");
	    	return true;
		}
		if(GetPVarInt(playerid, "toysDisabled") == 1) cmd_togtoys(playerid);
		if(vID == PlayerVehicle[playerid][0] || vID == PlayerVehicle[playerid][1]) return Error(playerid, "Exit your private vehicle to join the race!");
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			foreach(new ii : Player)
			{
				if(ii == playerid || !IsPlayerInVehicle(ii, vID))
					continue;
				OnPlayerExitVehicle(ii, vID);
				GetVehiclePos(vID, POS[0], POS[1], POS[2]);
	   			SetPlayerPos(ii, POS[0], POS[1]+1, POS[2]+2);
				format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"%s(%d) has joined a race, you have been removed from the vehicle.", pName[playerid], playerid);
				SendClientMessage(ii, COLOR_LB, str);
			}
		}
		else
		{
			AlreadyCalled = 1;
			new Float:posasd[3];
			GetPlayerPos(playerid, posasd[0], posasd[1], posasd[2]);
			SetPlayerPos(playerid, posasd[0], posasd[1], posasd[2]+2);
			if(raceVehicles == true)
			{
				SpawnPlayerVehicle(playerid, raceVehicleName, false);
				vID = GetPlayerVehicleID(playerid);
				SetVehicleVirtualWorld(vID, 11);
				SetVehiclePos(vID, RaceCheckpoints[0][0] -4, RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2]  + 2);
				SetVehicleZAngle(vID, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
			}
			else
			{
				SetPlayerPos(playerid, RaceCheckpoints[0][0], RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2] + 1);
				SetPlayerFacingAngle(playerid, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
				ShowPlayerDialog(playerid, 3131, DIALOG_STYLE_LIST, ""ORANGE_E"server: "LB_E"Vehicle List", ""PINK_E"Special Vehicles\n"LG_E"Bikes\n"WHITE_E"Convertibles\nIndustrial\nLowriders\nOff Road\nPublic Service Vehicles\nSaloons\n"LG_E"Sport Vehicles\n"WHITE_E"Station Wagons\nUnique Vehicles", "Next", "Exit");
				SendClientMessage(playerid, COLOR_RED, "{FFFFFF}["LB_E"RACE{FFFFFF}] "ORANGE_E"Spawn a vehicle to race with. You must have a vehicle during the race.");
			}
		}
		if(AlreadyCalled == 0)
		{
			if(raceVehicles == true)
			{
				SpawnPlayerVehicle(playerid, raceVehicleName, false);
				SetVehicleVirtualWorld(vID, 11);
				SetVehiclePos(vID, RaceCheckpoints[0][0] -4, RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2] + 2);
				SetVehicleZAngle(vID, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
			}
			else
			{
				SetVehiclePos(vID, RaceCheckpoints[0][0] -4, RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2] + 2);
				SetVehicleZAngle(vID, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
			}
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(raceVehicles == true)
		{
			SpawnPlayerVehicle(playerid, raceVehicleName, false);
			vID = GetPlayerVehicleID(playerid);
			SetVehicleVirtualWorld(vID, 11);
			SetVehiclePos(vID, RaceCheckpoints[0][0] -4, RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2]  + 2);
			SetVehicleZAngle(vID, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
		}
		else
		{
			SetPlayerPos(playerid, RaceCheckpoints[0][0], RaceCheckpoints[0][1] + random(7), RaceCheckpoints[0][2] + 1);
			SetPlayerFacingAngle(playerid, Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
			ShowPlayerDialog(playerid, 3131, DIALOG_STYLE_LIST, ""ORANGE_E"server: "LB_E"Vehicle List", ""PINK_E"Special Vehicles\n"LG_E"Bikes\n"WHITE_E"Convertibles\nIndustrial\nLowriders\nOff Road\nPublic Service Vehicles\nSaloons\n"LG_E"Sport Vehicles\n"WHITE_E"Station Wagons\nUnique Vehicles", "Next", "Exit");
			SendClientMessage(playerid, COLOR_RED, "{FFFFFF}["LB_E"RACE{FFFFFF}] "ORANGE_E"Spawn a vehicle to race with. You must have a vehicle during the race.");
		}
	}
	if(!strcmp(CRaceName, "8Track", true))
	{
		SetPlayerInterior(playerid, 7);
		if(IsPlayerInAnyVehicle(playerid))
		{
		    vID = GetPlayerVehicleID(playerid);
			LinkVehicleToInterior(vID, 7);
		}
	}
	else if(!strcmp(CRaceName, "DirtRace", true))
	{
		SetPlayerInterior(playerid, 4);
		if(IsPlayerInAnyVehicle(playerid))
		{
			vID = GetPlayerVehicleID(playerid);
			LinkVehicleToInterior(vID, 4);
		}
	}
	else if(!strcmp(CRaceName, "Liberty", true))
	{
		SetPlayerInterior(playerid, 1);
		if(IsPlayerInAnyVehicle(playerid))
		{
			vID = GetPlayerVehicleID(playerid);
			LinkVehicleToInterior(vID, 1);
		}
	}
	else if(!strcmp(CRaceName, "NP2", true))
	{
		SetPlayerWeather(playerid, 10);
		SetPlayerTime(playerid, 22, 0);
	}
	else
		SetPlayerInterior(playerid, 0);
	InDM[playerid] = 0;
	canUseKey[playerid] = false;
	ResetPlayerWeapons(playerid);
	SetCameraBehindPlayer(playerid);
	SetPlayerWorldBounds(playerid, 20000.0, -20000.0, 20000.0, -20000.0);
	//HideModelSelectionMenu(playerid);
	ShowPlayerRaceTextdraws(playerid);
	SetPlayerVirtualWorld(playerid, WORLD_DUEL);
	if(IsPlayerInAnyVehicle(playerid))
	{
		SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), 11);
	}
	if(GetPVarInt(playerid, "HideObjects") == 1)
	{
		DeletePVar(playerid, "HideObjects");
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	}
	DisablePlayerCheckpoint(playerid);

	CurrentCheckpoint[playerid] = 0;
	SetRaceCheckpoint(playerid, 0, 1);

	RaceParticipant[playerid] = 1;
	Participants++;
	pushBack += 2.5;

	format(str, sizeof(str), ""RACE" You have joined the race '%s' and have been teleported to the start.", CRaceName);
	SendClientMessage(playerid, COLOR_WHITEP, str);
	format(str, sizeof(str), "~y~~h~~h~You have joined the race ~y~%s~y~~h~~h~!", CRaceName);
	InfoTD_MSG(playerid, 6000, str);

	// Lock the vehicle
	CarLocked[GetPlayerVehicleID(playerid)] = true;
	UpdateMinigameBox(playerid, 3, "/Race");
	format(str, sizeof(str), ""LB_E"[RACE] "WHITEP_E"%s(%i) has joined the race '%s' "GREY_E"[%d/20]", pName[playerid], playerid, CRaceName, Participants);
	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] != 0) SendClientMessage(ii, COLOR_WHITEP, str);
		if(ii != playerid)
		{
			SetVehicleParamsForPlayer(GetPlayerVehicleID(playerid), ii, 0, 1);
		}
	}
	format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has joined the race '%s', which has %d/20 participant(s).", pName[playerid], playerid, CRaceName, Participants);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	DisableRemoteVehicleCollisions(playerid, 1);
	return true;
}
CMD:lcp(playerid)
{
	if(RaceParticipant[playerid] == 0) return Error(playerid,"You are not in race");
	if(CurrentCheckpoint[playerid] == 0) return Error(playerid,"No last checkpoint found");
	if(RaceActive == 1)
	{
		InfoTD_MSG(playerid, 6000, "~g~~h~~h~Succesfully teleported to ~r~last checkpoint!");
		TogglePlayerControllable(playerid, false);
		SetTimerEx("unfreezePlayer_2", 2500 , false, "i", playerid);
		if(IsPlayerInAnyVehicle(playerid))
		{
			SetVehiclePos(GetPlayerVehicleID(playerid),RaceCheckpoints[CurrentCheckpoint[playerid]-1][0], RaceCheckpoints[CurrentCheckpoint[playerid]-1][1], RaceCheckpoints[CurrentCheckpoint[playerid]-1][2]);
			SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle2D(RaceCheckpoints[CurrentCheckpoint[playerid]-1][0], RaceCheckpoints[CurrentCheckpoint[playerid]-1][1], RaceCheckpoints[CurrentCheckpoint[playerid]][0], RaceCheckpoints[CurrentCheckpoint[playerid]][1]));
		}
		else SetPlayerPos(playerid,RaceCheckpoints[CurrentCheckpoint[playerid]-1][0], RaceCheckpoints[CurrentCheckpoint[playerid]-1][1], RaceCheckpoints[CurrentCheckpoint[playerid]][2]);
		SendClientMessage(playerid, COLOR_LB, ""RACE" "LB2_E"You have been teleported to your last checkpoint.");
	}
	return 1;
}
CMD:parkour(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(ParkourBuilders[playerid] != 0)
	{
		Error(playerid, "You are currently building a parkour, can't join. Use /clearparkour to exit build mode.");
		return true;
	}
	else if(ParkourParticipant[playerid] > 0)
	{
		Error(playerid, "You've already joined the parkour!");
		return true;
	}
	else if(ParkourActive == 1 && ParkourStart == 1)
	{
		Error(playerid, "The parkour has already started, can't join.");
		return true;
	}
	else if(ParkoursReady == 1)
	{
		Error(playerid, "The parkour countdown has started already, can't join.");
		return true;
	}
	else if(ParkourActive == 0)
	{
		Error(playerid, "There is no parkour you can join!");
		return true;
	}
	if(pParticipants >= 20)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "ORANGE_E"Sorry the parkour is full, you can no longer join.. wait for the next one!");
		return 1;
	}
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't join a parkour while in a DM! Type /leave to exit.");
		return true;
	}
	if(doingStunt[playerid] != 0)
	{
		Error(playerid, "You can't join a parkour in this area! Type /leave to exit.");
		return true;
	}

	SavePlayerPosition(playerid);
	SetPlayerPosition(playerid, parkourCheckpoints[0][0], parkourCheckpoints[0][1] + random(5), parkourCheckpoints[0][2] + 1, 0);
	SetPlayerFacingAngle(playerid, Angle2D(parkourCheckpoints[0][0], parkourCheckpoints[0][1], parkourCheckpoints[1][0], parkourCheckpoints[1][1]));

	SetPlayerInterior(playerid, 0);
	InDM[playerid] = 0;
	canUseKey[playerid] = false;
	ResetPlayerWeapons(playerid);
	SetCameraBehindPlayer(playerid);
	SetPlayerWorldBounds(playerid, 20000.0, -20000.0, 20000.0, -20000.0);
	HideModelSelectionMenu(playerid);
	ShowPlayerParkourTextdraws(playerid);
	SetPlayerVirtualWorld(playerid, 19);

	if(GetPVarInt(playerid, "HideObjects") == 1)
	{
		DeletePVar(playerid, "HideObjects");
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	}
	DisablePlayerCheckpoint(playerid);

	pCurrentCheckpoint[playerid] = 0;
	SetParkourCheckpoint(playerid, 0, 1);

	ParkourParticipant[playerid] = 1;
	doingStunt[playerid] = 88;
	if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
	pParticipants++;

	format(str, sizeof(str), ""PARKOUR" You have joined the parkour '%s' and have been teleported to the start.", CParkourName);
	SendClientMessage(playerid, COLOR_LIME, str);
	format(str, sizeof(str), "~y~~h~~h~You have joined the parkour ~y~%s~y~~h~~h~!", CParkourName);
	InfoTD_MSG(playerid, 6000, str);


	format(str, sizeof(str), ""LB_E"[PARKOUR] "WHITEP_E"%s(%i) has joined the parkour '%s' "GREY_E"[%d/20]", pName[playerid], playerid, CParkourName, pParticipants);
	foreach(new ii : Player) if(ParkourParticipant[ii] != 0) SendClientMessage(ii, COLOR_WHITEP, str);
	UpdateMinigameBox(playerid, 3, "/Parkour");

	format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has joined the parkour '%s', which has %d/20 participant(s).", pName[playerid], playerid, CParkourName, pParticipants);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}

/*CMD:lcp(playerid)
{
	if(RaceParticipant[playerid] == 0)
	{
		Error(playerid, "You are not in a race!");
		return true;
	}
	SetRaceCheckpoint(playerid, CurrentCheckpoint[playerid], -1);
	SetVehiclePos(GetPlayerVehicleID(playerid),  RaceCheckpoints[CurrentCheckpoint[playerid]][0], RaceCheckpoints[CurrentCheckpoint[playerid]][1], RaceCheckpoints[CurrentCheckpoint[playerid]][2]);
	SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle2D(RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[1][0], RaceCheckpoints[1][1]));
	SendClientMessage(playerid, COLOR_LB, ""RACE" "LB2_E"You have been teleported to your last checkpoint.");
	return 1;
}*/

CMD:exit(playerid) return cmd_leave(playerid);
CMD:leave(playerid)
{
	/*if(RaceParticipant[playerid] == 0)
	{
		if(InDM[playerid] == 0)
		{
			if(doingStunt[playerid] == 0)
			{
				if(InEvent[playerid] == 0)
				{
					Error(playerid, "You aren't in a Race, DM or Event!");
					return true;
				}
			}
		}
	}*/
	if(GetPVarInt(playerid, "ParticipatingHG") == 1)
	{
	    SetPVarInt(playerid, "ParticipatingHG", 0);
	    SetPVarInt(playerid, "HGDead", 0);
	    TogglePlayerSpectating(playerid, 0);
	    TogglePlayerControllable(playerid, 1);
	    SpawnPlayer(playerid);
	    HG_CurrentSpectator[playerid] = -1;
	    SendClientMessage(playerid, -1, "{FF0000}You have left hungergames.");
	    canUseKey[playerid] = true;
	    UpdateDMText();
	    return 1;
	}

	if(RaceParticipant[playerid] == 0 && InDM[playerid] == 0 && doingStunt[playerid] == 0 && InEvent[playerid] == 0 && isCbug[playerid] == 0 && ParticipatingWar[playerid] == 0)
		return Error(playerid, "You aren't in a Race, DM, war or Event!");

	if(ParticipatingWar[playerid] == 1)
	{
	    ParticipatingWar[playerid] = 0;
		SetPlayerHealth(playerid, 0);
		SendClientMessage(playerid, -1, "{FF0000}You have left your war.");
		return 1;
	}

	if(InEvent[playerid] != 0)
	{
		RemovePlayerFromEvent(playerid);

		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have left the event.");
		format(str,sizeof(str),""EVENT" "GREY2_E"%s(%i) has left the event.", pName[playerid], playerid);
		SendClientMessageToAll(COLOR_GREY2, str);
		return 1;
	}
	else if(doingStunt[playerid] != 0)
	{
		if(doingStunt[playerid] == 88) // Parkour
		{
			if(ParkourParticipant[playerid] == 3 && ParkourStart == 1)
			{
				Error(playerid, "You can't leave now! (countdown in progress)");
				return 1;
			}
			pParticipants --;
			GameTextForPlayer(playerid, " ", 500, 6);
			DisablePlayerRaceCheckpoint(playerid);
			TogglePlayerControllable(playerid, true);
			SetPlayerVirtualWorld(playerid, 0);
			TextDrawHideForPlayer(playerid, parkourCT);
			HidePlayerParkourTextdraws(playerid);
			canUseKey[playerid] = true;
			ParkourParticipant[playerid] = 0;
			doingStunt[playerid] = 0;

			format(str, sizeof(str), ""PARKOUR" "RED_E"You have left the parkour '%s'.", CParkourName);
			SendClientMessage(playerid, COLOR_RED, str);

			LoadPlayerPosition(playerid);
			if(pParticipants == 0)
			{
				endparkour();

				format(str, sizeof(str), ""PARKOUR" Parkour '%s' has ended (last participant %s(%i) has left)", CParkourName, pName[playerid], playerid);
				foreach(new ii : Player)
				{
					if(RaceParticipant[ii] != 0) SendClientMessage(ii, COLOR_LIME, str);
				}
				format(tmp, sizeof(tmp), "2,9PARKOUR7,0 Parkour '%s' has ended (last participant %s(%i) has left)", CParkourName, pName[playerid], playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
				return true;
			}
			switch(pParticipants)
			{
				case 0:
				{
					format(str, sizeof(str), ""PARKOUR" %s(%i) has left the parkour, there aren't any participants left in '%s'.",pName[playerid], playerid, CParkourName);
					format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has left the race, there aren't any participants left in '%s'.", pName[playerid], playerid, CParkourName);
				}
				case 1:
				{
					format(str, sizeof(str), ""PARKOUR" %s(%i) has left the parkour, there is now one participant left in '%s'.", pName[playerid], playerid, CParkourName);
					format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has left the parkour , there is now one participant left in '%s'.", pName[playerid], playerid, CParkourName);
				}
				default:
				{
					format(str, sizeof(str), ""PARKOUR" %s(%i) has left the parkour, there are now %d participants left in '%s'.", pName[playerid], playerid, pParticipants, CParkourName);
					format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has left the parkour, there are now %d participants left in '%s'.", pName[playerid], playerid, pParticipants, CParkourName);
				}
			}
			foreach(new ii : Player)
			{
				if(ParkourParticipant[ii] != 0) SendClientMessage(ii, COLOR_LIME, str);
			}
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
			return 1;
		}
		else if(doingStunt[playerid] == 18) // Fallout
		{
			SendClientMessage(playerid, COLOR_WHITEP, ""FALLOUT" You have left the fallout minigame.");
			RemoveFromFallout(playerid);
			return true;
		}
		else if(doingStunt[playerid] == 19) // Derby
		{
			SendClientMessage(playerid, COLOR_WHITEP, ""DERBY" You have left the derby minigame.");
			RemoveFromDerby(playerid);
			return true;
		}
		else if(doingStunt[playerid] == 33) // LMS
		{
			SendClientMessage(playerid, COLOR_WHITEP, ""DERBY" You have left the LMS minigame.");
			RemoveFromLMS(playerid);
			LMS_LoseGame();
			return true;
		}
		else if(doingStunt[playerid] == 70) // Spectating Event
		{
			cmd_stopwatch(playerid);
			return true;
		}

		// Other stunts
		doingStunt[playerid] = 0;
		SetPlayerVirtualWorld(playerid, 0);
		if(IsPlayerInAnyVehicle(playerid)) SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), 0);
		DisableRemoteVehicleCollisions(playerid,0);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			switch(random(3))
			{
				case 0: SetPlayerVehiclePosition(playerid, 416.1567,2478.8418,16.7717,88.4233);
				case 1: SetPlayerVehiclePosition(playerid, 416.0542,2503.7742,16.7712,92.1983);
				case 2: SetPlayerVehiclePosition(playerid, 402.6683,2446.3616,16.8719,0.7707);
			}
		}
		else
		{
			switch(random(3))
			{
				case 0: SetPlayerPosition(playerid, 324.2835,2549.4883,17.0000,181.596);
				case 1: SetPlayerPosition(playerid, 396.9685,2552.2439,19.8588,181.5505);
				case 2: SetPlayerPosition(playerid, 412.1591,2447.2278,17.1000,36.4023);
			}
		}
		return true;
	}
	else if(InDM[playerid] >= 1)
	{
		if(InDM[playerid] == 200) return Error(playerid, "You can't type /leave here, use /killme!");
		if(InDuel[playerid] != -1)
		{
			new Float:hp;
			GetPlayerHealth(playerid, hp);
			if(hp < 30)
			{
				return Error(playerid, "You can't leave the duel with less than 30 HP, finish the duel!");
			}
			format(str,sizeof(str),""DUEL" "GREY_E"%s(%i) has left the duel.", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_GREY, str);
			SendClientMessage(playerid, COLOR_RED, ""DUEL" "RED_E"You have left the duel.");
			ResetPlayerWeapons(playerid);

			// Give Bets back
			foreach(new ii : Player)
			{
				if(GetPVarInt(ii, "betPlayer") != -1 && GetPVarInt(ii, "bettedDuelID") == InDuel[playerid])
				{
					GivePlayerCash(ii, GetPVarInt(ii, "betAmount"));
					format(str,sizeof(str),""RED_E"[BET] "WHITEP_E"%s(%i) has left the duel, you have received your money back.", pName[playerid], playerid);
					SendClientMessage(ii, COLOR_WHITEP, str);
					SetPVarInt(ii, "betPlayer", -1);
					DeletePVar(ii, "betAmount");
				}
			}
			EndDuel(playerid);
		}
		else cmd_leavedm(playerid);
		return 1;
	}
	else if (isCbug[playerid])
		return cmd_leavedm(playerid);
	else // Race
	{
		if(RaceParticipant[playerid] == 3 && RaceStart == 1)
		{
			Error(playerid, "You can't leave now! (countdown in progress)");
			return 1;
		}
		Participants--;
		GameTextForPlayer(playerid, " ", 500, 6);
		DisablePlayerRaceCheckpoint(playerid);
		TogglePlayerControllable(playerid, true);
		SetPlayerVirtualWorld(playerid, 0);
		TextDrawHideForPlayer(playerid, raceCT);
		HidePlayerRaceTextdraws(playerid);
		canUseKey[playerid] = true;
		RaceParticipant[playerid] = 0;
		DisableRemoteVehicleCollisions(playerid, 0);

		format(str, sizeof(str), ""RACE" "RED_E"You have left the race '%s'.", CRaceName);
		SendClientMessage(playerid, COLOR_RED, str);

		vID = GetPlayerVehicleID(playerid);

		LoadPlayerPosition(playerid);
		if(RaceStart == 1 && Participants == 0)
		{


			format(str, sizeof(str), ""RACE" Race '%s' has ended (last racer %s(%i) has left)", CRaceName, pName[playerid], playerid);
			foreach(new ii : Player)
			{
				if(RaceParticipant[ii] != 0) SendClientMessage(ii, COLOR_WHITEP, str);
			}
			format(tmp, sizeof(tmp), "2,9RACE7,0 Race '%s' has ended (last racer %s(%i) has left)", CRaceName, pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

			endrace();
			return true;
		}
		switch(Participants)
		{
			case 0:
			{
				format(str, sizeof(str), ""RACE" %s(%i) has left the race, there aren't any participants left in '%s'.",pName[playerid], playerid, CRaceName);
				format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has left the race, there aren't any participants left in '%s'.", pName[playerid], playerid, CRaceName);
			}
			case 1:
			{
				format(str, sizeof(str), ""RACE" %s(%i) has left the race, only one participant left in '%s'.", pName[playerid], playerid, CRaceName);
				format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has left the race, only one participant left in '%s'.", pName[playerid], playerid, CRaceName);
			}
			default:
			{
				format(str, sizeof(str), ""RACE" %s(%i) has left the race, there are now %d participants left in '%s'.", pName[playerid], playerid, Participants, CRaceName);
				format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has left the race, there are now %d participants left in '%s'.", pName[playerid], playerid, Participants, CRaceName);
			}
		}
		foreach(new ii : Player)
		{
			if(RaceParticipant[ii] != 0) SendClientMessage(ii, COLOR_WHITEP, str);
		}
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
		CarLocked[vID] = false;
		foreach(new ii : Player)
		{
			SetVehicleParamsForPlayer(vID, ii, 0, 0);
		}
	}
	UpdateDMText();
	return 1;
}

PlayerInRangeOfPlayer(playerid, targetid, Float:range=10.0)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(targetid, x, y, z);
	if(IsPlayerInRangeOfPoint(playerid, range, x, y, z)) return 1;
	return 0;
}
CMD:exitdm(playerid) return cmd_leavedm(playerid);
CMD:leavedm(playerid)
{
	if(eInfo[playerid][inPUBG] == 1)
	{
		return cmd_leavepubg(playerid,"");
	}
	if(InDM[playerid] >= 1 || isCbug[playerid])
	{
		if(InDM[playerid] == 13) // CnR
		{
			if(GetPVarInt(playerid, "Robber") != 0)
			{
				foreach(new ii : Player)
				{
					if(GetPVarInt(ii, "Cop") != 0)
					{
						if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
						{
							return Error(playerid, "You can't type /leave nearby a cop, escape first!");
						}
					}
				}
			}
			if(GetPVarInt(playerid, "Cop") != 0)
			{
				foreach(new ii : Player)
				{
					if(GetPVarInt(ii, "Robber") != 0)
					{
						if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
						{
							return Error(playerid, "You can't type /leave nearby a robber, escape first!");
						}
					}
				}
			}
			RemoveItems(playerid);
			RemovePlayerFromDM(playerid);
			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have left the Cops and Robbers minigame.");
			LoadPlayerPosition(playerid);
			UnBlockPayNSpray(playerid);
		}
		else
		{
			if(InDM[playerid] == 3 || InDM[playerid] == 4 || InDM[playerid] == 7) // Minigun and Rocket
			{
				ResetPlayerWeapons(playerid);
				SetPlayerArmedWeapon(playerid, 0);
				pSpawned[playerid] = 0;
				SetPlayerHealth(playerid, 9999);
				TogglePlayerControllable(playerid, false);
				SetTimerEx("RemoveFromDeathmatch", 2500, false, "i", playerid);
				InfoTD_MSG(playerid, 3000, "You are being removed from the deathmatch. Please wait..");
			}
			else
			{
				RemovePlayerFromDM(playerid);
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have left the deathmatch.");
				LoadPlayerPosition(playerid);
			}
		}
		if(GetPVarInt(playerid, "killCamSpectator"))
		{
			new watcherid = GetPVarInt(playerid, "killCamSpectator");
			KillTimer(killCamTimer[watcherid]);
			TogglePlayerSpectating(watcherid, 0);
			hideKillCam(watcherid);
			killCamON[watcherid] = false;
			DeletePVar(playerid, "killCamSpectator");
		}
		if(isCbug[playerid])
		{

			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have left the Cbug challenge");
			LoadPlayerPosition(playerid);
			isCbug[playerid] = false;
		}
		if(playerSpectated[playerid] != 0)
		{
			format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"%s(%i) has left the deathmatch.", pName[playerid], playerid);
			foreach(new ii : Player)
			{
				if(pSpectating[ii] == playerid && GetPlayerState(ii) == PLAYER_STATE_SPECTATING)
				{
					SetPlayerVirtualWorld(ii, GetPlayerVirtualWorld(playerid));
					SetPlayerInterior(ii, GetPlayerInterior(playerid));
					PlayerSpectatePlayer(ii, playerid);
					SendClientMessage(ii, COLOR_WHITEP, str);
				}
			}
		}
	}
	else Error(playerid, "You are not currently in a deathmatch!");
	return 1;
}
CMD:endrace(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(RaceActive== 0)
	{
		Error(playerid, "There is no race active.");
		return 1;
	}
	if(cd > 0)
	{
		Error(playerid, "Main countdown is currently in progress, can't end the race now!");
		return 1;
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""RACE" "RED_E"%s(%i) has ended the race.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""RACE" "RED_E"The race has been ended by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Administrator5 %s(%i) has ended the race.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	endrace();
	return 1;
}

CMD:endparkour(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(ParkourActive== 0)
	{
		Error(playerid, "There is no parkour active.");
		return 1;
	}
	if(pcd > 0)
	{
		Error(playerid, "Main countdown is currently in progress, can't end the parkour now!");
		return 1;
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""PARKOUR" "RED_E"%s(%i) has ended the parkour.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""PARKOUR" "RED_E"The parkour has been ended by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Administrator5 %s(%i) has ended the parkour.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	endparkour();
	return 1;
}

function RaceCD()
{
	if(RaceStart == 0)
	{
		RaceStart = 1;
		foreach(new ii : Player)
		{
			if(RaceParticipant[ii] == 0) continue;
			if(cd == 5)
			{
				TogglePlayerControllable(ii, false);
				SendClientMessage(ii, COLOR_GREEN, "RACE: "LB_E"Your controls are now locked until the race start.");
				SetCameraBehindPlayer(ii);
				TextDrawShowForPlayer(ii, raceCT);

			}
		}
	}
	switch(cd)
	{
		case 5, 4, 3, 2, 1:
		{
			format(str, sizeof(str), "%d", cd);
			TextDrawSetString(raceCT, str);

			foreach(new ii : Player)
			{
				if(RaceParticipant[ii] > 1)
				{
					PlayerPlaySound(ii, 1056, 0.0, 0.0, 0.0);
				}
			}
		}
		case 0:
		{
			format(str, sizeof(str), "2,9RACE7,0 Race '%s' has started!", CRaceName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			foreach(new ii : Player)
			{
				if(RaceParticipant[ii] == 0) continue;
				TogglePlayerControllable(ii, true);

				if(RaceParticipant[ii] == 1) continue;
				PlayerPlaySound(ii, 1057, 0.0, 0.0, 0.0);

				TextDrawSetString(raceCT, "~g~GO");

				RaceParticipant[ii] = 4;
				SetRaceCheckpoint(ii, 0, 1);
			}

			KillTimer(rCountdown);
			KillTimer(timeOverTimer);

			race_StartTick = GetTickCount();
			tRacePosition = SetTimer("Race_CalculatePosition", 900, true);
			timeOverTimer = SetTimer("raceTimeOver", 240000, false);
			SetTimer("unshowRaceCT", 1000, false);
		}
	}
	cd--;
}

function ParkourCD()
{
	if(ParkourStart == 0)
	{
		ParkourStart = 1;
		foreach(new ii : Player)
		{
			if(ParkourParticipant[ii] == 0) continue;
			if(pcd == 5)
			{
				TogglePlayerControllable(ii, false);
				SetCameraBehindPlayer(ii);
				TextDrawShowForPlayer(ii, parkourCT);
			}
		}
	}
	switch(pcd)
	{
		case 5, 4, 3, 2, 1:
		{
			format(str, sizeof(str), "%d", pcd);
			TextDrawSetString(parkourCT, str);

			foreach(new ii : Player)
			{
				if(ParkourParticipant[ii] > 1)
				{
					PlayerPlaySound(ii, 1056, 0.0, 0.0, 0.0);
				}
			}
		}
		case 0:
		{
			format(str, sizeof(str), "2,9Parkour7,0 Parkour '%s' has started!", CParkourName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			foreach(new ii : Player)
			{
				if(ParkourParticipant[ii] == 0) continue;
				TogglePlayerControllable(ii, true);

				if(ParkourParticipant[ii] == 1) continue;
				PlayerPlaySound(ii, 1057, 0.0, 0.0, 0.0);

				TextDrawSetString(parkourCT, "~g~GO");

				ParkourParticipant[ii] = 4;
				SetParkourCheckpoint(ii, 0, 1);
			}

			KillTimer(pCountdown);
			KillTimer(ptimeOverTimer);

			Parkour_StartTick = GetTickCount();
			tParkourPosition = SetTimer("Parkour_CalculatePosition", 900, true);
			ptimeOverTimer = SetTimer("parkourTimeOver", 240000, false);
			SetTimer("unshowParkourCT", 1000, false);
		}
	}
	pcd--;
}

function derbyCD()
{
	if(IsDerbyRunning == false)
	{
		IsDerbyRunning = true;
		foreach(new ii : Player)
		{
			if(doingStunt[ii] == 19)
			{
				DerbyWinner[ii] = true;
				bDerbyPlayers++;
				TextDrawShowForPlayer(ii, derbyCT);
				//TextDrawHideForPlayer(ii, TeleTD);
				InfoTD_MSG(ii, 500, " ");
				for(new m1s = 0; m1s < sizeof(Derby_Map1Spawns); m1s++)
				{
					if(!Derby_Map1Spawns[m1s][m1sUsed])
					{
						Streamer_UpdateEx(ii, Derby_Map1Spawns[m1s][m1sX], Derby_Map1Spawns[m1s][m1sY], Derby_Map1Spawns[m1s][m1sZ]);
						SetPlayerPos(ii, Derby_Map1Spawns[m1s][m1sX], Derby_Map1Spawns[m1s][m1sY], Derby_Map1Spawns[m1s][m1sZ]+2.0);
						SetPlayerFacingAngle(ii, Derby_Map1Spawns[m1s][m1sA]);
						SetCameraBehindPlayer(ii);
						SetPlayerHealth(ii, 98);
						ResetPlayerWeapons(ii);
						ShowPlayerDialog(ii, -1, DIALOG_STYLE_LIST, "Close", "Close", "Close", "Close");

						new vd;
						switch(random(6))
						{
							case 0: vd = 429;
							case 1: vd = 402;
							case 2: vd = 541;
							case 3: vd = 415;
							case 4: vd = 411;
							case 5: vd = 506;
						}
						//SpawnPlayerVehicle(ii, vd, false);
						//SetPlayerVehiclePosition(ii, Derby_Map1Spawns[m1s][m1sX], Derby_Map1Spawns[m1s][m1sY], Derby_Map1Spawns[m1s][m1sZ], Derby_Map1Spawns[m1s][m1sA]);
						if(pSpawnVehicle[ii] != -1)
						{
							DestroyVehicle(pSpawnVehicle[ii]);
							RemoveComponents(ii);
						}
						pSpawnVehicle[ii] = CreateVehicle(vd, Derby_Map1Spawns[m1s][m1sX], Derby_Map1Spawns[m1s][m1sY], floatadd(Derby_Map1Spawns[m1s][m1sZ], 0.5), Derby_Map1Spawns[m1s][m1sA], (random(128) + 127), (random(128) + 127), -1);
						SetPlayerVirtualWorld(ii, DERBY_WORLD);
						SetVehicleVirtualWorld(pSpawnVehicle[ii], DERBY_WORLD);
						SetTimerEx("unfreezePutInDerbyVehicle", 2000, false, "idffff", ii, pSpawnVehicle[ii],  Derby_Map1Spawns[m1s][m1sX], Derby_Map1Spawns[m1s][m1sY], Derby_Map1Spawns[m1s][m1sZ]+1, Derby_Map1Spawns[m1s][m1sA]);

						Derby_Map1Spawns[m1s][m1sUsed] = true;
						break;
					}
				}
			}
		}
	}
	switch(derbycd)
	{
		case 5, 4, 3, 2, 1:
		{
			format(str, sizeof(str), "%d", derbycd);
			TextDrawSetString(derbyCT, str);
			foreach(new ii : Player)
			{
				if(doingStunt[ii] == 19)
				{
					TogglePlayerControllable(ii, false);
					PlayerPlaySound(ii, 1056, 0.0, 0.0, 0.0);
				}
			}
		}
		case 0:
		{
			KillTimer(derbyCountdown);
			derbyCountdown = -1;
			if(CurrentDerbyPlayers > 1)
			{
				foreach(new ii : Player)
				{
					if(doingStunt[ii] == 19)
					{
						TogglePlayerControllable(ii, true);
						RepairVehicle(GetPlayerVehicleID(ii));
						PlayerPlaySound(ii, 3200, 0, 0, 0);
						format(str, sizeof(str), "~w~Derby has started with ~b~~h~~h~%d ~w~players.~n~Eliminate other players to win the derby!", bDerbyPlayers);
						InfoTD_MSG(ii, 6500, str);
						TextDrawSetString(derbyCT, "~g~~h~GO!");
					}
				}
				SetTimer("unshowDerbyCT", 1200, false);
				StartDerbyMap1();
			}
			else
			{
				foreach(new ii : Player)
				{
					if(doingStunt[ii] == 19)
					{
						RemovePlayerFromVehicle(ii);
						if(pSpawnVehicle[ii] != -1)
						{
							DestroyVehicle(pSpawnVehicle[ii]);
							pSpawnVehicle[ii] = -1;
						}
						SetPlayerVirtualWorld(ii, DERBY_WORLD);
						SetPlayerDerbyStaticMeshes(ii);
						TogglePlayerControllable(ii, false);
						ShowDerbyVotingDialog(ii);
					}
				}
				SendDerbyMessage(COLOR_WHITEP, ""DERBY" Derby has ended due to lack of participants.");
			}
		}
	}
	derbycd--;
}
