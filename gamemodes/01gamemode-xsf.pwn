CMD:omakeadmin(playerid, params[])
{
	if(pAdmin[playerid] < 5) return Error(playerid, "You are not authorized to use this command!");

	new playername[25], alevel;
	if(sscanf(params, "sd", playername, alevel))
	{
		Usage(playerid, "/ogiveadmin <Full Name> <level 1-4>");
		return true;
	}


	foreach(new i: Player)
	{
		if(strcmp(playername, pName[i], false) == 0)
		{
			return Error(playerid, "That player is currently online. Please use /setadmin.");
		}
	}

	if(alevel > 4) return Error(playerid, "Level can't be higher than 4!");
	if(alevel < 0) return Error(playerid, "Level can't be lower than 1!");

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id, adminlevel FROM players WHERE Name = '%e'", playername);
	mysql_tquery(g_SQL_handle, query, "ProcessOfflineAdmin", "iis", playerid, alevel, playername);
	return true;
}
forward ProcessOfflineAdmin(playerid, plevel, playername[]);
public ProcessOfflineAdmin(playerid, plevel, playername[])
{
	if(!cache_num_rows()) return Error(playerid, "That account does not exist.");

	new premium = cache_get_field_content_int(0, "adminlevel");
	new id = cache_get_field_content_int(0, "reg_id");
	if(premium == plevel) return Error(playerid, "This user already has that admin level.");

	mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET adminlevel = %i, hidden=0 WHERE reg_id = %i", plevel, id);
	mysql_tquery(g_SQL_handle, query);
	new premtype[24];
	switch(plevel)
	{
		case 0:premtype = "Regular Player";
		case 1..3: premtype = "Admin";
		case 4: premtype = "Lead Admin";
		case 5: premtype = "Manager";
		case 6: premtype = "Owner";
	}


	format(str, sizeof(str), ""RED_E"[OFFLINE]** "LG_E"%s(%i) "LB_E"has given "YELLOW_E"%s "LB_E" to "LG_E"%s", pName[playerid], playerid, premtype, playername);
	SendClientMessageToAll(COLOR_LB, str);

	format(str, sizeof(str), "4Server: 2[OFFLINE] %s(%i) has given %s to %s(%i)", pName[playerid], playerid, premtype, playername);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}
CMD:ogivepremium(playerid, params[])
{
	if(pAdmin[playerid] < 6) return Error(playerid, "You are not authorized to use this command!");

	new playername[25], alevel;
	if(sscanf(params, "sd", playername, alevel))
	{
		Usage(playerid, "/ogivepremium <Full Name> <level 1-3>");
		return true;
	}

	foreach(new i: Player)
	{
		if(strcmp(playername, pName[i], false) == 0)
		{
			return Error(playerid, "That player is currently online. Please use /givepremium.");
		}
	}

	if(alevel > 3) return Error(playerid, "Level can't be higher than 3!");
	if(alevel < 1) return Error(playerid, "Level can't be lower than 1!");

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id, premium FROM players WHERE Name = '%e'", playername);
	mysql_tquery(g_SQL_handle, query, "ProcessOfflinePremium", "iis", playerid, alevel, playername);
	return true;
}
forward ProcessOfflinePremium(playerid, plevel, playername[]);
public ProcessOfflinePremium(playerid, plevel, playername[])
{
	if(!cache_num_rows()) return Error(playerid, "That account does not exist.");

	new premium = cache_get_field_content_int(0, "premium");
	new id = cache_get_field_content_int(0, "reg_id");
	if(premium == plevel) return Error(playerid, "This user already has that premium level.");

	new bankadd, premtype[12];
	if(plevel == 1) bankadd = 0, premtype = "Premium";
	if(plevel == 2) bankadd = 1000000, premtype = "Premium";
	if(plevel == 3) bankadd = 5000000, premtype = "VIP";

	mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET bmoney = bmoney + %i, premium = %i WHERE reg_id = %i", bankadd, plevel, id);
	mysql_tquery(g_SQL_handle, query);

	format(str, sizeof(str), ""RED_E"[OFFLINE]** "LG_E"%s(%i) "LB_E"has given "YELLOW_E"%s "LB_E"membership to "LG_E"%s", pName[playerid], playerid, premtype, playername);
	SendClientMessageToAll(COLOR_LB, str);

	format(str, sizeof(str), "4Server: 2[OFFLINE] %s(%i) has given %s membership to %s(%i)", pName[playerid], playerid, premtype, playername);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}
CMD:givepremium(playerid, params[])
{
	if(pAdmin[playerid] < 6)
		return Error(playerid, "You are not authorized to use this command!");

	new alevel, months;
	if(sscanf(params, "k<player_name>di(0)", otherid, alevel, months))
	{
		Usage(playerid, "/givepremium <ID/Name> <level 1-3> <months (optional)>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(alevel > 3)
		return Error(playerid, "Level can't be higher than 3!");
	if(alevel < 0)
		return Error(playerid, "Level can't be lower than 0!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(pLogged[otherid] == false)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) isn't logged in!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(pPremium[otherid] == alevel)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) is already level %d premium!", giveplayer, otherid, alevel);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	if(months > 0)  months = gettime() + (2592000 * months);
		else if(months < 0 || months == 0) months = 0;

	if(alevel == 3)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) set you as a "YELLOW_E"VIP Player", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has given "YELLOW_E"VIP "LB_E"membership to "LG_E"%s(%i)", pName[playerid], playerid, giveplayer, otherid);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2%s(%i) has given VIP membership to %s(%i)", pName[playerid], playerid, giveplayer, otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4500, "~g~~h~You have received VIP membership!");
		BankMoney[otherid] += 5000000;
		pPremium[otherid] = 3;
		format(query, sizeof(query), "UPDATE players SET premium=3,v_expired=%i,bmoney=%i WHERE reg_id=%d", months, BankMoney[otherid], pRegID[otherid]);
		MySQL_updateQuery(query);
		AdminCommandLog("GIVEPREM", playerid, otherid, "VIP");
		Set3DALabel(otherid);
	}
	else if(alevel > 0)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) set you to a premium member (Level: %d)", pName[playerid], playerid, alevel);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has given premium membership to "LG_E"%s(%i) "GREY_E"(Level %d)", pName[playerid], playerid, giveplayer, otherid, alevel);
		SendClientMessageToAll(COLOR_LB, str);
		pPremium[otherid] = alevel;
		format(str, sizeof(str), "4Server: 2%s(%i) has given premium membership to %s(%i) (Level %d)", pName[playerid], playerid, giveplayer, otherid, alevel);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4500, "~y~~h~You have received premium membership!");
		if(alevel == 2) BankMoney[otherid] += 1000000;
		format(tmp, sizeof(tmp), "Premium Level %d", alevel);
		AdminCommandLog("GIVEPREM", playerid, otherid, tmp);
		format(query, sizeof(query), "UPDATE players SET premium=%d,v_expired=%i,bmoney=%i WHERE reg_id=%d", alevel, months, BankMoney[otherid], pRegID[otherid]);
		MySQL_updateQuery(query);
	}
	else
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) has removed your premium membership.", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has removed "LG_E"%s(%i) "LB_E"premium membership.", pName[playerid], playerid, giveplayer, otherid);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2%s(%i) has removed %s(%i) premium membership", pName[playerid], playerid, giveplayer, otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4000, "~r~~h~Your premium membership has been revoked!");
		format(query, sizeof(query), "UPDATE players SET premium=0,v_expired=0,chat_color=0,id_color=0,speedboost=1.3 WHERE reg_id=%d", pRegID[otherid]);
		MySQL_updateQuery(query);
		SetPlayerArmour(otherid, 0.0);
		pChatColor[otherid] = 0;
		pIDColor[otherid] = 0;
		pPremium[otherid] = 0;
		if(speedBoost[otherid] != 0.0) speedBoost[otherid] = 1.3;
		DestroyDynamic3DTextLabel(admin3D[playerid]);
	}
	return true;
}
CMD:givetemppremium(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	new alevel, dayz;
	if(sscanf(params, "k<player_name>dd", otherid, alevel, dayz))
	{
		Usage(playerid, "/givetemppremium <ID/Name> <level 1-3> <days>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(alevel > 3)
		return Error(playerid, "Level can't be higher than 3!");
	if(alevel < 0)
		return Error(playerid, "Level can't be lower than 0!");

	if(dayz > 31)
		return Error(playerid, "Days can't be longer than one month.");
	if(dayz < 0)
		return Error(playerid, "Days can't be lower than 0.");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(pLogged[otherid] == false)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) isn't logged in!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(pPremium[otherid] == alevel)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Player %s(%i) is already level %d premium!", giveplayer, otherid, alevel);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	iTemp = gettime() + 86400 * dayz;
	if(alevel == 3)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) set you as a "YELLOW_E"VIP Player "LB_E"for %d days.", pName[playerid], playerid, dayz);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has given "YELLOW_E"VIP "LB_E"membership to "LG_E"%s(%i) "LB_E"for %d days.", pName[playerid], playerid, giveplayer, otherid, dayz);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2%s(%i) has given VIP membership to %s(%i) for %d days.", pName[playerid], playerid, giveplayer, otherid, dayz);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4500, "~g~~h~You have received VIP membership!");
	}
	else if(alevel > 0)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) set you to a premium member (Level: %d) for %d days.", pName[playerid], playerid, alevel, dayz);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has given premium membership to "LG_E"%s(%i) "GREY_E"(Level %d) "LB_E"for %d days.", pName[playerid], playerid, giveplayer, otherid, alevel, dayz);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2%s(%i) has given premium membership to %s(%i) (Level %d)", pName[playerid], playerid, giveplayer, otherid, alevel, dayz);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4500, "~y~~h~You have received premium membership!");
	}
	else
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "LB_E"%s(%i) has removed your premium membership.", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_LB, str);
		format(str, sizeof(str), ""RED_E"** "LG_E"%s(%i) "LB_E"has removed "LG_E"%s(%i) "LB_E"premium membership.", pName[playerid], playerid, giveplayer, otherid);
		SendClientMessageToAll(COLOR_LB, str);

		format(str, sizeof(str), "4Server: 2%s(%i) has removed %s(%i) premium membership", pName[playerid], playerid, giveplayer, otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(otherid, 4000, "~r~~h~Your premium membership has been revoked!");
	}
	format(query, sizeof(query), "UPDATE players SET premium=%d,v_expired=%d WHERE reg_id=%d", alevel, iTemp, pRegID[otherid]);
	MySQL_updateQuery(query);
	pPremium[otherid] = alevel;
	premiumExpired[otherid] = iTemp;
	return true;
}

CMD:resetracerecord(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "s[24]", tmp))
	{
		Usage(playerid, "/resetracerecord <race> ");
		return true;
	}
	mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE racetimes SET holder='NONE',regid=-1,ms=0,time=0 WHERE race='%e'", tmp);
	MySQL_updateQuery(query);

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "GREY2_E"%s(%i) has reset the race record for %s.", pName[playerid], playerid, tmp);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"Race record for %s has been reset by an Administrator.", tmp);
	SendClientMessageToAll(COLOR_RED, str);

	return true;
}
