	format(str, sizeof(str), ""PARKOUR" Parkour '%s' is starting in 40 seconds! Type "LB_E"/parkour "LIME_E"to join!", CParkourName);
	SendClientMessageToAll(COLOR_LIME, str);

	format(str, sizeof(str), "~b~Parkour ~y~%s ~b~is starting. Type ~g~/parkour ~b~to race!", CParkourName);
