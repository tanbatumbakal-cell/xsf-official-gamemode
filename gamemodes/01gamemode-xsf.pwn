				if(MoneyBagStart != 0) 
				{
					SetPVarInt(playerid, "UnablePickMB",1); //make player unable to pick up the mb/cj
				}
				if(CookieJarStart != 0)
				{
					SetPVarInt(playerid, "UnablePickCJ",1); //make player unable to pick up the mb/cj
				}

			}
		}
