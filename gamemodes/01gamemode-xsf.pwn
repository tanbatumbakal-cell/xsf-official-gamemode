public OnPlayerModelSelection(playerid, response, listid, modelid)
{
	if(listid == skinlist)
	{
		if(response)
		{
			if(GetPlayerSkin(playerid) == modelid)
			{
				format(str, sizeof(str), "ERROR: "GREY2_E"You are already using skin ID %d!", modelid);
				SendClientMessage(playerid, COLOR_RED, str);
				return true;
			}
			if(InDM[playerid] == 13)
			{
				if(GetPVarInt(playerid, "Cop") != 0) return Error(playerid, "You can't change your skin as a cop!");
				if(modelid == 265 || modelid == 266 || modelid == 267 || modelid == 280 || modelid == 281 || modelid == 282 || modelid == 283 || modelid == 284 || modelid == 285 || modelid == 286 || modelid == 287 || modelid == 288)
					return Error(playerid, "You can't choose a cop skin as a robber!");
			}
			if(InDM[playerid] == 13) SetPVarInt(playerid, "CnRSkin", modelid) ,SendClientMessage(playerid,-1,"debug #1");
			new oldskin = GetPlayerSkin(playerid);
			SendClientMessage(playerid,-1,"debug #2");
			SetPlayerSkin(playerid, modelid);
			SendClientMessage(playerid,-1,"debug #3");
			HideModelSelectionMenu(playerid);
			SendClientMessage(playerid,-1,"debug #4");
			pInfo[playerid][pSaveSkin] = modelid;
			SendClientMessage(playerid,-1,"debug #5");
			format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have changed your skin to %d (skin before: %d)", modelid, oldskin);
			SendClientMessage(playerid, COLOR_GREY, str);
			SendClientMessage(playerid,-1,"debug #6");
			SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Use /saveskin to save your selected skin!");
		}
		return 1;
	}
	if(listid == toyslist)
	{
		if(response)
		{
			if(pCash[playerid] < 20000)
			{
				Error(playerid, "You don't have enough money to purchase this, each toy costs $20,000!");
				return 1;
			}
			GivePlayerCash(playerid, -20000);
			if(!PurchasedToy[playerid]) MySQL_CreatePlayerToy(playerid);

			SendClientMessage(playerid, COLOR_GREEN, ""SERVER_INITIALS" "GREEN_E"Purchased toy for $20,000!");
			pToys[playerid][toySelected[playerid]][toy_model] = modelid;
			HideModelSelectionMenu(playerid);
			new finstring[750];
			strcat(finstring, ""dot"Spine\n"dot"Head\n"dot"Left upper arm\n"dot"Right upper arm\n"dot"Left hand\n"dot"Right hand\n"dot"Left thigh\n"dot"Right thigh\n"dot"Left foot\n"dot"Right foot");
			strcat(finstring, "\n"dot"Right calf\n"dot"Left calf\n"dot"Left forearm\n"dot"Right forearm\n"dot"Left clavicle\n"dot"Right clavicle\n"dot"Neck\n"dot"Jaw");
			ShowPlayerDialog(playerid, TOY_DIALOG + 3, DIALOG_STYLE_LIST, ""WHITE_E"Select Bone", finstring, "Select", "Cancel");
		}
		return 1;
	}
	return 1;
}
public OnPlayerModelSelectionEx(playerid, response, extraid, modelid)
{
	if(extraid == VEHICLE_MENU)
	{
		if(response)
		{
			switch(modelid)
			{
				case 592, 577, 493, 452, 446, 519, 453, 484, 553: // Models not allowed near spawn.
				{
					if(IsPlayerInRangeOfPoint(playerid, 85.0, 376.6497, 2506.7773, 16.6647)
					|| IsPlayerInRangeOfPoint(playerid, 85.0, -2629.5991, 1357.5739, 7.1000)
					|| IsPlayerInRangeOfPoint(playerid, 85.0, -1208.9193, 26.1246, 13.9543)
					|| IsPlayerInRangeOfPoint(playerid, 85.0, 2155.2126, 1677.7125, 10.2580)) // AA, SF, SFAIR, LV
					{
						SendClientMessage(playerid, COLOR_GREY2, ""RED_E"Server: "GREY2_E"You can't spawn this vehicle near the spawnzone!");
						ShowVehicleMenu(playerid);
						return true;
					}
				}
			}
			format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"You have spawned a "LB2_E"%s.", vehName[modelid - 400]);
			SendClientMessage(playerid, COLOR_YELLOW, str);
			SpawnPlayerVehicle(playerid, modelid);
			HideModelSelectionMenu(playerid);
		}
		else ShowVehicleMenu(playerid);
		return 1;
	}
	return 1;
}
CMD:canceltd(playerid) return CancelSelectTextDraw(playerid); //LOL
// Event System
function EventDialog(playerid) {
	if(EventDialogPlayer) {
		ClosePlayerDialog(playerid);
		EventDialogPlayer = false;
	}
}

CMD:event(playerid)
{
	if(pAdmin[playerid] == 0)
		if(pPremium[playerid] != 3)
			if(!(Helper[playerid] == 1 || Helper[playerid] == 3))
				return Error(playerid, "You are not authorized to use this command!");

	if(AFK[playerid])
		return Error(playerid, "You can't start events whilst you're afk!");
 	if(InDM[playerid] != 0 || InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 || RaceParticipant[playerid] != 0)
	{
		Error(playerid, "You can't start events while in a DM/Race/Event!");
		return true;
	}
	if(PUBG[Start] >=1) return SendClientMessage(playerid,-1,"{FF0000}ERROR: "GREY2_E" There is a PUBG Event going on, Use /endpubg to end");
	
	if(!CanPlayerTeleport(playerid)) return true;
	if(EventGoingOn == 1) return Error(playerid, "There is an event going on now, if you want to force end it, use: /endevent.");
	if(EventGoingOn == 2) return Error(playerid, "There is a derby going on now, if you want to force end it, use: /endderby.");
	if(EventGoingOn >= 3) return Error(playerid, "There is an event going on now.");
	if(CSEvent == true) return Error(playerid, "There is a event going on now.");
	if(EventDialogPlayer) return Error(playerid, "Someone is currently starting an event.");

	if((gettime() < (lastEventTime + 900)) && pAdmin[playerid] < 2)
	{
		new seconds = lastEventTime + 900 - gettime();
		new minutes = seconds / 60;
		SendClientMessage(playerid, -1, str);

		if(seconds >= 60)
			seconds -= (minutes * 60);

		Error(playerid, "You can only start an event every 15 minutes!");
		format(str, sizeof(str), ""RED_E"*Time Left: %d minutes and %d seconds", minutes, seconds);
		SendClientMessage(playerid, -1, str);
		return 1;
	}

	SendClientMessage(playerid, COLOR_YELLOW, ""LB_E"Event Commands:");
	SendClientMessage(playerid, COLOR_YELLOW, ""RED_E"Server: "YELLOW_E"/event - Opens up event dialog.");
	SendClientMessage(playerid, COLOR_YELLOW, ""RED_E"Server: "YELLOW_E"/eventplayers - Shows a list of players for the event, useful when last player isnt awarded.");
	SendClientMessage(playerid, COLOR_YELLOW, ""RED_E"Server: "YELLOW_E"/eventkick - remove a player from the event.");
	SendClientMessage(playerid, COLOR_YELLOW, ""RED_E"Server: "YELLOW_E"/endevent - End the event and respawn all event players.");
	ShowPlayerDialog(playerid, EVENTMENU, DIALOG_STYLE_LIST, "Select Event Type:", ""LG_E"Cage Fight\n"LB_E"Field Fight\n"GREEN_E"Counter Strike\n"RED_E"====== Disabled Events ======\n"PINK_E"Derby\n"RED_E"Kill the president", "Select", "Cancel");
	EventDialogPlayer = true;
	EventDialogTimer = SetTimerEx("EventDialog", 60000, false, "i", playerid);
	return 1;
}

CMD:togeventann(playerid)
{
	if(pEventDialog[playerid])
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have disabled event pop-ups.");
		pEventDialog[playerid] = false;
	}
	else
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have enabled event pop-ups.");
		pEventDialog[playerid] = true;
	}
	return 1;
}

CMD:je(playerid)
{
	if(EventStarted == 1) return Error(playerid, "The event has already started, wait for the next one!");
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't join an event while in a DM! Type /leave to exit.");
		return true;
	}
	if(RaceParticipant[playerid] != 0)
	{
		Error(playerid, "You can't join an event while in a race! Type /leave to exit.");
		return true;
	}
	if(doingStunt[playerid] != 0) return Error(playerid, "Teleport out of the stunt area to join the event!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You are already in/signup for the event!");
	if(InDerby[playerid] == 1) return Error(playerid, "You are already in the derby!");
	{
		if(DerbyEvent == 1)
		{
			if(PlayersJoined >= 30)
			{
				SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the derby, it has reached its max players!");
				return 1;
			}
			if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
			DerbyPlayers ++;
			PlayersJoined ++;
			SavePlayerPosition(playerid);
			InDM[playerid] = 0;
			InEvent[playerid] = 1;
			InDerby[playerid] = 1;
			canUseKey[playerid] = false;
			SetPlayerHealth(playerid, 98);
			SetPlayerArmour(playerid, 0);
			if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour"))
			{
				SetPlayerArmour(playerid, 50.0);
			}
			doingStunt[playerid] = 10;
			canUseKey[playerid] = false;
			ResetPlayerWeapons(playerid); //Reset player weps for preset weps
			SetPlayerVirtualWorld(playerid, DERBY_EVENT);
			SetPlayerInterior(playerid, 15);
			SpawnPlayerVehicle(playerid, 504, false);
			switch(PlayersJoined)
			{
				case 1: SetPlayerVehiclePosition(playerid, -1488.1256,949.1411,1036.6194,297.5553, 15);
				case 2: SetPlayerVehiclePosition(playerid, -1362.8999,933.5988,1036.1342,23.3681, 15);
				case 3: SetPlayerVehiclePosition(playerid, -1349.8529,935.2669,1036.1560,32.4713, 15);
				case 4: SetPlayerVehiclePosition(playerid, -1335.5823,938.9312,1036.1941,31.1500, 15);
				case 5: SetPlayerVehiclePosition(playerid, -1325.5938,943.7802,1036.2595,39.3955, 15);
				case 6: SetPlayerVehiclePosition(playerid, -1313.4254,947.1619,1036.2922,52.4681, 15);
				case 7: SetPlayerVehiclePosition(playerid, -1304.0629,953.8312,1036.3864,58.3115, 15);
				case 8: SetPlayerVehiclePosition(playerid, -1296.4813,962.0264,1036.5059,72.1897, 15);
				case 9: SetPlayerVehiclePosition(playerid, -1290.1943,969.6625,1036.6246,72.8792, 15);
				case 10: SetPlayerVehiclePosition(playerid, -1283.6609,979.6376,1036.7775,82.5839, 15);
				case 11: SetPlayerVehiclePosition(playerid, -1280.6968,989.5144,1036.9431,87.6460, 15);
				case 12: SetPlayerVehiclePosition(playerid, -1279.2401,1002.4561,1037.1532,96.0138, 15);
				case 13: SetPlayerVehiclePosition(playerid, -1281.6422,1015.3014,1037.3744,102.9361, 15);
				case 14: SetPlayerVehiclePosition(playerid, -1287.0018,1024.9601,1037.5450,114.3087, 15);
				case 15: SetPlayerVehiclePosition(playerid, -1295.3719,1033.2085,1037.6958,119.4922, 15);
				case 16: SetPlayerVehiclePosition(playerid, -1303.0917,1039.0343,1037.8093,135.9668, 15);
				case 17: SetPlayerVehiclePosition(playerid, -1313.4579,1045.2555,1037.9233,139.1304, 15);
				case 18: SetPlayerVehiclePosition(playerid, -1515.6333,1007.5107,1037.6437,270.4684, 15);
				case 19: SetPlayerVehiclePosition(playerid, -1511.8466,1017.7837,1037.8105,253.8732, 15);
				case 20: SetPlayerVehiclePosition(playerid, -1507.8835,1026.1284,1037.9445,241.2056, 15);
				case 21: SetPlayerVehiclePosition(playerid, -1501.7307,1033.5645,1038.0581,241.0603, 15);
				case 22: SetPlayerVehiclePosition(playerid, -1493.4902,1039.7646,1038.1462,231.3743, 15);
				case 23: SetPlayerVehiclePosition(playerid, -1484.2012,1044.1748,1038.2067,233.9687, 15);
				case 24: SetPlayerVehiclePosition(playerid, -1475.5778,1049.3048,1038.2806,225.7470, 15);
				case 25: SetPlayerVehiclePosition(playerid, -1463.8635,1053.8461,1038.3282,216.7622, 15);
				case 26: SetPlayerVehiclePosition(playerid, -1453.7533,1056.5852,1038.3519,201.1941, 15);
				case 27: SetPlayerVehiclePosition(playerid, -1498.2275,957.3856,1036.7869,324.0452, 15);
				case 28: SetPlayerVehiclePosition(playerid, -1505.9064,963.1046,1036.8960,323.1812, 15);
				case 29: SetPlayerVehiclePosition(playerid, -1513.2411,972.3434,1037.0609,311.6987, 15);
				case 30: SetPlayerVehiclePosition(playerid, -1518.8619,982.3945,1037.2379,297.7285, 15);
				case 31: SetPlayerVehiclePosition(playerid, -1520.8704,992.4912,1037.4166,279.5745, 15);
			}
			vID = GetPlayerVehicleID(playerid);
			SetVehicleVirtualWorld(vID, DERBY_EVENT);
			SetPVarInt(playerid, "DerbyVeh", 1);
			GivePlayerWeapon(playerid, 29, 6000); //MP5
			SendClientMessage(playerid, COLOR_GREY, "{F42626}[DERBY]"GREY_E" You have joined the Derby event, you must eliminate all players till your in the last vehicle standing.");
			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You will be frozen until the event starts.");
			format(tmp, sizeof(tmp), "2,9EVENT3 %s(%i) has entered the event, type /je ingame to join.", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
			if(pAdmin[playerid] == 0 && pPremium[playerid] == 0) TogglePlayerControllable(playerid, false);
			GodModeLabel(playerid, false);
			foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, true);
			if(GetPVarInt(playerid, "HideObjects"))
			{
				DeletePVar(playerid, "HideObjects");
				Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
			}
			return 1;
		}
	}
	//------------------------- Cage Fight----------------------------------
	if(CageFight == 1)
	{
			if(NumEventPlayers >= 20)
			{
				SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the event, it has reached its max players (20)!");
				return 1;
			}
			if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
			SavePlayerPosition(playerid);
			InDM[playerid] = 22;
			SetPlayerVirtualWorld(playerid, CAGEFIGHT_EVENT);
			SetPlayerInterior(playerid, 0);
			canUseKey[playerid] = false;
			if(EventWeap == 12)
			{
				SetPlayerHealth(playerid, 10);
				SetPlayerArmour(playerid, 0);
			}
			else if(EventWeap == 1 || EventWeap == 2 || EventWeap == 3 || EventWeap == 4 || EventWeap == 5 || EventWeap == 6 || EventWeap == 7 || EventWeap == 8 || EventWeap == 9 || 				EventWeap == 10 || EventWeap == 11 || EventWeap == 13)
			{
				SetPlayerHealth(playerid, 98);
				SetPlayerArmour(playerid, 0);
				if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour"))
				{
					SetPlayerArmour(playerid, 50.0);
				}
			}
			NumEventPlayers ++;//counter
			ResetPlayerWeapons(playerid); //Reset player weps for preset weps
			GiveEventWeapons(playerid);
			SetCameraBehindPlayer(playerid);
			InEvent[playerid] = 1;
			SendClientMessage(playerid, COLOR_GREY2, ""EVENT""GREY_E" You have joined the cage fight event, you must eliminate all players till your the last man standing.");
			SendClientMessage(playerid, COLOR_GREY2, ""SERVER_INITIALS" "GREY_E"You will be frozen until the event starts.");
			format(tmp, sizeof(tmp), "2,9EVENT3 %s(%i) has entered the event, type /je ingame to join.", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
			format(str, sizeof(str), "**[Event]** %s(%i) has entered the event, type /je ingame to join.", pName[playerid], playerid);
			foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, true);
			//DCC_SendChannelMessage(Channel_Echo, str);
			switch(random(4))
			{
				case 0: SetPlayerPosition(playerid, 2747.1348 + (random(3) - random(3)), -1767.6613 + (random(3) - random(3)), 79.1520, 90.0783);
				case 1: SetPlayerPosition(playerid, 2734.7717 + (random(3) - random(3)), -1780.1125 + (random(3) - random(3)), 79.1520, 0.4746);
				case 2: SetPlayerPosition(playerid, 2723.0344 + (random(3) - random(3)), -1764.4871 + (random(3) - random(3)), 79.1520, 268.8864);
				case 3: SetPlayerPosition(playerid, 2735.1377 + (random(3) - random(3)), -1754.1909 + (random(3) - random(3)), 79.1520, 177.7672);
			}
			SetPlayerWorldBounds(playerid, 2828.125,2632.8125,-1664.0625,-1855.46875);
			if(pAdmin[playerid] == 0 && pPremium[playerid] == 0) TogglePlayerControllable(playerid, false);
			GodModeLabel(playerid, false);
			return 1;
	}
	else if(CageFight == 2)
	{
		if(NumEventPlayers >= 30)
		{
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the event, it has reached its max players! Watch the event using /watchevent.");
			return 1;
		}
		NumEventPlayers++;
		SavePlayerPosition(playerid);
		switch(random(4))
		{
			case 0: SetPlayerPosition(playerid, 1306.2388 + (random(3) - random(3)), 2192.3354 + (random(3) - random(3)), 11.0234, 224.4649);
			case 1: SetPlayerPosition(playerid, 1307.7892 + (random(3) - random(3)), 2111.2991 + (random(3) - random(3)), 11.0156, 317.0949);
			case 2: SetPlayerPosition(playerid, 1387.0259 + (random(3) - random(3)), 2109.4526 + (random(3) - random(3)), 11.0156, 49.8795);
			case 3: SetPlayerPosition(playerid, 1383.7898 + (random(3) - random(3)), 2185.4229 + (random(3) - random(3)), 11.0234, 139.9720);
		}
		if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
		InDM[playerid] = 22;
		SetPlayerVirtualWorld(playerid, CAGEFIGHT_EVENT);
		SetPlayerInterior(playerid, 0);
		SetPlayerHealth(playerid, 98);
		SetPlayerArmour(playerid, 0);
		canUseKey[playerid] = false;
		if(EventWeap == 12)
		{
			SetPlayerHealth(playerid, 10);
			SetPlayerArmour(playerid, 0);
		}
		else if(EventWeap == 1 || EventWeap == 2 || EventWeap == 3 || EventWeap == 4 || EventWeap == 5 || EventWeap == 6 || EventWeap == 7 || EventWeap == 8 || EventWeap == 9 || 					EventWeap == 10 || EventWeap == 11 || EventWeap == 13)
		{
			SetPlayerHealth(playerid, 98);
			SetPlayerArmour(playerid, 0);
			if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour"))
			{
				SetPlayerArmour(playerid, 50.0);
			}
		}
		SetPlayerWorldBounds(playerid, 1427.634, 1244.106, 2227.527, 2065.068);
		ResetPlayerWeapons(playerid);
		GiveEventWeapons(playerid);
		SetPlayerCameraPos(playerid, 1396.226684, 2097.452636, 24.608520);
		SetPlayerCameraLookAt(playerid, 1393.114746, 2100.938476, 22.829599);
		InEvent[playerid] = 2;
		SendClientMessage(playerid, COLOR_GREY, ""EVENT""GREY_E" You have joined the field fight event, you must eliminate all players till your the last man standing.");
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You will be frozen until the event starts.");
		format(tmp, sizeof(tmp), "2,9EVENT3 %s(%i) has entered the field fight, type /je ingame to join.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
		format(str, sizeof(str), "**[Event]** %s(%i) has entered the field fight, type /je ingame to join.", pName[playerid], playerid);
		//DCC_SendChannelMessage(Channel_Echo, str);
		if(pAdmin[playerid] == 0 && pPremium[playerid] == 0) TogglePlayerControllable(playerid, false);
		GodModeLabel(playerid, false);
		if(GetPVarInt(playerid, "HideObjects"))
		{
			DeletePVar(playerid, "HideObjects");
			Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
		}
 		foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, true);
	}
	if(IsKTP[playerid] == 1) return Error(playerid, "You are already signed to the KTP event!");
	if(EventGoingOn == 3)
	{
		if(playerid == President) return Error(playerid, "You are already signed to the KTP event! 'President'");
		for(new i = 0; i < 3; i++) if(playerid == Guards[i]) return Error(playerid, "You are already signed to the KTP event! 'Guard'");
		if(NumEventPlayers >= 30)
		{
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the event, it has reached its max players! Watch the event using /watchevent.");
			return 1;
		}
		NumEventPlayers++;
		SavePlayerPosition(playerid);
		InEvent[playerid] = 1;
		IsKTP[playerid] = 1;
		SendClientMessage(playerid, COLOR_GREY, ""EVENT""GREY_E" You have joined the ktp event, you target is the president, so be reay.");
		format(str, sizeof(str), "**[Event]** %s(%i) has signed up to Kill the president event, type /je ingame to join.", pName[playerid], playerid);
		//DCC_SendChannelMessage(Channel_Echo, str);
		GodModeLabel(playerid, false);
		if(GetPVarInt(playerid, "HideObjects"))
		{
			DeletePVar(playerid, "HideObjects");
			Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
		}
	}
	if(CSEvent)
	{
		if(!Signingup) return Error(playerid, "The sigingup is closed for this event.");
		if(NumEventPlayers >= 60)
		{
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the event, it has reached its max players! Watch the event using /watchevent.");
			return 1;
		}
		NumEventPlayers++;
		SavePlayerPosition(playerid);
		SetPlayerVirtualWorld(playerid, CS_WORLD);
		SetPVarInt(playerid, "oldColor", GetPlayerColor(playerid));
		if((NumEventPlayers % 2) == 0)
		{

	        SetPlayerColor(playerid, 0xAA3333AA);
	        SetPlayerHealth(playerid, 97);
	        SetPlayerArmour(playerid, 0);

	       	if(GetPlayerPing(playerid) > 300) Streamer_UpdateEx(playerid, TerroristsPosX + float(random(1)), TerroristsPosY + float(random(1)), TerroristsPosZ+1.0);
	        SetPlayerPos(playerid, TerroristsPosX + float(random(1)), TerroristsPosY + float(random(1)), TerroristsPosZ+1.0);
	        TogglePlayerControllable(playerid, false);
			SetPlayerTeam(playerid, 2);
			SendClientMessage(playerid, COLOR_GREY, ""EVENT""GREY_E" You have joined the CounterStrike event, you target is to plant the bomb and to kill the counter terrorists.");
		}
		else
		{


	        SetPlayerColor(playerid, 0x0000BBAA);
	        SetPlayerHealth(playerid, 97);
	        SetPlayerArmour(playerid, 0);

	      	if(GetPlayerPing(playerid) > 300) Streamer_UpdateEx(playerid, CTerroristsPosX + float(random(1)), CTerroristsPosY, CTerroristsPosZ+1.0);
	        SetPlayerPos(playerid, CTerroristsPosX + float(random(1)), CTerroristsPosY, CTerroristsPosZ+1.0);
	        TogglePlayerControllable(playerid, false);
			SetPlayerTeam(playerid, 1);
			SendClientMessage(playerid, COLOR_GREY, ""EVENT""GREY_E" You have joined the CounterStrike event, you target is to defuse the bomb (if planted) and to kill the terrorists.");
		}

		InEvent[playerid] = true;
		format(str, sizeof(str), "**[Event]** %s(%i) has signed up to CounterStrike event, type /je ingame to join.", pName[playerid], playerid);
		//DCC_SendChannelMessage(Channel_Echo, str);
		GodModeLabel(playerid, false);
		if(GetPVarInt(playerid, "HideObjects"))
		{
			DeletePVar(playerid, "HideObjects");
			Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no events at the moment.");

	return 1;
}
CMD:eventplayers(playerid)
{
	if(EventGoingOn == 0) return Error(playerid, "There is no event going on right now!");
	new eParticipants = 0;
	foreach(new ii : Player)
	{
		if(InEvent[ii] == 0) continue;
		eParticipants++;
		format(str, sizeof(str), "%d. %s(%i)", eParticipants, pName[ii], ii);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	format(str, sizeof(str), ""RED_E"- "WHITE_E"Showing a list of total %d participant(s) in the event", eParticipants);
	SendClientMessage(playerid, COLOR_WHITE, str);

	SetTimer("EndEventCheck", 1000, 0);
	SetTimer("EndDerbyCheck", 2000, 0);
	return true;
}
CMD:derbyplayers(playerid)
{
	if(!IsDerbyRunning)
		return Error(playerid, "There is no derby going on right now!");
	new dParticipants = 0;
	foreach(new ii : Player)
	{
		if(doingStunt[ii] != 19) continue;
		dParticipants = dParticipants + 1;
	}

	format(str, sizeof(str), ""SERVER_INITIALS" Showing a list of total %d participant(s) in the DERBY:", dParticipants);
	SendClientMessage(playerid, COLOR_WHITE, str);

	dParticipants = 0;
	foreach(new ii : Player)
	{
		if(doingStunt[ii] != 19) continue;
		dParticipants = dParticipants + 1;
		format(str, sizeof(str), "%d. %s(%i)", dParticipants, pName[ii], ii);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	SetTimer("EndEventCheck", 1000, 0);
	SetTimer("EndDerbyCheck", 2000, 0);
	return true;
}
CMD:endevent(playerid)
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	if(EventGoingOn == 0 && !CSEvent)
		return Error(playerid, "There is no event going on right now!");
	if(EventGoingOn != 0)
	{
		end_Event();

		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has ended the event.", pName[playerid], playerid);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"The event has been ended by an Administrator.");
		SendClientMessageToAll(COLOR_RED, str);
	}
	else if(CSEvent)
	{
	    CSEvent = false;
	    IsBombPlanter = INVALID_PLAYER_ID;
	    IsBombPlanted = false;
	    TimeleftVal = 305;
	    Signingup = false;
	    EventStarted = false;
	    EventGoingOn = false;
	    NumEventPlayers = 0;

	    foreach(new i : Player)
	    {
	        if(!InEvent[i]) continue;
	        if(GetPlayerTeam(i) == 0) continue;
	        SpawnPlayer(i);
	        SetPlayerVirtualWorld(i, 0);
	        SetPlayerColor(i, GetPVarInt(i, "oldColor"));
	        DeletePVar(i, "givenByAdmin");
	    }
	    Auto_Start_Var = -1;
	    KillTimer(SecTimer);
	    CSEvent = false;
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has ended the Counter Strike Event.", pName[playerid], playerid);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"The Counter Strike Event has been ended by an Administrator.");
		SendClientMessageToAll(COLOR_RED, str);
	}
	return 1;
}
CMD:endderby(playerid)
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	if(EventGoingOn != 2)
		return Error(playerid, "There is no derby going on right now!");

	end_Event();

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has ended the derby.", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"The derby has been ended by an Administrator.");
	SendClientMessageToAll(COLOR_RED, str);
	return 1;
}
CMD:cd(playerid)
{
	if(pAdmin[playerid] == 0)
		if(pPremium[playerid] == 0)
			return Error(playerid, "You are not authorized to use this command! Use /count instead.");
	if(RaceParticipant[playerid] > 0)
	{
		Error(playerid, "You can't start a countdown while in a race, please wait for the race to start.");
		return true;
	}
	if(Count != -1) return Error(playerid, "There is already a countdown in progress, wait for it to end!");

	Count = 6;
	countTimer = SetTimer("pCountDown", 1000, 1);

	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] == 0 && InDM[ii] == 0 && doingStunt[ii] == 0 && InEvent[ii] == 0) showCD[ii] = 1;
	}

	format(str, sizeof(str), ""RED_E"*** "LB_E"{%06x}%s(%i) "LB_E"has started a global countdown!", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_LB, str);
	format(tmp, sizeof(tmp), "4Server:3 %s(%i) has started a global countdown.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	format(str, sizeof(str), "**[Countdown]** %s(%i) has started a global countdown.", pName[playerid], playerid);
	//DCC_SendChannelMessage(Channel_Echo, str);
	return 1;
}
CMD:countdown(playerid) return cmd_count(playerid);
CMD:count(playerid)
{
	if(RaceParticipant[playerid] > 0)
	{
		Error(playerid, "You can't start a countdown while in a race, please wait for the race to start.");
		return true;
	}

	if(GetPVarInt(playerid, "UsedCount") == 3)
	{
		Error(playerid, "You can only start countdowns 3 times per minute!");
		return true;
	}
	if(GetPVarInt(playerid, "UsedCount") == 0) SetTimerEx("ResetCount", 60000, false, "i", playerid);
	new counts = GetPVarInt(playerid, "UsedCount") + 1;
	SetPVarInt(playerid, "UsedCount", counts);
	if(Count != -1) return Error(playerid, "There is already a countdown in progress, wait for it to end!");

	Count = 6;
	countTimer = SetTimer("pCountDown", 1000, 1);
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	foreach(new ii : Player)
	{
		if(IsPlayerInRangeOfPoint(ii, 25.0, POS[0], POS[1], POS[2])) showCD[ii] = 1;
	}
	format(str, sizeof(str), ""WHITE_E"*** {%06x}%s(%i) "LB_E"has started a countdown!", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_LB, str);
	format(tmp, sizeof(tmp), "4Server:3 %s(%i) has started a countdown in their area.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	format(str, sizeof(str), "**[Countdown]** %s(%i) has started a countdown in their area.", pName[playerid], playerid);
	//DCC_SendChannelMessage(Channel_Echo, str);
	return true;
}

CMD:stopcount(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	Count = -1;
	KillTimer(countTimer);
	format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has stopped the current countdown!", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	return true;
}

CMD:nobodyhatesmeee(playerid) {

	if(GetPVarInt(playerid, "GabieHatesMe") > gettime())
		return Error(playerid, "You are dead to Gabie.");

	if(doingStunt[playerid])
		return Error(playerid, "You can't use this command right now!");
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't use this command in a DM zone!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
		return Error(playerid, "You can't use this command in an event!");

	PlayerPlaySound(playerid, 3200, 0.0, 0.0, 0.0);
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
		SetPlayerVelocity(playerid, random(5)+999,random(5)+999,random(5)+100); // Forces the player to jump (Z velocity + 0.2)
	else
		SetVehicleVelocity(GetPlayerVehicleID(playerid), random(5)+999, random(5)+999, random(5)+100);

			//CreateExplosion(x, y, z, 1, 10.0);
	SetPlayerDrunkLevel (playerid, random(50000));

	switch(random(3))
	{
		case 0: PlayerPlaySound(playerid, 3200, 0.0, 0.0, 0.0);
		case 1: PlayerPlaySound(playerid, 3200, 0.0, 0.0, 0.0);
		case 2: PlayerPlaySound(playerid, 3200, 0.0, 0.0, 0.0);
		case 3: PlayerPlaySound(playerid, 3200, 0.0, 0.0, 0.0);
	}

	SetPVarInt(playerid, "GabieHatesMe", gettime() + 60);
	SetTimerEx("GabieHatesMe", 2700, false, "i", playerid);
	return 1;
}

function GabieHatesMe(playerid) {
	SetPlayerHealth(playerid, 0.0);
	SetPlayerDrunkLevel(playerid, 0);
	TogglePlayerSpectating(playerid, 1);
	TogglePlayerSpectating(playerid, 0);
	return 1;
}

