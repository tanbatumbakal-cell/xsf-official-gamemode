CMD:ask(playerid,params[]) return cmd_question(playerid,params);
CMD:question(playerid, params[])
{
	if(isnull(params))
	{
		Usage(playerid, "/question <your question>");
		return true;
	}
	if(GetPVarInt(playerid, "UsedAsk") == 2) return Error(playerid, "You can only ask questions 2 times per minute!");

    if(strlen(params) > 100)
	{
		Error(playerid, "Too long, keep your question below 100 characters.");
		return true;
	}
	format(tmp, sizeof(tmp), ""RED_E"*** "SBLUE_E"%s(%d) has asked a question!", pName[playerid], playerid);
	format(str, sizeof(str), ""RED_E"*** "SBLUE_E"Question: %s", params);
	SetPVarInt(playerid, "askedQuestion", 1);
	foreach(new i : Player)
	{
		if(Helper[i] > 0 || pAdmin[i] > 0)
		{
			SendClientMessage(i, COLOR_SBLUE, tmp);
			SendClientMessage(i, COLOR_SBLUE, str);
			PlayerPlaySound(i, 1057, 0.0, 0.0, 0.0);
			if(GetPVarInt(i, "infoSent") == 0)
			{
				SetPVarInt(i, "infoSent", 1);
				Info(i, "Type /reply <ID/Name> to answer this player-generated question");
			}
		}
	}
	if(GetPVarInt(playerid, "UsedAsk") == 0) SetTimerEx("ResetAsk", 60000, false, "i", playerid);
	new counts = GetPVarInt(playerid, "UsedAsk") + 1;
	SetPVarInt(playerid, "UsedAsk", counts);
	SendClientMessage(playerid, COLOR_WHITEP,""RED_E"Server: "WHITEP_E"Your question has been sent to the server helpers. Please wait for a response!");
	format(str, sizeof(str), ""RED_E"%s(%d): "SBLUE_E"%s",pName[playerid], playerid, params);
	for(new ir = 1; ir < MAX_QUESTIONS - 1; ir++)
	{
		Questions[ir] = Questions[ir + 1];
	}
	Questions[MAX_QUESTIONS - 1] = str;
	return true;
}

CMD:checkquestions(playerid) return cmd_questions(playerid);
CMD:questions(playerid)
{
	if(pAdmin[playerid] < 1 && Helper[playerid] <= 0)
		return Error(playerid, "You are not authorized to use this command!");
	new bigStr[600], QCount;
	strcat(bigStr, ""RED_E"Recent Questions:\n\n"WHITE_E"");
	for(new i = 1; i < MAX_QUESTIONS; i++)
	{
		if(strcmp(Questions[i], "none", false) != 0)
		{
			QCount++;
			format(str, sizeof(str), "%s\n", Questions[i]);
			strcat(bigStr, str);
		}
	}
	if(QCount == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "There hasn't been any questions!");
	}
	else ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Recent Questions", bigStr, "OK", "");
	return 1;
}

CMD:reply(playerid, params[])
{
	if(Helper[playerid] == 0 && pAdmin[playerid] == 0)
		return Error(playerid, "You are not authorized to use this command!");
	new largeString[144];
	if(sscanf(params, "k<player_name>s[143]", otherid, largeString))
	{
		Usage(playerid, "/reply <ID/Name> <Answer>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(!GetPVarInt(otherid, "askedQuestion"))
		return Error(playerid, "This player hasn't asked a question or their question has already been answered!");

	if(strlen(largeString) > 120)
	{
		Error(playerid, "Answer can't be longer than 120 characters!");
		return true;
	}

	if(!pHidden[playerid])
		format(str, sizeof(str), ""RED_E"*** "SBLUE_E"%s(%d) has answered your question!", pName[playerid], playerid);
	else
	    format(str, sizeof(str), ""RED_E"*** "SBLUE_E"An administrator has answered your question!");

	SendClientMessage(otherid, COLOR_SBLUE, str);
	format(str, sizeof(str), ""RED_E"*** "SBLUE_E"Answer: %s", largeString);
	AdminCommandLog("ANSWER", playerid, otherid, largeString);
	SendClientMessage(otherid, COLOR_SBLUE, str);
	DeletePVar(otherid, "askedQuestion");
	foreach(new i : Player)
	{
		if(Helper[i] > 0 || pAdmin[i] >0)
		{
			format(str, sizeof(str), ""RED_E"*** "SBLUE_E"%s(%d) has replied to %s(%d)'s question!", pName[playerid], playerid, pName[otherid], otherid);
			SendClientMessage(i, COLOR_SBLUE, str);
			format(str, sizeof(str), ""RED_E"*** "SBLUE_E"Answer: %s", largeString);
			SendClientMessage(i, COLOR_SBLUE, str);

		}
	}

	PlayerPlaySound(otherid, 1057, 0.0, 0.0, 0.0);
	SendClientMessage(playerid, COLOR_WHITEP,""RED_E"Server: "WHITEP_E"Your answer has been sent to the player, thanks for assisting!");
	return true;
}

CMD:clear(playerid, params[]) return cmd_clearchat(playerid, params);
CMD:clearchat(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	for(new ii = 0; ii < 100; ii++)
		{
			SendClientMessageToAll(COLOR_WHITE,"");
		}




	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has cleared the chat!", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"Chat has been cleared by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server: 2%s(%i) cleared the chat", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}
CMD:clearmychat(playerid)
{
	for(new ii = 0; ii < 100; ii++)
	{
		SendClientMessage(playerid, COLOR_SYSTEM, " ");
		GameTextForPlayer(playerid, "~p~Chat cleared!", 1000, 1);
	}
	return true;
}
CMD:disarm(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/disarm <ID/Name>");
		return true;
	}

	if(!IsPlayerConnected(otherid))
		return Error(playerid, "Player not connected!");


	ResetPlayerWeapons(otherid);

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has disarmed %s(%i)", pName[playerid], playerid, pName[otherid], otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been disarmed by an Administrator.", pName[otherid], otherid);
	SendClientMessageToAllEx(otherid, COLOR_RED, str);

	SendClientMessage(playerid, COLOR_YELLOW2, "- AS - "WHITE_E"^ The above message has been sent to everyone except the disarmed player");
	format(str, sizeof(str), "4Server: 2%s(%i) has disarmed %s(%i)", pName[playerid], playerid, pName[otherid], otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

IsValidRaceVehicle(modelid)
{
	switch(modelid)
	{
		case 592, 577, 511, 512, 593, 520, 553, 476, 519, 460, 513, 548, 425, 417, 487, 488, 497, 563, 447, 469, 472, 473, 493, 595,
			 484, 430, 453, 452, 446, 454, 524, 578, 455, 403, 443, 514, 515, 531, 408, 456, 433, 431, 437, 432, 601, 532, 486, 406: return false;
	}
	return true;
}

function raceTimeOver()
{
	if(RaceActive == 0) return true;

	format(str, sizeof(str), ""RACE" Race '%s' has ended. (times up)", CRaceName);
	SendClientMessageToAll(COLOR_WHITEP, str);
	format(str, sizeof(str), "2,9RACE7,0 Race '%s' has ended. (time over)", CRaceName);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	endrace();
	return true;
}

function parkourTimeOver()
{
	if(ParkourActive == 0) return true;

	format(str, sizeof(str), ""PARKOUR" Parkour '%s' has ended. (times up)", CParkourName);
	SendClientMessageToAll(COLOR_LIME, str);
	format(str, sizeof(str), "2,9PARKOUR7,0 Parkour '%s' has ended. (time over)", CParkourName);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	endparkour();
	return true;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(ParkourParticipant[playerid] != 0)
	{
		switch(ParkourParticipant[playerid])
		{
			case 0:
			{
				// Excludes all parkour builders from having conflicts with the system
				return true;
			}
			case 1:
			{
				if(ParkourStart == 0)
				{
					format(str, sizeof(str), ""PARKOUR" The parkour '%s' is starting in %d seconds. Stay by the checkpoint.", CParkourName, pmscd);
					SendClientMessage(playerid, COLOR_LIME, str);
					ParkourParticipant[playerid] = 2;
				}
			}
			case 6:
			{
				ParkourParticipant[playerid] = 0;
				doingStunt[playerid] = 0;
				PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
				new rankz[8];
				switch(pRanking)
				{
					case 1:
					{
						rankz = "first";

						GivePlayerCash(playerid, 30000);
						GivePlayerScore(playerid, 4);
						GivePlayerCookie(playerid, 1);
						pInfo[playerid][pRacesWon]++;
					
						InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished first!~n~~b~~h~~h~$30000, +4 score and +1 cookie.");
						format(query, sizeof(query), "UPDATE players SET parkours_won=parkours_won+1 WHERE reg_id=%d", pRegID[playerid]);
						MySQL_updateQuery(query);
						UpdateGroupScore(pGroupID[playerid], 2);
					}
					case 2:
					{
						rankz = "second";

						GivePlayerCash(playerid, 15000);
						GivePlayerScore(playerid, 3);

						InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished second!~n~~b~~h~~h~$15000 and 3 points earned.");
					}
					case 3:
					{
						rankz = "third";

						GivePlayerCash(playerid, 7500);
						GivePlayerScore(playerid, 2);

						InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished third!~n~~b~~h~~h~$7500 and 2 points earned.");
					}
					case 4: rankz = "4th";
					case 5: rankz = "5th";
					case 6: rankz = "6th";
					case 7: rankz = "7th";
					case 8: rankz = "8th";
					case 9: rankz = "9th";
					case 10: rankz = "10th";
					case 11: rankz = "11th";
					case 12: rankz = "12th";
					case 13: rankz = "13th";
					case 14: rankz = "14th";
					case 15: rankz = "15th";
					case 16: rankz = "16th";
					case 17: rankz = "17th";
					case 18: rankz = "18th";
					case 19: rankz = "19th";
					case 20: rankz = "20th";
				}

				if(pRanking > 3)
				{
					format(tmp, sizeof(tmp), "~g~~h~~h~You finished %s!", rankz);
					InfoTD_MSG(playerid, 10000, tmp);
				}

				new ParkourTime = GetTickCount() - Parkour_StartTick;
				// Calculate milliseconds into minutes, seconds and milliseconds
				// minute = minutes, second = seconds, racingTime = remaining milliseconds (before was total milliseconds), hour = total milliseconds
				hour = ParkourTime;
				minute = ParkourTime / 60000;
				ParkourTime = ParkourTime - (minute * 60000);
				second = ParkourTime / 1000;
				ParkourTime = ParkourTime - (second * 1000);


				if(minute == 0)
				{
					format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has finished %s in %02d.%03d seconds", pName[playerid], playerid, rankz,  second, ParkourTime);
					format(str, sizeof(str), ""PARKOUR" %s(%i) has finished %s in "YELLOW_E"%02d.%03d seconds.", pName[playerid], playerid, rankz,  second, ParkourTime);
				}
				else
				{
					if(minute == 1)
					{
						format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has finished %s in %d minute and %02d.%03d seconds", pName[playerid], playerid, rankz,  minute, second, ParkourTime);
						format(str, sizeof(str), ""PARKOUR" %s(%i) has finished %s in "YELLOW_E"%d minute and %02d.%03d seconds.", pName[playerid], playerid, rankz,  minute, second, ParkourTime);
					}
					else
					{
						format(tmp, sizeof(tmp), "2,9PARKOUR7,0 %s(%i) has finished %s in %d minutes and %02d.%03d seconds", pName[playerid], playerid, rankz,  minute, second, ParkourTime);
						format(str, sizeof(str), ""PARKOUR" %s(%i) has finished %s in "YELLOW_E"%d minutes and %02d.%03d seconds.", pName[playerid], playerid, rankz,  minute, second, ParkourTime);
					}
				}
				if(pRanking <= 7) SendClientMessageToAll(COLOR_LIME, str);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

				// Check if there's a new record for this parkour.
				if(hour < Parkour_RecordMS || !Parkour_RecordMS)
				{
					if(pTotalHours[playerid] >= 3 && pLogged[playerid] == true)
					{
						// Send fancy messages
						format(str, sizeof(str), ""PARKOUR" %s(%i) has made a new parkour record for "YELLOW_E"'%s'!", pName[playerid], playerid, CParkourName);
						SendClientMessageToAll(COLOR_LIME, str);
						format(str, sizeof(str), "2,9PARKOUR7,0 %s(%i) made a new parkour record for '%s'", pName[playerid], playerid, CParkourName);
						IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
						GameTextForPlayer(playerid, "~g~New parkour record!", 2000, 5);
						PlayerPlaySound(playerid, 1132, 0, 0, 0);

						if(Parkour_RecordMS != 0)
						{
							// Calculate the difference between the old race record and the new race record
							new diff_msec = Parkour_RecordMS - hour;
							new diff_second = diff_msec / 1000;
							diff_msec = diff_msec - (diff_second * 1000);

							format(str, sizeof(str), "2,9PARKOUR7,0 The new record is %02d.%03d seconds faster than the old one.", diff_second, diff_msec);
							IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

							format(str, sizeof(str), ""PARKOUR" The new record is %02d.%03d seconds faster than the old one!", diff_second, diff_msec);
							SendClientMessageToAll(COLOR_LIME, str);

						}
						Parkour_RecordMS = hour;

						mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE parkourtimes SET holder='%e',regid=%d,ms=%d,time=UNIX_TIMESTAMP() WHERE parkour='%e'", pName[playerid], pRegID[playerid], hour, CParkourName);
						print(query);
						MySQL_updateQuery(query);
					}
					else
					{
						SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You made a new parkour record!");
						SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Your race record could not be saved as you have less than 3 hours online or not logged in!");
					}
				}

				pRanking ++;
				pParticipants --;
				DisablePlayerRaceCheckpoint(playerid);
				SetPlayerVirtualWorld(playerid, 0);
				DisableRemoteVehicleCollisions(playerid, 0);

				canUseKey[playerid] = true;
				HidePlayerParkourTextdraws(playerid);
				if(pParticipants == 0)
				{
					format(str, sizeof(str), ""PARKOUR" Parkour '%s' has ended (last player finished)", CParkourName);
					SendClientMessageToAll(COLOR_LIME, str);
					format(str, sizeof(str), "2,9PARKOUR7,0 Parkour '%s' has ended (last player finished)", CParkourName);
					IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

					endparkour();
				}
			}
			default:
			{
				if(ParkourStart == 1)
				{
					PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
					pCurrentCheckpoint[playerid] = pCurrentCheckpoint[playerid] + 1;
					if(pCurrentCheckpoint[playerid] == pLCurrentCheckpoint)
					{
						SetParkourCheckpoint(playerid, pCurrentCheckpoint[playerid], -1);
						ParkourParticipant[playerid] = 6;
					}
					else
					{
						SetParkourCheckpoint(playerid, pCurrentCheckpoint[playerid], pCurrentCheckpoint[playerid] + 1);
					}
					//format(str, sizeof(str), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Checkpoint: ~b~~h~%d~w~/~b~%d", CurrentCheckpoint[playerid], LCurrentCheckpoint+1);
					//GameTextForPlayer(playerid, str, 3000, 3);
					format(tmp, sizeof(tmp), "~w~Checkpoint: ~b~~h~%d~w~/~b~%d", pCurrentCheckpoint[playerid], pLCurrentCheckpoint+1);
					InfoTD_MSG(playerid, 3000, tmp);
				}
			}
		}
	}
	else switch(RaceParticipant[playerid])
	{
		case 0:
		{
			// Excludes all race builders from having conflicts with the system
			return true;
		}
		case 1:
		{
			if(RaceStart == 0)
			{
				format(str, sizeof(str), ""RACE" The race '%s' is starting in %d seconds. Stay in the checkpoint or you will be disqualified.", CRaceName, mscd);
				SendClientMessage(playerid, COLOR_WHITEP, str);
				RaceParticipant[playerid] = 2;
			}
		}
		case 6:
		{
			RaceParticipant[playerid] = 0;
			PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
			new rankz[8];
			switch(Ranking)
			{
				case 1:
				{
					rankz = "first";
                    UpdateGroupScore(pGroupID[playerid], 2);
					GivePlayerCash(playerid, 30000);
					GivePlayerScore(playerid, 4);
					GivePlayerCookie(playerid, 1);
					pInfo[playerid][pRacesWon]++;
					InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished first!~n~~b~~h~~h~$30000, +4 score and +1 cookie.");
					format(query, sizeof(query), "UPDATE players SET races_won=races_won+1 WHERE reg_id=%d", pRegID[playerid]);
					MySQL_updateQuery(query);
					if(pInfo[playerid][pRacesWon] >= 10)
					{
						if(pAch6[playerid] == 0)
						{
							pAch6[playerid] = 1;
							format(query, sizeof(query), "UPDATE achievements SET a6=1 WHERE reg_id=%d", pRegID[playerid]);
							MySQL_updateQuery(query);
							GivePlayerAchievement(playerid, "Elite Racer", "Congrats you won 10 races!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
						}
					}
				}
				case 2:
				{
					rankz = "second";

					GivePlayerCash(playerid, 15000);
					GivePlayerScore(playerid, 3);

					InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished second!~n~~b~~h~~h~$15000 and 3 points earned.");
				}
				case 3:
				{
					rankz = "third";

					GivePlayerCash(playerid, 7500);
					GivePlayerScore(playerid, 2);

					InfoTD_MSG(playerid, 10000, "~g~Congratulations, ~h~you finished third!~n~~b~~h~~h~$7500 and 2 points earned.");
				}
				case 4: rankz = "4th";
				case 5: rankz = "5th";
				case 6: rankz = "6th";
				case 7: rankz = "7th";
				case 8: rankz = "8th";
				case 9: rankz = "9th";
				case 10: rankz = "10th";
				case 11: rankz = "11th";
				case 12: rankz = "12th";
				case 13: rankz = "13th";
				case 14: rankz = "14th";
				case 15: rankz = "15th";
				case 16: rankz = "16th";
				case 17: rankz = "17th";
				case 18: rankz = "18th";
				case 19: rankz = "19th";
				case 20: rankz = "20th";
			}

			if(Ranking > 3)
			{
				format(tmp, sizeof(tmp), "~g~~h~~h~You finished %s!", rankz);
				InfoTD_MSG(playerid, 10000, tmp);
			}

			new racingTime = GetTickCount() - race_StartTick;
			// Calculate milliseconds into minutes, seconds and milliseconds
			// minute = minutes, second = seconds, racingTime = remaining milliseconds (before was total milliseconds), hour = total milliseconds
			hour = racingTime;
			minute = racingTime / 60000;
			racingTime = racingTime - (minute * 60000);
			second = racingTime / 1000;
			racingTime = racingTime - (second * 1000);

			CarLocked[GetPlayerVehicleID(playerid)] = false;
			foreach(new ii : Player)
			{
				SetVehicleParamsForPlayer(GetPlayerVehicleID(playerid), ii, 0, 0);
			}
			if(minute == 0)
			{
				format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has finished %s in %02d.%03d seconds", pName[playerid], playerid, rankz,  second, racingTime);
				format(str, sizeof(str), ""RACE" %s(%i) has finished %s in "YELLOW_E"%02d.%03d seconds.", pName[playerid], playerid, rankz,  second, racingTime);
			}
			else
			{
				if(minute == 1)
				{
					format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has finished %s in %d minute and %02d.%03d seconds", pName[playerid], playerid, rankz,  minute, second, racingTime);
					format(str, sizeof(str), ""RACE" %s(%i) has finished %s in "YELLOW_E"%d minute and %02d.%03d seconds.", pName[playerid], playerid, rankz,  minute, second, racingTime);
				}
				else
				{
					format(tmp, sizeof(tmp), "2,9RACE7,0 %s(%i) has finished %s in %d minutes and %02d.%03d seconds", pName[playerid], playerid, rankz,  minute, second, racingTime);
					format(str, sizeof(str), ""RACE" %s(%i) has finished %s in "YELLOW_E"%d minutes and %02d.%03d seconds.", pName[playerid], playerid, rankz,  minute, second, racingTime);
				}
			}
			if(Ranking <= 5) SendClientMessageToAll(COLOR_WHITEP, str);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

			// Check if there's a new record for this race.
			if(hour < race_RecordMS || !race_RecordMS)
			{
				if(pTotalHours[playerid] >= 3 && pLogged[playerid] == true)
				if(pScore[playerid] >= 3000 && pLogged[playerid] == true)
				{
					// Send fancy messages
					format(str, sizeof(str), ""RACE" %s(%i) has made a new race record for "YELLOW_E"'%s'!", pName[playerid], playerid, CRaceName);
					SendClientMessageToAll(COLOR_WHITEP, str);
					format(str, sizeof(str), "2,9RACE7,0 %s(%i) made a new race record for '%s'", pName[playerid], playerid, CRaceName);
					IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
					GameTextForPlayer(playerid, "~g~New race record!", 2000, 5);
					PlayerPlaySound(playerid, 1132, 0, 0, 0);

					if(race_RecordMS != 0)
					{
						// Calculate the difference between the old race record and the new race record
						new diff_msec = race_RecordMS - hour;
						new diff_second = diff_msec / 1000;
						diff_msec = diff_msec - (diff_second * 1000);

						format(str, sizeof(str), "2,9RACE7,0 The new record is %02d.%03d seconds faster than the old one.", diff_second, diff_msec);
						IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

						format(str, sizeof(str), ""RACE" The new record is %02d.%03d seconds faster than the old one!", diff_second, diff_msec);
						SendClientMessageToAll(COLOR_WHITEP, str);

					}
					race_RecordMS = hour;

					mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE racetimes SET holder='%e',regid=%d,ms=%d,time=UNIX_TIMESTAMP() WHERE race='%e'", pName[playerid], pRegID[playerid], hour, CRaceName);
					MySQL_updateQuery(query);

					if(pAch17[playerid] == 0)
					{
						pAch17[playerid] = 1;
						format(query, sizeof(query), "UPDATE achievements SET a17=1 WHERE reg_id=%d", pRegID[playerid]);
						MySQL_updateQuery(query);
						GivePlayerAchievement(playerid, "Pro Racer", "Congrats you beat a race record!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
					}
					switch(random(4))
					{
						case 0:
						{
							format(str, sizeof(str), "I'm coming for that race record %s!", pName[playerid]);
							SendBotMsg(str);
						}
						case 1:
						{
							format(str, sizeof(str), "HAX!!", pName[playerid]);
							SendBotMsg(str);
						}
						case 2:
						{
							format(str, sizeof(str), "Nice record %s :D", pName[playerid]);
							SendBotMsg(str);
						}
						case 3:
						{
							format(str, sizeof(str), "Damn %s you're too fast for me.. D:", pName[playerid]);
							SendBotMsg(str);
						}
					}
				}
				else
				{
					SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You made a new race record!");
					SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Your race record could not be saved as you have less than 3 hours online and 3000 score or you are not logged in!");
				}
			}

			Ranking ++;
			Participants --;
			DisablePlayerRaceCheckpoint(playerid);
			SetPlayerVirtualWorld(playerid, 0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), 0);
			canUseKey[playerid] = true;
			HidePlayerRaceTextdraws(playerid);
			DisableRemoteVehicleCollisions(playerid, 0);
			if(Participants == 0)
			{
				format(str, sizeof(str), ""RACE" Race '%s' has ended (last racer finished)", CRaceName);
				SendClientMessageToAll(COLOR_WHITEP, str);
				format(str, sizeof(str), "2,9RACE7,0 Race '%s' has ended (last racer finished)", CRaceName);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

				endrace();
			}
		}
		default:
		{
			if(RaceStart == 1)
			{
				PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
				CurrentCheckpoint[playerid] = CurrentCheckpoint[playerid] + 1;
				if(CurrentCheckpoint[playerid] == LCurrentCheckpoint)
				{
					SetRaceCheckpoint(playerid, CurrentCheckpoint[playerid], -1);
					RaceParticipant[playerid] = 6;
				}
				else
				{
					SetRaceCheckpoint(playerid, CurrentCheckpoint[playerid], CurrentCheckpoint[playerid] + 1);
				}
				//format(str, sizeof(str), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Checkpoint: ~b~~h~%d~w~/~b~%d", CurrentCheckpoint[playerid], LCurrentCheckpoint+1);
				//GameTextForPlayer(playerid, str, 3000, 3);
				format(tmp, sizeof(tmp), "~w~Checkpoint: ~b~~h~%d~w~/~b~%d", CurrentCheckpoint[playerid], LCurrentCheckpoint+1);
				InfoTD_MSG(playerid, 3000, tmp);
			}
		}
	}
	return 1;
}

CMD:buildrace(playerid, params[])
{
	if(pAdmin[playerid] < 3)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(RaceBuilders[playerid] != 0)
	{
		Error(playerid, "You are already building a race!");
	}
	else if(RaceParticipant[playerid] > 0)
	{
		Error(playerid, "You are currently participating in a race! You must use /leave if you want to build a race.");
	}
	else
	{
		if(RaceBuilt == 1)
			return Error(playerid, "You can't build a race now! Someone else already is.");

		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" You are now building a race");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /cp - Place a checkpoint | /dcp - Delete a checkpoint");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /scp - Select Checkpoint | /rcp - Replace checkpoint");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /clearrace - Start over again | /saverace - Save your build parkour.");

		RaceBuilders[playerid] = 1;
		RaceBuilt = 1;
		BCurrentCheckpoints = 0;
		BAirrace = 0;
		BCPsize = 10.0;
	}
	return 1;
}

CMD:buildparkour(playerid, params[])
{
	if(pAdmin[playerid] < 2)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(ParkourBuilders[playerid] != 0)
	{
		Error(playerid, "You are already building a parkour!");
	}
	else if(ParkourParticipant[playerid] > 0)
	{
		Error(playerid, "You are currently participating in a parkour! You must use /leave if you want to build a parkour.");
	}
	else
	{
		if(ParkourBuilt == 1)
			return Error(playerid, "You can't build a parkour now! Someone else already is.");

		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" You are now building a parkour!");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /pcp - Place a checkpoint | /pdcp - Delete a checkpoint");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /pscp - Select Checkpoint | /prcp - Replace checkpoint");
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" /clearparkour - Start over again | /saveparkour - Save your build parkour.");

		ParkourBuilders[playerid] = 1;
		ParkourBuilt = 1;
		pBCurrentCheckpoints = 0;
		pBAirrace = 0;
		pBCPsize = 10.0;
	}
	return 1;
}

CMD:cp(playerid)
{
	if(pAdmin[playerid] < 3)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(RaceBuilders[playerid] != 0 && BCurrentCheckpoints < 49)
	{
		GetPlayerPos(playerid, POS[0], POS[1], POS[2]);

		format(str, sizeof(str), ""RACE" Checkpoint %d created (%f, %f, %f)", BCurrentCheckpoints, POS[0], POS[1], POS[2]);
		SendClientMessage(playerid, COLOR_GREEN, str);

		BRaceCheckpoints[BCurrentCheckpoints][0] = POS[0];
		BRaceCheckpoints[BCurrentCheckpoints][1] = POS[1];
		BRaceCheckpoints[BCurrentCheckpoints][2] = POS[2];

		BSelectedCheckpoint = BCurrentCheckpoints;
		SetBRaceCheckpoint(playerid, BCurrentCheckpoints, -1);
		BCurrentCheckpoints ++;
	}
	else if(RaceBuilders[playerid] != 0 && BCurrentCheckpoints == 49)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Maximum amount of checkpoints reached (%d).", 49);
		SendClientMessage(playerid, COLOR_RED, str);
	}
	else Error(playerid, "You are not building a race!");
	return 1;
}

CMD:pcp(playerid)
{
	if(pAdmin[playerid] < 2)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}
	if(ParkourBuilders[playerid] != 0 && pBCurrentCheckpoints < 49)
	{
		GetPlayerPos(playerid, POS[0], POS[1], POS[2]);

		format(str, sizeof(str), ""PARKOUR" Checkpoint %d created (%f, %f, %f)", pBCurrentCheckpoints, POS[0], POS[1], POS[2]);
		SendClientMessage(playerid, COLOR_LIME, str);

		pBRaceCheckpoints[pBCurrentCheckpoints][0] = POS[0];
		pBRaceCheckpoints[pBCurrentCheckpoints][1] = POS[1];
		pBRaceCheckpoints[pBCurrentCheckpoints][2] = POS[2];

		pBSelectedCheckpoint = pBCurrentCheckpoints;
		SetBParkourCheckpoint(playerid, pBCurrentCheckpoints, -1);
		pBCurrentCheckpoints ++;
	}
	else if(ParkourBuilders[playerid] != 0 && pBCurrentCheckpoints == 49)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"Maximum amount of checkpoints reached (%d).", 49);
		SendClientMessage(playerid, COLOR_RED, str);
	}
	else Error(playerid, "You are not building a parkour!");
	return 1;
}

CMD:scp(playerid, params[])
{
	if(pAdmin[playerid] < 3)
	{
		Error(playerid, "You are not authorized to use this command!");
		return true;
	}

	new sele;
	if(sscanf(params, "d", sele))
	{
		Usage(playerid, "/scp [checkpoint]");
		return 1;
	}

	if(RaceBuilders[playerid] != 0)
	{
		if(sele>BCurrentCheckpoints -1 || BCurrentCheckpoints < 1 || sele < 0)
		{
			Error(playerid, "Invalid checkpoint!");
			return 1;
		}
		format(str,sizeof(str), ""SERVER_INITIALS" Selected checkpoint %d", sele);
		SendClientMessage(playerid, COLOR_GREEN, str);
		BActiveCP(playerid, sele);
		BSelectedCheckpoint = sele;
	}
	else Error(playerid, "You are not building a race!");
	return 1;
}
