					IRC_GroupSay(ircGroup, IRC_CHANNEL, "2,9COUNTER STRIKE3,0 Counter Strike is starting in 15 seconds, /je ingame to join.");
					format(str,sizeof(str),""RED_E"[Event::CounterStrike]"WHITE_E" CounterStrike is starting in 20 seconds! Use /je to join the event!");
					SendClientMessageToAll(COLOR_LB,str);
