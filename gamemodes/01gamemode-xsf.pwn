// DMS.
CMD:bf(playerid) return cmd_battlefield(playerid);
CMD:battlefield(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;

	if(InDM[playerid] == 13) return Error(playerid, "Leave the CnR minigame before joining a DM! "RED_E"/leave.");
	if(doingStunt[playerid] != 0) return Error(playerid, "Teleport out of this stunt area before joining a DM!");
	if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
	if(InDM[playerid] == 1)
	{
		Error(playerid, "You already are in this DM!");
		return true;
	}
	if(gettime() < lastDM[playerid]+10) return Error(playerid, "You must wait before joining another DM lobby");
	lastDM[playerid] = gettime();
	CheckDM(playerid);
	SavePlayerPosition(playerid);
	ResetPlayerWeapons(playerid);
	switch(random(7))
	{
		case 0: SetPlayerPosition(playerid, -1131.6479, 1029.1998, 1345.7306, 255.3691, 10);
		case 1: SetPlayerPosition(playerid, -975.3635, 1089.3511, 1344.9720, 88.6975, 10);
		case 2: SetPlayerPosition(playerid, -1009.2294, 1078.9606, 1343.2344, 81.4908, 10);
		case 3: SetPlayerPosition(playerid, -1042.9960, 1040.1443, 1342.2969, 323.6997, 10);
		case 4: SetPlayerPosition(playerid, -1096.5231, 1022.0341, 1343.5490, 320.9030, 10);
		case 5: SetPlayerPosition(playerid, -1131.8911, 1094.6980, 1345.7910, 270.4559, 10);
		case 6: SetPlayerPosition(playerid, -973.5475, 1023.6379, 1345.0494, 93.4210, 10);
	}

	SendClientMessage(playerid, COLOR_FIREBRICK, "* Welcome to the BATTLEFIELD!");

	ShowPlayerDialog(playerid, BF_DIALOG, DIALOG_STYLE_LIST, ""WHITE_E"Choose your Weapon", ""dot"Knife M4 Deagle MP5 CombatShotgun\n"dot"Katana AK Deagle TEC-9 SawnoffShotgun\n"dot"Chainsaw M4 Country Rifle Silenced 9mm TEC-9 Shotgun\n"dot"Shovel AK Sniper Deagle Uzi SawnoffShotgun", "Select", "");

	InDM[playerid] = 1;
	BattleField++;
	TeleMSGDM(playerid, "BattleField (/bf)");

	UpdateMinigameBox(playerid, 1, "/BF");

	if(GetDMMembers(1) == 1)
	{
	    new stri[128];
	    GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	    format(stri, sizeof stri, "{FF0000}[DM Advertisement] {FFFFFF}%s has joined BattleField DM and feels lonely! Join them, /battlefield", PlayerName);

	    foreach(new i : Player)
	    {
	        if(dmMessages[i] == 1)
	        {
	            SendClientMessage(i, -1, stri);
			}
		}
	}
	return true;
}

CMD:rocket(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] == 13) return Error(playerid, "Leave the CnR minigame before joining a DM! "RED_E"/leave.");
	if(doingStunt[playerid] != 0) return Error(playerid, "Teleport out of this stunt area before joining a DM!");
	if(InDM[playerid] == 4)
	{
		Error(playerid, "You already are in this DM!");
		return true;
	}
	if(InDM[playerid] == 7)
	{
		Error(playerid, "Please leave the minigun DM using "YELLOW_E"/leave "RED_E"before joining the Rocket DM!");
		return true;
	}

	if(gettime() < lastDM[playerid]+10) return Error(playerid, "You must wait before joining another DM lobby");
	if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
	lastDM[playerid] = gettime();
	CheckDM(playerid);
	SavePlayerPosition(playerid);
	ResetPlayerWeapons(playerid);
	InDM[playerid] = 4;
	switch(random(6))
	{
		case 0: SetPlayerPosition(playerid, 1250.9, 2765.8, 10.8, 0);
		case 1: SetPlayerPosition(playerid, 1366.7, 2734.3, 10.8, 0);
		case 2: SetPlayerPosition(playerid, 1366.7593, 2734.3677, 10.8203, 0);
		case 3: SetPlayerPosition(playerid, 1344.7437, 2772.8569, 30.6975, 0);
		case 4: SetPlayerPosition(playerid, 1312.1455, 2841.2253, 10.8203, 0);
		case 5: SetPlayerPosition(playerid, 1215.5587, 2835.2925, 10.8125, 0);
	}

	SendClientMessage(playerid, COLOR_FIREBRICK, "* Welcome to Rocket DM!");
	GivePlayerWeapon(playerid, 35, 400);
	SetPlayerWorldBounds(playerid, 1443.253, 1080.102, 2869.626, 2699.431);
	Rocket++;
	TeleMSGDM(playerid, "Rocket DM (/rocket)");
	UpdateMinigameBox(playerid, 1, "/Rocket");

	if(GetDMMembers(4) == 1)
	{
	    new stri[128];
	    GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	    format(stri, sizeof stri, "{FF0000}[DM Advertisement] {FFFFFF}%s has joined Rocket DM and feels lonely! Join them, /rocket", PlayerName);
     	foreach(new i : Player)
	    {
	        if(dmMessages[i] == 1)
	        {
	            SendClientMessage(i, -1, stri);
			}
		}
	}
	return true;
}

