CMD:rainbow(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		Error(playerid, "You must be a driver in a vehicle to use the rainbow feature!");
		return true;
	}

	if(pInfo[playerid][pRainbow] == 0)
	{
		RainbowTimer[playerid] = SetTimerEx("ChangeColors", 400, true, "i", playerid);
		pInfo[playerid][pRainbow] = 1;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" The Rainbow Effect has been turned on.");
		InfoTD_MSG(playerid, 3000, "~r~T~y~h~b~e ~g~R~r~A~y~I~y~N~b~B~r~~h~O~b~~h~W ~y~~h~E~g~~h~F~r~~h~F~b~~h~E~y~~h~C~r~~h~~h~T ~w~has been turned ~g~~h~on~w~.");
	}
	else
	{
		KillTimer(RainbowTimer[playerid]);
		pInfo[playerid][pRainbow] = 0;
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" The Rainbow Effect has been turned off.");
		InfoTD_MSG(playerid, 3000, "~r~T~y~h~b~e ~g~R~r~A~y~I~y~N~b~B~r~~h~O~b~~h~W ~y~~h~E~g~~h~F~r~~h~F~b~~h~E~y~~h~C~r~~h~~h~T ~w~has been turned ~r~~h~off~w~.");
	}
	return true;
}

CMD:killme(playerid)
{
	if(InDM[playerid] == 22) return true;

	if(GetPVarType(playerid, "commitSuicide"))
	{
		Error(playerid, "Please wait before committing suicide again.");
		return true;
	}
	format(str, sizeof(str), "* {%06x}%s(%i) "PINK_E"has committed suicide.", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	SetPlayerHealth(playerid, 0.0);
	SetPVarInt(playerid, "commitSuicide", 1);
	SetTimerEx("resetKill", 20000, false, "i", playerid);
	InfoTD_MSG(playerid, 4000, "~r~~h~~h~You have committed suicide.");
	return 1;
}

CMD:reclass(playerid)
{
	if(IsPlayerInAnyVehicle(playerid))
		return Error(playerid, "You must be on foot to respawn yourself!");

	SetPlayerHealth(playerid, 0.0);
	ForceClassSelection(playerid);
	SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have reclassed yourself!");
	return true;
}
CMD:respawn(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "You must be on foot to respawn yourself!");
	if(AFK[playerid]) return Error(playerid, "You cannot respawn yourself while being AFK.");
	if(RobberyCount[playerid] != 0) return Error(playerid, "You can't respawn while committing a robbery.");
	if(GetPVarInt(playerid, "InStore") != 0) return Error(playerid, "You can't respawn while in a store.");
	if(InDuel[playerid] != -1) return Error(playerid, "You can't use this command while dueling!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't use this command while racing!");
	if(pSpectating[playerid] != -1) return Error(playerid, "You can't do this while spectating.");

	if(InDM[playerid] == 13) // CnR
	{
		if(GetPVarInt(playerid, "Robber") != 0)
		{
			foreach(new ii : Player)
			{
				if(GetPVarInt(ii, "Cop") != 0)
				{
					if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
					{
						return Error(playerid, "You can't type /respawn nearby a cop, escape first!");
					}
				}
			}
		}
		if(GetPVarInt(playerid, "Cop") != 0)
		{
			foreach(new ii : Player)
			{
				if(GetPVarInt(ii, "Robber") != 0)
				{
					if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
					{
						return Error(playerid, "You can't type /respawn nearby a robber, escape first!");
					}
				}
			}
		}

	}

	killStreak[playerid] = 0;
	SpawnPlayer(playerid);
	SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have respawned yourself!");
	return true;
}
CMD:sp(playerid) return cmd_spos(playerid);
CMD:s(playerid) return cmd_spos(playerid);
CMD:spos(playerid)
{
	if(doingStunt[playerid] != 0) return Error(playerid, "You can't use /spos here!");
	if(InDM[playerid] != 0) return Error(playerid, "You can't save your position while in a DM!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't save your position while racing!");
	if(pSpectating[playerid] != -1) return Error(playerid, "You can't save your position while spectating!");
	if(pSpawned[playerid] == 0) return Error(playerid, "You must be spawned to use this commmand!");
	if(InDuel[playerid] != -1) return Error(playerid, "You can't use this command while dueling!");

	SavePlayerPositionEx(playerid);
	InfoTD_MSG(playerid, 3500, "~y~~h~~h~Your position has been saved.~n~~w~Write /lpos now to restore.");
	SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have saved your position. Type /lpos to restore back to this position.");
	return true;
}
CMD:l(playerid) return cmd_lpos(playerid);
CMD:lp(playerid) return cmd_lpos(playerid);
CMD:lpos(playerid)
{
	if(doingStunt[playerid] != 0)
	{
		Error(playerid, "You can't use /lpos here!");
		return true;
	}
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't load your position while in a DM!");
		return true;
	}
	if(sPOS2_X[playerid] == 0)
	{
		Error(playerid, "You must save your position first! Use /spos");
		return true;
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
	{
		Error(playerid, "You can't load your position while in the passenger seat!");
		return true;
	}

	if(GetPlayerInterior(playerid) != 0) return Error(playerid, "You can't load your position while being on an interior!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't load your position while racing!");
	if(pSpectating[playerid] != -1) return Error(playerid, "You can't load your position while spectating!");
	if(pSpawned[playerid] == 0) return Error(playerid, "You must be spawned to use this commmand!");
	if(isCbug[playerid]== 1) return Error(playerid, "You can't load your position right now.");
	LoadPlayerPositionEx(playerid);
	InfoTD_MSG(playerid, 3000, "~g~~h~~h~Your position has been restored!");
	SendClientMessage(playerid, COLOR_LB, ""SERVER_INITIALS" "LB2_E"You have teleported back to your saved position.");
	return true;
}

CMD:flip(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		Error(playerid, "You must be the driver of a vehicle to flip it!");
		return true;
	}
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 && pAdmin[playerid] != 5)
	{
		Error(playerid, "This command cannot be used while in a derby!");
		return true;
	}
	if(doingStunt[playerid] == 19 && pAdmin[playerid] != 5)
	{
		Error(playerid, "This command cannot be used while in a derby!");
		return true;
	}
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't flip your vehicle while in a DM!");
		return true;
	}
	vID = GetPlayerVehicleID(playerid);

	GetVehicleZAngle(vID, A);
	SetVehicleZAngle(vID, A);
	RepairVehicle(vID);

	format(str, sizeof(str), "~y~~h~~h~Your ~y~%s ~y~~h~~h~has been flipped.", vehName[GetVehicleModel(vID) - 400]);
	InfoTD_MSG(playerid, 3500, str);
	PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);
	return true;
}
