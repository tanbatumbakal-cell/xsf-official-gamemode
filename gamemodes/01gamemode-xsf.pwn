function OnPlayerPickUpGift(playerid, giftid)
{
	new rand;
	new giftx = random(6);
	switch(giftx)
	{
	

		case 0:
		{
			rand = RandomEx(1000, 10000);
			GivePlayerCash(playerid, rand);
			SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized cash that starts from $1K to $10K");
		}
		case 1:
		{
			rand = RandomEx(1, 100);
			SetPlayerScore(playerid, GetPlayerScore(playerid)+rand);
			SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized score that starts from 1 to 10");
		}
		case 2:
		{
			rand = RandomEx(10, 100);
			pCookies[playerid] += rand;
			SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized cookies that starts from 10 to 100");
		}
		case 3:
		{
			rand = random(5);
			if(rand == 1)
			{
				rand = random(2);
				if(rand == 0) rand++;
				if(pPremium[playerid] < rand)
				{
					pPremium[playerid] = rand;
					iTemp = gettime() + 86400 * 30;
					format(query, sizeof(query), "UPDATE players SET premium=%d,v_expired=%d WHERE reg_id=%d", rand, iTemp, pRegID[playerid]);
					MySQL_updateQuery(query);
					premiumExpired[playerid] = iTemp;

					SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized permantly premium level (1 or 2) check /stats for your gift!");
					format(str,sizeof(str),""RED_E"[xMasGift]: "GREEN_E"%s(%d) just got a Premium Level from the gift, Congratulations!" , GetName(playerid) , playerid);
					SendClientMessageToAll(-1,str);
				}
				else SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Sad your gift was a premium level but since you already have it, you will be refunded with some random cash.");
			}
			else return OnPlayerPickUpGift(playerid, 0);
		}
		case 4:
		{
			rand = random(8);
			if(rand == 1)
			{
				if(pPremium[playerid] != 3)
				{
					iTemp = gettime() + 86400 * 30;
					format(query, sizeof(query), "UPDATE players SET premium=3,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
