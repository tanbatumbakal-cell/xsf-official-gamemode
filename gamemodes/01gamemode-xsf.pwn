public IRC_OnUserNickChange(botid, oldnick[], newnick[], host[])
{
	if(botid == ircBot[0])
	{
		format(str, sizeof(str), ""BLUE_E"[IRC]"WHITE_E" %s has changed nick to %s. ("IRC_CHANNEL" on "IRC_SERVER")", oldnick, newnick);
		SendClientMessageToAll(COLOR_WHITE, str);
