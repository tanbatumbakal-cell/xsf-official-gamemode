//====================================================[ADMIN COMMANDS]==============================================================================
CMD:acmds(playerid)
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new line3[2500];
	strcat(line3, ""WHITE_E"Junior Admin Commands:"LB2_E"\n\
	/acmds /aka /akaip /akill /alounge /announce /apm /asay /(un)blockcmds /caps /clearchat /cnrAnn /dassign /disarm /dkick /event /eventkick\n\
	/explode /force /forcerespawn /fr /forcerules /forcespec /(un)freeze /gethere /getin /getip /giveallcookie /goto /hide /jail /jetpack /kick /loadparkour\n\
	/loadrace /(un)mute /offlineban(/oban) /ojail /omute /pAnn /peject /pinfo /profile /pweaps /racekick /reports /reward /santasled /sethealth /setvhealth\n\
	/silent(kick/ban) /slap /spec /spectators /startparkour /startrace /tempban(/tban) /timeout /togspec /ban /unban /vkill /warn /wprofile /mutedlist, /jailedlist, /oblockcmds, /oblockcheck\n\
	/dr, /autogetip, /setarmour /checkweeklytime /dragplayer /setworld");


	if(pAdmin[playerid] >= 2)
		strcat(line3, "\n\n"WHITE_E"Admin Commands:"LB2_E"\n\
		/addparkourrecord /(un)banip (/buildparkour /clearparkour /deletepcp /pcp /saveparkour) /(un)cuff /delabel /deleteparkour /endduel /endrace /forceafk /givecar\n\
		/givejetpack /giveweapon /healall /ipinfo /resetparkourrecord /resetrecord /respawnpvs /respawnvehicles(/rv) /roadblock /setskin /startcj /startmb /syncfooter /telep\n\
		/throw /(un)banip /vlabels /chase");

	if(pAdmin[playerid] >= 3)
		strcat(line3, "\n\n"WHITE_E"Senior Admin Commands:"LB2_E"\n\
		/addracerecord /aminigun (/buildrace /clearrace /cp /deletecp /saverace) /dawn /day /forceduel /forceend /forcemap /fullhide /gotoxyz /invincible /playsong /rconsay\n\
		/resetchatcolor /resetidcolor /rpg  /settempname /startreaction, /crash, /disablegod");

	if(pAdmin[playerid] >= 4)
		strcat(line3, ""WHITE_E"\n\nLead Admin Commands:"LB2_E"\n\
		/omakehelper /makehelper /changehname /changehowner /changeprice /deleterace /fakeban /fakeme /fakemsg /fakepm /getrekt /invite /la /movehouse /playsongforall\n\
		/reloadhouse /resetach /seepms /sellhouse, /setks");

	if(pAdmin[playerid] >= 5)
		strcat(line3, ""WHITE_E"\n\nManagement Commands:"LB2_E"\n\
		/agod /ann4 /blockadip /botmsg /chumban /chumkick /connectbots /createhouse /disarmall /giveach /giveallweapon /gmx /gotocj /gotomb /ha(health&armour) /makeadmin\n\
		/night /omakeadmin /resetallparkourrecords /resetallracerecords /saveallstats /setbcash /setcash /setcookies /setdeaths /sethours /setname /setpassword\n\
		/setscore /setskills /settime /setweather /takemoney /togspec /vehiclex /makeallsendpm /activity");

	if(pAdmin[playerid] >= 6)
		strcat(line3, "\n\n"WHITE_E"Owner Commands:"LB2_E"\n\
		/airbreak /createvehicle /givepremium /killall /muteall /setgroupscore /getfps");

	strcat(line3, "\n\n"PINK_E"Click on any player on the tab menu to open up the admin panel.");
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "YELLOW_E"Staff Commands", line3, "OK","");
	return true;
}
CMD:getfps(playerid, params[])
{
	if(pAdmin[playerid] > 5 || pDeveloper[playerid] == 1)
	{
		new string[128], giveplayerid;
		if(sscanf(params, "k<player_name>", giveplayerid)) return Usage(playerid, "/getfps <playerid>");
		if(giveplayerid == INVALID_PLAYER_ID) return Error(playerid, "Player not found");
		format(string, sizeof(string), "[FPS]{FFFFFF} %s's current FPS: %d", GetName(giveplayerid), pFPS[giveplayerid]);
		SendClientMessage(playerid, COLOR_RED, string);
	}
	else
	{
	  	return Error(playerid, "You are not authorized to use this command!");
	}
	return 1;
}

CMD:setworld(playerid, params[])
{
    if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	new giveplayerid;
    new theworld;
	if(sscanf(params, "k<player_name>d", giveplayerid, theworld)) return Usage(playerid, "/setworld <playerid> <worldid>");
	if(giveplayerid == INVALID_PLAYER_ID) return Error(playerid, "Player not found");

	SetPlayerVirtualWorld(giveplayerid, theworld);

	new string[128];
	format(string,sizeof(string),"You have set the world of %s to %d",pName[giveplayerid],theworld);
	SendClientMessage(playerid,COLOR_ORANGE,string);

 	format(string,sizeof(string),"Admin %s has set your world to %d",pName[playerid],theworld);
	SendClientMessage(giveplayerid,COLOR_ORANGE,string);
	return 1;
}

CMD:setinterior(playerid, params[]) return cmd_setint(playerid, params);
CMD:setint(playerid, params[])
{
    if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	new giveplayerid;
    new theworld;
	if(sscanf(params, "k<player_name>d", giveplayerid, theworld)) return Usage(playerid, "/setint <playerid> <interiorid>");
	if(giveplayerid == INVALID_PLAYER_ID) return Error(playerid, "Player not found");

	SetPlayerVirtualWorld(giveplayerid, theworld);

	new string[128];
	format(string,sizeof(string),"You have set the interior of %s to %d",pName[giveplayerid],theworld);
	SendClientMessage(playerid,COLOR_ORANGE,string);

 	format(string,sizeof(string),"Admin %s has set your interior to %d",pName[playerid],theworld);
	SendClientMessage(giveplayerid,COLOR_ORANGE,string);
	return 1;
}

stock IsHelperCMD(param[]) {
	new isHCMD =0;
	if(!strcmp(param, "/event") || !strcmp(param, "/eventkick") || !strcmp(param, "/forcerespawn") || !strcmp(param, "/forcerules") || strfind(param, "/h", true) != -1 || strfind(param, "/jail", true) != -1 || strfind(param, "/unjail", true) != -1 || strfind(param, "/warn", true) != -1) {
	    isHCMD = 1;
	}
	if(strfind(param, "/slap", true) != -1 || strfind(param, "/warn", true) != -1 || strfind(param, "/checkweeklytime", true) != -1) {
 		isHCMD = 1;
 	}
 	return isHCMD;
}

CMD:hcmds(playerid)
{
	if(pAdmin[playerid] < 1)
		if(Helper[playerid] < 1)
			return Error(playerid, "You are not authorized to use this command!");

	str = "";
	strcat(str, ""WHITE_E"Helper commands:"LB2_E"\n\
	/event /eventkick /forcerespawn /forcerules /h /hsay /(un)jail /loadrace /(un)mute /questions /reply /slap /warn /checkweeklytime");
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "YELLOW_E"Helper Commands", str, "OK","");
	return true;
}

CMD:devcmds(playerid)
{
	if(pDeveloper[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
