		pToys[playerid][3][toy_sx],
		pToys[playerid][3][toy_sy],
		pToys[playerid][3][toy_sz]);
	strcat(line4, lstr);

	format(lstr, sizeof(lstr),
	" `Slot4_Model` = %i, `Slot4_Bone` = %i, `Slot4_XPos` = %.3f, `Slot4_YPos` = %.3f, `Slot4_ZPos` = %.3f, `Slot4_XRot` = %.3f, `Slot4_YRot` = %.3f, `Slot4_ZRot` = %.3f, `Slot4_XScale` = %.3f, `Slot4_YScale` = %.3f, `Slot4_ZScale` = %.3f,",
		pToys[playerid][4][toy_model],
		pToys[playerid][4][toy_bone],
		pToys[playerid][4][toy_x],
		pToys[playerid][4][toy_y],
		pToys[playerid][4][toy_z],
		pToys[playerid][4][toy_rx],
		pToys[playerid][4][toy_ry],
		pToys[playerid][4][toy_rz],
		pToys[playerid][4][toy_sx],
		pToys[playerid][4][toy_sy],
		pToys[playerid][4][toy_sz]);
	strcat(line4, lstr);

	format(lstr, sizeof(lstr),
	" `Slot5_Model` = %i, `Slot5_Bone` = %i, `Slot5_XPos` = %.3f, `Slot5_YPos` = %.3f, `Slot5_ZPos` = %.3f, `Slot5_XRot` = %.3f, `Slot5_YRot` = %.3f, `Slot5_ZRot` = %.3f, `Slot5_XScale` = %.3f, `Slot5_YScale` = %.3f, `Slot5_ZScale` = %.3f WHERE `Name` = '%s'",
		pToys[playerid][5][toy_model],
		pToys[playerid][5][toy_bone],
		pToys[playerid][5][toy_x],
		pToys[playerid][5][toy_y],
		pToys[playerid][5][toy_z],
		pToys[playerid][5][toy_rx],
		pToys[playerid][5][toy_ry],
		pToys[playerid][5][toy_rz],
		pToys[playerid][5][toy_sx],
		pToys[playerid][5][toy_sy],
		pToys[playerid][5][toy_sz],
		pName[playerid]);
	strcat(line4, lstr);

	MySQL_updateQuery(line4);
	return true;
}

// Private Vehicle System
MySQL_LoadPlayerVehicle(playerid)
{
	new lquery[600];
	mysql_format(g_SQL_handle, lquery, sizeof(lquery), "SELECT * FROM vehicles WHERE Owner='%e'", pName[playerid]);
	MySQL_query(lquery, true, "LoadPlayerVehicle", "i", playerid);
}

forward LoadPlayerVehicle(playerid);
public LoadPlayerVehicle(playerid)
{
	if(MySQL_rowCount() > 0)
	{
		new rows = MySQL_rowCount();
		printf("PV loading rows: %d", rows);
		for(new i = 0; rows > i; i++)
		{
			new id = cache_get_field_content_int(i, "VehicleCount") - 1;
			new plate[13];


			printf("PV loading id: %d", id);
			printf("PV loading i: %d", i);
			BoughtVehicle[playerid][id] = true;



			PlayerInfoVeh[playerid][id][Model] = cache_get_field_content_int(i, "Model");
			PlayerInfoVeh[playerid][id][Price] 	= cache_get_field_content_int(i, "Price");
			PlayerInfoVeh[playerid][id][PaintJob]= cache_get_field_content_int(i, "PaintJob");
			PlayerInfoVeh[playerid][id][Color1] = cache_get_field_content_int(i, "Color1");
			PlayerInfoVeh[playerid][id][Color2] = cache_get_field_content_int(i, "Color2");
			PlayerInfoVeh[playerid][id][Locked] = cache_get_field_content_int(i, "Locked");
			PlayerInfoVeh[playerid][id][Mod1] = cache_get_field_content_int(i, "Mod1");
			PlayerInfoVeh[playerid][id][Mod2] = cache_get_field_content_int(i, "Mod2");
			PlayerInfoVeh[playerid][id][Mod3] = cache_get_field_content_int(i, "Mod3");
			PlayerInfoVeh[playerid][id][Mod4] = cache_get_field_content_int(i, "Mod4");
			PlayerInfoVeh[playerid][id][Mod5] = cache_get_field_content_int(i, "Mod5");
			PlayerInfoVeh[playerid][id][Mod6] = cache_get_field_content_int(i, "Mod6");
			PlayerInfoVeh[playerid][id][Mod7] = cache_get_field_content_int(i, "Mod7");
			PlayerInfoVeh[playerid][id][Mod8] = cache_get_field_content_int(i, "Mod8");
			PlayerInfoVeh[playerid][id][Mod9] = cache_get_field_content_int(i, "Mod9");
			PlayerInfoVeh[playerid][id][Mod10] = cache_get_field_content_int(i, "Mod10");
			PlayerInfoVeh[playerid][id][Mod11] = cache_get_field_content_int(i, "Mod11");
			PlayerInfoVeh[playerid][id][Mod12] = cache_get_field_content_int(i, "Mod12");
			PlayerInfoVeh[playerid][id][Mod13] = cache_get_field_content_int(i, "Mod13");
			PlayerInfoVeh[playerid][id][Mod14] = cache_get_field_content_int(i, "Mod14");
			PlayerInfoVeh[playerid][id][Mod15] = cache_get_field_content_int(i, "Mod15");
			PlayerInfoVeh[playerid][id][Mod16] = cache_get_field_content_int(i, "Mod16");
			PlayerInfoVeh[playerid][id][Mod17] = cache_get_field_content_int(i, "Mod17");

			cache_get_field_content(0, "Plate", plate);
			strmid(PlayerInfoVeh[playerid][id][Plate], plate, 0, 13, 13);

			format(PlayerInfoVeh[playerid][id][Owner], 24, pName[playerid]);

			PlayerInfoVeh[playerid][id][Model2] = cache_get_field_content_int(i, "Model_2");
			PlayerInfoVeh[playerid][id][Price2] = cache_get_field_content_int(i, "Price_2");
			PlayerInfoVeh[playerid][id][PaintJob2] = cache_get_field_content_int(i, "Paintjob_2");
			PlayerInfoVeh[playerid][id][Color12] = cache_get_field_content_int(i, "Color1_2");
			PlayerInfoVeh[playerid][id][Color22] = cache_get_field_content_int(i, "Color2_2");

			PlayerInfoVeh[playerid][id][Model3] = cache_get_field_content_int(i, "Model_3");
			PlayerInfoVeh[playerid][id][Price3] = cache_get_field_content_int(i, "Price_3");
			PlayerInfoVeh[playerid][id][PaintJob3] = cache_get_field_content_int(i, "Paintjob_3");
			PlayerInfoVeh[playerid][id][Color13] = cache_get_field_content_int(i, "Color1_3");
			PlayerInfoVeh[playerid][id][Color23] = cache_get_field_content_int(i, "Color2_3");
		}
	}
	return 1;
}

// Loading Achivements
