					SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "BLUE_E"You have joined the Blue Team!");
					GameTextForPlayer(playerid, "~w~You have joined the ~b~Blue Team~w~!", 4000, 4);
