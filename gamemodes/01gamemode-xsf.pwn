CMD:pcmds(playerid)
{
	new line3[2650];
	strcat(line3, ""PINK_E"Most Used Commands:\n"LB_E"/god\t\t"RED_E"» "WHITE_E"Enable godmode in stunt zones.\n"LB_E"/settings\t"RED_E"» "WHITE_E"Edit your ingame server settings.\n"LB_E"/teles\t\t"RED_E"» "WHITE_E"Open up the teleport dialog.\n"LB_E"/toys\t\t"RED_E"» "WHITE_E"Attach permanent objects to your character.\n"LB_E"/hold\t\t"RED_E"» "WHITE_E"Attach temporary custom objects to your character.");
	strcat(line3, "\n"LB_E"/duel\t\t"RED_E"» "WHITE_E"Challenge a player to a duel\n"LB_E"/premium\t"RED_E"» "WHITE_E"Displays all premium info and commands.\n"LB_E"/tops\t\t"RED_E"» "WHITE_E"Displays top statistics for online players.\n"LB_E"/weaponset\t"RED_E"» "WHITE_E"Choose your custom spawn weapons.\n"LB_E"/tpmsgs\t"RED_E"» "WHITE_E"Toggle minigame/race and DM messages above speedometer.");
	strcat(line3, "\n"LB_E"/v\t\t"RED_E"» "WHITE_E"Spawn your own vehicle, use /v <vehicle name> to chose your own.\n"LB_E"/anims\t\t"RED_E"» "WHITE_E"List of server animations.\n"LB_E"/skin\t\t"RED_E"» "WHITE_E"Select your own skin.\n"LB_E"/stats\t\t"RED_E"» "WHITE_E"View your personal server statistics.\n"LB_E"/goto\t\t"RED_E"» "WHITE_E"Teleport to any player in the server.");
	strcat(line3, "\n\n"PINK_E"Regular Commands:\n"IVORY_E"/spos\t\t"RED_E"» "WHITE_E"Save your position.\n"IVORY_E"/lpos\t\t"RED_E"» "WHITE_E"Load your saved postion.\n"IVORY_E"/pm\t\t"RED_E"» "WHITE_E"Send a player a private message.\n"IVORY_E"/w\t\t"RED_E"» "WHITE_E"Send a message to the players closest to you.\n"IVORY_E"/count\t\t"RED_E"» "WHITE_E"Start a countdown in your area.\n"IVORY_E"/vmenu\t"RED_E"» "WHITE_E"Open Vehicle menu.\n");
	strcat(line3, "\n"IVORY_E"/givecash\t"RED_E"» "WHITE_E"Send a player money.\n"IVORY_E"/savestats\t"RED_E"» "WHITE_E"Manually save your stats.\n"IVORY_E"/me\t\t"RED_E"» "WHITE_E"Perform an action.\n"IVORY_E"/afk\t\t"RED_E"» "WHITE_E"Teleport to an AFK area, adds [AFK] to your nick.\n"IVORY_E"/time\t\t"RED_E"» "WHITE_E"Set your own time.\n"IVORY_E"/weather\t"RED_E"» "WHITE_E"Set your own weather.");
	strcat(line3, "\n"IVORY_E"/weapons\t"RED_E" "WHITE_E"Opens up a weapon menu.\n"IVORY_E"/saveskin\t"RED_E" "WHITE_E"Spawn with your saved skin on every connect.\n"IVORY_E"/sync\t\t"RED_E" "WHITE_E"Use this command to sync yourself when stuck.\n"IVORY_E"/kill\t\t"RED_E" "WHITE_E"Commit suicide.");
	strcat(line3, "\n"IVORY_E"/fightstyles\t"RED_E"» "WHITE_E"Select your fightstyle.\n"IVORY_E"/color\t\t"RED_E"» "WHITE_E"Set your nick color.\n"IVORY_E"/toggoto\t"RED_E"» "WHITE_E"Toggle players from teleporting to you.\n"IVORY_E"/cshop\t\t"RED_E"» "WHITE_E"Purchase items using your cookies\n"IVORY_E"/togeventann\t\t"RED_E"» "WHITE_E"Toggle the event dialog from appearing!");
	ShowPlayerDialog(playerid, 223, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Player Commands (1/2)", line3, "Next", "Exit");
	return true;
}

CMD:vcmds(playerid)
{
	new line3[1700];
	strcat(line3, ""IVORY_E"/vmenu\t"RED_E"» "WHITE_E"Open Vehicle menu.\n"IVORY_E"/carcolor\t"RED_E"» "WHITE_E"Set your own vehicle color.\n"IVORY_E"/sb\t\t"RED_E"» "WHITE_E"Toggle the speedboost feature\n"IVORY_E"/repair, /fix\t"RED_E"» "WHITE_E"Repair your vehicle.\n"IVORY_E"/autotune\t"RED_E"» "WHITE_E"Toggle the autotune feature.\n"IVORY_E"/flip\t\t"RED_E"» "WHITE_E"Flip your vehicle.\n"IVORY_E"/hyd\t\t"RED_E"» "WHITE_E"Add hydraullics to your vehicle.");
	strcat(line3, "\n"IVORY_E"/tune\t\t"RED_E"» "WHITE_E"Vehicle tuning menu\n"IVORY_E"/wheels\t"RED_E"» "WHITE_E"Wheels menu\n"IVORY_E"/ramp\t\t"RED_E"» "WHITE_E"Enable ramp spawning.\n"IVORY_E"/lock\t\t"RED_E"» "WHITE_E"Lock your vehicle\n"IVORY_E"/unlock\t"RED_E"» "WHITE_E"Unlock your vehicle.\n"IVORY_E"/rainbow\t"RED_E"» "WHITE_E"Make your car flashy.");
	strcat(line3, "\n"IVORY_E"/nos\t\t"RED_E"» "WHITE_E"Add nitro to your vehicle\n"IVORY_E"/paintjob\t"RED_E"» "WHITE_E"Change your vehicle paintjob\n"IVORY_E"/antifall\t\t"RED_E"» "WHITE_E"Enable antifall for bikes.\n"IVORY_E"/plate\t\t"RED_E"» "WHITE_E"Change your vehicle plate.\n"IVORY_E"/speedo\t"RED_E"» "WHITE_E"Enable the speedometer.\n"IVORY_E"/autofix\t"RED_E"» "WHITE_E"Toggle the auto vehicle fix.");
	strcat(line3, "\n"IVORY_E"/siren\t\t"RED_E"» "WHITE_E"Add police sirens to your vehicle.\n"IVORY_E"/removewheels "RED_E"» "WHITE_E"Remove custom wheels from your vehicle.\n"IVORY_E"/lights\t\t"RED_E"» "WHITE_E"Toggle vehicle lights.\n"IVORY_E"/pv\t\t"RED_E"» "WHITE_E"Access your private vehicle controls.\n"IVORY_E"/eject\t\t"RED_E"» "WHITE_E"Eject a passenger from your vehicle.");
	strcat(line3, "\n\n"WHITE_E"Shortcut Keys:\n"PINK_E"MMB - Teleport to your last vehicle\nNUM 2 - Flip your vehicle.\nCTRL - Add nos to your vehicle\n\n"RED_E"» "LB_E"Use /v or /veh <name> to spawn your own vehicle!");
	ShowPlayerDialog(playerid, 224, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Vehicle Commands", line3, "Back", "Exit");
	return true;
}
CMD:locate(playerid, params[]) return cmd_loc(playerid, params);
CMD:loc(playerid, params[])
{
	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/locate <ID>");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(pSpectating[otherid] != -1)
		return Error(playerid, "Player is spectating.");

	format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d)'s Location: "WHITE_E"%s", pName[otherid], otherid, GetPlayerLocation(otherid));
	SendClientMessage(playerid, COLOR_WHITEP, str);
	return true;
}

