	return true;
}

	
CMD:pubgstats(playerid, params[])
{
	if(pLogged[playerid] == false)
	{
		Error(playerid, "You must be logged in to check statistics!");
		return true;
	}
	if(sscanf(params, "k<player_name>", otherid))
	{
	   DisplayPUBGStats(playerid, playerid);
	}
	else
	{
		if(otherid == INVALID_PLAYER_ID)
		{
			Error(playerid, "Player not connected!");
			return true;
		}

		DisplayPUBGStats(playerid, otherid);
	}
	return true;
}
CMD:offlinestats(playerid, params[]) return cmd_ostats(playerid, params);
CMD:ostats(playerid, params[])
{
	if(pLogged[playerid] == false)
	{
		Error(playerid, "You must be logged in to check statistics!");
		return true;
	}

	if(sscanf(params, "s[24]", tmp))
	{
		Usage(playerid, "/ostats <player name>");
		return true;
	}

	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);

		if(!strcmp(PlayerName, tmp, true))
		{
			Error(playerid, "Player is online, you can use /stats on them.");
			return true;
		}
	}

	// Load User Data
	new cQuery[80];
	//new cVar[500];

	// strcat(cVar, "adminlevel,hours,minutes,seconds,kills,deaths,money,score,premium,saveskin,cookies,events_won,races_won,MB_found,reg_time,last_time,");
	// strcat(cVar, "bmoney,rtests,arrests,killstreak,description,duels_won,fallouts,group_id,group_rank,derby_wins,cookiejars,spawnplace,maths,report_points,helper,admOnTime,gSpawnX,gSpawnY,gSpawnZ,pmhidden");

	mysql_format(g_SQL_handle, cQuery, sizeof(cQuery), "SELECT * FROM players WHERE name='%e' LIMIT 1", tmp);
	MySQL_query(cQuery, true, "LoadOfflineStats", "is", playerid, tmp);

	return true;
}

CMD:getid(playerid, params[])
{
	if(sscanf(params, "s[16]", tmp))
	{
		Usage(playerid, "/getid <PART OF NAME>");
		return true;
	}

	if(strlen(tmp) < 2 || strlen(tmp) > 24)
	{
		Error(playerid, "Part of name length invalid! The length must stay between 2-24 characters!");
		return true;
	}

	format(str, sizeof(str), "Searching for '%s' in names...", tmp);
	SendClientMessage(playerid, COLOR_WHITE, str);
	new found;
	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);
		new namelen = strlen(PlayerName);
		new bool:searched=false;
		for(new pos=0; pos <= namelen; pos++)
		{
			if(searched != true)
			{
				if(strfind(PlayerName, params,true) == pos)
				{
					found++;
					format(str,sizeof(str),"%d. %s (ID: %d)", found, PlayerName, ii);
					SendClientMessage(playerid, COLOR_GREEN , str);
					searched = true;
				}
			}
		}
	}
	if(found == 0) SendClientMessage(playerid, COLOR_LB, "No Players was found!");
	return true;
}
CMD:block(playerid, params[]) return cmd_ignore(playerid, params);
CMD:ignore(playerid, params[])
{
	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/ignore <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(ignore[playerid][otherid] == 1)
		return cmd_unignore(playerid, params);

	ignore[playerid][otherid] = 1;

	format(str, sizeof(str), ""SERVER_INITIALS" "DARK_E"%s(%i) is now ignored by you. They wont be able to teleport to you or PM you.", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_DARK, str);
	SendClientMessage(playerid, COLOR_DARK, ""SERVER_INITIALS" "GREY_E"Type /unignore to un-ignore this player.");
	return true;
}

CMD:unblock(playerid, params[]) return cmd_unignore(playerid, params);
CMD:unignore(playerid, params[])
{
	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/unignore <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(ignore[playerid][otherid] == 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"You aren't ignoring %s(%i)! Use /ignore to ignore.", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	ignore[playerid][otherid] = 0;

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) is no longer blocked by you. They will now be able to tele to you and pm you..", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	return true;
}

CMD:ignorelist(playerid, params[])
{
	if(sscanf(params, "i", otherid))
	{
		new ignoreds;
		foreach(new ii : Player)
		{
			if(ignore[playerid][ii] == 0)
				continue;

			ignoreds = ignoreds + 1;
		}

		if(ignoreds == 0)
			return SendClientMessage(playerid, COLOR_PINK, "[IGNORE] You aren't ignoring anybody.");

		format(str, sizeof(str), "[IGNORE] You are ignoring %d player(s):", ignoreds);
		SendClientMessage(playerid, COLOR_PINK, str);
		foreach(new ii : Player)
		{
			if(ignore[playerid][ii] == 0)
				continue;

			ignoreds = ignoreds + 1;

			GetPlayerName(ii, giveplayer, sizeof(giveplayer));

			format(str, sizeof(str), "    %d. %s(%i)", ignoreds, giveplayer, ii);
			SendClientMessage(playerid, COLOR_PINK, str);
		}
	}
	else
	{
		if(pAdmin[playerid] == 0)

			return Error(playerid, "Viewing other ignore lists is for admins only. Use /ignorelist without parameters!");


		new ignoreds;
		foreach(new ii : Player)
		{
			if(ignore[otherid][ii] == 0)
				continue;

			ignoreds = ignoreds + 1;
		}

		GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

		if(ignoreds == 0)
		{
			format(str, sizeof(str), "[IGNORE] %s(%i) isn't ignoring anybody.", giveplayer, otherid);
			SendClientMessage(playerid, COLOR_PINK, str);
			return true;
		}

		format(str, sizeof(str), "[IGNORE] %s(%i) is ignoring %d player(s):", giveplayer, otherid, ignoreds);
		SendClientMessage(playerid, COLOR_PINK, str);

		foreach(new ii : Player)
		{
			if(ignore[otherid][ii] == 0)
				continue;

			ignoreds = ignoreds + 1;

			GetPlayerName(ii, giveplayer, sizeof(giveplayer));

			format(str, sizeof(str), "    %d. %s(%i)", ignoreds, giveplayer, ii);
			SendClientMessage(playerid, COLOR_PINK, str);
		}
	}
	return true;
}

GetAFKElements(string_to_fill[],page=1,&left=0,&inserted=0,amount=30,maxstrsize=sizeof(string_to_fill))
{
	string_to_fill[0] = 0;
	string_to_fill[1] = 0;

	new afks = 0;
	new curr = 0;
	new from = (page-1)*amount;
	new to = from+amount;

	left = 0;
	inserted = 0;

	foreach(new ii : Player)
	{
		if(AFK[ii] == 1 || cAFK[ii] > 30) afks++;
	}


	if(afks == 1)
	{
		format(str, sizeof(str), "There is 1 AFK player:\n\n");
		strcat(string_to_fill, str, maxstrsize);
	}
	else
	{
		format(str, sizeof(str), "There are %d AFK players:\n\n", afks);
		strcat(string_to_fill, str, maxstrsize);
	}


	//loop all houses
	afks = 0;
	foreach(new ii : Player)
	{
		if(AFK[ii] == 1 || cAFK[ii] > 30)
		{
			//check if we want to list this house
			afks++;
			if(curr >= from && curr < to)
			{
				GetPlayerName(ii, giveplayer, sizeof(giveplayer));
				if(cAFK[ii] > 120)
				{
					new zpe = cAFK[ii] / 60;
					format(str, sizeof(str), ""WHITE_E"%d) "WHITEP_E"%s(%i) "GREY_E"(AFK for %d minutes)\n", afks, giveplayer, ii, zpe);
				}
				else format(str, sizeof(str), ""WHITE_E"%d) "WHITEP_E"%s(%i) "GREY_E"(AFK for %d seconds)\n", afks, giveplayer, ii, cAFK[ii]);
				strcat(string_to_fill,str,maxstrsize);
				++inserted;
			}
			else if(curr >= to)
			{
				//if not make sure we know there are houses left to list
				++left;
			}
			//and skip unneeded houses but make sure to keep track
			++curr;
		}
	}
	return 1;
}

CMD:afklist(playerid)
{
	new page = 1;
	new inserted;
	new left, afks = 0;

	//for users, pages begin at 1
	if(page < 1)
	{
		page = 1;
	}
	foreach(new ii : Player)
	{
		if(AFK[ii] == 1 || cAFK[ii] > 30) afks++;
	}
	GetAFKElements(afkstring,page,left,inserted);

	if(afks == 0)
	{
		return SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no AFK players on the server.");
	}
	else if(inserted == 1)
	{
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITEP_E"AFK List", afkstring, "Close", "");
	}
	else
	{
		if(left)
		{
			ShowPlayerDialog(playerid, 929, DIALOG_STYLE_MSGBOX, ""WHITEP_E"AFK List", afkstring, "Next Page", "Close");
		}
		else
		{
			ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITEP_E"AFK List", afkstring, "Close", "");
		}
	}
	return true;
}

CMD:cnrlist(playerid)
{
	new cnrs, finstring[2048];
	foreach(new ii : Player)
	{
		if(InDM[ii] == 13) cnrs++;
	}

	if(cnrs == 0) return SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no players playing CnR.");

	if(cnrs == 1)
	{
		format(tmp, sizeof(tmp), "There is one player playing CnR:\n\n");
		strcat(finstring, tmp);
	}
	else
	{
		format(tmp, sizeof(tmp), "There are %d players in CnR:\n\n", cnrs);
		strcat(finstring, tmp);
	}
	cnrs = 0;
	foreach(new ii : Player)
	{
		if(InDM[ii] == 13)
		{
			GetPlayerName(ii, giveplayer, sizeof(giveplayer));

			if(GetPVarInt(ii, "Robber") != 0)
			{
				str = ""RED_E"Robber";
			}
			else
			{
				switch(GetPVarInt(ii, "Cop"))
				{
					case 1: str = ""LB_E"Cop";
					case 2: str = ""BLUE_E"Swat";
					case 3: str = ""PURPLE_E"Army";
				}
			}
			if(cnrs <= 40)
			{
				format(tmp, sizeof(tmp), ""WHITE_E"%d) "WHITEP_E"%s(%i) "WHITE_E"(%s"WHITE_E")\n", cnrs, giveplayer, ii, str);
				strcat(finstring, tmp);
			}
			else
			{
				format(tmp, sizeof(tmp), "\n[... too many online]");
				strcat(finstring, tmp);
				break;
			}
			cnrs++;
		}
	}

	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITEP_E"CnR List", finstring, "Close", "");
	return true;
}

GetHouseElements(string_to_fill[],page=1,&left=0,&inserted=0,amount=30,&invalid_owner=0,maxstrsize=sizeof(string_to_fill))
{
	string_to_fill[0] = 0;
	string_to_fill[1] = 0;

	new houses = 0;
	new curr = 0;
	new from = (page-1)*amount;
	new to = from+amount;

	left = 0;
	inserted = 0;
	invalid_owner = 0;

	foreach(new h : Houses)
	{
		if(hInfo[h][HouseOwner] != 0 && h != 0)
		{
			houses++;
		}
	}


	if(houses == 1)
	{
		format(str, sizeof(str), "There is 1 house available:\n\n");
		strcat(string_to_fill, str, maxstrsize);
	}
	else
	{
		format(str, sizeof(str), "There are %d houses available:\n\n", houses);
		strcat(string_to_fill, str, maxstrsize);
	}


	//loop all houses
	houses = 0;
	foreach(new i : Houses)
	{
		if(hInfo[i][HouseOwner] != 0 && i != 0)
		{
			//check if we want to list this house
			houses++;
			if(curr >= from && curr < to)
			{
				format(str, sizeof(str), " "WHITE_E"%d) "WHITEP_E"House ID: %d "GREY_E"(Location: %s) (Price: "GREEN_E"$%s"GREY_E")\n", houses, i, GetHouseLocation(i), ToCurrency(hInfo[i][HouseValue]));
				strcat(string_to_fill,str,maxstrsize);
				++inserted;
			}
			else if(curr >= to)
			{
				//if not make sure we know there are houses left to list
				++left;
			}
			//and skip unneeded houses but make sure to keep track
			++curr;
		}
		else
		{
		   ++invalid_owner;
		}
	}
	return 1;
}

CMD:houses(playerid,params[])
