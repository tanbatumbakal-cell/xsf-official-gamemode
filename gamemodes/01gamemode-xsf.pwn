public OnPlayerRequestSpawn(playerid)
{
	// Do not let the player spawn when they have an account, but haven't logged in
	if(pRegID[playerid] != 0 && pLogged[playerid] == false)
	{
		PlayerPlaySound(playerid, 1085, 0, 0, 0);
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" This account is registered, please login with your password below in order to spawn!");

		format(line, sizeof(line), ""WHITE_E"Welcome to xTreme Stunt Freeroam, "YELLOW_E"%s\n\n"RED_E"This account is registered.\n"WHITE_E"Enter your password below to login\n\n"RED_E"Note:\n- "WHITE_E"You will not be able to spawn until you login.\n"RED_E"- "WHITE_E"If this is not your account please quit and change your name.", pName[playerid]);
		ShowPlayerDialog(playerid, 5, DIALOG_STYLE_PASSWORD, ""ORANGE_E"Login", line, "Login", "");
		return false;
	}

	// Admin-Only Skin
	if (GetPlayerSkin(playerid) ==  217 || GetPlayerSkin(playerid) ==  211)
	{
		if (pAdmin[playerid] == 0 && pDeveloper[playerid] == 0)
		{
			GameTextForPlayer(playerid, "~r~This class is for admins only~y~!", 2500, 3);
			return false;
		}
	}
	PlayerPlaySound(playerid, 1186, 0, 0, 0);
	TextDrawHideForPlayer(playerid, wTD);
	TextDrawHideForPlayer(playerid, wTD1);
	TextDrawHideForPlayer(playerid, wTD2);
	TextDrawHideForPlayer(playerid, wTD3);
	TextDrawHideForPlayer(playerid, wTD4);
	TextDrawHideForPlayer(playerid, wTD5);
	TextDrawHideForPlayer(playerid, wTD6);
	TextDrawHideForPlayer(playerid, wTD7);
	TextDrawHideForPlayer(playerid, wTD8);
	TextDrawHideForPlayer(playerid, wTD9);
	return true;
}

public OnPlayerSpawn(playerid)
{
    if(GetPVarInt(playerid, "HadGod") == 1 && InDM[playerid] == 0 && doingStunt[playerid] == 0)
	{
		SetPlayerHealth(playerid, 9999);
		GOD[playerid] = true;
		DeletePVar(playerid, "HadGod");
	}

    PreloadAnimLib(playerid,"BOMBER");

	if(snowOn[playerid]) CreateSnow(playerid);
	SetPlayerHealth(playerid, 98);
	pSpawned[playerid] = 1;
	if(GetPVarInt(playerid, "MusicPlaying") == 0) //if music in /music is on..
		StopAudioStreamForPlayer(playerid);

	if(GetPVarInt(playerid, "BadSports") == 1)
	{
		SetPlayerPosOnSpawn(playerid);
		SetPlayerHealth(playerid, 50);
		SetPlayerVirtualWorld(playerid, 3992039);
		return 1;
	}

	// If the player spawns more than once in .33 secs, kick them.
	iTemp = GetTickCount();
	if((iTemp - pLastSpawnTick[playerid]) < 333)
	{
		SpawnHack[playerid]++;
		if(SpawnHack[playerid] == 3)
		{
			SendClientMessage(playerid, COLOR_RED, ""GREY_E"Anti-Cheat: "RED_E"You have been kicked for the respawn hack.");
			format(str, sizeof(str), "4Server:3 %s(%i) has been kicked for respawn hack.", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			KickEx(playerid);
			return true;
		}
	}
	else SpawnHack[playerid] = 0;
	pLastSpawnTick[playerid] = iTemp;

	DeletePVar(playerid, "givenByAdmin");

	TextDrawHideForPlayer(playerid, letterbox[0]);
	TextDrawHideForPlayer(playerid, letterbox[1]);
	TogglePlayerControllable(playerid, true);

	GameTextForPlayer(playerid, " ", 1000, 3); // Hides Gametext

	if(pWelcome[playerid] == 1)
	{
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "PINK_E"Unregistered Player Help", ""RED_E"""\n\
	    "WHITE_E"Your name is not registered. Please use the "LB_E"/register "WHITE_E"command to automatically save your stats. If you register an acount,\n\
		"WHITE_E"you will receive money and score every few minutes you play and you will have access to more server features!\n\
		"WHITE_E"\n\
		"WHITE_E"Command "LB_E"/help"WHITE_E" for helpful information about server.\n\
		"WHITE_E"\n\
		"WHITE_E"On server we have many different commands. Command "LB_E"/c"WHITE_E" to receive useful information about server commands.\n\
		"WHITE_E"\n\
		"WHITE_E"Command "LB_E"/teles"WHITE_E" to view many fun stunts and areas to teleport to.\n\
		"WHITE_E"\n\
		"WHITE_E"If you want to spawn a vehicle, command"LB_E" /v (name/id)"WHITE_E" or use the vehicle menu by using "LB_E"/v\n\
		"WHITE_E"\n\
		"WHITE_E"To keep server fun for everyone, we set a few rules. If you are new, please read our rules, command"LB_E" /rules\n\
		"WHITE_E"\n\
		"WHITE_E"For more help, tips and useful information, please visit our website at"LB_E" www.serverserver.com\n\
	    ", "Close", "");
		pWelcome[playerid] = 0;
	}
	if(pWelcomeR[playerid] == 1)
	{
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "PINK_E"Newly Registered Player Help", ""RED_E"\
		"WHITE_E"Welcome to server!\n\
		"WHITE_E"\n\
		"WHITE_E"Your account has succesfully been registered, your stats will now be saved, you will receive money and score every few minutes you play\n\
		"WHITE_E"and you now have access to more server features!\n\
		"WHITE_E"\n\
		"WHITE_E"Command "LB_E"/help"WHITE_E" for helpful information about server.\n\
		"WHITE_E"\n\
		"WHITE_E"On server we have many different commands. Command "LB_E"/c"WHITE_E" to receive useful information about server commands.\n\
		"WHITE_E"\n\
		"WHITE_E"Command "LB_E"/teles"WHITE_E" to view many fun stunts and areas to teleport to.\n\
		"WHITE_E"\n\
		"WHITE_E"If you want to spawn a vehicle, command"LB_E" /v (name/id)"WHITE_E" or use the vehicle menu by using "LB_E"/v\n\
		"WHITE_E"\n\
		"WHITE_E"To keep server fun for everyone, we set a few rules. If you are new, please read our rules, command"LB_E" /rules\n\
		"WHITE_E"\n\
		"WHITE_E"For more help, tips and useful information, please visit our website at"LB_E" www.serverserver.com\n\
	    ", "Close", "");
		pWelcomeR[playerid] = 0;
	}

	if(InDM[playerid] >= 1 && InDM[playerid] != 200 && InDM[playerid] != 33)
	{
		SendToDM(playerid);
		return true;
	}

	if(GetPVarInt(playerid, "toysDisabled") != 1)
	{
	    AttachPlayerToys(playerid); // Attach player Toys.
	}

	if(bounty[playerid] > 0) SetPlayerAttachedObject(playerid, 7, 1254,2,0.440999,0.000000,0.023000,-1.799999,84.099983,0.000000,1.000000,1.000000,1.000000);

	if(pPremium[playerid] >= 2 && pSpectating[playerid] == -1)
	{
	    if(ParticipatingWar[playerid] == 0 && GetPVarInt(playerid, "togArmour")) {
			SetPlayerArmour(playerid, 50.0);
			if(pPremium[playerid] == 3) SetPlayerArmour(playerid, 97);
		}
	}

	if(doingStunt[playerid] == 19)
	{
		SetPlayerDerbyStaticMeshes(playerid); // Derby
		return true;
	}

	if(GetPVarInt(playerid, "FirstSpawn") == 0)
	{
		SetPVarInt(playerid, "FirstSpawn", 1);

		TextDrawHideForPlayer(playerid, ConnectTD[8]);
		TextDrawHideForPlayer(playerid, wTD);
		TextDrawHideForPlayer(playerid, wTD1);
		TextDrawHideForPlayer(playerid, wTD2);
		TextDrawHideForPlayer(playerid, wTD3);
		TextDrawHideForPlayer(playerid, wTD4);
		TextDrawHideForPlayer(playerid, wTD5);
		TextDrawHideForPlayer(playerid, wTD6);
		TextDrawHideForPlayer(playerid, wTD7);
		TextDrawHideForPlayer(playerid, wTD8);
		TextDrawHideForPlayer(playerid, wTD9);
		if(GetPVarInt(playerid, "GotObject"))
		{
			RemovePlayerAttachedObject(playerid, 7);
			RemovePlayerAttachedObject(playerid, 8);
			DeletePVar(playerid, "GotObject");
		}
		if(GOD[playerid] == 1 && god3D[playerid] == Text3D:-1 && ParticipatingWar[playerid] == 0)
		{
			TextDrawShowForPlayer(playerid, godTD);
			god3D[playerid] = CreateDynamic3DTextLabel("Godmode {41FF00}ON", 0xFFFF8288, 0, 0, 0.42, 16.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pTotalHours[playerid] < 5)
		{
			TextDrawShowForPlayer(playerid, helpTD);
			SetTimerEx("hideHelpTD", 20000, false, "i", playerid);
		}
		
		if(admin3D[playerid] != Text3D:-1) DestroyDynamic3DTextLabel(admin3D[playerid]);
		if(pPremium[playerid] == 3 && pAdmin[playerid] == 0 && Helper[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{00f9ff}VIP", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		// Still have to add it to the function

		if(Helper[playerid] == 1)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Helper", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pMapper[playerid] == 1)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Mapper", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pDeveloper[playerid] == 1 && Helper[playerid] == 3)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{62e100}Developer", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 1 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 2 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 3 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 4 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{f6d300}Lead Admin", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 5 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{0045ff}Manager", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 6 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{ea0000}Owner", 0xFFFF8288, 0, 0, -0.61, 20.0, playerid, INVALID_VEHICLE_ID, 1);
		}

		//AFK3D[playerid] = Create3DTextLabel("AFK", COLOR_WHITE, 0, 0, 0, 20.0, 0);
		ShowPlayerTextDraws_OPS(playerid);
		PlayerPlaySound(playerid, 1186, 0, 0, 0);
		// Show GangZones
		GangZoneShowForPlayer(playerid, Zone[0], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[1], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[2], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[3], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[4], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[5], 0x00C3FF55);
		GangZoneShowForPlayer(playerid, Zone[6], 0xFF000555);
		GangZoneShowForPlayer(playerid, Zone[7], 0xFF000555);
		GangZoneShowForPlayer(playerid, Zone[8], 0xFF000555);
		if(pMute[playerid] > 0)
		{
			format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You still have %d seconds left of your mute time!", pMute[playerid]);
			SendClientMessage(playerid, COLOR_GREY, str);
		}
	}


	InDM[playerid] = 0;
	SetPlayerTeam(playerid, 255);
	ApplyAnimation(playerid, "CRACK", "null", 0.0, 0, 0, 0, 0, 0);
	if(pSpectating[playerid] != -1)
	{
		pSpectating[playerid] = -1;
		LoadPlayerPosition(playerid);
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have been put back to your old position.");
	}
	else SetPlayerPosOnSpawn(playerid);
	if(GOD[playerid] == 0)
	{
		GiveSpawnWeapons(playerid);
	}
	else if(GOD[playerid] == 1 && ParticipatingWar[playerid] != 1)
	{
		GodModeLabel(playerid, true);
	}
	else GodModeLabel(playerid, true);

	if(GetPVarInt(playerid, "HideObjects"))
	{
		DeletePVar(playerid, "HideObjects");
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	}
	if(playerSpectated[playerid] != 0)
	{
		hour = GetPlayerVirtualWorld(playerid);
		minute = GetPlayerInterior(playerid);
		format(str, sizeof(str), ""SERVER_INITIALS" %s(%i) has respawned.", pName[playerid], playerid);
		foreach(new ii : Player)
		{
			if(pSpectating[ii] == playerid)
			{
				SetPlayerVirtualWorld(ii, hour);
				SetPlayerInterior(ii, minute);
				SendClientMessage(ii, COLOR_YELLOW, str);
				PlayerSpectatePlayer(ii, playerid);
			}
		}
	}
	if(pInfo[playerid][pSaveSkin] > 0 && pInfo[playerid][pSaveSkin] < 312)
	{
		SetPlayerSkin(playerid, pInfo[playerid][pSaveSkin]);
	}
	doingStunt[playerid] = 0;
	canUseKey[playerid] = true;
	if(pJail[playerid] > 0)
	{
		JailPlayer(playerid);
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You still have %d seconds left of your jail time!", pJail[playerid]);
		SendClientMessage(playerid, COLOR_GREY, str);
		new tmp_reason[60];
		GetPVarString(playerid, "JailedReason", tmp_reason, 60);
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You were jailed for %s!", tmp_reason);
		SendClientMessage(playerid, COLOR_GREY, str);
		SetPVarInt(playerid, "JailedByAdmin", 1);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
		return true;
	}
	if(GetPVarInt(playerid, "cuffedTime") != 0)
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);

	if(ParticipatingWar[playerid] == 1)
	{
	    GodModeLabel(playerid, false);
	    SetPlayerVirtualWorld(playerid, WarAway[playerid]);
	    GiveSpawnWeapons(playerid);
	    SetPlayerPosition(playerid, GangWarLoc[WarAway[playerid]][0], GangWarLoc[WarAway[playerid]][1], GangWarLoc[WarAway[playerid]][2], 360.0000);
	}

	return true;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
	if(CarLocked[vehicleid] == true)
	{
		SetVehicleParamsForPlayer(vehicleid, forplayerid, 0, 1);
	}
}

