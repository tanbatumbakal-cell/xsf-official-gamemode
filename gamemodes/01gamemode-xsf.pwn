// Cookies
GivePlayerCookie(playerid, cookies)
{
	pCookies[playerid] += cookies;

	if(pCookies[playerid] >= 50)
	{
		if(pAch14[playerid] == 0)
		{
			pAch14[playerid] = 1;
			format(query, sizeof(query), "UPDATE achievements SET a14=1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			GivePlayerAchievement(playerid, "Cookie Monster", "Congrats you've earned 50 cookies!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
		}
	}

	if(pLogged[playerid]) {
		new str_query[100]; // We don't need a 4080 query size, now do we?
		format(str_query, sizeof(str_query), "UPDATE players SET cookies = %d WHERE reg_id = %d", pCookies[playerid], pRegID[playerid]);
		MySQL_updateQuery(str_query);
	}
}

