CMD:removewheels(playerid)
{
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1010);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1073);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1074);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1075);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1077);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1078);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1079);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1080);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1081);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1082);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1083);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1085);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1096);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1097);
	RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1098);
	SendClientMessage(playerid, COLOR_WHITEP, ""RED_E"Server: "WHITEP_E"You have removed your custom wheels.");
	pWheels[playerid] = 999;
	if(pLogged[playerid] == true)
	{
		format(query, sizeof(query), "UPDATE players SET wheels=999 WHERE reg_id=%d", pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return 1;
}

CMD:removecomponents(playerid) return cmd_removetune(playerid);
CMD:removetunes(playerid) return cmd_removetune(playerid);
CMD:removetune(playerid)
{
	new componentid;
	vID = GetPlayerVehicleID(playerid);
	for (new i; i < 14; i++)
	{
		componentid = GetVehicleComponentInSlot(vID, i);
		if (componentid != 0)
		{
			RemoveVehicleComponent(vID, componentid);
		}
	}

	if(vID == PlayerVehicle[playerid][0] || vID == PlayerVehicle[playerid][1])
	{
		new id = 0;
		if(vID == PlayerVehicle[playerid][1]) id = 1;
		if(vID == PlayerVehicle[playerid][0]) id = 0;

		SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"You have removed all the tune components from your private vehicle.");
		PlayerInfoVeh[playerid][id][Mod1] = 0;
		PlayerInfoVeh[playerid][id][Mod2] = 0;
		PlayerInfoVeh[playerid][id][Mod3] = 0;
		PlayerInfoVeh[playerid][id][Mod4] = 0;
		PlayerInfoVeh[playerid][id][Mod5] = 0;
		PlayerInfoVeh[playerid][id][Mod6] = 0;
		PlayerInfoVeh[playerid][id][Mod7] = 0;
		PlayerInfoVeh[playerid][id][Mod8] = 0;
		PlayerInfoVeh[playerid][id][Mod9] = 0;
		PlayerInfoVeh[playerid][id][Mod10] = 0;
		PlayerInfoVeh[playerid][id][Mod11] = 0;
		PlayerInfoVeh[playerid][id][Mod12] = 0;
		PlayerInfoVeh[playerid][id][Mod13] = 0;
		PlayerInfoVeh[playerid][id][Mod14] = 0;
		PlayerInfoVeh[playerid][id][Mod15] = 0;
		PlayerInfoVeh[playerid][id][Mod16] = 0;
		PlayerInfoVeh[playerid][id][Mod17] = 0;
	}
	else SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"You have removed all the tuned components from your vehicle.");
	return true;
}
CMD:afk(playerid, params[])
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(AFK[playerid] == 1)
		return cmd_back(playerid);
	if(InDM[playerid] != 0)
	{
		Error(playerid, "You can't go afk while in a DM, please /leave the deathmatch.");
		return true;
	}
	if(pMute[playerid] > 0)
	{
		Error(playerid, "You are muted, you cannot go afk.");
		return true;
	}
	if(doingStunt[playerid] != 0)
	{
		Error(playerid, "You can't go AFK in this area, type /leave!");
		return true;
	}


	format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "PINK_E"is now Away from Keyboard. "WHITE_E"(AFK)", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_PINK, str);
	format(str, sizeof(str), "4Server:2 %s(%i) is now AFK.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	format(str, sizeof(str), "**[AFK]** %s(%i) is now Away from keyboard.", pName[playerid], playerid);
	//DCC_SendChannelMessage(Channel_Echo, str);


	SavePlayerPosition(playerid);
	vID = GetPlayerVehicleID(playerid);
	if(IsPlayerInAnyVehicle(playerid))
	{
		foreach(new ii : Player)
		{
			if(ii == playerid || !IsPlayerInVehicle(ii, vID)) continue;
			OnPlayerExitVehicle(ii, vID);
			GetVehiclePos(vID, POS[0], POS[1], POS[2]);
			SetPlayerPos(ii, POS[0], POS[1]+1, POS[2]+2);
			format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"%s(%d) has went AFK, you have been removed from the vehicle.", pName[playerid], playerid);
			SendClientMessage(ii, COLOR_LB, str);
		}
		SetPlayerVehiclePosition(playerid, 1729.4001,3195.2603 + random(7),10.4081,115.1725);
		SetVehicleVirtualWorld(vID, 77);
	}
	else
	{
		SetPlayerPosition(playerid, 3143.1875,2694.4568,8.1734,146.4935);
	}
	SetPlayerVirtualWorld(playerid, AFK_WORLD);
	GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "ORANGE_E"You are now in AFK mode.");
	SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "ORANGE_E"Type /back to return to your previous position.");
	PlayerTextDrawSetString(playerid, InfoTD[playerid], "~r~~h~You are in AFK mode. Type /back to return.");
	PlayerTextDrawShow(playerid, InfoTD[playerid]);
	/*if(strlen(PlayerName) < 18)
	{
		strins(PlayerName, "[AFK]", 0);
		SetPlayerName(playerid, PlayerName);
		SetPVarInt(playerid, "nameChanged", 1);
	}*/
	SetPlayerHealth(playerid, 9999);
	ResetPlayerWeapons(playerid);
	AFK[playerid] = 1;
	PlayerPlaySound(playerid, 1185, 0, 0, 0);
	return true;
}

CMD:forceafk(playerid, params[])
{
	if(pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "k<player_name>", otherid)) return Usage(playerid, "/forceafk <playerid>");

	if(otherid == INVALID_PLAYER_ID) return	Error(playerid, "Player is not connected!");
	if(pMute[otherid]) return Error(playerid, "This player is muted. They cannot go afk.");
	if(AFK[otherid] == 1) return cmd_back(otherid);

	if(InDM[playerid] != 0 || InEvent[playerid] != 0) cmd_leave(otherid);
	cmd_afk(otherid, "");
	return 1;
}

CMD:back(playerid)
{
	if(AFK[playerid] == 0)
		return SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "ORANGE_E"You are not currently AFK.");

	AFK[playerid] = 0;
	/*if(GetPVarInt(playerid, "nameChanged"))
	{
		GetPlayerName(playerid, PlayerName, 24);
		strdel(PlayerName, 0, 5);
		SetPlayerName(playerid, PlayerName);
		DeletePVar(playerid, "nameChanged");
	}*/

	LoadPlayerPosition(playerid);
	SetPlayerHealth(playerid, 98);
	if(GOD[playerid] == 0) GiveSpawnWeapons(playerid);

	format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "PINK_E"is now back from being AFK!", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	format(str, sizeof(str), "4Server:2 %s(%i) is back from being AFK.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "**[AFK]** %s(%i) isn't away from keyboard anymore.", pName[playerid], playerid);
	//DCC_SendChannelMessage(Channel_Echo, str);
	SetPVarInt(playerid, "InfoTDshown", -1);
	PlayerTextDrawHide(playerid, InfoTD[playerid]);
	PlayerPlaySound(playerid, 1186, 0, 0, 0);
	return true;
}
CMD:startreaction(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");
	if (sscanf(params, "s[26]", tmp))
	{
		Usage(playerid, "/startreaction <Reaction Characters>");
		return true;
	}
	if(strlen(tmp) > 25) return Error(playerid, "Reaction must be shorter than 24 characters.");
	reactionAward = 0;
	reactionTimeStart = 0;
	format(xChars, sizeof(xChars), "%s", tmp);

	reactionAward = strlen(xChars) * 1000;
	format(str, sizeof(str), ""RED_E"ReactionTest :: (%d) "LB_E"The first one to type'"YELLOW_E"%s"LB_E"' wins 2 score and "LG_E"$%d!", random(100) , tmp, reactionAward);
	SendClientMessageToAll(COLOR_PINK, str);
	format(str, sizeof(str), "3,1ReactionTest:4 The first one to type '%s' wins 2 score and $%d!", tmp, reactionAward);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	format(str, sizeof(str), "**[Reaction]** The first one to type '%s' wins 2 score and $%d!", tmp, reactionAward);
	//DCC_SendChannelMessage(Channel_Echo, str);

	reactionActive = true;
	reactionTimeStart = GetTickCount();
	return true;
}
CMD:playsong(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");

	new songname[40];
	if (sscanf(params, "s[30]", songname))
	{
		Usage(playerid, "/playsong <songname>");
		return true;
	}
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	format(tmp, sizeof(tmp), "http://serverserver.com/music/%s.mp3", songname);
	foreach(new ii : Player)
	{
		if(IsPlayerInRangeOfPoint(ii, 35.0, POS[0], POS[1], POS[2]))
		{
			if(GetPVarType(ii, "MusicDisabled") == 0)
			{
				PlayAudioStreamForPlayer(ii, tmp);
			}
		}
	}
	return true;
}
CMD:playsongforall(playerid, params[])
{
	if(pAdmin[playerid] < 4)
		return Error(playerid, "You are not authorized to use this command!");

	new songname[40];
	if (sscanf(params, "s[30]", songname))
	{
		Usage(playerid, "/playsong <songname>");
		return true;
	}
	format(tmp, sizeof(tmp), "http://serverserver.com/music/%s.mp3", songname);
	foreach(new ii : Player)
	{
		if(GetPVarType(ii, "MusicDisabled") == 0)
		{
			PlayAudioStreamForPlayer(ii, tmp);
		}
	}
	return true;
}
CMD:aopen(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	MoveDynamicObject(Gate[5], 404.0100, 2595.6599, 24.1879, 3);
	SetTimer("CloseaHouseGate", 3000, false);
	GameTextForPlayer(playerid,"~g~~h~Opening..", 2000, 5);
	SendClientMessage(playerid, COLOR_YELLOW, "You have opened the house garage!");
	return true;
}

CMD:stopmusicforall(playerid)
{
	if(pAdmin[playerid] != 6)
		return Error(playerid, "You are not authorized to use this command!");
	foreach(new ii : Player)
	{
		StopAudioStreamForPlayer(ii);
	}
	return true;
}
CMD:stopsound(playerid) return cmd_stopmusic(playerid);
CMD:stopmusic(playerid)
{
	StopAudioStreamForPlayer(playerid);
	SetPVarInt(playerid, "MusicDisabled", 1);
	return true;
}
CMD:playmusic(playerid)
{
	DeletePVar(playerid, "MusicDisabled");
	return true;
}

CMD:helmet(playerid)
{
	if(GetPVarInt(playerid, "HelmetDisabled") == 0)
	{
		SetPVarInt(playerid, "HelmetDisabled", 1);
		SendClientMessage(playerid, COLOR_YELLOW, "Helmet disabled!");
		if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
	}
	else
	{
		DeletePVar(playerid, "HelmetDisabled");
		SendClientMessage(playerid, COLOR_YELLOW, "Helmet enabled!");
		if(IsBikeModel(GetVehicleModel(GetPlayerVehicleID(playerid))))
		{
			GivePlayerHelmet(playerid);
		}
	}
	return 1;
}
CMD:rules(playerid)
{
	new line3[1500];
	strcat(line3, ""YELLOW_E"You must follow these rules in order to play on this server, failure to comply will result in "RED_E"punishments!"LG_E"\n\n\
	 1)  "LB2_E"Do not use cheats or any type of mods that interfere in multiplayer gameplay. \n\
	         (Cleo is NOT allowed, ENB, Car, Skin, Weapon mods are allowed.)");

	strcat(line3, ""LG_E"\n2)  "LB2_E"Do not advertise here, this will result in a permanent ban."LG_E"\n\
	 3)  "LB2_E"Do not insult other players or staff members."LG_E"\n\
	 4)  "LB2_E"Do not scream hacker on chat, use /report!"LG_E"\n\
	 5)  "LB2_E"Do not flame or insult players, this can be taken through /pm.");

	strcat(line3, "\n"LG_E"6)  "LB2_E"Do not constantly use caps in chat, spamming will result in a kick."LG_E"\n\
	 7)  "LB2_E"Do not abuse any type of bugs or glitches (C-Bug and 2Shotting is allowed)"LG_E"\n\
	 8)  "LB2_E"Do not annoy admins or constantly ask for free things."LG_E"\n\
	 9)  "LB2_E"Do not farm your stats or achievements."LG_E"\n\
	10) "LB2_E"Do not register multiple accounts for no reason.");

	strcat(line3,"\n"LG_E"11) "LB2_E"Do not driveby in spawn areas and do not constantly spawnkill."LG_E"\n\
	12) "LB2_E"Do not spam the chat or private messages."LG_E"\n\
	13) "LB2_E"Do not sell, share or trade your account with other players."LG_E"\n\
	14) "LB2_E"We do not refund stupidity");

	strcat(line3, "\n"YELLOW_E"\nBe sure to follow these rules in order to avoid punishment, if you disagree with any of the above quit the server now."LG_E"\n\
	For more information visit our forum at serverserver.com");

	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Server Rules", line3, "OK", "");
	return true;
}

CMD:moneybag(playerid) return cmd_mb(playerid);
