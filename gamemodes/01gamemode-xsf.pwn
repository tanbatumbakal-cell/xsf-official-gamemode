CMD:groupwar(playerid, params[])
{
	new gid, homeCount=0, awayCount=0, trID;
	if(pGroupID[playerid] == 0) return Error(playerid, "You must be in a group to use this command!");
	foreach(new i : Player)
	{
	    if(pGroupID[playerid] == pGroupID[i])
	    {
	        if(ParticipatingWar[playerid] == 1)
	        {
	            return Error(playerid, "One or more players of your group are already in a war!");
			}
		}
	}
	if(ParticipatingWar[playerid] == 1) return Error(playerid, "You are already in another war!");
	if(pGroupRank[playerid] < 5) return Error(playerid, "You must be at least the co-leader of the group to send war requests!");
	if(sscanf(params, "i", gid)) return SendClientMessage(playerid, -1, "{FF0000}Syntax: {FFFFFF}/groupwar [group id (/groups)]");
	if(gid == pGroupID[playerid]) return Error(playerid, "You cannot request a group war against your own group!");
	foreach(new i : Player)
	{
	    if(pGroupID[i] == gid && !InEvent[i])
	    {
	        awayCount++;
	        trID=i;
		}
		if(pGroupID[i] == pGroupID[playerid] && !InEvent[i])
		{
		    homeCount++;
		}
	}
	if(awayCount >= 1)
	{
	    format(str, sizeof str, "{FF0000}You have been invited to war by %s (ID %i) (Your members: %i; their members: %i) (/acceptwar)", pGroupName[playerid], pGroupID[playerid], awayCount, homeCount);
	    SendGroupMessage(trID, str);
	    GangWarRequester[pGroupID[trID]] = pGroupID[playerid];

	    format(str, sizeof str, "{FF0000}You have invited %s (ID %i) to war (Your members: %i; their members: %i)", pGroupName[trID], pGroupID[trID], homeCount, awayCount);
	    SendGroupMessage(playerid, str);
	    new Float:Loc[3];
	    GetPlayerPos(playerid, Loc[0], Loc[1], Loc[2]);
	    GangWarLoc[pGroupID[trID]][0] = Loc[0];
	    GangWarLoc[pGroupID[trID]][1] = Loc[1];
	    GangWarLoc[pGroupID[trID]][2] = Loc[2];
	}
	else Error(playerid, "The enemy team does not have enough players online");
	return 1;
}

CMD:acceptwar(playerid, params[])
{
    if(pGroupID[playerid] == 0) return Error(playerid, "You must be in a group to use this command!");
	foreach(new i : Player)
	{
	    if(pGroupID[playerid] == pGroupID[i])
	    {
	        if(ParticipatingWar[playerid] == 1)
	        {
	            return Error(playerid, "One or more players of your group are already in a war!");
			}
		}

	}
	if(ParticipatingWar[playerid] == 1) return Error(playerid, "You are already in another war!");
    if(pGroupRank[playerid] < 5) return Error(playerid, "You must be at least the co-leader of the group to accept war requests!");
	if(GangWarRequester[pGroupID[playerid]] > 0)
	{
	    new trID;

		foreach(new i : Player)
		{
		    if(pGroupID[i] == GangWarRequester[pGroupID[playerid]])
		    {
		        trID=i;
				break;
			}
		}

	    format(str, sizeof str, "{FF0000}Your group war request has been accepted by %s", pGroupName[playerid]);
	    SendGroupMessage(trID, str);

	    format(str, sizeof str, "{FF0000}You have accepted %s's group war request.", pGroupName[trID]);
	    SendGroupMessage(playerid, str);

	    for(new i=0; i < MAX_PLAYERS;i++)
		{
		    if(IsPlayerConnected(i))
		    {
			    if(pGroupID[i] == GangWarRequester[pGroupID[playerid]] || pGroupID[i] == pGroupID[playerid])
			    {
					if(AFK[i] == 0)
					{
						SetPlayerHealth(playerid, 98);
		                GodModeLabel(playerid, false);

					    GiveSpawnWeapons(playerid);

				        SetPlayerPosition(i, GangWarLoc[pGroupID[playerid]][0], GangWarLoc[pGroupID[playerid]][1], GangWarLoc[pGroupID[playerid]][2], 360.0000);
				        ParticipatingWar[i] = 1;
				        WarAway[i] = pGroupID[playerid];
				        SetPlayerVirtualWorld(i, WarAway[i]);
			        }
				}
			}
		}

		warStats[pGroupID[trID]] = 0;
		warStats[pGroupID[playerid]] = 0;

		GangWarRequester[pGroupID[playerid]] = 0;
		SetTimerEx("WarEnd", 300000, false, "ii",  pGroupID[trID], pGroupID[playerid]);
		GangWarTimer[pGroupID[playerid]] = SetTimerEx("WarMinCounter", 60000, true, "ii", pGroupID[trID], pGroupID[playerid]);
		GangWarMinutes[pGroupID[playerid]] = 5;
	}
	return 1;
}

forward WarEnd(team1, team2);
public WarEnd(team1, team2)
{
	new t1p, t2p;

    foreach(new i : Player)
	{
	    if(pGroupID[i] == team1 && ParticipatingWar[i] == 1)
	    {
	        ParticipatingWar[i] = 0;
	        OpponentGang[i] = 0;
	        SendClientMessage(i, -1, "War ended!");
	        t1p = i;
	        SetPlayerVirtualWorld(i, 0);
		}
		if(pGroupID[i] == team2 && ParticipatingWar[i] == 1)
		{
	        ParticipatingWar[i] = 0;
	        OpponentGang[i] = 0;
	        SendClientMessage(i, -1, "War ended!");
	        t2p = i;
	        SetPlayerVirtualWorld(i, 0);
		}
	}
	new result[128];
	if(warStats[team1] > warStats[team2]) {
	    format(result, sizeof result, "{FF0000}%s has won group war against %s [%i - %i]", pGroupName[t1p], pGroupName[t2p], warStats[team1], warStats[team2]);
	}
	else if(warStats[team1] < warStats[team2]) {
	    format(result, sizeof result, "{FF0000}%s has won group war against %s [%i - %i]", pGroupName[t2p], pGroupName[t1p], warStats[team2], warStats[team1]);
	}
	else format(result, sizeof result, "{FF0000}Group war between %s and %s ended with a draw [%i - %i]", pGroupName[t1p], pGroupName[t2p], warStats[team2], warStats[team1]);
	SendClientMessageToAll(-1, result);

	KillTimer(GangWarTimer[team2]);
	KillTimer(GangWarTimer[team1]);
	return 1;
}

forward WarMinCounter(team1, team2);
public WarMinCounter(team1, team2)
{
    new t1p, t2p;

    foreach(new i : Player)
	{
	    if(pGroupID[i] == team1 && ParticipatingWar[i] == 1)
	    {
	        t1p = i;
		}
		if(pGroupID[i] == team2 && ParticipatingWar[i] == 1)
		{
	        t2p = i;
		}
	}

    GangWarMinutes[team2] -= 1;
    new stri[128];
    format(stri, sizeof stri, "{FF0000}[WAR STATUS] %i minutes of war remaining! [%s: %i - %s: %i]", GangWarMinutes[team2], pGroupName[t1p], warStats[team1], pGroupName[t2p], warStats[team2]);
    foreach(new i : Player)
	{
	    if(pGroupID[i] == team1)
	    {
	        if(GangWarMinutes[team2] > 0) SendClientMessage(i, -1, stri);
		}
		if(pGroupID[i] == team2)
		{
	        if(GangWarMinutes[team2] > 0) SendClientMessage(i, -1, stri);
		}
	}
	return 1;
}

CMD:gangs(playerid) return cmd_groups(playerid);
CMD:groups(playerid)
{
	new Iterator:Gangs[2]<MAX_PLAYERS>;
	new finstring[2048];

	Iter_Init(Gangs);

	foreach(new ii : Player)
	{
		if(pGroupID[ii] > 0 && !Iter_Contains(Gangs[0], pGroupID[ii]))
		{
			Iter_Add(Gangs[0], pGroupID[ii]);
			Iter_Add(Gangs[1], ii);
		}
	}

	if(Iter_Count(Gangs[1]) > 0)
	{
		format(tmp, sizeof(tmp), ""WHITE_E"%i groups online:\n", Iter_Count(Gangs[1]));
		strcat(finstring, tmp);

		for(new i = Iter_First(Gangs[1]), count = 0; i != Iter_End(Gangs[1]); i = Iter_Next(Gangs[1], i), ++count)
		{
			if(count <= 40)
			{
				format(tmp, sizeof(tmp), "\n%i - %s [ID: %i}", count + 1, pGroupName[i], pGroupID[i]);
				strcat(finstring, tmp);
			}
			else
			{
				format(tmp, sizeof(tmp), "\n[... too many online]");
				strcat(finstring, tmp);
				break;
			}
		}
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server - "WHITE_E"Groups Online", finstring, "OK", "");
	}
	else
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no groups online!");
	}
	return 1;
}


CMD:topgroups(playerid)
{
	format(query, sizeof(query), "SELECT gName,gScore,gFounder FROM groups WHERE gID ORDER BY gScore DESC LIMIT 20;");
	MySQL_query(query, true, "ShowTopGroups", "i", playerid);
	return true;
}

function ShowTopGroups(playerid)
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new count = 0,
			finstring[2400];

		for(new i = 0; i < rows; i++)
		{
			new groupname[25],
				groupleader[25],
				groupscore = 0;

			cache_get_field_content(i, "gName", groupname, 25);
			groupscore  = cache_get_field_content_int(i, "gScore");
			cache_get_field_content(i, "gFounder", groupleader, 25);

			format(tmp, sizeof(tmp), "\n"LB_E"%i) "WHITE_E"%s   "RED_E"||   "WHITEP_E"Founder: %s   "RED_E"||   "WHITE_E"Score: %d", count + 1, groupname, groupleader, groupscore);
			strcat(finstring, tmp);
			count++;
		}
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Top Groups", finstring, "OK", "");
	}
}
CMD:toprp(playerid)
{
	format(query, sizeof(query), "SELECT name,pubg_rankpoints FROM players WHERE reg_id ORDER BY pubg_rankpoints DESC LIMIT 10;");
	MySQL_query(query, true, "ShowTopRP", "i", playerid);
	return true;
}
CMD:racerecords(playerid,params[])
{
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT holder,ms,time,race FROM `racetimes` WHERE regid ORDER BY `time` DESC LIMIT 10;");
	MySQL_query(query, true, "RaceRecordLoad", "i", playerid);
	return 1;
}
CMD:checkrecord(playerid,params[])
{
	if(sscanf(params, "s[40]", tmp))
	{
		Usage(playerid, "/checkrecord <racename>");
		return true;
	}
	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT holder,ms,time FROM `racetimes` WHERE `race` = '%e'" , tmp);
	MySQL_query(query, true, "CheckRaceRecord", "is", playerid , tmp);
	return 1;
}
function CheckRaceRecord(playerid,race[])
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new name[25], ms , time , count = 0,string[350];

		cache_get_field_content(0, "holder", name, 25);
		ms  = cache_get_field_content_int(0, "ms");
		time  = cache_get_field_content_int(0, "time");
		localtime(time, tmParam);
		strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);
		if(ms < 60000) format(str,sizeof(str),"%02d.%03d"  , (ms%60000)/1000, (ms%1000));
		else format(str,sizeof(str),"%02d:%02d.%03d" , (ms/60000), (ms%60000)/1000, (ms%1000));
		if(ms != 0)
		{
			format(string, sizeof(string), ""WHITE_E"%i) "WHITEP_E"Race Name: %s   "RED_E"||   "WHITEP_E"Record Holder: %s "RED_E"||   "WHITEP_E" Created on %s "RED_E"||   "WHITEP_E" Time %s\n", count + 1, race, name,tmp,str);
		}
		else
		{
		    return Error(playerid,"Race doesn't have a record yet.");
		}
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Race Record", string, "OK", "");
	}
	else
	{
	    return Error(playerid,"Race doesn't exists");
	}
	return 1;
}
function RaceRecordLoad(playerid)
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new finstring[3000] , count = 0;
		for(new i = 0; i < rows; i++)
		{
			new name[25] , race[30], ms , time ,string[350];

			cache_get_field_content(i, "holder", name, 25);
			cache_get_field_content(i, "race", race, 25);
			ms  = cache_get_field_content_int(i, "ms");
			time  = cache_get_field_content_int(i, "time");
			localtime(time, tmParam);
			strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);

	        if(ms < 60000) format(str,sizeof(str),"%02d.%03d"  , (ms%60000)/1000, (ms%1000));
	        else format(str,sizeof(str),"%02d:%02d.%03d" , (ms/60000), (ms%60000)/1000, (ms%1000));
			if(ms != 0)
			{
				format(string, sizeof(string), ""WHITE_E"%i) "WHITEP_E"Race Name: %s   "RED_E"||   "WHITEP_E"Record Holder: %s "RED_E"||   "WHITEP_E" Created on %s "RED_E"||   "WHITEP_E" Time %s\n", count + 1, race, name,tmp,str);
				strcat(finstring, string);
				count++;
			}
		}
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Last 10 Race Records", finstring, "OK", "");
	}
}
function ShowTopRP(playerid)
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new finstring[2400];
		for(new i = 0; i < rows; i++)
		{
			new name[25],
				rank_points = 0,
				count = 0;

			cache_get_field_content(i, "name", name, 25);
			rank_points  = cache_get_field_content_int(i, "pubg_rankpoints");
			if(rank_points != 0)
			{
				format(tmp, sizeof(tmp), ""WHITE_E"%i) "WHITEP_E"%s  "RED_E"||  "LB_E"Rank Points: %i\n", count + 1, name, rank_points);
				strcat(finstring, tmp);
				count++;
			}
			else
			{
				format(tmp, sizeof(tmp), ""WHITE_E"%i) ----\n", count + 1);
				strcat(finstring, tmp);
			}
		}
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Top Rank Points", finstring, "OK", "");
	}
}
CMD:score(playerid) return cmd_topscore(playerid);
CMD:topscore(playerid)
{
	new score[MAX_PLAYERS][e_top_score],
		finstring[2048];

	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i) && pHidden[i] == 0)
		{
			score[i][E_playerid] = i;
			score[i][E_pscore] = pScore[i];
		}
		else
		{
			score[i][E_playerid] = -1;
			score[i][E_pscore] = -1;
		}
	}

	SortDeepArray(score, E_pscore, .order = SORT_DESC);

	for(new i = 0; i < 20; i++)
	{
		if(score[i][E_pscore] != -1 && score[i][E_pscore] != 0)
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) "WHITEP_E"%s(%d)  "RED_E"||  "LB_E"Score: %i\n", i + 1, pName[score[i][E_playerid]], score[i][E_playerid], score[i][E_pscore]);
			strcat(finstring, tmp);
		}
		else
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) ----\n", i + 1);
			strcat(finstring, tmp);
		}
	}
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server - "WHITE_E"Top Scores", finstring, "Close", "");
	return 1;
}
