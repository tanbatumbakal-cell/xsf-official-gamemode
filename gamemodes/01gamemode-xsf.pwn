		return 1;
	}*/

	// Main Statistics
	switch(pAdmin[p2])
	{
		case 0:
		{
			if(pPremium[p2] > 0)
			{
				if(pPremium[p2] == 3)
				{
					if(premiumExpired[p2] != 0) str3 = ""LB2_E"> Status: "LB_E"VIP Player (Temporary)";
					else str3 = ""LB2_E"> Status: "LB_E"VIP Player";
				}
				else
				{
					if(premiumExpired[p2] != 0) format(str3, sizeof(str3), ""LB2_E"> Status: "WHITE_E"Premium Member (Level: %d) (Temp)", pPremium[p2]);
					else format(str3, sizeof(str3), ""LB2_E"> Status: "WHITE_E"Premium Member (Level: %d)", pPremium[p2]);
				}
			}
			else str3 = ""LB2_E"> Status: "WHITE_E"Regular Player";
			if(Helper[p2] == 1) str3 = ""LB2_E"> Status: "HELPER_C"Helper";
			if(pMapper[p2] == 1) str3 = ""LB2_E"> Status: "HELPER_C"Mapper";
			if(pDeveloper[p2] == 1) str3 = ""LB2_E"> Status: "HELPER_C"Developer";
		}
		case 1..3: str3 = ""LB2_E"> Status: {D300EB}Admin";
		case 4: str3 = ""LB2_E"> Status: {F7DC0C}Lead Admin";
		case 5: str3 = ""LB2_E"> Status: {2633E0}Manager";
		case 6: str3 = ""LB2_E"> Status: {FF0000}Owner";
	}
	if(pDeveloper[p2] == 1 && pAdmin[p2] != 6) str3 = ""LB2_E"> Status: "HELPER_C"Developer";
	if(pHidden[p2] != 0) str3 = ""LB2_E"> Status: "WHITE_E"Regular Player";

	//new pCity[28];
	if(pGroupID[p2] != -1)
	{

		format(str11, sizeof(str11), ""LB2_E"> Group: "WHITE_E"%s "RED_E"|| "LB2_E"Rank: "WHITE_E"%s", pGroupName[p2], GetGroupRank(pGroupID[p2],pGroupRank[p2]));
	}
	else format(str11, sizeof(str11), ""LB2_E"> Group: "WHITE_E"None "RED_E"|| "LB2_E"Rank: "WHITE_E"None");
	//format(str9, sizeof(str9), ""LB2_E"> Country: "WHITE_E"- "RED_E"|| "LB2_E"City: "WHITE_E"- "RED_E"|| "LB2_E"GMT: "WHITE_E"-");
	format(line4, sizeof(line4), "{%06x}%s (ID: %i) "LB_E"stats:\n\n{FF4545}Main Statistics:\n%s\n\
	"LB2_E"> Score: "WHITE_E"%d\n"LB2_E"> Cookies: "WHITE_E"%d\n"LB2_E"> Money: "LG_E"$"WHITE_E"%s\n"LB2_E"> Bank Money: "LG_E"$"WHITE_E"%s\n%s\n"LB2_E"> Rank: "WHITE_E"%s\n\n", pColor[p2], giveplayer, p2, str3, pScore[p2], pCookies[p2], ToCurrency(pCash[p2]), ToCurrency(BankMoney[p2]), str11, GetLevelName(p2));
	strcat(line3, line4);

	/// General Statistics
	if(pCurrHours[p2] == 0)
	{
		if(pCurrMinutes[p2] == 0)
		{
			format(str5, sizeof(str5), ""LB2_E"> Current Online Time: "WHITE_E"%d seconds", pCurrSeconds[p2]);
		}
		else format(str5, sizeof(str5), ""LB2_E"> Current Online Time: "WHITE_E"%d minutes and %d seconds", pCurrMinutes[p2], pCurrSeconds[p2]);
	}
	else format(str5, sizeof(str5), ""LB2_E"> Current Online Time: "WHITE_E"%d %s and %d minutes", pCurrHours[p2], pCurrHours[p2] == 1 ? ("hour") : ("hours"), pCurrMinutes[p2]);
	if(pTotalHours[p2] == 0)
	{
		if(pTotalMinutes[p2] == 0)
		{
			format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d seconds", pTotalSeconds[p2]);
		}
		else format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d minutes and %d seconds", pTotalMinutes[p2], pTotalSeconds[p2]);
	}
	else format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d hours and %d minutes", pTotalHours[p2], pTotalMinutes[p2]);

	format(line4, sizeof(line4),  "{FF4545}General Statistics:\n"LB2_E"> Member Since: "WHITE_E"%s\n%s\n%s\n", pRegDate[p2], str5, str4);
	strcat(line3, line4);

	new deaths = pInfo[p2][pDeaths];

	deaths = (deaths == 0) ? (1) : (deaths);

	format(line4, sizeof(line4), ""LB2_E"> Kills: "WHITE_E"%d / "LB2_E"Deaths: "WHITE_E"%d "RED_E"|| "LB2_E"KDR: "WHITE_E"%0.2f\n"LB2_E"> Highest Killstreak: "WHITE_E"%d\n\
	"LB2_E"> Achievements Completed: "WHITE_E"%d"RED_E"/"WHITE_E"28\n", pInfo[p2][pKills], pInfo[p2][pDeaths], Float:pInfo[p2][pKills] / Float:deaths, TotalKillStreak[p2], GetPlayerAchievement(p2));
	strcat(line3, line4);

	// Other Statistics
	switch(pSpawnPlace[p2])
	{
		case -1: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Random.";
		case 0: str7 = ""LB2_E"> Spawn Place: "WHITE_E"San Fierro";
		case 1: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Bayside";
		case 2: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Abandoned Airport";
		case 3: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Las Venturas Airport";
		case 4: str7 = ""LB2_E"> Spawn Place: "WHITE_E"HalfPipe";
		case 5: str7 = ""LB2_E"> Spawn Place: "WHITE_E"San Fierro Airport";
		case 6: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Own House.";
		case 11: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Group spawn.";
		case 12: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Custom spawn.";
	}
	GetPlayerCountry(p2, pCountry[p2]);
	if(pTogCountry[p2] == 0) format(line4, sizeof(line4), "\n{FF4545}Other Statistics:\n%s\n"LB2_E"> Country: "WHITE_E"%s\n"LB2_E"> Skin ID: "WHITE_E"%d\n"LB2_E"> Duels Won: "WHITE_E"%d\n"LB2_E"> Events Won: "WHITE_E"%d\n"LB2_E"> Arrests: "WHITE_E"%d\n\
	"LB2_E"> Races Won: "WHITE_E"%d\n"LB2_E"> PUBGs Won: "WHITE_E"%d\n"LB2_E"> Moneybags Found: "WHITE_E"%d\n", str7, pCountry[p2], GetPlayerSkin(p2), pDuelsWon[p2], pInfo[p2][pEventsWon], pArrests[p2],pInfo[p2][pRacesWon],PUBG_Wins[p2], pInfo[p2][pMBFound]);

	else format(line4, sizeof(line4), "\n{FF4545}Other Statistics:\n%s\n"LB2_E"> Skin ID: "WHITE_E"%d\n"LB2_E"> Duels Won: "WHITE_E"%d\n"LB2_E"> Events Won: "WHITE_E"%d\n"LB2_E"> Arrests: "WHITE_E"%d\n\
	"LB2_E"> Races Won: "WHITE_E"%d\n"LB2_E"> PUBGs Won: "WHITE_E"%d\n"LB2_E"> Moneybags Found: "WHITE_E"%d\n", str7, GetPlayerSkin(p2), pDuelsWon[p2], pInfo[p2][pEventsWon], pArrests[p2], pInfo[p2][pRacesWon],PUBG_Wins[p2], pInfo[p2][pMBFound]);
	strcat(line3, line4);

	if(GetOwnedHouses(p2) > 0) {
		format(line4, sizeof(line4), ""LB2_E"> Owned house ids: "WHITE_E"");
		new house_count = GetOwnedHouses(p2);
		new h = 0;

		Loop(itt, house_count+1, 1)
		{
			h = ReturnPlayerHouseID(p2, itt);
			if(itt == house_count) format(line4, sizeof(line4), "%s%i", line4, h);
			else format(line4, sizeof(line4), "%s%i, ", line4, h);
		}
		format(line4, sizeof(line4), "%s\n", line4);
		strcat(line3, line4);
	}

	format(line4, sizeof(line4), ""LB2_E"> Cookie Jars Found: "WHITE_E"%d\n"LB2_E"> Reactions Won: "WHITE_E"%d\n"LB2_E"> Math Quizzes Won: "WHITE_E"%d\n"LB2_E"> Fallouts Won: "WHITE_E"%d\n"LB2_E"> Derbies Won: "WHITE_E"%d\n\
	"LB2_E"> Report Points: "WHITE_E"%d\n\n"LB2_E"> Description:\n   "WHITEP_E"%s\n", pCookieJars[p2], reactionsWon[p2], mathsWon[p2], pFallouts[p2], pDerbys[p2], pReportPoints[p2], pDescription[p2]);
	strcat(line3, line4);

	if(p2 == playerid)
	{
		ShowPlayerDialog(playerid, DESCRIPTION_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Statistics", line3, "Edit", "Close");
	}
	else ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Statistics", line3, "Close", "");
	return true;
}
DisplayCnRStats(playerid, p2)
{
	if(!IsPlayerConnected(p2) || !IsPlayerConnected(playerid)) return Error(playerid, "Player not connected!");
	if(!pLogged[p2]) return Error(playerid, "Player is not logged in!");
	new longstr[900];
	if(!pHidden[p2]) format(longstr, sizeof(longstr), "{%06x}%s (ID: %i) "WHITEP_E"stats:\n\n{FF4545}Cops and Robbers Stats:\n"LB_E"> Arrests: "WHITE_E"%d\n"LB_E"> Takedowns: "WHITE_E"%d\n\
			"LB_E"> Robberies: "WHITE_E"%d\n"LB_E"> Player Robberies: "WHITE_E"%d\n"LB_E"> Cops Killed: "WHITE_E"%d\n"LB_E"> Times Arrested: "WHITE_E"%d", pColor[p2], pName[p2], p2, pArrests[p2], pTakedowns[p2], pRobberies[p2], pPlayerRobberies[p2], pCopKills[p2], pTimesArrested[p2]);
	else format(longstr, sizeof(longstr), "{%06x}%s (ID: %i) "WHITEP_E"stats:\n\n{FF4545}Cops and Robbers Stats:\n"LB_E"> Arrests: "WHITE_E"0\n"LB_E"> Takedowns: "WHITE_E"0\n\
			"LB_E"> Robberies: "WHITE_E"0\n"LB_E"> Player Robberies: "WHITE_E"0\n"LB_E"> Cops Killed: "WHITE_E"0\n"LB_E"> Times Arrested: "WHITE_E"0", pColor[p2], pName[p2], p2);

	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"CnR Statistics", longstr, "Close", "");
	return true;
}
DisplayPUBGStats(playerid, p2)
{
	if(!IsPlayerConnected(p2) || !IsPlayerConnected(playerid)) return Error(playerid, "Player not connected!");
	if(!pLogged[p2]) return Error(playerid, "Player is not logged in!");
	new longstr[900];
	if(!pHidden[p2]) format(longstr, sizeof(longstr), "{%06x}%s (ID: %i) "WHITEP_E"stats:\n\n{FF4545}PUBG Statistics:\n"LB_E"> PUBG Wins: "WHITE_E"%d\n"LB_E"> PUBG Rank Points: "WHITE_E"%d\n"LB_E"> PUBG Kill Points: "WHITE_E"%d\n"LB_E"> PUBG Kills: "WHITE_E"%d\n"LB_E"> PUBG Deaths: "WHITE_E"%d\n"LB_E"> PUBG KDR: "WHITE_E"%.2f", pColor[p2], pName[p2], p2, PUBG_Wins[p2] , PUBG_RP[p2],PUBG_KP[p2] , PUBG_Kills[p2] , PUBG_Deaths[p2] ,Float:PUBG_Kills[p2] / PUBG_Deaths[p2]);
	else format(longstr, sizeof(longstr), "{%06x}%s (ID: %i) "WHITEP_E"stats:\n\n{FF4545}PUBG Statistics:\n"LB_E"> PUBG Wins: "WHITE_E"%d\n"LB_E"> PUBG Points: "WHITE_E"%d\n"LB_E"> PUBG Kills: "WHITE_E"%d\n"LB_E"> PUBG Deaths: "WHITE_E"%d\n"LB_E"> PUBG KDR: "WHITE_E"%.2f", pColor[p2], pName[p2], p2,0,0,0,0.0);
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"CnR Statistics", longstr, "Close", "");
	return true;
}
new p3 = 420;


function LoadOfflineStats(playerid, PlayersName[])
{
	if(!cache_num_rows())
	{
		format(str, sizeof(str), ""RED_E"[ERROR] "GREY_E"Account '%s' does not exist.", PlayersName);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	else
	{
		format(str, sizeof(str), ""GREEN_E"[Success] "GREY_E"Account '%s' does exist.", PlayersName);
		SendClientMessage(playerid, COLOR_GREY, str);
		pAdmin[p3] = cache_get_field_content_int(0, "adminlevel"); 
		pTotalHours[p3] = cache_get_field_content_int(0, "hours");
		pTotalMinutes[p3] = cache_get_field_content_int(0, "minutes");
		pTotalSeconds[p3] = cache_get_field_content_int(0, "seconds");
		pInfo[p3][pKills] = cache_get_field_content_int(0, "kills");
		pInfo[p3][pDeaths] = cache_get_field_content_int(0, "deaths");
		pCash[p3] = cache_get_field_content_int(0, "money");
		pScore[p3] = cache_get_field_content_int(0, "score");
		pPremium[p3] = cache_get_field_content_int(0, "premium");
		pInfo[p3][pSaveSkin] = cache_get_field_content_int(0, "saveskin");
		pCookies[p3] = cache_get_field_content_int(0, "cookies");
		PUBG_Wins[p3] = cache_get_field_content_int(0, "pubg_wins");
		pInfo[p3][pEventsWon] = cache_get_field_content_int(0, "events_won");
		pInfo[p3][pRacesWon] = cache_get_field_content_int(0, "races_won");
		pInfo[p3][pMBFound] = cache_get_field_content_int(0, "MB_found");
		BankMoney[p3] = cache_get_field_content_int(0, "bmoney");
		reactionsWon[p3] = cache_get_field_content_int(0, "rtests");
		pArrests[p3] = cache_get_field_content_int(0, "arrests");
		TotalKillStreak[p3] = cache_get_field_content_int(0, "killstreak");
		pDuelsWon[p3] = cache_get_field_content_int(0, "duels_won");
		pFallouts[p3] = cache_get_field_content_int(0, "fallouts");
		pGroupID[p3] = cache_get_field_content_int(0, "group_id");
		pGroupRank[p3] = cache_get_field_content_int(0, "group_rank");
		pDerbys[p3] = cache_get_field_content_int(0, "derby_wins");
		pCookieJars[p3] = cache_get_field_content_int(0, "cookiejars");
		pSpawnPlace[p3] = cache_get_field_content_int(0, "spawnplace");
		mathsWon[p3] = cache_get_field_content_int(0, "maths");
		pReportPoints[p3] = cache_get_field_content_int(0, "report_points");
		Helper[p3] = cache_get_field_content_int(0, "helper");
		admOnTime[p3] = cache_get_field_content_int(0, "admOnTime");
		gSpawnPos[p3][0] = cache_get_field_content_float(0, "gSpawnX" );
		gSpawnPos[p3][1] = cache_get_field_content_float(0, "gSpawnY" );
		gSpawnPos[p3][2] = cache_get_field_content_float(0, "gSpawnZ" );
 		pSpawnPos[p3][0] = cache_get_field_content_float(0, "pSpawnX");
		pSpawnPos[p3][1] = cache_get_field_content_float(0, "pSpawnY");
		pSpawnPos[p3][2] = cache_get_field_content_float(0, "pSpawnZ");
		pSpawnPos[p3][3] = cache_get_field_content_float(0, "pSpawnA");
		pmhidden[p3] = cache_get_field_content_int(0, "pmhidden");
		cache_get_field_content(0, "reg_time", pRegDate[p3], 20);
		cache_get_field_content(0, "last_time", pLastDate[p3],20);
		cache_get_field_content(0, "description", pDescription[p3], 40);

		pLevel[p3] = GetLevel(pScore[p3]);

		if(Helper[p3] == 2) 
			pMapper[p3] = 1;
		else if(Helper[p3] == 3) 
			pDeveloper[p3] = 1;
		format(query, sizeof(query), "SELECT gName FROM groups WHERE gID=%d", pGroupID[p3]);
		new Cache:qResult = mysql_query(g_SQL_handle, query);
		if(cache_num_rows())
			cache_get_field_content(0, "gName", pGroupName[p3], 24);
		else
			format(pGroupName[p3], 24, "n/a");
		cache_delete(qResult);

		new line4[700];
		new line3[2000];
		new str3[80], str4[80], str7[80], str11[140];
		switch(pAdmin[p3])
		{
			case 0:
			{
				if(pPremium[p3] > 0)
				{
					if(pPremium[p3] == 3)
					{
						if(premiumExpired[p3] != 0) str3 = ""LB2_E"> Status: "LB_E"VIP Player (Temporary)";
						else str3 = ""LB2_E"> Status: "LB_E"VIP Player";
					}
					else
					{
						if(premiumExpired[p3] != 0) format(str3, sizeof(str3), ""LB2_E"> Status: "WHITE_E"Premium Member (Level: %d) (Temp)", pPremium[p3]);
						else format(str3, sizeof(str3), ""LB2_E"> Status: "WHITE_E"Premium Member (Level: %d)", pPremium[p3]);
					}
				}
				if(Helper[p3] == 0 && pPremium[p3] == 0) str3 = ""LB2_E"> Status: "WHITE_E"Regular Player";
				else if(Helper[p3] == 1) str3 = ""LB2_E"> Status: "HELPER_C"Helper";
				else if(pMapper[p3] == 1) str3 = ""LB2_E"> Status: "HELPER_C"Mapper";
				else if(pDeveloper[p3] == 1 && Helper[p3] == 3) str3 = ""LB2_E"> Status: "HELPER_C"Developer";
				else if(pPremium[p3] == 0 && pDeveloper[p3] == 0 && pMapper[p3] == 0 && Helper[p3] == 0) str3 = ""LB2_E"> Status: "WHITE_E"Regular Player";

			}
			case 1..3: str3 = ""LB2_E"> Status: {D300EB}Admin";
			case 4: str3 = ""LB2_E"> Status: {F7DC0C}Lead Admin";
			case 5: str3 = ""LB2_E"> Status: {2633E0}Manager";
			case 6: str3 = ""LB2_E"> Status: {FF0000}Owner";
		}
		if(pDeveloper[p3] == 1 && pAdmin[p3] != 6 && Helper[p3] == 3) str3 = ""LB2_E"> Status: "HELPER_C"Developer";
		if(pHidden[p3] != 0) str3 = ""LB2_E"> Status: "WHITE_E"Regular Player";
		//new pCity[28];
		if(pGroupID[p3] != -1)
		{
		   format(str11, sizeof(str11), ""LB2_E"> Group: "WHITE_E"%s "RED_E"|| "LB2_E"Rank: "WHITE_E"%s", pGroupName[p3],  GetGroupRank(pGroupID[p3],pGroupRank[p3]));
		}
		else format(str11, sizeof(str11), ""LB2_E"> Group: "WHITE_E"None "RED_E"|| "LB2_E"Rank: "WHITE_E"None");
		/*GetPlayerCity(p3, pCity, sizeof(pCity));
		format(str9, sizeof(str9), ""LB2_E"> Country: "WHITE_E"%s "RED_E"|| "LB2_E"City: "WHITE_E"%s "RED_E"|| "LB2_E"GMT: "WHITE_E"%d", pCountry[p3], pCity, GetPlayerGMT(p3));*/
		//format(str9, sizeof(str9), ""LB2_E"> Country: "WHITE_E"- "RED_E"|| "LB2_E"City: "WHITE_E"- "RED_E"|| "LB2_E"GMT: "WHITE_E"-");
		format(line4, sizeof(line4), ""WHITEP_E"%s's stats:\n\n{FF4545}Main Statistics:\n%s\n\
		"LB2_E"> Score: "WHITE_E"%d\n"LB2_E"> Cookies: "WHITE_E"%d\n"LB2_E"> Money: "LG_E"$"WHITE_E"%s\n"LB2_E"> Bank Money: "LG_E"$"WHITE_E"%s\n%s\n\n", PlayersName, str3, pScore[p3], pCookies[p3], ToCurrency(pCash[p3]), ToCurrency(BankMoney[p3]), str11);
		strcat(line3, line4);

		  /// General Statistics

		if(pTotalHours[p3] == 0)
		{
			if(pTotalMinutes[p3] == 0)
		    {
				format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d seconds", pTotalSeconds[p3]);
			}
			else format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d minutes and %d seconds", pTotalMinutes[p3], pTotalSeconds[p3]);
		}
		else format(str4, sizeof(str4), ""LB2_E"> Total Online Time: "WHITE_E"%d hours, %d minutes and %d seconds", pTotalHours[p3], pTotalMinutes[p3], pTotalSeconds[p3]);

		format(line4, sizeof(line4), "{FF4545}General Statistics:\n"LB2_E"> Member Since: "WHITE_E"%s\n"LB2_E"> Last Online: "WHITE_E"%s\n%s\n", pRegDate[p3], pLastDate[p3], str4);
		strcat(line3, line4);

		new deaths = pInfo[p3][pDeaths];

		//Set deaths to 1 if 0 to stop divide by 0
	    deaths = (deaths == 0) ? (1) : (deaths);

		format(line4, sizeof(line4), ""LB2_E"> Kills: "WHITE_E"%d / "LB2_E"Deaths: "WHITE_E"%d "RED_E"|| "LB2_E"KDR: "WHITE_E"%0.2f\n"LB2_E"> Highest Killstreak: "WHITE_E"%d\n\
		\n", pInfo[p3][pKills], pInfo[p3][pDeaths], Float:pInfo[p3][pKills] / Float:deaths, TotalKillStreak[p3]);
		strcat(line3, line4);

		// Other Statistics
		switch(pSpawnPlace[p3])
		{
		   case -1: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Random.";
		   case 0: str7 = ""LB2_E"> Spawn Place: "WHITE_E"San Fierro";
		   case 1: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Bayside";
		   case 2: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Abandoned Airport";
		   case 3: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Las Venturas Airport";
		   case 4: str7 = ""LB2_E"> Spawn Place: "WHITE_E"HalfPipe";
		   case 5: str7 = ""LB2_E"> Spawn Place: "WHITE_E"San Fierro Airport";
		   case 6: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Own House.";
		   case 11: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Group Spawn.";
		   case 12: str7 = ""LB2_E"> Spawn Place: "WHITE_E"Custom Spawn.";
		}
		format(line4, sizeof(line4), "{FF4545}Other Statistics:\n%s\n"LB2_E"> Skin ID: "WHITE_E"%d\n"LB2_E"> Duels Won: "WHITE_E"%d\n"LB2_E"> Events Won: "WHITE_E"%d\n"LB2_E"> Arrests: "WHITE_E"%d\n\
		"LB2_E"> Races Won: "WHITE_E"%d\n"LB2_E"> PUBGs Won: "WHITE_E"%d\n"LB2_E"> Moneybags Found: "WHITE_E"%d\n"LB2_E"> Cookie Jars Found: "WHITE_E"%d\n", str7, pInfo[p3][pSaveSkin], pDuelsWon[p3], pInfo[p3][pEventsWon], pArrests[p3], pInfo[p3][pRacesWon],PUBG_Wins[p3], pInfo[p3][pMBFound], pCookieJars[p3]);

		strcat(line3, line4);

		format(line4, sizeof(line4), ""LB2_E"> Reactions Won: "WHITE_E"%d\n"LB2_E"> Math Quizzes Won: "WHITE_E"%d\n"LB2_E"> Fallouts Won: "WHITE_E"%d\n"LB2_E"> Derbies Won: "WHITE_E"%d\n"LB2_E"> Report Points: "WHITE_E"%d\
		\n\n"LB2_E"> Description:\n   "WHITEP_E"%s\n", reactionsWon[p3], mathsWon[p3], pFallouts[p3], pDerbys[p3], pReportPoints[p3], pDescription[p3]);
		strcat(line3, line4);

		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Offline Statistics", line3, "Close", "");
	}
	return true;
}


// Achivements
GivePlayerAchievement(playerid, achname[], stuffz[])
{
	if(GetPVarInt(playerid, "AchShowing") == 1) return true;
	// Give Score Money
	GivePlayerCash(playerid, 100000);
	GivePlayerScore(playerid, 5);

	InfoTD_MSG(playerid, 5000, "~g~Congratulations, you've earned an achivement!~n~~g~$~w~100000 and 5 score!");
	format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "GREEN_E"has unlocked the achievement '%s'!", pColor[playerid], pName[playerid], playerid, achname);
	SendClientMessageToAll(COLOR_GREEN, str);
	SendClientMessage(playerid, COLOR_WHITEP, ""GREEN_E"*** "WHITEP_E"Type "WHITE_E"/ach "WHITEP_E"to view the achievements you have completed.");
	format(str, sizeof(str), "4Server:3 %s(%i) has unlocked the achievement '%s'!", pName[playerid], playerid, achname);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	// Show Achievement
	ShowPlayerAchievement(playerid, achname, stuffz);

	CheckPlayerAchievementCompleted(playerid);
	return true;
}
GivePlayerAchievementNoReward(playerid, achname[], stuffz[])
{
	if(GetPVarInt(playerid, "AchShowing") == 1) return true;
	// Give Score Money
	GivePlayerCash(playerid, 100000);
	GivePlayerScore(playerid, 5);

	InfoTD_MSG(playerid, 5000, "~g~Congratulations, you've earned an achivement!~n~~g~$~w~100000 and 5 score!");
	format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "GREEN_E"has unlocked the achievement '%s'!", pColor[playerid], pName[playerid], playerid, achname);
	SendClientMessageToAll(COLOR_GREEN, str);
	SendClientMessage(playerid, COLOR_WHITEP, ""GREEN_E"*** "WHITEP_E"Type "WHITE_E"/ach "WHITEP_E"to view the achievements you have completed.");
	format(str, sizeof(str), "4Server:3 %s(%i) has unlocked the achievement '%s'!", pName[playerid], playerid, achname);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	// Show Achievement
	ShowPlayerAchievement(playerid, achname, stuffz);
	return true;
}

GetPlayerAchievement(playerid)
{
	new achs;
	if(pAch1[playerid] == 1) achs++;
	if(pAch2[playerid] == 1) achs++;
	if(pAch3[playerid] == 1) achs++;
	if(pAch4[playerid] == 1) achs++;
	if(pAch5[playerid] == 1) achs++;
	if(pAch6[playerid] == 1) achs++;
	if(pAch7[playerid] == 1) achs++;
	if(pAch8[playerid] == 1) achs++;
	if(pAch9[playerid] == 1) achs++;
