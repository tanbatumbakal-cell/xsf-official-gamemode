CMD:pm(playerid, params[])
{
	if(pMute[playerid] > 0)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You are muted and can't PM! Mute will be lifted in %d seconds.", pMute[playerid]);
		SendClientMessage(playerid, COLOR_GREY, str);
		return true;
	}

	if(sscanf(params, "k<player_name>s[140]", otherid, tmp))
	{
		Usage(playerid, "/pm <ID> <Message>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
	{
		Error(playerid, "Player not connected!");
		return true;
	}
	if(otherid == playerid) return Error(playerid, "You can't PM yourself!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(ignore[otherid][playerid] == 1 && pAdmin[playerid] == 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) has chosen not to receive PMs from you!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);

		format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has tried to send you a pm!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_GREY, str);
		return true;
	}
	if(GetPVarInt(otherid, "PMsDisabled") == 1 && pAdmin[playerid] == 0)
	{
		format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has disabled their private messages!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_GREY, str);

		format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has tried to send you a pm!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_GREY, str);
		return true;
	}
	if(RaceParticipant[otherid] == 4)
	{
		format(str, sizeof(str), ""RED_E"Server: "GREY_E"This player is currently racing.");
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	if(checkForAdvertise(params)){
		format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s)", pName[playerid], playerid, params);
		SendAdminMessage(COLOR_RED, str);
		Error(playerid, "You cannot advertise here, you naughty boy");
		return false;
	}


	SendPlayerPM(playerid, otherid, tmp);
	return true;

}
CMD:apm(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>s[140]", otherid, tmp))
	{
		Usage(playerid, "/apm <ID> <Message>");
		return true;
	}
	// Decide about multi-line PMs
	new i = -1;
	if(strlen(tmp) > 70)
	{
		i = strfind(tmp, " ", false, 60);
		if(i > 80 || i == -1) i = 70;

		// store the second line text
		line = " ";
		strcat(line, tmp[i]);

		// delete the rest from tmp
		tmp[i] = EOS;
	}

	format(str, sizeof(str), "* "RED_E"PM from an Administrator: "YELLOW_E"%s", tmp);
	SendClientMessage(otherid, COLOR_YELLOW, str);
	if(i != -1) SendClientMessage(otherid, COLOR_YELLOW, line);

	format(str, sizeof(str), "* "RED_E"Admin PM to %s(%i): "YELLOW_E"%s", pName[otherid], otherid, tmp);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	if(i != -1) SendClientMessage(playerid, COLOR_YELLOW, line);
	return true;
}
CMD:pms(playerid) return cmd_checkpms(playerid);
CMD:lastpms(playerid) return cmd_checkpms(playerid);
CMD:checkpms(playerid)
{
	new bigStr[500], PMCount;
	strcat(bigStr, ""RED_E"Recent PM's (oldest to newest):\n\n"WHITE_E"");
	for(new i = 1; i < MAX_PMS; i++)
	{
		if(strcmp(PMs[playerid][i], "none", false) != 0)
		{
			PMCount++;
			format(str, sizeof(str), "%s\n", PMs[playerid][i]);
			strcat(bigStr, str);
		}
	}
	if(PMCount == 0)
	{
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""RED_E"Recent PMs", ""WHITE_E"You haven't received any private messages!", "Close", "");
	}
	else ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Recent PMs", bigStr, "OK", "");
	return 1;
}
CMD:tpm(playerid, params[])
{
	if(InDM[playerid] != 13)
	{
		Error(playerid, "You must be in a CnR minigame to use this command!");
		return true;
	}
	if(pMute[playerid] > 0)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You are muted and can't TPM! Mute will be lifted in %d seconds.", pMute[playerid]);
		SendClientMessage(playerid, COLOR_GREY, str);
		return true;
	}
	if(isnull(params))
	{
		Usage(playerid, "/tpm <message>");
		return true;
	}

	if(checkForAdvertise(params)){
		format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s)", pName[playerid], playerid, params);
		SendAdminMessage(COLOR_RED, str);
		Error(playerid, "You cannot advertise here!");
		return false;
	}

	if(GetPVarInt(playerid, "Cop") != 0)
	{
		foreach(new ii : Player)
		{
			if(GetPVarInt(ii, "Cop") != 0)
			{
				format(str, sizeof(str), ""RED_E"[TPM] "LB_E"%s(%d):{FFFFFF} %s", pName[playerid], playerid, params);
				SendClientMessage(ii, COLOR_LB, str);
			}
		}
	}
	else if(GetPVarInt(playerid, "Robber") != 0)
	{
		foreach(new ii : Player)
		{
			if(GetPVarInt(ii, "Robber") != 0)
			{
				format(str, sizeof(str), ""RED_E"[TPM] "YELLOW_E"%s(%d):{FFFFFF} %s", pName[playerid], playerid, params);
				SendClientMessage(ii, COLOR_YELLOW, str);

			}
		}
	}
	format(str, sizeof(str), "3%s2[%i]: 7[TPM]2 %s",  pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "**[Team-PM]** %s (%i): %s", pName[playerid], playerid, params);
	//DCC_SendChannelMessage(Channel_Echo, str);
	return true;
}


CMD:r(playerid, params[])
{
	if(isnull(params))
	{
		Usage(playerid, "/r <message>");
		SendClientMessage(playerid, COLOR_WHITEP,""ORANGE_E"FUNCTION: "WHITEP_E"Reply to a private message.");
		return true;
	}
	switch(GetPVarInt(playerid, "lastPMer"))
	{
		case -1:
		{
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" The person who last PMed you is not online anymore!");
			return true;
		}
		case -2:
		{
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" You haven't received any PMs during your online time!");
			return true;
		}
		default:
		{
			if(tmp[1] == ' ')
			{
				format(str, sizeof(str), "%i %s", GetPVarInt(playerid, "lastPMer"), params);
			}
			else
			{
				format(str, sizeof(str), "%i %s", GetPVarInt(playerid, "lastPMer"), params);
			}
			cmd_pm(playerid, str);
			return true;
		}
	}
	return true;
}
CMD:antifall(playerid, params[])
{
	if(GetPVarInt(playerid, "antiFall") == 0)
	{
		SetPVarInt(playerid, "antiFall", 1);
		SendClientMessage(playerid, COLOR_GOLD, "Anti-fall has been turned on.");
		format(str, sizeof(str),"4Server: 3%s(%i)2 has turned anti-fall on.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(playerid, 5000, "~b~~h~Anti-fall has been turned ~g~~h~on~b~~h~.");
	}
	else
	{
		SetPVarInt(playerid, "antiFall", 0);
		SendClientMessage(playerid, COLOR_GOLD, "Anti-fall has been turned off.");
		format(str, sizeof(str),"4Server: 3%s(%i)2 has turned anti-fall off.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		InfoTD_MSG(playerid, 5000, "~b~~h~Anti-fall has been turned ~r~~h~off~b~~h~.");
	}
	return true;
}

CMD:lock(playerid)
{
	if(InDM[playerid] == 13) return Error(playerid, "You can't lock your vehicle while playing CnR!");

	vID = GetPlayerVehicleID(playerid);
	vv = GetVehicleModel(vID);
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"You must be a driver in this %s to be able to /lock it!", vehName[vv - 400]);
		}
		else
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"You must be a driver in a vehicle!");
		}
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(vID == PlayerVehicle[playerid][0])
	{
		if(PlayerInfoVeh[playerid][0][Locked] == 1)
		{
			cmd_unlock(playerid);
			return true;
		}
	}
	if(vID == PlayerVehicle[playerid][1])
	{
		if(PlayerInfoVeh[playerid][1][Locked] == 1)
		{
			cmd_unlock(playerid);
			return true;
		}
	}
	else if(CarLocked[vID] == true)
	{
		cmd_unlock(playerid);
		return true;
	}

	CarLocked[vID] = true;
	foreach(new ii : Player)
	{
		if(ii != playerid)
		{
			SetVehicleParamsForPlayer(GetPlayerVehicleID(playerid), ii, 0, 1);
		}
	}
	if(vID == PlayerVehicle[playerid][0])
	{
		PlayerInfoVeh[playerid][0][Locked] = 1;
		format(str, sizeof(str), ""SERVER_INITIALS" Your %s has been locked. Use /unlock to unlock your private vehicle.", vehName[vv - 400]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
	}
	if(vID == PlayerVehicle[playerid][1])
	{
		PlayerInfoVeh[playerid][1][Locked] = 1;
		format(str, sizeof(str), ""SERVER_INITIALS" Your %s has been locked. Use /unlock to unlock your private vehicle.", vehName[vv - 400]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
	}
	else
	{
		format(str, sizeof(str), ""SERVER_INITIALS" Your %s has been locked. It will be automatically be unlocked once you exit it.", vehName[vv - 400]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
	}
	format(str, sizeof(str), "~y~Your ~y~~h~%s ~y~has been locked. Unlock using /unlock.", vehName[vv - 400]);
	InfoTD_MSG(playerid, 4500, str);

	format(str, sizeof(str), "4Server: 2%s(%i)3 has locked their %s.", pName[playerid], playerid, vehName[vv - 400]);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "**[Tune]** %s(%i) has locked their %s!", pName[playerid], playerid, vehName[vv-400]);
	//DCC_SendChannelMessage(Channel_Staff, str);
	return true;
}

CMD:unlock(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"You must be a driver in this %s to be able to /unlock it!", vehName[GetVehicleModel(GetPlayerVehicleID(playerid)) - 400]);
		}
		else
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"You must be a driver in a vehicle!");
		}
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	vID = GetPlayerVehicleID(playerid);
	vv = GetVehicleModel(vID);
	if(vID == PlayerVehicle[playerid][0])
	{
		if(PlayerInfoVeh[playerid][0][Locked] == 0)
		{
			cmd_lock(playerid);
			return true;
		}
	}
    if(vID == PlayerVehicle[playerid][1])
	{
		if(PlayerInfoVeh[playerid][1][Locked] == 0)
		{
			cmd_lock(playerid);
			return true;
		}
	}
	else if(CarLocked[vID] == false)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"This %s isn't locked!", vehName[vv - 400]);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	CarLocked[vID] = false;
	foreach(new ii : Player)
	{
		SetVehicleParamsForPlayer(GetPlayerVehicleID(playerid), ii, 0, 0);
	}
	format(str, sizeof(str), ""SERVER_INITIALS" Your %s has been unlocked.", vehName[vv - 400]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	format(str, sizeof(str), "~y~Your ~y~~h~%s ~y~has been unlocked.", vehName[vv - 400]);
	InfoTD_MSG(playerid, 3000, str);
	format(str, sizeof(str), "4Server: 2%s(%i)3 has unlocked their %s.", pName[playerid], playerid, vehName[vv - 400]);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "**[Tune]** %s(%i) has unlocked their %s.", pName[playerid], playerid, vehName[vv-400]);
	//DCC_SendChannelMessage(Channel_Staff, str);
	if(vID == PlayerVehicle[playerid][0])
	{
		PlayerInfoVeh[playerid][0][Locked] = 0;
	}
    if(vID == PlayerVehicle[playerid][1])
	{
		PlayerInfoVeh[playerid][1][Locked] = 0;
	}
	return true;
}



CMD:dive(playerid, params[])
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] != 0 || doingStunt[playerid] != 0)
	{
		Error(playerid, "This command can't be used in this area!");
		return true;
	}
	new height;
	if(sscanf(params, "d", height))
	{
		GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
		SetPlayerPosition(playerid, POS[0], POS[1], POS[2] + 500.0, 0);
	}
	else
	{
		if(height < 1)
		{
			return Error(playerid, "Height must be at least 1!");
		}
		if(height > 1000)
		{
			Error(playerid, "Height maximum is 1000!");
			height = 1000;
		}

		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
		{
			GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
			SetPlayerPos(playerid, POS[0], POS[1], POS[2] + height);
		}
		else
		{
			vID = GetPlayerVehicleID(playerid);
			GetVehiclePos(vID, POS[0], POS[1], POS[2]);
			SetVehiclePos(vID, POS[0], POS[1], POS[2] + height);
		}
	}
	GivePlayerWeapon(playerid, 46, 1);

	SendClientMessage(playerid, COLOR_GREEN, "Enjoy your flight!");
	return true;
}
