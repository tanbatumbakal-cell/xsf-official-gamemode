forward EventCD();
public EventCD()
{
	foreach(new ii : Player)
	{
		if(InEvent[ii] == 0) continue;
		if(evcd == 5)
		{
			if(pAdmin[ii] == 0) TogglePlayerControllable(ii, false);
			GameTextForPlayer(ii, " ", 500, 6);
			SetCameraBehindPlayer(ii);
			TextDrawShowForPlayer(ii, raceCT);
		}
	}
	switch(evcd)
	{
		case 5, 4, 3, 2, 1:
		{
			format(str, sizeof(str), "%d", evcd);
			TextDrawSetString(raceCT, str);

			foreach(new ii : Player)
			{
				if(InEvent[ii] != 0)
				{
					PlayerPlaySound(ii, 1056, 0.0, 0.0, 0.0);
				}
			}
		}
		case 0:
		{

			SendClientMessageToAll(COLOR_LB,""EVENT" "WHITEP_E"Event has started! Watch the event using "WHITE_E"/watchevent!");
			KillTimer(eCountdown);
			foreach(new ii : Player)
			{
				if(InEvent[ii] != 0)
				{
					TextDrawHideForPlayer(ii, raceCT);
					TogglePlayerControllable(ii, true);
					GameTextForPlayer(ii, "~r~~h~fight!", 5000, 3);
					SendClientMessage(ii, COLOR_YELLOW, ""EVENT" "YELLOW_E"You must eliminate all the other contenders and be the last man standing to win this event. Good luck!");
					PlayerPlaySound(ii, 3200, 0, 0, 0);
				}
			}
		}
	}
	evcd--;
}
function unshowRaceCT()
{
	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] == 0) continue;
		TextDrawHideForPlayer(ii, raceCT);
	}
}

function unshowParkourCT()
{
	foreach(new ii : Player)
	{
		if(ParkourParticipant[ii] == 0) continue;
		TextDrawHideForPlayer(ii, parkourCT);
	}
}

function unshowDerbyCT()
{
	foreach(new ii : Player)
	{
		if(doingStunt[ii] == 19) TextDrawHideForPlayer(ii, derbyCT);
	}
}

SetRaceCheckpoint(playerid, target, next)
{
	if(next == -1 && Airrace == 0)
	{
		SetPlayerRaceCheckpoint(playerid, 1, RaceCheckpoints[target][0], RaceCheckpoints[target][1], RaceCheckpoints[target][2], 0.0, 0.0, 0.0, 14.0);
	}
	else if(next == -1 && Airrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 4, RaceCheckpoints[target][0], RaceCheckpoints[target][1], RaceCheckpoints[target][2], 0.0, 0.0, 0.0, 14.0);
	}
	else if(Airrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 3, RaceCheckpoints[target][0], RaceCheckpoints[target][1], RaceCheckpoints[target][2], RaceCheckpoints[next][0], RaceCheckpoints[next][1], RaceCheckpoints[next][2], 14.0);
	}
	else
	{
		SetPlayerRaceCheckpoint(playerid, 0, RaceCheckpoints[target][0], RaceCheckpoints[target][1], RaceCheckpoints[target][2], RaceCheckpoints[next][0], RaceCheckpoints[next][1], RaceCheckpoints[next][2], 14.0);
	}
}

SetBRaceCheckpoint(playerid,target,next)
{
	if(next == -1 && BAirrace == 0)
	{
		SetPlayerRaceCheckpoint(playerid, 1, BRaceCheckpoints[target][0], BRaceCheckpoints[target][1], BRaceCheckpoints[target][2], 0.0, 0.0, 0.0,BCPsize);
	}
	else if(next == -1 && BAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 4, BRaceCheckpoints[target][0], BRaceCheckpoints[target][1], BRaceCheckpoints[target][2], 0.0, 0.0, 0.0, BCPsize);
	}
	else if(BAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 3, BRaceCheckpoints[target][0], BRaceCheckpoints[target][1], BRaceCheckpoints[target][2], BRaceCheckpoints[next][0], BRaceCheckpoints[next][1], BRaceCheckpoints[next][2], BCPsize);
	}
	else
	{
		SetPlayerRaceCheckpoint(playerid, 0, BRaceCheckpoints[target][0], BRaceCheckpoints[target][1], BRaceCheckpoints[target][2], BRaceCheckpoints[next][0], BRaceCheckpoints[next][1], BRaceCheckpoints[next][2], BCPsize);
	}
}

SetParkourCheckpoint(playerid, target, next)
{
	if(next == -1 && pAirrace == 0)
	{
		SetPlayerRaceCheckpoint(playerid, 1, parkourCheckpoints[target][0], parkourCheckpoints[target][1], parkourCheckpoints[target][2], 0.0, 0.0, 0.0, 7.0);
	}
	else if(next == -1 && pAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 4, parkourCheckpoints[target][0], parkourCheckpoints[target][1], parkourCheckpoints[target][2], 0.0, 0.0, 0.0, 7.0);
	}
	else if(pAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 3, parkourCheckpoints[target][0], parkourCheckpoints[target][1], parkourCheckpoints[target][2], parkourCheckpoints[next][0], parkourCheckpoints[next][1], parkourCheckpoints[next][2], 7.0);
	}
	else
	{
		SetPlayerRaceCheckpoint(playerid, 0, parkourCheckpoints[target][0], parkourCheckpoints[target][1], parkourCheckpoints[target][2], parkourCheckpoints[next][0], parkourCheckpoints[next][1], parkourCheckpoints[next][2], 7.0);
	}
}

SetBParkourCheckpoint(playerid,target,next)
{
	if(next == -1 && BAirrace == 0)
	{
		SetPlayerRaceCheckpoint(playerid, 1, pBRaceCheckpoints[target][0], pBRaceCheckpoints[target][1], pBRaceCheckpoints[target][2], 0.0, 0.0, 0.0,BCPsize);
	}
	else if(next == -1 && BAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 4, pBRaceCheckpoints[target][0], pBRaceCheckpoints[target][1], pBRaceCheckpoints[target][2], 0.0, 0.0, 0.0, BCPsize);
	}
	else if(BAirrace == 1)
	{
		SetPlayerRaceCheckpoint(playerid, 3, pBRaceCheckpoints[target][0], pBRaceCheckpoints[target][1], pBRaceCheckpoints[target][2], pBRaceCheckpoints[next][0], pBRaceCheckpoints[next][1], pBRaceCheckpoints[next][2], BCPsize);
	}
	else
	{
		SetPlayerRaceCheckpoint(playerid, 0, pBRaceCheckpoints[target][0], pBRaceCheckpoints[target][1], pBRaceCheckpoints[target][2], pBRaceCheckpoints[next][0], pBRaceCheckpoints[next][1], pBRaceCheckpoints[next][2], BCPsize);
	}
}

endrace()
{
	for(new ii = 0; ii < LCurrentCheckpoint; ii++)
	{
		RaceCheckpoints[ii][0] = 0.0;
		RaceCheckpoints[ii][1] = 0.0;
		RaceCheckpoints[ii][2] = 0.0;
	}
	LCurrentCheckpoint = 0;

	if(RaceCDTimer != -1)
	{
		KillTimer(RaceCDTimer);
		RaceCDTimer = -1;
	}
	KillTimer(tRacePosition);
	KillTimer(timeOverTimer);

	foreach(new ii : Player)
	{
		if(RaceParticipant[ii] != 0)
		{
			LoadPlayerPosition(ii);
			TextDrawHideForPlayer(ii, raceCT);
			HidePlayerRaceTextdraws(ii);
			canUseKey[ii] = true;
			TogglePlayerControllable(ii, 1);
			DisablePlayerRaceCheckpoint(ii);
			DisableRemoteVehicleCollisions(ii, 0);
		}
		RaceParticipant[ii] = 0;
	}

	pushBack = 0.0;
	race_StartTick = 0;
	MajStart = 0;
	mscd = 0;
	RaceActive = 0;
	RacersReady = 0;
	RaceStart = 0;
	Participants = 0;
}
endparkour()
{
	for(new ii = 0; ii < pLCurrentCheckpoint; ii++)
	{
		parkourCheckpoints[ii][0] = 0.0;
		parkourCheckpoints[ii][1] = 0.0;
		parkourCheckpoints[ii][2] = 0.0;
	}
	pLCurrentCheckpoint = 0;

	if(pCDTimer != -1)
	{
		KillTimer(pCDTimer);
		pCDTimer = -1;
	}
	KillTimer(tParkourPosition);
	KillTimer(ptimeOverTimer);

	foreach(new ii : Player)
	{
		if(ParkourParticipant[ii] != 0)
		{
			LoadPlayerPosition(ii);
			TextDrawHideForPlayer(ii, parkourCT);
			HidePlayerParkourTextdraws(ii);
			canUseKey[ii] = true;
			TogglePlayerControllable(ii, 1);
			doingStunt[ii] = 0;
			DisablePlayerRaceCheckpoint(ii);
		}
		ParkourParticipant[ii] = 0;
	}

	Parkour_StartTick = 0;
	pMajStart = 0;
	pmscd = 0;
	ParkourActive = 0;
	ParkoursReady = 0;
	ParkourStart = 0;
	pParticipants = 0;
}

BActiveCP(playerid, sele)
{
	if(BCurrentCheckpoints -1 == sele)
	{
		SetBRaceCheckpoint(playerid, sele, -1);
	}
	else
	{
		SetBRaceCheckpoint(playerid, sele, sele + 1);
	}
}

pBActiveCP(playerid, sele)
{
	if(pBCurrentCheckpoints -1 == sele)
	{
		SetBParkourCheckpoint(playerid, sele, -1);
	}
	else
	{
		SetBParkourCheckpoint(playerid, sele, sele + 1);
	}
}

function RaceCountDown()
{
	if(RaceStart == 1 || MajStart == 0)
	{
		MajStart = 0;
		mscd = 0;
		KillTimer(RaceCDTimer);
		RaceCDTimer = -1;
		return true;
	}

	mscd--;
	if(mscd <= 5)
	{
		if(Participants <= 0)// || Participants == 1)
		{
			format(str, sizeof(str), ""RACE" Race '%s' has been aborted (not enough participants)!", CRaceName);
			SendClientMessageToAll(COLOR_WHITEP, str);
			format(str, sizeof(str), "2,9RACE7,0 Race '%s' has been aborted (not enough participants)!", CRaceName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

			endrace();
			return true;
		}
		KillTimer(RaceCDTimer);
		RaceCDTimer = -1;
		MajStart = 0;
		mscd = 0;
		foreach(new ii : Player)
		{
			if(RaceParticipant[ii] == 0) continue;
			GameTextForPlayer(ii, " ", 500, 6);
			SetCameraBehindPlayer(ii);
			if(!IsPlayerInRangeOfPoint(ii, 50.0, RaceCheckpoints[0][0], RaceCheckpoints[0][1], RaceCheckpoints[0][2]))
			{
				SendClientMessage(ii, COLOR_GREY, "RACE: "RED_E"You are too far away from the race starting point. You have been removed, stay in the checkpoint next time!");
				Participants--;
				SetPlayerVirtualWorld(ii, 0);
				SetVehicleVirtualWorld(GetPlayerVehicleID(ii), 0);
				DisablePlayerRaceCheckpoint(ii);
				TogglePlayerControllable(ii, true);
				RaceParticipant[ii] = 0;
				canUseKey[ii] = true;
				HidePlayerRaceTextdraws(ii);
				DisableRemoteVehicleCollisions(ii, 0);
			}
			if(GetPlayerState(ii) == PLAYER_STATE_PASSENGER)
			{
				SendClientMessage(ii, COLOR_GREY, "RACE: "RED_E"You can't be a passenger. You have been removed, stay in your own car next time!");
				Participants--;
				SetPlayerVirtualWorld(ii, 0);
				SetVehicleVirtualWorld(GetPlayerVehicleID(ii), 0);
				DisablePlayerRaceCheckpoint(ii);
				TogglePlayerControllable(ii, true);
				RaceParticipant[ii] = 0;
				canUseKey[ii] = true;
				HidePlayerRaceTextdraws(ii);
				DisableRemoteVehicleCollisions(ii, 0);
			}
			if(Participants <= 0)// || Participants == 1)
			{
				format(str, sizeof(str), ""RACE" Race '%s' has been aborted (not enough participants)!", CRaceName);
				SendClientMessageToAll(COLOR_WHITEP, str);
				format(str, sizeof(str), "2,9RACE7,0 Race '%s' has been aborted (not enough participants)!", CRaceName);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

				endrace();
				return true;
			}
		}
		format(str, sizeof(str), ""RACE" Race "YELLOW_E"'%s' "WHITEP_E"with %d participant(s) begins in 5 seconds!", CRaceName, Participants);
		SendClientMessageToAll(COLOR_WHITEP, str);
		format(tmp, sizeof(tmp), "2,9RACE7,0 Race '%s' with %d participant(s) begins in 5 seconds!", CRaceName, Participants);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

		cd = 5;
		rCountdown = SetTimer("RaceCD", 1000, true);
	}
	else
	{
		if(mscd == 20)
		{
			if(Participants > 0)
			{
				format(str, sizeof(str), ""RACE" Race "YELLOW_E"'%s' "WHITEP_E"starts in 20 seconds with %d participant(s)! Type /join to participate.", CRaceName, Participants);
			}
			else format(str, sizeof(str), ""RACE" Race "YELLOW_E"'%s' "WHITEP_E"starts in 20 seconds! Type /join to participate.", CRaceName);
			SendClientMessageToAll(COLOR_WHITEP, str);
		}
		format(str,sizeof(str),"~y~Race starting in:~n~~r~- %d -~n~~y~seconds.", mscd);
		foreach(new ii : Player)
		{
			if(RaceParticipant[ii] > 0)
			{
				GameTextForPlayer(ii, str, 3000, 3);
				InfoTD_MSG(ii, 3000, "~b~~h~Stay by the checkpoint till the race starts.~n~~b~~h~Type ~w~/cw ~b~~h~to change your virtual world.");
			}
		}
	}
	return true;
}

function ParkourCountDown()
{
	if(ParkourStart == 1 || pMajStart == 0)
	{
		pMajStart = 0;
		pmscd = 0;
		KillTimer(pCDTimer);
		pCDTimer = -1;
		return true;
	}

	pmscd--;
	if(pmscd <= 5)
	{
		if(pParticipants == 0)
		{
			format(str, sizeof(str), ""PARKOUR" Parkour '%s' has been aborted (not enough participants)!", CParkourName);
			SendClientMessageToAll(COLOR_LIME, str);
			format(str, sizeof(str), "2,9PARKOUR7,0 Parkour '%s' has been aborted (not enough participants)!", CParkourName);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

			endparkour();
			return true;
		}
		KillTimer(pCDTimer);
		pCDTimer = -1;
		pMajStart = 0;
		pmscd = 0;
		foreach(new ii : Player)
		{
			if(ParkourParticipant[ii] == 0) continue;
			GameTextForPlayer(ii, " ", 500, 6);
			SetCameraBehindPlayer(ii);
			if(!IsPlayerInRangeOfPoint(ii, 50.0, parkourCheckpoints[0][0], parkourCheckpoints[0][1], parkourCheckpoints[0][2]))
			{
				SendClientMessage(ii, COLOR_GREY, "PARKOUR: "RED_E"You are too far away from the starting point. You have been removed, stay in the checkpoint next time!");
				pParticipants--;
				SetPlayerVirtualWorld(ii, 0);
				DisablePlayerRaceCheckpoint(ii);
				TogglePlayerControllable(ii, true);
				ParkourParticipant[ii] = 0;
				doingStunt[ii] = 0;
				canUseKey[ii] = true;
				HidePlayerParkourTextdraws(ii);
			}
			if(pParticipants == 0)
			{
				format(str, sizeof(str), ""PARKOUR" Parkour '%s' has been aborted (not enough participants)!", CParkourName);
				SendClientMessageToAll(COLOR_LIME, str);
				format(str, sizeof(str), "2,9PARKOUR7,0 Parkour '%s' has been aborted (not enough participants)!", CParkourName);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

				endrace();
				return true;
			}
		}
		format(str, sizeof(str), ""PARKOUR" Parkour "YELLOW_E"'%s' "LIME_E"with %d participant(s) begins in 5 seconds!", CParkourName, pParticipants);
		SendClientMessageToAll(COLOR_LIME, str);
		format(tmp, sizeof(tmp), "2,9PARKOUR7,0 Parkour '%s' with %d participant(s) begins in 5 seconds!", CParkourName, pParticipants);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);

		pcd = 5;
		pCountdown = SetTimer("ParkourCD", 1000, true);
	}
	else
	{
		if(pmscd == 20)
		{
			if(pParticipants > 0)
			{
				format(str, sizeof(str), ""PARKOUR" Parkour "YELLOW_E"'%s' "LIME_E"starts in 20 seconds with %d participant(s)! Type /parkour to participate.", CParkourName, pParticipants);
			}
			else format(str, sizeof(str), ""PARKOUR" Parkour "YELLOW_E"'%s' "LIME_E"starts in 20 seconds! Type /parkour to participate.", CParkourName);
			SendClientMessageToAll(COLOR_LIME, str);
		}
		format(str,sizeof(str),"~y~Parkour starting in:~n~~r~- %d -~n~~y~seconds.", pmscd);
		foreach(new ii : Player)
		{
			if(ParkourParticipant[ii] > 0)
			{
				GameTextForPlayer(ii, str, 3000, 3);
				InfoTD_MSG(ii, 3000, "~b~~h~Stay by the checkpoint till the parkour starts.~n~~b~~h~Type ~w~/cw ~b~~h~to change your virtual world.");
			}
		}
	}
	return true;
}

clearrace(playerid)
{
	for(new ii = 0; ii < BCurrentCheckpoints; ii++)
	{
		BRaceCheckpoints[ii][0] = 0.0;
		BRaceCheckpoints[ii][1] = 0.0;
		BRaceCheckpoints[ii][2] = 0.0;
	}
	BCurrentCheckpoints = 0;
	DisablePlayerRaceCheckpoint(playerid);
	SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Your race has been cleared! Use /buildrace to start a new one.");

	RaceBuilders[playerid] = 0;
	RaceBuilt = 0;
}

clearparkour(playerid)
{
	for(new ii = 0; ii < pBCurrentCheckpoints; ii++)
	{
		pBRaceCheckpoints[ii][0] = 0.0;
		pBRaceCheckpoints[ii][1] = 0.0;
		pBRaceCheckpoints[ii][2] = 0.0;
	}
	pBCurrentCheckpoints = 0;
	DisablePlayerRaceCheckpoint(playerid);
	SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Your parkour has been cleared! Use /buildparkour to start a new one.");

	ParkourBuilders[playerid] = 0;
	ParkourBuilt = 0;
}

