MySQL_CreatePlayerAchivements(playerid)
{
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `achievements` (`reg_id`, `name`) VALUES (%i, '%e')", pRegID[playerid], pName[playerid]);
	MySQL_updateQuery(query);
}

MySQL_CreateBuyVehicle(playerid, id)
{
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `vehicles` (`Owner`, `Price`, `Model`, `Plate`, `VehicleCount`) VALUES ('%e', %i, %i, '%e', '%d')", pName[playerid], PlayerInfoVeh[playerid][id][Price], PlayerInfoVeh[playerid][id][Model], PlayerInfoVeh[playerid][id][Plate], id+1);
	MySQL_query(query, true, "OnPlayerBuyVehicle", "ii", playerid, id);
}
forward OnPlayerBuyVehicle(playerid, id);
public OnPlayerBuyVehicle(playerid, id)
{
	BoughtVehicle[playerid][id] = true;
	format(PlayerInfoVeh[playerid][id][Owner], 24, pName[playerid]);
	PlayerInfoVeh[playerid][id][Locked] = 1;
	MySQL_SavePlayerVeh(playerid, id);
	return true;
}

MySQL_DeletePlayerVehicle(playerid, id)
{
	mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM `vehicles` WHERE `Owner` = '%e' AND `VehicleCount` = %d", pName[playerid], id+1);
	MySQL_query(query, true, "OnPlayerDeleteVehicle", "ii", playerid, id);
}
forward OnPlayerDeleteVehicle(playerid, id);
public OnPlayerDeleteVehicle(playerid, id)
{
	BoughtVehicle[playerid][id] = false;
	if(PlayerVehicle[playerid][id] != -1)
	{
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][id]);
		DestroyVehicle(PlayerVehicle[playerid][id]);
		PlayerVehicle[playerid][id] = -1;
	}
	PlayerInfoVeh[playerid][id][Owner] = 0;
	PlayerInfoVeh[playerid][id][Model] = -1;
	PlayerInfoVeh[playerid][id][PaintJob] = -1;
	PlayerInfoVeh[playerid][id][Color1] = 0;
	PlayerInfoVeh[playerid][id][Color2] = 0;
	strmid(PlayerInfoVeh[playerid][id][Plate], "SERVER_INITIALS", 0, 7, 7);
	PlayerInfoVeh[playerid][id][Locked] = 0;
	PlayerInfoVeh[playerid][id][Mod1] = 0;
	PlayerInfoVeh[playerid][id][Mod2] = 0;
	PlayerInfoVeh[playerid][id][Mod3] = 0;
	PlayerInfoVeh[playerid][id][Mod4] = 0;
	PlayerInfoVeh[playerid][id][Mod5] = 0;
	PlayerInfoVeh[playerid][id][Mod6] = 0;
	PlayerInfoVeh[playerid][id][Mod7] = 0;
	PlayerInfoVeh[playerid][id][Mod8] = 0;
	PlayerInfoVeh[playerid][id][Mod9] = 0;
	PlayerInfoVeh[playerid][id][Mod10] = 0;
	PlayerInfoVeh[playerid][id][Mod11] = 0;
	PlayerInfoVeh[playerid][id][Mod12] = 0;
	PlayerInfoVeh[playerid][id][Mod13] = 0;
	PlayerInfoVeh[playerid][id][Mod14] = 0;
	PlayerInfoVeh[playerid][id][Mod15] = 0;
	PlayerInfoVeh[playerid][id][Mod16] = 0;
	PlayerInfoVeh[playerid][id][Mod17] = 0;
	GivePlayerCash(playerid, floatround(PlayerInfoVeh[playerid][id][Price] / 2));
	PlayerInfoVeh[playerid][id][Price] = -1;

	InfoTD_MSG(playerid, 5000, "~r~~h~You have sold your private vehicle!");
	return true;
}


MySQL_SavePlayerVeh(playerid, id)
{
	if(!BoughtVehicle[playerid][id]) return true;
	new lquery[650];
	new line4[1100];

	mysql_format(g_SQL_handle, lquery, sizeof(lquery), "UPDATE `vehicles` SET `Model` = %i, `Price` = %i, `PaintJob` = %i, `Color1` = %i, `Color2` = %i, `Plate` = '%e', `Locked` = %i, \
	`Mod1` = %i, `Mod2` = %i, `Mod3` = %i, `Mod4` = %i, `Mod5` = %i, `Mod6` = %i, `Mod7` = %i, `Mod8` = %i, `Mod9` = %i, `Mod10` = %i, `Mod11` = %i, `Mod12` = %i, `Mod13` = %i, `Mod14` = %i, `Mod15` = %i, `Mod16` = %i, `Mod17` = %i, ",\
		PlayerInfoVeh[playerid][id][Model],
		PlayerInfoVeh[playerid][id][Price],
		PlayerInfoVeh[playerid][id][PaintJob],
		PlayerInfoVeh[playerid][id][Color1],
		PlayerInfoVeh[playerid][id][Color2],
		PlayerInfoVeh[playerid][id][Plate],
		PlayerInfoVeh[playerid][id][Locked],
		PlayerInfoVeh[playerid][id][Mod1],
		PlayerInfoVeh[playerid][id][Mod2],
		PlayerInfoVeh[playerid][id][Mod3],
		PlayerInfoVeh[playerid][id][Mod4],
		PlayerInfoVeh[playerid][id][Mod5],
		PlayerInfoVeh[playerid][id][Mod6],
		PlayerInfoVeh[playerid][id][Mod7],
		PlayerInfoVeh[playerid][id][Mod8],
		PlayerInfoVeh[playerid][id][Mod9],
		PlayerInfoVeh[playerid][id][Mod10],
		PlayerInfoVeh[playerid][id][Mod11],
		PlayerInfoVeh[playerid][id][Mod12],
		PlayerInfoVeh[playerid][id][Mod13],
		PlayerInfoVeh[playerid][id][Mod14],
		PlayerInfoVeh[playerid][id][Mod15],
		PlayerInfoVeh[playerid][id][Mod16],
		PlayerInfoVeh[playerid][id][Mod17]);
	strcat(line4, lquery);

	mysql_format(g_SQL_handle, lquery, sizeof(lquery), "`Model_2` = %i, `Price_2` = %i, `PaintJob_2` = %i, `Color1_2` = %i, `Color2_2` = %i, `Model_3` = %i, `Price_3` = %i, `PaintJob_3` = %i, `Color1_3` = %i, `Color2_3` = %i WHERE `Owner` = '%e' AND `VehicleCount` = %d",
		PlayerInfoVeh[playerid][id][Model2],
		PlayerInfoVeh[playerid][id][Price2],
		PlayerInfoVeh[playerid][id][PaintJob2],
		PlayerInfoVeh[playerid][id][Color12],
		PlayerInfoVeh[playerid][id][Color22],
		PlayerInfoVeh[playerid][id][Model3],
		PlayerInfoVeh[playerid][id][Price3],
		PlayerInfoVeh[playerid][id][PaintJob3],
		PlayerInfoVeh[playerid][id][Color13],
		PlayerInfoVeh[playerid][id][Color23],
		pName[playerid], id+1);
	strcat(line4, lquery);

	MySQL_updateQuery(line4);
	return true;
}

