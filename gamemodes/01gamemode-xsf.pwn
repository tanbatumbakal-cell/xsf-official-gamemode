CMD:unbanip(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(isnull(params))
	{
		Usage(playerid, "/unbanip <IP Address>");
		return 1;
	}

	format(str, sizeof(str), "4Server:3 %s(%d) has IP un-banned address %s", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	format(str, sizeof(str), "unbanip %s", params);
	SendRconCommand(str);
	format(str, sizeof(str), "reloadbans");
	SendRconCommand(str);
	format(str, sizeof(str), "- AS - "RED_E"You have unbanned IP address %s.", params);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	return 1;
}
CMD:hide(playerid)
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(pHidden[playerid] == 0)
	{
		pHidden[playerid] = 1;
		if(!GetPVarInt(playerid, "FullHidden")) {
			format(str, sizeof(str), ""RED_E"* ADMIN-MSG: "GREY_E"%s(%i) has hidden themself from the admin list.", pName[playerid], playerid);
			SendAdminMessage(COLOR_GREY, str);
		}
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "RED_E"You have hidden yourself from the admin list!");
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "RED_E"Type /hide again to display yourself on the list.");
		DestroyDynamic3DTextLabel(admin3D[playerid]);
		admin3D[playerid] = Text3D:-1;
	}
	else
	{
		if(GetPVarInt(playerid, "FullHidden"))
			return Error(playerid, "Use /fullhide to unhide yourself!");

		pHidden[playerid] = 0;
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "GREEN_E"You will now be displayed on the admin list!");
		if(pAdmin[playerid] == 1 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 2 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 3 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{e600f4}Admin", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 4 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{f6d300}Lead Admin", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 5 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{0045ff}Manager", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		if(pAdmin[playerid] == 6 && pHidden[playerid] == 0)
		{
			admin3D[playerid] = CreateDynamic3DTextLabel("{ea0000}Owner", 0xFFFF8288, 0, 0, -0.41, 50.0, playerid, INVALID_VEHICLE_ID, 1);
		}
	}
	if(pLogged[playerid] == true)
	{
		format(query, sizeof(query), "UPDATE players SET hidden=%d WHERE reg_id=%d", pHidden[playerid], pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return true;
}

CMD:toghide(playerid)
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");
	if(pmhidden[playerid] == 0)
	{
		pmhidden[playerid] = 1;
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "RED_E"You have hidden yourself from the hidden admin list!");
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "RED_E"Type /toghide again to display yourself on the list.");
		DestroyDynamic3DTextLabel(admin3D[playerid]);
		admin3D[playerid] = Text3D:-1;
	}
	else
	{
		pmhidden[playerid] = 0;
		SendClientMessage(playerid, COLOR_YELLOW, "- AS - "GREEN_E"You will now be displayed on the hidden admin list!");
	}
	if(pLogged[playerid] == true)
	{
		format(query, sizeof(query), "UPDATE players SET pmhidden=%d WHERE reg_id=%d", pHidden[playerid], pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return true;
}

CMD:saveallstats(playerid)
{
 	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	foreach(new ii : Player)
	{
		SavePlayerStats(ii);
	}
	format(tmp, sizeof(tmp), ""SERVER_INITIALS" %s(%d) has manually saved your stats.", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_YELLOW, tmp);
	IRC_GroupSay(ircGroup, IRC_CHANNEL,  "4* 3All server player stats have been saved!");
	GameTextForAll("~b~~h~Server Restarting~w~!", 8000, 3);
	for(new l; l < 4; l++) SendClientMessageToAll(COLOR_GREY2, "\n");
	SendClientMessageToAll(COLOR_LB, ""RED_E"*** "LB2_E"Server Is Restarting, reconnect if you get disconnected!");
	SendClientMessageToAll(COLOR_LB, ""RED_E"*** "LB2_E"Please re-join the server if you get a ban message upon connection!");
	return true;
}
