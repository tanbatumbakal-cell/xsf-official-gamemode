CheckBPCompleted(playerid)
{
	if(GetPVarInt(playerid, "CompletedBP1") == 1 && GetPVarInt(playerid, "CompletedBP2") == 1 && GetPVarInt(playerid, "CompletedBP3") == 1 && GetPVarInt(playerid, "CompletedBP4") == 1)
	{
		if(pAch20[playerid] == 0)
		{
			DeletePVar(playerid, "CompletedBP1");
			DeletePVar(playerid, "CompletedBP2");
			DeletePVar(playerid, "CompletedBP3");
			DeletePVar(playerid, "CompletedBP4");
			pAch20[playerid] = 1;
			format(query, sizeof(query), "UPDATE achievements SET a20=1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			GivePlayerAchievement(playerid, "Pro Biker", "Congrats you completed 4 bike parkours!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
		}
	}
}

UpdateMinigameBox(playerid, type, const tele[])
{
	if(strlen(pName[playerid]) > 12) return true;
	szString_3 = szString_2;
	szString_2 = szString_1;
	szString_1 = szString_0;
	switch(type)
	{
		case 1: format(szString_0, sizeof(szString_0), "~r~~h~[DM] ~w~%s(%d) has joined %s", pName[playerid], playerid, tele);
		case 2: format(szString_0, sizeof(szString_0), "~b~~h~[MG] ~w~%s(%d) has joined %s", pName[playerid], playerid, tele);
		case 3: format(szString_0, sizeof(szString_0), "~y~~h~[RACE] ~w~%s(%d) has joined %s", pName[playerid], playerid, tele);
	}

	TextDrawSetString(TD_line[0], szString_0);
	TextDrawSetString(TD_line[1], szString_1);
	TextDrawSetString(TD_line[2], szString_2);
	TextDrawSetString(TD_line[3], szString_3);
	return true;
}


CanPlayerTeleport(playerid)
{
	if(!pSpawned[playerid])
	{
		Error(playerid, "You must be spawned to teleport!");
		return false;
	}
	else if(InDM[playerid] == 13) // CnR
	{
		if(GetPVarInt(playerid, "Robber") != 0)
		{
			foreach(new ii : Player)
			{
				if(GetPVarInt(ii, "Cop") != 0)
				{
					if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
					{
						return Error(playerid, "You can't type /leave nearby a cop, escape first!");
					}
				}
			}
		}
		if(GetPVarInt(playerid, "Cop") != 0)
		{
			foreach(new ii : Player)
			{
				if(GetPVarInt(ii, "Robber") != 0)
				{
					if(PlayerInRangeOfPlayer(playerid, ii, 50.0))
					{
						return Error(playerid, "You can't type /leave nearby a cop, escape first!");
					}
				}
			}
		}
	}
	else if(pSpectating[playerid] != -1)
	{
		Error(playerid, "You can't use this command while spectating, type /specoff!");
		return false;
	}
	else if(isCbug[playerid])
	{
		Error(playerid, "You Cannot teleport while you are in the cbug challenge!");
		return false;
	}
	else if(AFK[playerid] == 1)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while AFK!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /back to return.");
		InfoTD_MSG(playerid, 4000, "~y~~h~Type /back to return to your old position.");
		return false;
	}
	else if(doingStunt[playerid] == 18 || doingStunt[playerid] == 19 || doingStunt[playerid] == 33 || doingStunt[playerid] == 70) // Fallout, Derby LMS
	{
		if(doingStunt[playerid] == 70)
		{
			SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /stopwatch to stop spectating the event.");
			InfoTD_MSG(playerid, 3500, "~y~~h~Type /stopwatch before teleporting!");
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while in a minigame!");
			SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the minigame.");
			InfoTD_MSG(playerid, 3500, "~y~~h~Type /leave to exit the minigame.");
		}
		return false;
	}
	else if(InDuel[playerid] != -1 )
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while in a duel!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the duel.");
		InfoTD_MSG(playerid, 3500, "~b~~h~Type /leave to exit the duel.");
		return false;
	}
	else if(RaceParticipant[playerid] != 0)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while in a race!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the race.");
		Info(playerid, "Spawn a vehicle using /v "RED_E" || "WHITEP_E"Flip your vehicle using /flip "RED_E"|| "WHITEP_E"Change virtual world using /cw");
		InfoTD_MSG(playerid, 2500, "~g~~h~Type /v to spawn a vehicle. Type ~w~/cw ~g~~h~to change your virtual world.");
		return false;
	}
	else if(ParkourParticipant[playerid] != 0)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while in a parkour!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the parkour.");
		return false;
	}
	else if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 || eInfo[playerid][inPUBG] == 1)
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command while in an event!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the event.");
		return false;
	}
	else if(InDM[playerid] == 3 || InDM[playerid] == 4 || InDM[playerid] == 11 || InDM[playerid] == 7 || InDM[playerid] == 12) // Minigun and Rocket
	{
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"You can't use this command in this DM!");
		SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY_E"Type /leave to exit the DM.");
		InfoTD_MSG(playerid, 3500, "~y~~h~Type /leave to exit this deathmatch.");
		return false;
	}
	else if(GetPVarInt(playerid, "HousePreview") != 0)
	{
		Error(playerid, "You are currently previewing an interior, please exit the preview before teleporting.");
		return false;
	}
	else if(GetPVarInt(playerid, "ParticipatingHG") == 1)
	{
	    Error(playerid, "You cannot teleport while in Hungergames; /leave before doing so.");
	    return false;
	}
	return true;
}

forward killCamCD(playerid, killerid);
public killCamCD(playerid, killerid)
{
	killCamCounter[playerid]--;
	if(killCamCounter[playerid] > 0)
	{
		new Float:kHP, Float:kAR;
		GetPlayerHealth(killerid,kHP), GetPlayerArmour(killerid, kAR);
		format(str, sizeof(str), "~g~Player:~w~ : %s", pName[killerid]);
		PlayerTextDrawSetString(playerid, NameX[playerid], str);
		format(str, sizeof(str), "~r~HEALTH~w~ : %.0f%", kHP);
		PlayerTextDrawSetString(playerid, HealthTD[playerid], str);
		if(kAR >= 0)
		{
			format(str, sizeof(str), "~r~ARMOUR~w~ : %.0f%", kAR);
			PlayerTextDrawSetString(playerid, Armour[playerid], str);
		}
		else
		{
			format(str, sizeof(str), "~r~ARMOUR~w~ : NONE");
			PlayerTextDrawSetString(playerid, Armour[playerid], str);
		}
		format(str, sizeof(str), "~r~KillStreak~w~ : %d", killStreak[killerid]);
		PlayerTextDrawSetString(playerid, killStreakTD[playerid], str);
		format(str, sizeof(str), "You will respawn in ~y~%d ~w~seconds.~n~Press the fire key to respawn at anytime.", killCamCounter[playerid]);
		PlayerTextDrawSetString(playerid, killCamTD8[playerid], str);
	}
	else if(killCamCounter[playerid] == 0)
	{
		KillTimer(killCamTimer[playerid]);
		if(killCamON[playerid] != false)
		{
			DeletePVar(killerid, "killCamSpectator");
			TogglePlayerSpectating(playerid, 0);
			hideKillCam(playerid);
			killCamON[playerid] = false;

		}
	}
	return 1;
}

UpdateKillCam(playerid, killerid)
{
	new Float:kHP, Float:kAR;
	GetPlayerHealth(killerid,kHP), GetPlayerArmour(killerid, kAR);
	format(str, sizeof(str), "~g~Player:~w~ : %s", pName[killerid]);
	PlayerTextDrawSetString(playerid, NameX[playerid], str);
	format(str, sizeof(str), "~r~HEALTH~w~ : %.0f%", kHP);
	PlayerTextDrawSetString(playerid, HealthTD[playerid], str);
	if(kAR >= 0)
	{
		format(str, sizeof(str), "~r~Armor~w~ : %.0f%", kAR);
		PlayerTextDrawSetString(playerid, Armour[playerid], str);
	}
	else
	{
		format(str, sizeof(str), "~r~Armor~w~ : NONE");
		PlayerTextDrawSetString(playerid, Armour[playerid], str);
	}
	format(str, sizeof(str), "~r~KillStreak~w~ : %d", killStreak[killerid]);
	PlayerTextDrawSetString(playerid, killStreakTD[playerid], str);
	format(str, sizeof(str), "You will respawn in ~y~%d ~w~seconds.~n~Press the fire key to respawn at anytime.", killCamCounter[playerid]);
	PlayerTextDrawSetString(playerid, killCamTD8[playerid], str);
}



AddKickLogEntry(playerid, kickName[], kickIP[], adminID, kickReason[])
{
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO kicks(player,player_ip,player_regid,admin,admin_regid,reason,time) VALUES('%e','%e',%d,'%e','%d','%e',UNIX_TIMESTAMP())", kickName, kickIP, pRegID[playerid], pName[adminID], pRegID[adminID], kickReason);
	MySQL_updateQuery(query);
}

AdminCommandLog(const command[], adminid, player = INVALID_PLAYER_ID, logstr[] = '*')
{
	// Get the admin's name
	new logPlayerName[24];
	GetPlayerName(adminid, logPlayerName, sizeof(logPlayerName));

	// Set the logging message to be correct
	new logStrEscaped[128];
	if(logstr[0] == '*')
		logStrEscaped = "*", printf("AdminCommandLog: logstr detected as unnecessary, logStrEscaped = '%s' (must be '*')", logStrEscaped);
	else
		mysql_real_escape_string(logstr, logStrEscaped), printf("AdminCommandLog: logstr detected necessary, escaped from '%s' to '%s'", logstr, logStrEscaped);

	if(player != INVALID_PLAYER_ID)
	{
		// The action involves a player, get their name
		new gName[24];
		GetPlayerName(player, gName, sizeof(gName));
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO adminlog (command,admin,adminid,player,playerid,str,time) VALUES('%e','%e',%d,'%e',%d,'%e',UNIX_TIMESTAMP())", command, logPlayerName, pRegID[adminid], gName, pRegID[player], logStrEscaped);
	}
	else
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO adminlog (command,admin,adminid,str,time) VALUES('%e','%e',%d,'%e',UNIX_TIMESTAMP())", command, logPlayerName, pRegID[adminid], logStrEscaped);
	}

	// Send the query!
	MySQL_updateQuery(query);
	return true;
}
GetWeaponIdFromName(wepname[])
{
	for(new i = 0; i < sizeof(WeaponNames); i++)
	{
		if(strfind(WeaponNames[i],wepname,true) != -1) return i;
	}
	return -1;
}



BlockPayNSpray(playerid)
{
	if(GetPVarInt(playerid, "PayGatesCreated") == 1)
		return 1;
	PaySprayGate[playerid][0] = CreateDynamicObject(971, -361, 1194.2, 18.245, 0, 90, 0, -1,-1, playerid);
    PaySprayGate[playerid][1] = CreateDynamicObject(971, 1026, -1029.48, 31.7, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][2] = CreateDynamicObject(971, 1043, -1026, 31.8, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][3] = CreateDynamicObject(971, 2071.6001, -1831.8, 13, 0, 0, 90, -1,-1, playerid);
	PaySprayGate[playerid][4] = CreateDynamicObject(971, -100.1, 1111.46, 21.1, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][5] = CreateDynamicObject(971, 2386.1001, 1043.4, 10, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][6] = CreateDynamicObject(971, -1904.6, 277.70001, 43, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][7] = CreateDynamicObject(971, -1935.5, 239.2, 33.7, 0, 0, 0, -1,-1, playerid);
	PaySprayGate[playerid][8] = CreateDynamicObject(971, -2716.1001, 216.8, 3.8, 0, 0, 90, -1,-1, playerid);
	SetPVarInt(playerid, "PayGatesCreated", 1);
	return 1;
}
UnBlockPayNSpray(playerid)
{
	if(GetPVarInt(playerid, "PayGatesCreated") == 1)
	{
		for(new i;i<8;i++)
		{
			SetPVarInt(playerid, "PayGatesCreated", 0);
			DestroyDynamicObject(PaySprayGate[playerid][i]);
		}
	}
	return 1;
}

GetPlayerID(name[])
{
	foreach(new i : Player)
	{
		GetPlayerName(i, giveplayer, sizeof(giveplayer));
		if(strcmp(giveplayer, name) == 0)
