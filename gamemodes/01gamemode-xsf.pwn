CMD:ann4(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "s[128]", tmp))
	{
		Usage(playerid, "/ann4 <msg>");
		return true;
	}
	format(str, sizeof(str), ""RED_E":: "WHITEP_E"server "RED_E":: "LB2_E"%s", tmp);
	SendClientMessageToAll(COLOR_LB, str);
	return true;
}

CMD:vkill( playerid, params[ ] )
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	new vehicleid;
	new string[128];
	format(string, 128, "%s", vehicleid);
	if( sscanf( params, "i", vehicleid ) )
	{
		Usage(playerid, "/vkill <ID>");
		return true;
	}
	if(vehicleid<1196)
	{
		Error(playerid, "You can't kill this vehicle because it is a default server vehicle!");
		return true;
	}

	DestroyVehicle( vehicleid );
	format(string, 128, "{FFFF00}- AS - {FF0000} Vehicle %i has been destroyed.",vehicleid);
	SendClientMessage(playerid, -1, string);
	return 1;
}

CMD:setvhealth( playerid, params[ ] )
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	new vehicleid, Float:vHealth;
	new string[128];
	if( sscanf( params, "if", vehicleid,vHealth ) )
	{
		Usage(playerid, "/setvhealth <ID> <Health");
		return true;
	}
	SetVehicleHealth(vehicleid, vHealth);
	if(vHealth > 900)
		RepairVehicle(vehicleid);

	format(string, 128, "{FFFF00}- AS - {FF0000} Vehicle %i health has been set to %.1f.",vehicleid, vHealth);
	SendClientMessage(playerid, -1, string);
	return 1;
}

CMD:akill(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>S(*)[60]", otherid, tmp))
	{
		Usage(playerid, "/akill <ID/Name> <optional: reason>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	SetPlayerHealth(otherid, 0.0);

	if(tmp[0] != '*')
	{
		format(str, sizeof(str), "4Server: 2%s(%i) has killed %s(%i).", pName[playerid], playerid, giveplayer, otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has killed %s(%i). "GREY_E"[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, tmp);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been killed by an Administrator. "GREY_E"[Reason: %s]", giveplayer, otherid, tmp);
	}
	else
	{
		format(str, sizeof(str), "4Server: 2%s(%i) has killed %s(%i).", pName[playerid], playerid, giveplayer, otherid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has killed %s(%i).", pName[playerid], playerid, giveplayer, otherid);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been killed by an Administrator.", giveplayer, otherid);
	}

	SendClientMessageToAll(COLOR_RED, str);
	return true;
}
CMD:admins(playerid)
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be registered to use this command! (/register)");

	new count = 0, count2 = 0;

	foreach(new ii : Player)
	{
		if(pAdmin[ii] > 0 && pHidden[ii] == 0 && pmhidden[ii] == 0) count++;
		if(pHidden[ii] != 0 || pmhidden[ii] != 0) count2++;
	}

	if(count == 0)
	{
		if(count2 == 0 || pAdmin[playerid] < 2)
		{
			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no administrators online.");
			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Use /report if you suspect a player of cheating.");
			return true;
		}
	}

	new line3[900];
	if(count != 0 || count2 != 0)
	{
		format(str, sizeof(str), ""WHITEP_E"Admins Online: "WHITE_E"%d", count);
		format(line3, sizeof(line3), ""WHITE_E"There are %d staff members online:\n", count);
	}
	foreach(new ii : Player)
	{
	    if(pAdmin[ii] > 0)
	    {
			if(pAdmin[playerid] > 0)
			{
				switch(pAdmin[ii])
				{
					case 1: tmp = "{8A2BE2}(Admin Level 1)";
					case 2: tmp = "{8A2BE2}(Admin Level 2)";
					case 3: tmp = "{8A2BE2}(Admin Level 3)";
					case 4: tmp = "{FF4500}(Lead Admin)";
					case 5: tmp = "{2633E0}(Management)";
					case 6: tmp = "{FF0000}(Owner)";
				}
			}
			else
			{
				switch(pAdmin[ii])
				{
					case 1..3: tmp = "{8A2BE2}(Admin)";
					case 4: tmp = "{FF4500}(Lead Admin)";
					case 5: tmp = "{2633E0}(Management)";
					case 6: tmp = "{FF0000}(Owner)";
				}
			}
			if(cAFK[ii] > 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(AFK)", line3, pColor[ii], pName[ii], ii, tmp);
			else if(pHidden[ii] == 0 && pmhidden[ii] == 0 && cAFK[ii] < 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s", line3, pColor[ii], pName[ii], ii, tmp);
			if(pAdmin[playerid] > 1 && cAFK[ii] < 20)
			{
				if(GetPVarInt(ii, "FullHidden") == 0)
				{
					if(pHidden[ii] && cAFK[ii] < 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(Hidden Administrator)", line3, pColor[ii], pName[ii], ii, tmp);
					else if(pHidden[ii] && cAFK[ii] > 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(Hidden Administrator) (AFK)", line3, pColor[ii], pName[ii], ii, tmp);
					else if(pmhidden[ii] && pAdmin[playerid] > 4 && cAFK[ii] < 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(Hidden Management)", line3, pColor[ii], pName[ii], ii, tmp);
					else if(pmhidden[ii] && pAdmin[playerid] > 4 && cAFK[ii] > 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(Hidden Management) (AFK)", line3, pColor[ii], pName[ii], ii, tmp);
				}
				else
				{
					new name[24];
					GetPVarString(ii, "OldNick", name, sizeof(name));
					if(cAFK[ii] > 20) format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(%s Full-Hidden) (AFK)", line3, pColor[ii], pName[ii], ii, tmp, name);
					else format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(%s Full-Hidden)", line3, pColor[ii], pName[ii], ii, tmp, name);
				}
			}
		}
	}

	format(line3, sizeof(line3), "%s\n\n\n"WHITE_E"To report a hacker, use "YELLOW_E"/report!\n\n"GREY2_E"Do not PM any admins for no reason.\nThe server is also being watched from IRC.", line3);
	ShowPlayerDialog(playerid, 16, DIALOG_STYLE_MSGBOX, str, line3, "Close", "");
	return 1;
}
CMD:admin(playerid) return cmd_admins(playerid);
