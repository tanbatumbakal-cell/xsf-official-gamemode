CMD:devs(playerid, params[]) return cmd_developers(playerid, params);
CMD:developers(playerid, params[])
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be registered to use this command! (/register)");

	new count;
	foreach(new ii : Player)
	{
		if(pDeveloper[ii] > 0) count++;
	}

	if(count == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no developers online!");
		return true;
	}

	new line3[900], displayed;
	if(count == 1)
	{
		str = ""WHITEP_E"Developers Online: "WHITE_E"1";
		line3 = ""WHITE_E"There is 1 developer online:\n";
	}
	else
	{
		format(str, sizeof(str), ""WHITEP_E"Developers Online: "WHITE_E"%d", count);
		format(line3, sizeof(line3), ""WHITE_E"There are %d developers online:\n", count);
	}

	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, sizeof(PlayerName));
		if(pDeveloper[ii] == 1)
		{
			if(displayed == 0)
			{
				if(cAFK[ii] > 20)
				{
					format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(AFK)", line3, pColor[ii], PlayerName, ii);
				}
				else format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i)", line3, pColor[ii], PlayerName, ii);
			}
			else
			{
				if(cAFK[ii] > 20)
				{
					format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) "WHITE_E"(AFK)", line3, pColor[ii], PlayerName, ii);
				}
				else format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i)", line3, pColor[ii], PlayerName, ii);
			}
			displayed = displayed + 1;
		}
	}
	format(line3, sizeof(line3), "%s\n\n\n"WHITE_E"You can suggest new features and report bugs at serverserver.com/forums!", line3);

	ShowPlayerDialog(playerid, 16, DIALOG_STYLE_MSGBOX, str, line3, "Close", "");

	return true;
}

