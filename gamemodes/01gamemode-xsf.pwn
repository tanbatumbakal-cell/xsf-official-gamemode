	format(str, sizeof(str), "2,9RACE7,0 Race '%s' is starting in 40 seconds! Write /join ingame to join it!", CRaceName);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	if(race_RecordMS != 0)
	{
		// Do the calculations!
		localtime(race_RecordMadeAt, tmParam);
		strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);

		new racems = race_RecordMS, racemin, racesec;
		racemin = racems / 60000;
		racems = racems - (racemin * 60000);
		racesec = racems / 1000;
		racems = racems - (racesec * 1000);
		if(racemin == 0)
		{
			format(str, sizeof(str), ""RACE" Race record is %02d.%03d seconds by "YELLOW_E"'%s' "WHITEP_E"made on %s", racesec, racems, TopRacerName, tmp);
			SendClientMessageToAll(COLOR_WHITEP, str);
		}
		else
		{
			if(racemin == 1)
			{
				format(str, sizeof(str), ""RACE" Race record is %d minute and %02d.%03d seconds by "YELLOW_E"'%s' "WHITEP_E"made on %s", racemin, racesec, racems, TopRacerName, tmp);
				SendClientMessageToAll(COLOR_WHITEP, str);
			}
			else
			{
				format(str, sizeof(str), ""RACE" Race record is %d minutes and %02d.%03d seconds by "YELLOW_E"'%s' "WHITEP_E"made on %s", racemin, racesec, racems, TopRacerName, tmp);
				SendClientMessageToAll(COLOR_WHITEP, str);
			}
		}
		format(str, sizeof(str), "2,9RACE7,0 Race record is %d:%02d.%03d by %s made on %s", racemin, racesec, racems, TopRacerName, tmp);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}
	else
	{
		format(str, sizeof(str), ""RACE" Race "YELLOW_E"'%s' "WHITEP_E"has no record time yet! Be the first one to make it!", CRaceName);
		SendClientMessageToAll(COLOR_WHITEP, str);
		format(str, sizeof(str), "2,9RACE7,0 There is no race record on race '%s'!", CRaceName);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	}

	RaceStart = 0;
	RacersReady = 0;
	RaceActive = 1;
	Ranking = 1;
	return true;
}

function startparkour()
{
