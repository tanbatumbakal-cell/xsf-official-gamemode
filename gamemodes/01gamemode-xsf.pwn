				{
					pAch2[playerid] = 1;
					format(query, sizeof(query), "UPDATE achievements SET a2=1 WHERE reg_id=%d", pRegID[playerid]);
					MySQL_updateQuery(query);
					GivePlayerAchievement(playerid, "Mass Killer", "Congrats you reached a 20 killstreak!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
				}

				GetPlayerHealth(playerid, pHealth);
				SetPlayerHealth(playerid, pHealth+30);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~g~~h~+30 ~w~Health", 3500, 5);
				switch(random(5))
				{
					case 0:
					{
						format(str, sizeof(str), "I'm gonna kill you %s!", pName[playerid]);
						SendBotMsg(str);
					}
					case 1:
					{
						format(str, sizeof(str), "Everyone kill %s for free cookies!", pName[playerid]);
						SendBotMsg(str);
					}
					case 2:
					{
						format(str, sizeof(str), "No one is good enough to kill %s? :/", pName[playerid]);
						SendBotMsg(str);
					}
					case 3:
					{
						format(str, sizeof(str), "%s is too good, someone kill them please..", pName[playerid]);
						SendBotMsg(str);
					}
					case 4:
					{
						format(str, sizeof(str), "How is %s not dead yet!", pName[playerid]);
						SendBotMsg(str);
					}
				}
			}
			case 25:
			{
				InfoTD_MSG(playerid, 4500, "~r~~h~~h~25 Kill Streak!~n~~w~+~g~$~w~30000~w~ and +5 score");
				GivePlayerScore(playerid, 6);
