	{
		vID = GetPlayerVehicleID(playerid);
		GetVehiclePos(vID, POS[0], POS[1], POS[2]);
		GetVehicleZAngle(vID, A);
	}
	sPOS2_X[playerid] = POS[0];
	sPOS2_Y[playerid] = POS[1];
	sPOS2_Z[playerid] = POS[2];
	sPOS2_A[playerid] = A;
	sPOS2_Int[playerid] = GetPlayerInterior(playerid);
	sPOS2_VW[playerid] = GetPlayerVirtualWorld(playerid);
}

LoadPlayerPositionEx(playerid)
{
	//Streamer_UpdateEx(playerid, GetPVarFloat(playerid, "sPOS2_X"), GetPVarFloat(playerid, "sPOS2_Y"), GetPVarFloat(playerid, "sPOS2_Z"));

	if(!IsPlayerInAnyVehicle(playerid))
	{
		SetPlayerPosition(playerid, sPOS2_X[playerid], sPOS2_Y[playerid], sPOS2_Z[playerid], sPOS2_A[playerid], sPOS2_Int[playerid]);
	}
	else
	{
		vID = GetPlayerVehicleID(playerid);
		SetPlayerVehiclePosition(playerid, sPOS2_X[playerid], sPOS2_Y[playerid], sPOS2_Z[playerid], sPOS2_A[playerid], sPOS2_Int[playerid]);
		LinkVehicleToInterior(vID, sPOS2_Int[playerid]);
		SetVehicleVirtualWorld(vID, sPOS2_VW[playerid]);
	}
	SetPlayerVirtualWorld(playerid, sPOS2_VW[playerid]);
}

KillStreak(playerid)
{
	if(killStreak[playerid] != 0)
	{
		new Float:pHealth;
		GetPlayerName(playerid, giveplayer, sizeof(giveplayer));
		if(killStreak[playerid] > TotalKillStreak[playerid])
		{
			TotalKillStreak[playerid] = killStreak[playerid];
		}
		if(killStreak[playerid] > 0)
		{
			if((killStreak[playerid] % 10) == 0)
			{
				new i = random(4);
				switch(i)
				{
					case 0: str = "OH MY GOD.";
					case 1: str = "Rest in peace.";
					case 2: str = "Just wow!";
					case 3: str = "RIP server.";
					case 4: str = "Amazing.";
				}
				format(str, sizeof(str), "**[Killstreak]** %s (%i) is on a kill streak with %s, %s", pName[playerid], playerid, killStreak[playerid], str);
				//DCC_SendChannelMessage(Channel_Echo, str);
			}
		}
		switch(killStreak[playerid])
		{
			case 3:
			{
				InfoTD_MSG(playerid, 4500, "~g~~h~~h~Triple Kill!~n~~w~+~g~$~w~5000~w~ and +2 score");
				GivePlayerScore(playerid, 2);
				GivePlayerCash(playerid, 5000);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 3 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			}
			case 5:
			{
				InfoTD_MSG(playerid, 4500, "~r~~h~~h~Mega Kill!~n~~w~+~g~$~w~6000~w~ and +3 score");
				GivePlayerScore(playerid, 3);
				GivePlayerCash(playerid, 6000);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 5 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				SendClientMessage(playerid, COLOR_GREEN, "> "PINK_E"You have earned a cookie for killing 5 people without dying.");
				GivePlayerCookie(playerid, 1);
				GetPlayerHealth(playerid, pHealth);
				SetPlayerHealth(playerid, pHealth+10);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~g~~h~+10 ~w~Health", 3500, 5);
			}
			case 7:
			{
				InfoTD_MSG(playerid, 4500, "~g~~h~~h~Ultra Kill!~n~~w~+~g~$~w~8000~w~ and +4 score");
				GivePlayerScore(playerid, 3);
				GivePlayerCash(playerid, 8000);
				format(str, sizeof(str), ""RED_E"[KS] {%06x}%s(%i) "GREY_E"is unstoppable with a 7 streak kill!", pColor[playerid], giveplayer, playerid);
				SendClientMessageToAll(COLOR_GREY, str);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 7 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			}
			case 10:
			{
				InfoTD_MSG(playerid, 4500, "~g~~h~~h~Monster Kill!~n~~w~+~g~$~w~10000~w~ and +5 score");
				GivePlayerScore(playerid, 4);
				GivePlayerCash(playerid, 10000);
				format(str, sizeof(str), ""RED_E"[KS] {%06x}%s(%i) "GREY_E"is godlike with a 10 streak kill!", pColor[playerid], giveplayer, playerid);
				SendClientMessageToAll(COLOR_GREY, str);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 10 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				SendClientMessage(playerid, COLOR_GREEN, "> "PINK_E"You have earned 2 cookies for killing 10 people without dying.");
				GivePlayerCookie(playerid, 2);

				GetPlayerHealth(playerid, pHealth);
				SetPlayerHealth(playerid, pHealth+10);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~g~~h~+10 ~w~Health", 3500, 5);
			}
			case 15:
			{
				InfoTD_MSG(playerid, 4500, "~g~~h~~h~Incredible Kill!~n~~w~+~g~$~w~15000~w~ and +5 score");
				GivePlayerScore(playerid, 5);
				GivePlayerCash(playerid, 15000);
				format(str, sizeof(str), ""RED_E"[KS] {%06x}%s(%i) "GREY_E"can't be stopped with a 15 streak kill!", pColor[playerid], giveplayer, playerid);
				SendClientMessageToAll(COLOR_GREY, str);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 15 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			}
			case 20:
			{
				InfoTD_MSG(playerid, 4500, "~r~~h~~h~Monster Kill!~n~~w~+~g~$~w~20000~w~ and +5 score");
				GivePlayerScore(playerid, 6);
				GivePlayerCash(playerid, 20000);
				format(str, sizeof(str), ""RED_E"[KS] {%06x}%s(%i) "GREY_E"shitting on everyone with a 20 streak kill!", pColor[playerid], giveplayer, playerid);
				SendClientMessageToAll(COLOR_GREY, str);
				format(str, sizeof(str), "3%s(%i)2 is on a kill streak with 20 kills!", giveplayer, playerid);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				SendClientMessage(playerid, COLOR_GREEN, "> "PINK_E"You have earned 4 cookies for killing 10 people without dying.");
				GivePlayerCookie(playerid, 4);
