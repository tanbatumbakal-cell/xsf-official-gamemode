stock IsLeapYear(year)
{
	if(year % 4 == 0) return 1;
	else return 0;
}

stock TimestampToDate(Timestamp, &year, &month, &day, &hour, &minute, &second, HourGMT, MinuteGMT = 0)
{
	new tmp = 2;
	year = 1970;
	month = 1;
	Timestamp -= 172800; // Delete two days from the current timestamp. This is necessary, because the timestamp retrieved using gettime() includes two too many days.
	for(;;)
	{
		if(Timestamp >= 31536000)
		{
			year ++;
			Timestamp -= 31536000;
			tmp ++;
			if(tmp == 4)
			{
				if(Timestamp >= 31622400)
				{
					tmp = 0;
					year ++;
					Timestamp -= 31622400;
				}
				else break;
			}
		}
		else break;
	}
	for(new i = 0; i < 12; i ++)
	{
		if(Timestamp >= MonthTimes[i][2 + IsLeapYear(year)])
		{
			month ++;
			Timestamp -= MonthTimes[i][2 + IsLeapYear(year)];
		}
		else break;
	}
	day = 1 + (Timestamp / 86400);
	Timestamp %= 86400;
	hour = HourGMT + (Timestamp / 3600);
	Timestamp %= 3600;
	minute = MinuteGMT + (Timestamp / 60);
	second = (Timestamp % 60);
	if(minute > 59)
	{
		minute = 0;
		hour ++;
	}
	if(hour > 23)
	{
		hour -= 24;
		day ++;
	}
	if(day > MonthTimes[month][IsLeapYear(year)])
	{
		day = 1;
		month ++;
	}
	if(month > 12)
	{
		month = 1;
		year ++;
	}
	return 1;
}

stock DateToTimestamp(str[11])
{
	new date[3]; // date[0] = day		date[1] = month			date[2] = year
	if(!sscanf(str,"p<"#SPLITTER">ddd",date[0],date[1],date[2]))
	{
		new total = 0, tmp = 0;
		total += date[0] * 86400;
		if(date[1] == 2 && date[0] < 29) tmp = ((date[2] - 1968) / 4 - 2);
		else tmp = ((date[2] - 1968) / 4 - 1);
		total += tmp * 31622400;
		total += (date[2] - 1970 - tmp) * 31536000;
		for(new i = 1; i < date[1]; i ++) total += MonthTimes[i][0 + IsLeapYear(date[2])] * 86400;
		return total;
	}
	else return -1;
}
*/
/* END OF DateToTimestamp - credits to Jochemd */




public OnPlayerText(playerid, text[])
{
	if(isnull(text)) return 0;
	if(pSpawned[playerid] == 0)
	{
		Error(playerid, "You must be spawned or logged in to use chat.");
		return false;
	}

	if(checkForAdvertise(text)){
		format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s) - muted for 60s", pName[playerid], playerid, text);
		SendAdminMessage(COLOR_RED, str);
		Error(playerid, "You cannot advertise here!");
		format(str, sizeof(str), "**[Admin] %s(%d)** has attempted to advertise! **(Text: %s)** muted for 60s", pName[playerid], playerid, text);
		pMute[playerid] += 65;
		return false;
	}

	// Trim the message from the end
	new iu = strlen(text) - 1;
	while(text[iu] == ' ')
		iu --;

	iu++;
	if(!iu)
		return false;
	text[iu] = EOS;

	if(pAdmin[playerid] == 0)
	{
		if(pMute[playerid] > 0)
		{
			format(str, sizeof(str), "* You can't speak while muted, mute will be lifted in %d seconds.", pMute[playerid]);
			SendClientMessage(playerid, COLOR_ORANGE, str);
			GameTextForPlayer(playerid, "~r~You are muted~y~!", 3000, 3);
			return false;
		}
		if(strfind(LastText[playerid], text, false) != -1)
		{
			RepeatMsg[playerid]++;
			if(RepeatMsg[playerid] >= 2 || RepeatMsg[playerid] && !pLogged[playerid]|| (RepeatMsg[playerid] && pTotalHours[playerid] == 0 && pTotalMinutes[playerid] < 20))
			{
				SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"Do not repeat your message.");
				return false;
			}
		}
		else RepeatMsg[playerid] = 0;
		strmid(LastText[playerid], text, 0, strlen(text), sizeof(LastText[]));

		// Check for frequent text lines
		SpamCount[playerid]++;
		if(SpamCount[playerid] > 6)
		{
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been kicked for excessive spam.", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_RED, str);
			SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "RED_E"You have been kicked for excessive spamming!");
			format(str, sizeof(str), "4Anti-Spam:3 %s(%i) has been kicked for excessive spam.", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str), "**[Anti-Spam] %s(%i)** has been kicked for excessive spam.", pName[playerid], playerid);
			//DCC_SendChannelMessage(Channel_Staff, str);
			Kick(playerid);
			return false;
		}
		else if(SpamCount[playerid] > 2)
		{
			SendClientMessage(playerid, COLOR_RED, ""GREY2_E"Anti-Spam: "RED_E"Please wait before speaking again!");
			return false;
		}


		//fresh players
		if(pLogged[playerid] == false || (pTotalHours[playerid] == 0 && pTotalMinutes[playerid] < 20)) //super strict mode on new players
		{
			new i_space; new i_numcount, i_period, i_pos;
			while(text[i_pos])
		 	{
		  		if('0' <= text[i_pos] <= '9') i_numcount ++;
		   		else if(text[i_pos] == '.') i_period ++;
		   		else if(text[i_pos] == ' ') i_space++;
				i_pos++;
			}
			if(i_numcount >= 5 && i_period >= 2 || i_numcount >= 5 && i_space >= 2)
			{
				format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s) muted for 60s", pName[playerid], playerid, text);
				SendAdminMessage(COLOR_RED, str);
				SendClientMessage(playerid, COLOR_RED, ""GREY2_E"Server: "RED_E"You are not allowed to advertise! [Strict mode on new players]");
				format(str, sizeof(str), "4Server:2 %s(%d) has attempted to advertise! (Text: %s) - Muted for 60s", pName[playerid], playerid, text);
				IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				pMute[playerid] += 65;
				return false;
			}
		}

		

		//new anti advertising
		if(stringContainsIP(text) && strfind(text[0], xChars, false) == -1)
		{
			format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s)", pName[playerid], playerid, text);
			SendAdminMessage(COLOR_RED, str);
			SendClientMessage(playerid, COLOR_RED, ""GREY2_E"Server: "RED_E"You are not allowed to advertise other servers here!");
			format(str, sizeof(str), "4Server:2 %s(%d) has attempted to advertise! (Text: %s)", pName[playerid], playerid, text);
			IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			return false;
		}

		if(strfind(text, ":", true) != -1)
		{
			new i_numcount, i_period, i_pos;
	 		while(text[i_pos])
		 	{
		  		if('0' <= text[i_pos] <= '9') i_numcount ++;
		   		else if(text[i_pos] == '.') i_period ++;
				i_pos++;
			}
			if(i_numcount >= 8 && i_period >= 3)
			{
				format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"%s(%i) has attempted to advertise! (Text: %s)", pName[playerid], playerid, text);
				SendAdminMessage(COLOR_RED, str);
				SendClientMessage(playerid, COLOR_RED, ""GREY2_E"Server: "RED_E"You are not allowed to advertise other servers here!");
				format(str, sizeof(str), "4Server:2 %s(%d) has attempted to advertise! (Text: %s)", pName[playerid], playerid, text);
				IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				pMute[playerid] += 65;
				return false;
			}
		}

		// Anti-Caps
		if(GetPVarType(playerid, "Caps"))
			UpperToLower(text);
	}
	if(text[0] == '@')
	{
		switch(GetPVarInt(playerid, "lastPMer"))
		{
			case -1:
			{
				SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" The last person that pm'ed you isn't online anymore!");
				return false;
			}
			case -2:
			{
				SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" '@' is the prefix for chatting with the last person that PM'ed you, no one has PM'ed you.");
				return false;
			}
			default:
			{
				if(text[1] == ' ')
				{
					format(tmp, sizeof(tmp), "%i %s", GetPVarInt(playerid, "lastPMer"), text[2]);
				}
				else
				{
					format(tmp, sizeof(tmp), "%i %s", GetPVarInt(playerid, "lastPMer"), text[1]);
				}
				cmd_pm(playerid, tmp);
				return false;
			}
		}
	}
	else if(text[0] == '#' && pAdmin[playerid] != 0)
	{
		cmd_a(playerid, text[1]);
		return false;
	}
	else if(text[0] == '#' && pAdmin[playerid] != 0)
	{
		cmd_a(playerid, text[1]);
		return false;
	}
	else if(text[0] == '\'' && pAdmin[playerid] != 0 && pDeveloper[playerid] != 0)
	{
		cmd_dchat(playerid, text[1]);
		return false;
	}
	else if(text[0] == '*' && (Helper[playerid] == 1 || Helper[playerid] == 3 || pAdmin[playerid] > 0))
	{
		cmd_h(playerid, text[1]);
		return 0;
	}
	else if(text[0] == '!' && pGroupID[playerid] != -1) {
		cmd_g(playerid, text[1]);
		return 0;
	}
	if(strfind(text, "/q", true) != -1)
	{
		Error(playerid, "You are not allowed to type /q in chat!");
		return false;
	}
	GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
	if(pGroupID[playerid] != -1) 
		LoadTag(playerid);
	else togTag[playerid] = true;
	new namewithtag[90];

	if(LastTag[playerid]) 
		format(namewithtag,sizeof(namewithtag),"%s%s" ,  togTag[playerid] ? (pGTag[playerid]): ("") , PlayerName);
	else format(namewithtag,sizeof(namewithtag),"%s%s" ,PlayerName, togTag[playerid] ? (pGTag[playerid]): (""));

	// Check if we need to send a multi-line message
	if(strlen(text) > 80)
	{
		// Find the first space, start looking at 70 characters
		new i = strfind(text, " ", false, 70);
		// If no spaces were found or one was found at 90+ characters, default it to 80
		if(i == -1 || i > 90) i = 80;

		tmp[0] = EOS;
		if(pAdmin[playerid] != 0 && pHidden[playerid] == 0) tmp = "{FFFFFF}";
		if(pChatColor[playerid] != 0 && pHidden[playerid] == 0)
		{
			new cStr[20];
			format(cStr, sizeof(cStr), "{%06x}", pChatColor[playerid]);
			tmp = cStr;
		}
		strcat(tmp, text[i]);
		text[i] = EOS;
		if(pHidden[playerid] != 0)
		{
			format(str, sizeof(str), "{%06x}%s "GREY_E"(%i):"WHITE_E" %s", pColor[playerid], PlayerName, playerid, text);
		}
		else if(pChatColor[playerid] != 0)
		{
			if(pIDColor[playerid] != 0) format(str, sizeof(str), "{%06x}%s {%06x}[%i]:{%06x} %s", 
																	pColor[playerid], namewithtag, pIDColor[playerid], playerid, pChatColor[playerid], text);
			else format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{%06x} %s", 
											pColor[playerid], namewithtag, playerid, pChatColor[playerid], text);
		}
		else if(pIDColor[playerid] != 0)
		{
			switch(pAdmin[playerid])
			{
				case 0:
				{
					if(pPremium[playerid] != 0)
					{
						format(str, sizeof(str), "{%06x}%s {%06x}(%i):"WHITE_E" %s", pColor[playerid],namewithtag ,  pIDColor[playerid], playerid, text);
					}
					else format(str, sizeof(str), "{%06x}%s {%06x}(%i):"WHITE_E" %s", pColor[playerid],namewithtag ,  pIDColor[playerid], playerid, text);
				}
				case 1..6: format(str, sizeof(str), "{%06x}%s {%06x}[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  pIDColor[playerid], playerid, text);
			}
		}
		else switch(pAdmin[playerid])
		{
			case 0:
			{
				if(pPremium[playerid] != 0)
				{
					format(str, sizeof(str), "{%06x}%s "LB_E"(%i):"WHITE_E" %s", pColor[playerid],namewithtag ,  playerid, text);
				}
				else format(str, sizeof(str), "{%06x}%s "GREY_E"(%i):"WHITE_E" %s", pColor[playerid],namewithtag ,  playerid, text);
			}
			case 1: format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  playerid, text);
			case 2: format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  playerid, text);
			case 3: format(str, sizeof(str), "{%06x}%s "ORANGE_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  playerid, text);
			case 4: format(str, sizeof(str), "{%06x}%s "RED_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  playerid, text);
			case 5: format(str, sizeof(str), "{%06x}%s {2E64C1}[%i]:{FFFFFF} %s", pColor[playerid],namewithtag ,  playerid, text);
			case 6: format(str, sizeof(str), "{%06x}%s {FF0000}[%i]:{FFFFFF} %s" , pColor[playerid],namewithtag, playerid, text);
		}
	}
	else
	{

		if(mathsAnswered == 0)
		{
		    if(IsNumeric(text) && strval(text) == mathsAnswer)
		    {
		        cmd_answer(playerid,text);
		        return 0;
		    }
		}
		if(strcmp(text, xChars, false) == 0)
		{
			if(pLogged[playerid] == false)
			{
				Error(playerid, "Sorry, you must be logged in in order to participate in reaction test (/register)!");
				return false;
			}
			if(reactionActive == false)
			{
				format(str, sizeof(str), ""RED_E"ReactionTest :: "LB_E"The reaction test is already over! %s(%d) already won!", pName[reactionWinnerID], reactionWinnerID);
				SendClientMessage(playerid, COLOR_LB, str);
				return false;
			}
			if(pMute[playerid] > 0)
			{
				format(str, sizeof(str), "* You can't participate while muted, mute will be lifted in %d seconds.", pMute[playerid]);
				SendClientMessage(playerid, COLOR_ORANGE, str);
				GameTextForPlayer(playerid, "~r~You are muted~y~!", 3000, 3);
				return false;
			}
			else
			{
				reactionActive = false;

				// Calculate seconds and milliseconds from tickcount
				datez = GetTickCount() - reactionTimeStart;
				hour = datez;
				second = datez / 1000;
				datez = datez - second * 1000;

				reactionsWon[playerid]++;
				GivePlayerScore(playerid, 2);
				GivePlayerCash(playerid, reactionAward);
				format(query, sizeof(query), "UPDATE players SET rtests=rtests+1 WHERE reg_id=%d", pRegID[playerid]);
				MySQL_updateQuery(query);
				InfoTD_MSG(playerid, 5000, "~g~~h~Congratulations!~n~~w~You won the reaction test!");
				reactionWinnerID = playerid;
				if(pGroupID[playerid] != -1)
				{
					UpdateGroupScore(pGroupID[playerid], 1);
				}

				format(str, sizeof(str), ""LRED_E"[REACTION] {%06x}%s(%i) "YELLOW_E"has won the reaction test for phrase '"LB2_E"%s"YELLOW_E"' in %2d.%03d seconds!", pColor[playerid], PlayerName, playerid, xChars, second, datez);
				SendClientMessageToAll(COLOR_YELLOW, str);
				format(str, sizeof(str), "3,1ReactionTest:4 %s(%i) has won the reaction test for phrase '%s' %2d.%03d seconds!", PlayerName, playerid, xChars, second, datez);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
				format(str, sizeof(str), "Won the Reaction Test in %02d.%03d seconds!", second, datez);
				SetPlayerChatBubble(playerid, str, COLOR_ORANGE, 40.0, 4000);
				reactionTimeStart = 0;
				
				if(reactionsWon[playerid] == 50)
				{
					if(pAch10[playerid] == 0)
					{
						pAch10[playerid] = 1;
						format(query, sizeof(query), "UPDATE achievements SET a10=1 WHERE reg_id=%d", pRegID[playerid]);
						MySQL_updateQuery(query);
						GivePlayerAchievement(playerid, "Too Fast", "Congrats you've won 50 reaction tests!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
					}
				}
				switch(random(10))
				{
					case 0:
					{
						format(str, sizeof(str), "That's unreal, %s", pName[playerid]);
						SendBotMsg(str);
					}
					case 1:
					{
						format(str, sizeof(str), "Wow %s, what keyboard do you use?", pName[playerid]);
						SendBotMsg(str);
					}
					case 2:
					{
						format(str, sizeof(str), "Damn %s! How did you keyboard-smash so perfectly?", pName[playerid]);
						SendBotMsg(str);
					}
					case 3:
					{
						format(str, sizeof(str), "Don't break that keyboard, %s!", pName[playerid]);
						SendBotMsg(str);
					}
					case 4:
					{
						SendBotMsg("I never win these reaction tests D:");
					}
					case 5..9: { }
				}
			}
		}
		if(pHidden[playerid] != 0)
		{
			format(str, sizeof(str), "{%06x}%s "GREY_E"(%i):"WHITE_E" %s", pColor[playerid], PlayerName, playerid, text);
		}
		else if(pChatColor[playerid] != 0)
		{
			if(pIDColor[playerid] != 0) format(str, sizeof(str), "{%06x}%s {%06x}[%i]:{%06x} %s", pColor[playerid],namewithtag , pIDColor[playerid], playerid, pChatColor[playerid], text);
			else format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{%06x} %s", pColor[playerid],namewithtag, playerid, pChatColor[playerid], text);
		}
		else if(pIDColor[playerid] != 0)
		{
			switch(pAdmin[playerid])
			{
				case 0:
				{
					if(pPremium[playerid] != 0)
					{
						format(str, sizeof(str), "{%06x}%s {%06x}(%i):"WHITE_E" %s", pColor[playerid],namewithtag, pIDColor[playerid], playerid, text);
					}
					else format(str, sizeof(str), "{%06x}%s {%06x}(%i):"WHITE_E" %s", pColor[playerid],namewithtag, pIDColor[playerid], playerid, text);
				}
				case 1..6: format(str, sizeof(str), "{%06x}%s {%06x}[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, pIDColor[playerid], playerid, text);
			}
		}
		else switch(pAdmin[playerid])
		{
			case 0:
			{
				if(pPremium[playerid] != 0)
				{
					format(str, sizeof(str), "{%06x}%s "LB_E"[%i]:"WHITE_E" %s", pColor[playerid],namewithtag, playerid, text);
				}
				else format(str, sizeof(str), "{%06x}%s "GREY_E"(%i):"WHITE_E" %s", pColor[playerid],namewithtag, playerid, text);
			}
			case 1: format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
			case 2: format(str, sizeof(str), "{%06x}%s "GREY2_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
			case 3: format(str, sizeof(str), "{%06x}%s "ORANGE_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
			case 4: format(str, sizeof(str), "{%06x}%s "RED_E"[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
			case 5: format(str, sizeof(str), "{%06x}%s {2E64C1}[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
			case 6: format(str, sizeof(str), "{%06x}%s {FF0000}[%i]:{FFFFFF} %s", pColor[playerid],namewithtag, playerid, text);
		}
		foreach(new ii : Player) if(GetPVarInt(ii, "BadSports") == 0) SendClientMessage(ii, COLOR_WHITE, str);
	}
	format(str, sizeof(str), "3%s2[%i]1: %s", PlayerName, playerid, text);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);

	format(str, sizeof(str), "**[Chat]** %s (%d): %s", pName[playerid], playerid, text);
	//DCC_SendChannelMessage(Channel_Echo, str);

	format(str, sizeof(str), "Says: "WHITE_E"%s", text);
	SetPlayerChatBubble(playerid, str, COLOR_BLUE, 20.0, 4000);
	msgsSent++;
	return false;
}

