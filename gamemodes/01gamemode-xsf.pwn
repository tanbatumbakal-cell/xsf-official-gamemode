				strcat(line3, "\n"IVORY_E"/bounties\t"RED_E"» "WHITE_E"View the players that have a hit on them.\n"IVORY_E"/ignore\t\t"RED_E"» "WHITE_E"Block a player from PMing you.\n"IVORY_E"/loc\t\t"RED_E"» "WHITE_E"Locate a player.\n"IVORY_E"/afklist\t\t"RED_E"» "WHITE_E"View a list of AFK players.\n"IVORY_E"/tag\t\t"RED_E"» "WHITE_E"Set a 3D Text label above your name.\n"IVORY_E"/ostats\t\t"RED_E"» "WHITE_E"View statistics of offline players.");
