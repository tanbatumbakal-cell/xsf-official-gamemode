		} else if(doingStunt[playerid] == 19) {
			SetPlayerPosition(playerid, 405.1100,2474.0784,35.7369,360.0000);
			GetPlayerName(playerid, giveplayer, sizeof(giveplayer));
			GetPlayerIp(playerid, PlayerIP, sizeof(PlayerIP));

			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"ChumLee has re-connected %s(%i) to the game "GREY2_E"[Reason: AFK in a derby]", giveplayer, playerid);
			SendClientMessageToAll(COLOR_RED, str);

			format(str, sizeof(str), "4Server: 2Server has re-connected %s(%i) to the game [Reason: AFK in a derby]", giveplayer, playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

			SetPVarInt(playerid, "pBugged", 1);
			format(giveplayer,sizeof(giveplayer), "banip %s", PlayerIP);
			SendRconCommand(giveplayer);
			printf("pbuggged 3");
		}
	}

	if(ParticipatingWar[playerid] == 1)
	{
	    if(GOD[playerid] == 1)
	    {
	        GOD[playerid] = 0;
	        SetPlayerHealth(playerid, 98);
	        SetPlayerArmour(playerid, 0);
	        GiveSpawnWeapons(playerid);

	        TextDrawHideForPlayer(playerid, godTD);
			DestroyDynamic3DTextLabel(god3D[playerid]);
			god3D[playerid] = Text3D:-1;
		}
	}

	if((InDM[playerid] || InEvent[playerid] || ParticipatingWar[playerid]) && GetPVarInt(playerid, "nameTagOFF"))
	{
		foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, true);
		DeletePVar(playerid, "nameTagOFF");
		SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"Your nametag has been automatically enabled, other players will now to able to see your name.");
	}
    if(GetPlayerWeapon(playerid) == 4)//if the player have a knife -- checking for stabbing
    {
	    if(InDM[playerid] == 0)
	    {
    	    if(GetPlayerAnimationIndex(playerid) != 0)
    	    {
		       	new animation[2][35];
   			   	GetAnimationName(GetPlayerAnimationIndex(playerid), animation[0], 35, animation[1], 35);

				if( !strcmp(animation[0], "KNIFE", true)
             		& !strcmp(animation[1], "KILL_Knife_Player", true))
            	{
	                new target = GetPlayerTargetPlayer(playerid);

	                if(IsPlayerConnected(target))
	                {
	                    new Float:x, Float:y, Float:z;
	                    GetPlayerPos(target, x, y, z);

	                    if(IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z))
	                    {
	                        if(GOD[target]==1)
	                        {
	                            ClearAnimations(playerid);

	                            GetPlayerPos(playerid, x, y, z);
	                            SetPlayerPos(playerid, x, y, z+5);

	                            new world = GetPlayerVirtualWorld(playerid);//store player virtual world in var

								TogglePlayerSpectating(playerid, true);

								SetPlayerVirtualWorld(playerid, world + 1);

								TogglePlayerSpectating(playerid, false);

								SetPlayerVirtualWorld(playerid, world);

	                            GameTextForPlayer(playerid, "~r~You can't knife players on god mode", 3000, 3);
								return 0;
	                        }
							else if(InDM[target] == 13 && GetPlayerTeam(playerid) != GetPlayerTeam(target)) {
								ClearAnimations(playerid);
								GetPlayerPos(target, x, y, z);
								SetPlayerPos(target, x, y, z);
								SetPlayerHealth(target, 0.0);
								return 0;
							}
	                    }
	                }
	            }
	        }
		}
    }
	/*static lastServerUpdate;
	iTemp = GetTickCount();
	if(lastServerUpdate != 0 && (iTemp - lastServerUpdate) > 500)
	{
		format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"Possible server lag detected (tick %i) (length %dms)",  iTemp, (iTemp - lastServerUpdate));
		SendAdminMessage(COLOR_RED, str, 3);
		foreach(new i : Player)
		{
			if(pAdmin[i] > 3) SendClientMessage(i, COLOR_RED, str);
		}
		print(str);
	}
	lastServerUpdate = iTemp;*/

	if(cAFK[playerid] > 60)
	{
		if(InDM[playerid] > 0 && InDM[playerid] != 13)
		{
  			if(eInfo[playerid][inPUBG] == 1)
		    {
				ResetPlayerWeapons(playerid);
				cmd_leavepubg(playerid,"");
		    }
			ResetPlayerWeapons(playerid);
			RemovePlayerFromDM(playerid);
			SendClientMessage(playerid, COLOR_GREY, ""RED_E"Server: "GREY2_E"You have been removed from the deathmatch for being AFK more than 1 minute.");
			SetPlayerPosOnSpawn(playerid);
		}
		if(GetPVarInt(playerid, "recivedPM"))
		{
			DeletePVar(playerid, "recivedPM");
			InfoTD_MSG(playerid, 4000, "~w~You have received a PM while you were AFK!~N~Type ~r~~h~/checkpms ~w~to view your private messages.");
		}
	}
	/*vID = GetPlayerVehicleID(playerid);
	if(vID == 0) GetPlayerPos(playerid, LastFootPos[0][playerid], LastFootPos[1][playerid], LastFootPos[2][playerid]);

	if(vID != LastState[playerid] && vID != 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && InDerby[playerid] == 0)
	{
		new Float: fDistance = GetVehicleDistanceFromPoint(vID, LastFootPos[0][playerid], LastFootPos[1][playerid], LastFootPos[2][playerid]),
			Float: fOffset = 10.0;

		if((GetVehicleModel(vID) == 577 ) || (GetVehicleModel(vID) == 592)) fOffset = 25.0; // Andromanda | AT-400

		if(fDistance > fOffset)
		{
			// Hacks Detected
			new hwarns = GetPVarInt(playerid, "VehHacks") + 1;
			SetPVarInt(playerid, "VehHacks", hwarns);
			if(GetPVarInt(playerid, "VehHacks") == 3)
			{
				GetVehiclePos(vID, POS[0], POS[1], POS[2]);
				OnPlayerExitVehicle(playerid, GetPlayerVehicleID(playerid));
				SetPlayerPos(playerid, POS[0]+4, POS[1], POS[2]+1);
				return 0;
			}
			return 0;
		}
		GetPlayerPos(playerid, LastFootPos[0][playerid], LastFootPos[1][playerid], LastFootPos[2][playerid]);
		LastState[playerid] = vID;
	}*/
	if(AFK[playerid] != 1)
	{
		cAFK[playerid] = 0;
	}
	return true;
}

CMD:resetadmhours(playerid, params[])
{
	if(pAdmin[playerid] >= 5)
	{
	    ResetAdminHours();
	    SendClientMessage(playerid, -1, "{FF0000}Admin hours have been reset for everybody.");
	}
	return 1;
}

ResetAdminHours()
{
    format(query, sizeof(query), "UPDATE players SET admOnTime=0");
	MySQL_updateQuery(query);
	return 1;
}
SavePlayerStats(playerid)
{

	if(pLogged[playerid] == true)
	{
		//space the saves by 15 seconds, as they are under "onPlayerCommandText" right now, to increase the save rates.
		if(LastStatSave[playerid] + 15 > gettime()) 
			return 1;
		else
		{
			LastStatSave[playerid] = gettime();	
		}

		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET hours=%d,minutes=%d,seconds=%d,kills=%d,killstreak=%d,money=%d,score=%d,deaths=%d,cookies=%d,active=0,god=%d,Muted=%d,Jailed=%d,admOnTime=%i,gSpawnX=%f,gSpawnY=%f,gSpawnZ=%f,pSpawnX=%f,pSpawnY=%f,pSpawnZ=%f,pSpawnA=%f,pmhidden=%i,togevent=%i,pubg_rankpoints=%d,pubg_killpoints=%d,pubg_wins = %d,pubg_kills = %d,pubg_deaths = %d , last_time=CURRENT_TIMESTAMP() WHERE reg_id=%d",
			pTotalHours[playerid], pTotalMinutes[playerid], pTotalSeconds[playerid], pInfo[playerid][pKills], TotalKillStreak[playerid], pCash[playerid], pScore[playerid], pInfo[playerid][pDeaths], pCookies[playerid], GOD[playerid], pMute[playerid], pJail[playerid], admOnTime[playerid],
			gSpawnPos[playerid][0],
			gSpawnPos[playerid][1],
			gSpawnPos[playerid][2],

			pSpawnPos[playerid][0],
			pSpawnPos[playerid][1],
			pSpawnPos[playerid][2],
			pSpawnPos[playerid][3],
			pmhidden[playerid],
   			(pEventDialog[playerid] ? (1) : (0)),
  			PUBG_RP[playerid],
			PUBG_KP[playerid],
			PUBG_Wins[playerid],
			PUBG_Kills[playerid],
			PUBG_Deaths[playerid],
			pRegID[playerid]
			);

		MySQL_updateQuery(query);

		MySQL_SavePlayerToys(playerid);
		MySQL_SavePlayerVeh(playerid, 0);
        MySQL_SavePlayerVeh(playerid, 1);
	}
	return 1;
}


public OnPlayerCommandText(playerid, cmdtext[])
{
	SavePlayerStats(playerid);
	// Print Commands.
	if(isnull(cmdtext)) return 0;
	//if(pAdmin[playerid] > 0) return 0;
	if(GetPVarInt(playerid, "ParticipatingHG") && pAdmin[playerid] == 0 && IsHelperCMD(cmdtext) && strcmp(cmdtext, "/inv", true, 4) && strcmp(cmdtext, "/takeitem", true, 9) && strcmp(cmdtext, "/leave", true, 6) && strcmp(cmdtext, "/hgstats", true, 8) && strcmp(cmdtext, "/hgchat", true, 7) && strcmp(cmdtext, "/exit", true, 5)) return Error(playerid, "You can't use any commands while being in HungerGames");
	if(GetPVarInt(playerid, "BadSports"))
	{
		if(!strcmp(cmdtext, "/veh", true, 2))
		{
			new pos;
			while(cmdtext[++pos] > ' ')
				str[pos-1] = tolower(cmdtext[pos]);
			str[pos-1] = '\0';
			format(str, 32, "cmd_%s", str);

			while(cmdtext[pos] == ' ')
				pos++;

			if(!cmdtext[pos])
				pos = CallLocalFunction(str, "is", playerid, "\1");
			else
				pos = CallLocalFunction(str, "is", playerid, cmdtext[pos]);

			return 1;
		}
		else return Error(playerid, "You cannot use commands while being banned from the main game.");
	}
	if(pRegID[playerid] != 0 && !pLogged[playerid]) return Error(playerid, "You cannot use commands while logged out of a registered account.");
	if(InEvent[playerid] && CSEvent && strcmp(cmdtext, "/leave", true, 6) && pAdmin[playerid] == 0) return Error(playerid, "You can't use any command while being in CS event");
	printf("[CMD]: %s(%d) has used the command '%s'", pName[playerid], playerid, cmdtext);

	if(ChaseBonus)
	{
		if(ChasePlayer == playerid && strcmp(cmdtext, "/v", true, 2) && !pAdmin[playerid])
		{
			Error(playerid, "You can't use any commands while being chased. (except: /v)");
			return true;
		}
	}
	if(pJail[playerid] > 0 && pAdmin[playerid] == 0)
	{
		if(strcmp(cmdtext, "/escape", true))
		{
			if(strcmp(cmdtext, "/bc", true))
			{
				format(str, sizeof(str), ""RED_E"Server:"GREY2_E" You can't use commands in jail, you will be out in "GREY_E"%d seconds.", pJail[playerid]);
				SendClientMessage(playerid, COLOR_GREY2, str);
				return true;
			}
		}
	}
	if(killCamON[playerid] == true && pAdmin[playerid] == 0)
	{
		Error(playerid, "You can not use commands while on the killCam, press the fire key to spawn.");
		return 1;
	}
	if(Freezed[playerid] == true && pAdmin[playerid] == 0)
	{
		Error(playerid, "You can not use any commands while frozen!");
		return 1;
	}
	if(pBlocked[playerid] > 0 && pAdmin[playerid] == 0)
	{
		format(str, sizeof(str), "* Your commands are blocked, block will be lifted in %d seconds.", pBlocked[playerid]);
		SendClientMessage(playerid, COLOR_ORANGE, str);
		GameTextForPlayer(playerid, "~r~Your commands are blocked~y~!", 3000, 4);
		return true;
	}

	// If the player sends more than one command in 0.333 seconds, block their commands for 30 seconds.
	iTemp = GetTickCount();
	if((iTemp - pLastCommandTick[playerid]) < 333)
	{
		pBlocked[playerid] = 30;
		SendClientMessage(playerid, COLOR_RED, ""GREY_E"Anti-Spam: "RED_E"Possible flood detected (commands blocked for 30 seconds)!");
		return true;
	}
	pLastCommandTick[playerid] = iTemp;

	// Close any open dialogs.
	ClosePlayerDialog(playerid);

	new pos;
	while(cmdtext[++pos] > ' ')
		str[pos-1] = tolower(cmdtext[pos]);
	str[pos-1] = '\0';
	format(str, 32, "cmd_%s", str);

	while(cmdtext[pos] == ' ')
		pos++;

	if(!cmdtext[pos])
		pos = CallLocalFunction(str, "is", playerid, "\1");
	else
		pos = CallLocalFunction(str, "is", playerid, cmdtext[pos]);

	if(!pos)
	{
		sscanf(cmdtext, "s[90] ", tmp);
		str = ""RED_E"ERROR: "WHITE_E"The command "GREY2_E"";
		strcat(str, tmp);
		strcat(str, " "WHITE_E"couldn't be found. Look at "YELLOW_E"/CMDS "WHITE_E"and "YELLOW_E"/TELES!");
		SendClientMessage(playerid, COLOR_WHITE, str);

		InfoTD_MSG(playerid, 2700, "~w~Unknown command! Check out ~y~/cmds ~w~and ~y~/teles");
		TextDrawShowForPlayer(playerid, ErrorTD);
		PlayerPlaySound(playerid, 1085, 0, 0, 0);
		SetTimerEx("hideError", 2700, false, "i", playerid);
		return true;
	}
	return true;
}

function DestroyRamp(playerid)
{
	new rampObject = GetPVarInt(playerid, "rampObject");
	if(rampObject) DestroyDynamicObject(rampObject);
	DeletePVar(playerid, "rampObject");
	rampTimer[playerid] = -1;
}

// Callbacks which are fired from inside ODR
forward PassChange_OnPassCheck(playerid);
public PassChange_OnPassCheck(playerid)
{
	if(!MySQL_rowCount())
	{
		ShowPlayerDialog(playerid, 198, DIALOG_STYLE_INPUT, "Change your password", "Insert your current password...", "Continue", "Exit");
		Error(playerid, "Invalid password specified.");
		InfoTD_MSG(playerid, 3000, "~r~~h~Error changing password!~n~~w~Wrong password.");
	}
	else
	{
		ShowPlayerDialog(playerid, 199, DIALOG_STYLE_INPUT, ""WHITE_E"Change your password", "Enter your new password!\n\n"dot"All passwords are hashed with SHA1, and are not saved in cleartext.\n"dot"Our databases are leaked. Take precaution and change your pass wherever you use it.\n"dot"This will be your new pass:\n", "Enter", "Exit");
		InfoTD_MSG(playerid, 3000, "~w~Insert your new password!");
	}
	return true;
}
forward PassChange_OnForcedPassCheck(playerid, password[]);
public PassChange_OnForcedPassCheck(playerid, password[])
{
	if(MySQL_rowCount())
	{
		ShowPlayerDialog(playerid, 199, DIALOG_STYLE_INPUT, ""WHITE_E"Change your password", "Enter your new password!\n\n"dot"All passwords are hashed on our database.\n"dot"All passwords are case-sensitive.\n"dot"You can't use the same old password. Please enter a new, STRONG password.\n", "Enter", "Exit");
		Error(playerid, "You cannot use the same password you already have.");
		InfoTD_MSG(playerid, 3000, "~w~Insert your new password!");
	}
	else
	{
		
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET pass=SHA1('%e'), passchanged = 1 WHERE reg_id=%d", password, pRegID[playerid]);
		MySQL_updateQuery(query);
		format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your password has been changed to '"LB2_E"%s'!", password);
		SendClientMessage(playerid, COLOR_YELLOW, str);
		SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "YELLOW_E"Please note your password and remember it for your next login.");
		format(str, sizeof(str), "~w~Password changed to ~r~%s", password);
		InfoTD_MSG(playerid, 3000, str);
		SetPVarInt(playerid, "PasswordChange", 1);
	}
	return true;
}

public OnIncomingConnection(playerid, ip_address[], port)
{
	SendRconCommand("reloadbans");
	return 1;
}

forward OnPlayerLoginAuth(playerid, inserted_pass[]);
public OnPlayerLoginAuth(playerid, inserted_pass[])
{
	if(!MySQL_rowCount())
	{
		SendClientMessage(playerid, COLOR_ORANGE, ""SERVER_INITIALS" "ORANGE_E"This account is not registered. Register your account to gain access to bonus commands and features!");
		ShowRegisterDialog(playerid);
	}
	else
	{
		new real_pass_hash[42];
		new inserted_pass_hash[42];
		cache_get_field_content(0, "pass", real_pass_hash, 42);
		sha1(inserted_pass, inserted_pass_hash);
		if(strcmp(real_pass_hash, inserted_pass_hash, false) != 0)
		{/*
			// Wrong password
			datez = GetPVarInt(playerid, "FailedLogin") + 1;
			if(datez == 3)
			{
				//format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s's name has been changed to %s_%d.", pName[playerid], pName[playerid], newname);
				//SendClientMessageToAllEx(playerid, COLOR_GREY2, str);
				format(tmp, sizeof(tmp), "2Server:3 %s(%i) 4 has been kicked for too many failed login attempts.", pName[playerid], playerid);
				IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
				format(str, sizeof(str), ""RED_E"Server: "LB2_E"%s(%i) has been kicked for too many failed login attempts.", pName[playerid], playerid);
				SendClientMessageToAll(COLOR_LB, str);
				KickEx(playerid);
				return true;
			}
			SetPVarInt(playerid, "FailedLogin", datez);

			format(str, sizeof(str), ""RED_E"ERROR: "DARK_E"Wrong Password! [%d/3]", GetPVarInt(playerid, "FailedLogin"));
			SendClientMessage(playerid, COLOR_DARK, str);
			SendClientMessage(playerid, COLOR_DARK, "If you forgot your password, recover it at serverserver.com!");
			InfoTD_MSG(playerid, 4000, "~r~~h~Error logging in!~n~~w~Wrong password. Go to serverserver.com to recover your password!");

			format(line, sizeof(line), ""RED_E"Welcome back, "YELLOW_E"%s\n\n"RED_E"This account is registered.\n"WHITE_E"Enter your password below to login\n\n"RED_E"Wrong Password. %d attempts left!\n"RED_E"Note:\n- "WHITE_E"You will not be able to spawn until you login.\n"PINK_E"- "WHITE_E"If this is not your account please quit and change your name.", pName[playerid], (3 - GetPVarInt(playerid, "FailedLogin")));
			ShowPlayerDialog(playerid, 5, DIALOG_STYLE_PASSWORD, ""ORANGE_E"Login", line, "Login", "");*/
			// Wrong password
			datez = GetPVarInt(playerid, "FailedLogin") + 1;
			if(datez == 3)
			{
				DeletePVar(playerid, "FailedLogin");
				SetPVarInt(playerid, "CantRegister", 1);
				pRegID[playerid] = 0;

				new newname = random(9000);
				//format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s's name has been changed to %s_%d.", pName[playerid], pName[playerid], newname);
				//SendClientMessageToAllEx(playerid, COLOR_GREY2, str);
				format(tmp, sizeof(tmp), "2Server:3 %s(%i)'s4 name has been changed to %s_%d for too many failed logins.", pName[playerid], playerid, pName[playerid], newname);
				IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp);
				format(str, sizeof(str), ""RED_E"Server: "LB2_E"Your name has been changed to %s_%d for too many failed login attempts.", pName[playerid], newname);
				SendClientMessage(playerid, COLOR_LB, str);
				GameTextForPlayer(playerid, "~r~~h~Name changed!", 3500, 3);

				format(tmp, sizeof(tmp), "%s_%d", pName[playerid], newname);
				SetPlayerName(playerid, tmp);
				GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
				pName[playerid] = PlayerName;
				pWelcome[playerid] = 1;
				return true;
			}
			SetPVarInt(playerid, "FailedLogin", datez);

			format(str, sizeof(str), ""RED_E"ERROR: "DARK_E"Wrong Password! [%d/3]", GetPVarInt(playerid, "FailedLogin"));
			SendClientMessage(playerid, COLOR_DARK, str);
			SendClientMessage(playerid, COLOR_DARK, "If you forgot your password, recover it at serverserver.com!");
			InfoTD_MSG(playerid, 4000, "~r~~h~Error logging in!~n~~w~Wrong password. Go to serverserver.com to recover your password!");

			format(line, sizeof(line), ""RED_E"Welcome back, "YELLOW_E"%s\n\n"RED_E"This account is registered.\n"WHITE_E"Enter your password below to login\n\n"RED_E"Wrong Password. %d attempts left!\n"RED_E"Note:\n- "WHITE_E"You will not be able to spawn until you login.\n"PINK_E"- "WHITE_E"If this is not your account please quit and change your name.", pName[playerid], (3 - GetPVarInt(playerid, "FailedLogin")));
			ShowPlayerDialog(playerid, 5, DIALOG_STYLE_PASSWORD, ""ORANGE_E"Login", line, "Login", "");
		}
		else
		{
			LastLoginRequest[playerid] = 1;
			// Right password, commence login
			DeletePVar(playerid, "FailedLogin");

			// Load data here
			new p_PmDisabled, p_HitSound, p_PassChange;
			new p_Armor, p_bstoggle;
			new jailed_reason[60];

			pLogged[playerid] = true;

			pAdmin[playerid] = cache_get_field_content_int(0, "adminlevel"); 
