	Info(playerid, "Type /gohouse <ID> to teleport to a house ID.");
	return true;
}

GetHouseElements2(string_to_fill[],page=1,&left=0,&inserted=0,amount=30,&invalid_owner=0,maxstrsize=sizeof(string_to_fill))
{
	string_to_fill[0] = 0;
	string_to_fill[1] = 0;

	new houses = 0;
	new curr = 0;
	new from = (page-1)*amount;
	new to = from+amount;

	left = 0;
	inserted = 0;
	invalid_owner = 0;

	foreach(new h : Houses)
	{
		if(hInfo[h][HouseForSale] != 0 && h != 0)
