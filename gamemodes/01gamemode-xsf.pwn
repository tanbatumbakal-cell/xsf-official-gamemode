function OnProxyDetect(playerid, response_code, data[])
{
	new name[MAX_PLAYERS];
	new ip[16];

	GetPlayerName(playerid, name, sizeof(name));
	GetPlayerIp(playerid, ip, sizeof ip);

	if(strcmp(ip, "127.0.0.1", true) == 0) 
		return 1;


	if(response_code == 200)
	{
		if(data[0] == 'Y')
		{
			format(str, sizeof(str), ""RED_E"*ProxyDetection: "GREY_E"%s(%d) has joined the server using a VPN/Proxy.", name, playerid);
	    	SendAdminMessage(0xFF0000FF, str);
	    	valstr(str, playerid);
	    	foreach(new i : Player) if(pAdmin[i] > 0) 
	    		cmd_ipinfo(i, str);

		}
		if(data[0] == 'N')
		{
			return 1;
		}
		if(data[0] == 'X')
		{
			format(str, sizeof(str), ""RED_E"*ProxyDetection: "GREY_E"%s(%d) has joined the server using an Invalid IP format.", name, playerid);
	    	SendAdminMessage(0xFF0000FF, str);
	    	return 1;
		}
	}
	else
	{
		printf("The request failed! The response code was: %d", response_code);
	}
	return 1;
}

