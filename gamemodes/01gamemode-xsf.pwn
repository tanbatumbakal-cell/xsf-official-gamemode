CMD:agod(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "s[8]", tmp))
	{
		SetPVarInt(playerid, "aGod", 1);
		SetPlayerHealth(playerid, 9999);
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREY_E"You have enabled admin godmode.");
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "YELLOW_E"Type /agod off to disable it.");
	}
	else
	{
		if(!strcmp(tmp, "off", true))
		{
			DeletePVar(playerid, "aGod");
			SetPlayerHealth(playerid, 98);
			SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREY_E"You have disabled godmode.");
		}
		else
		{
			SetPVarInt(playerid, "aGod", 1);
			SetPlayerHealth(playerid, 9999);
			SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREY_E"You have enabled godmode.");
			SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "YELLOW_E"Type /agod off to disable it.");
		}
	}
	return true;
}

//for devs
CMD:devann(playerid, params[])
{
	if(pDeveloper[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params)) return Usage(playerid, "/devann [text]");
	format(str, sizeof(str), ""RED_E"** Developer (%s):{FFFFFF} %s", pName[playerid], params);
	SendClientMessageToAll(0xFEE349FF, str);
	return 1;
}

CMD:devgmx(playerid, params[])
{
	if(pDeveloper[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params)) return Usage(playerid, "/devgmx [reason]");
	format(str, sizeof(str), "A developer has restarted the server, reason: %s", params);
	SendClientMessageToAll(COLOR_GREY, str);
	SendRconCommand("gmx");
	SendRconCommand("reloadfs Objects");
	return 1;
}

CMD:devlock(playerid, params[])
{
	if(pDeveloper[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params)) return Usage(playerid, "/devlock [password]");
	if(!IsValidChar(params)) return Error(playerid, "This isn't a valid password");
	format(str, sizeof(str), "password %s", params);
	SendRconCommand(str);
	return 1;
}

CMD:devkickplayers(playerid, params[])
{
	if(pDeveloper[playerid] == 0) return Usage(playerid, "You are not authorized to use this command.");
	if(isnull(params)) return Usage(playerid, "/devkickplayers [reason]");
	format(str, sizeof(str), "A developer has kicked all players from the server, reason: %s.", params);
	SendClientMessageToAll(COLOR_GREY2, str);
	new count;
	foreach(new i : Player)
	{
		if(pDeveloper[i] == 0)
		{
			count++;
			Kick(i);
		}
	}
	format(str, sizeof(str), "You have kicked a total of %d players from the server. ", count);
	SendClientMessage(playerid, COLOR_GREY2, str);
	return 1;
}

function GetPlayerCount()
{
	new amount =0;
	for(new i =0; i <MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
			amount++;
		}
	}
	return amount;
}

CMD:heal(playerid, params[])
{
	if(pPremium[playerid] == 0)
		return Error(playerid, "You are not authorized to use this command!");
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't heal yourself in DM zones!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
		return Error(playerid, "You can't heal yourself in an event!");
	if(GetPVarInt(playerid, "UsedHeal") == 1)
	{
		SendClientMessage(playerid, COLOR_GREY2, ""RED_E"Server: "GREY_E"You can only heal once every 30 seconds!");
		return true;
	}
	if(GetPVarInt(playerid, "UsedHeal") == 0) SetTimerEx("ResetHeal", 30000, false, "i", playerid);
	SetPVarInt(playerid, "UsedHeal", 1);
	if(sscanf(params, "k<player_name>", otherid))
	{
		SetPlayerHealth(playerid, 97);
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"You have healed yourself!");
	}
	else
	{
		if(InDM[otherid] != 0)
			return Error(playerid, "Player is currently in a DM and can't be healed!");
		if(InEvent[otherid] != 0)
			return Error(playerid, "Player is currently in aa event and can't be healed!");
		if(GOD[otherid] != 0)
			return Error(playerid, "Player has godmode and doesn't need to be healed!");
		SetPlayerHealth(otherid, 97);
		format(str, 90, ""SERVER_INITIALS" "GREEN_E"%s(%i) has healed you!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_GREEN, str);
	}
	return 1;
}

CMD:disablearmour(playerid) return cmd_togarmour(playerid);
CMD:togarmor(playerid) return cmd_togarmour(playerid);
CMD:armour(playerid) return cmd_togarmour(playerid);
CMD:armor(playerid) return cmd_togarmour(playerid);
CMD:togarmour(playerid)
{
	if(pPremium[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 || GetPVarInt(playerid, "ParticipatingHG") == 1)
		return Error(playerid, "You can't use this command in an event!");
	if(bounty[playerid] > 0)
		return Error(playerid, "You currently have a hit on you, you can't toggle armour!");
	GetPlayerArmour(playerid, A);
	if(!GetPVarInt(playerid, "togArmour"))
	{
		if(InDM[playerid] != 0)
			return Error(playerid, "You can't enable your armour in DM zones!");

		SetPlayerArmour(playerid, 50.0);
		if(pPremium[playerid] == 3) SetPlayerArmour(playerid, 97.0);

		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"You have enabled your armour!");
		SetPVarInt(playerid, "togArmour", 1);

		format(query, sizeof(query), "UPDATE players SET TogArmour = 1 WHERE reg_id = %i", pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	else
	{
		SetPlayerArmour(playerid, 0.0);
		SetPVarInt(playerid, "togArmour", 0);
		SendClientMessage(playerid, COLOR_RED,""SERVER_INITIALS" "RED_E"You have disabled your armour!");

		format(query, sizeof(query), "UPDATE players SET TogArmour = 0 WHERE reg_id = %i", pRegID[playerid]);
		MySQL_updateQuery(query);
	}
	return 1;
}
CMD:godmode(playerid) return cmd_god(playerid);
CMD:god(playerid)
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be logged in in order to enable godmode!");

	if(doingStunt[playerid] == 33 || doingStunt[playerid] == 18 || doingStunt[playerid] == 19)
		return Error(playerid, "You can't toggle godmode in the minigame!");
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't toggle godmode in DM zones!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
		return Error(playerid, "You can't toggle godmode in an event!");
	if(bounty[playerid] > 0)
		return Error(playerid, "You currently have a hit on you, you can't enable godmode!");
	if(GetPVarInt(playerid, "cantgod"))
		return Error(playerid, "Your usage of the /god command is currently disabled.");

	if(GOD[playerid] == 0)
	{
		new Float:hp;
		GetPlayerHealth(playerid, hp);

		if(PlayerHit[playerid] == true)
			return Error(playerid, "You can't enable godmode while being shot at!");

		SendClientMessage(playerid, COLOR_GREEN, ""SERVER_INITIALS" "GREY_E"You have enabled god-mode. You will now have infinite health in stunt zones.");
		SendClientMessage(playerid, COLOR_RED, "> "YELLOW_E"You will not be able to use weapons with godmode enabled, type /god again to disable.");
		ResetPlayerWeapons(playerid);
		GOD[playerid] = 1;
		SetPlayerHealth(playerid, 9999);
		if(GetPVarInt(playerid, "TDDisabled")) TextDrawShowForPlayer(playerid, godTD);
		InfoTD_MSG(playerid, 4000, "~y~~h~You have ~g~enabled ~y~~h~godmode!");
		format(str, sizeof(str), "4Server:3 %s(%i)2 has enabled godmode.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
		if(god3D[playerid] == Text3D:-1) god3D[playerid] = CreateDynamic3DTextLabel("Godmode {41FF00}ON", 0xFFFF8288, 0, 0, 0.42, 16.0, playerid, INVALID_VEHICLE_ID, 1);
		if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour")) SetPlayerArmour(playerid, 97);
		if(killStreak[playerid] != 0) killStreak[playerid] = 0, Info(playerid, "Your killstreak has been reset to 0.");
	}
	else
	{
		InfoTD_MSG(playerid, 4000, "~y~~h~You have ~r~disabled ~y~~h~godmode!");
		SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "GREY_E"You have disabled god-mode. You can now lose health in stunt zones.");
		SendClientMessage(playerid, COLOR_RED, "> "YELLOW_E"You can now freely use weapons.");
		GOD[playerid] = 0;
		SetPlayerHealth(playerid, 98);
		TextDrawHideForPlayer(playerid, godTD);

		if(doingStunt[playerid] == 0)
		{
			GiveSpawnWeapons(playerid);
		}
		format(str, sizeof(str), "4Server:3 %s(%i)2 has disabled godmode.", pName[playerid], playerid);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
		DestroyDynamic3DTextLabel(god3D[playerid]);
		god3D[playerid] = Text3D:-1;
	}
	PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
	return true;
}
CMD:getip(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/getip <ID>");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(pAdmin[otherid] == 6)
	{
		Error(playerid, "You can't get the server owners ip!");
		format(str, 90, "*** "RED_E"%s(%i) tried to get your IP!", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_YELLOW, str);
		return 1;
	}
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	GetPlayerIp(otherid, PlayerIP, sizeof(PlayerIP));

	format(str, 90, "- AS - "RED_E"%s(%i)'s IP: %s", giveplayer, otherid, PlayerIP);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	cmd_ipinfo(playerid, params);
	return true;
}
CMD:autogetip(playerid) {
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new getip = !GetPVarInt(playerid, "AGetIP");

	SetPVarInt(playerid, "AGetIP", getip);

	if(getip) SendClientMessage(playerid, COLOR_GREY, ""YELLOW_E"- AS - "LB2_E"You have "GREEN_E"enabled "LB2_E"auto get ip.");
	else SendClientMessage(playerid, COLOR_GREY, ""YELLOW_E"- AS - "LB2_E"You have "RED_E"disabled "LB2_E"auto get ip.");
	return 1;
}
CMD:hydra(playerid)
{
	if(pPremium[playerid] != 3)
		return Error(playerid, "You must be a VIP member to use this command, check /premium for more info.");

	if(InDM[playerid] != 0) return Error(playerid, "You can't spawn a vehicle while in a DM!");
	if(doingStunt[playerid] != 0) return Error(playerid, "You can't spawn a vehicle in this area! Type /leave");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You can't spawn vehicles in an event!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't this vehicle in a race!");
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "You are already in a vehicle!");
	SpawnPlayerVehicle(playerid, 520);
	return true;
}
CMD:hunter(playerid)
{
	if(pPremium[playerid] != 3)
		return Error(playerid, "You must be a VIP member to use this command, check /premium for more info.");

	if(InDM[playerid] != 0) return Error(playerid, "You can't spawn a vehicle while in a DM!");
	if(doingStunt[playerid] != 0) return Error(playerid, "You can't spawn a vehicle in this area! Type /leave");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You can't spawn vehicles in an event!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't this vehicle in a race!");
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "You are already in a vehicle!");
 	SpawnPlayerVehicle(playerid, 425);
	return true;
}
CMD:tank(playerid)
{
	if(pPremium[playerid] != 3)
		return Error(playerid, "You must be a VIP member to use this command, check /premium for more info.");

	if(InDM[playerid] != 0) return Error(playerid, "You can't spawn a vehicle while in a DM!");
	if(doingStunt[playerid] != 0) return Error(playerid, "You can't spawn a vehicle in this area! Type /leave");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You can't spawn vehicles in an event!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't this vehicle in a race!");
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "You are already in a vehicle!");
	SpawnPlayerVehicle(playerid, 432);
	return true;
}
CMD:spectate(playerid, params[]) return cmd_spec(playerid, params);
CMD:spec(playerid, params[])
{
	if(pLogged[playerid] == false) return Error(playerid, "You must be registered to use this command! (/register)");
	if(pAdmin[playerid] == 0 && pPremium[playerid] == 0 && Helper[playerid] == 0 && p_Forced[playerid] == false) return Error(playerid, "You are not authorized to use this command!");

	if(pSpawned[playerid] == 0) return Error(playerid, "You can't spectate while not spawned yet!");
	if(pAdmin[playerid] == 0 && doingStunt[playerid] != 0) return Error(playerid, "You can't spectate from this area..");
	if(pAdmin[playerid] == 0 && InDM[playerid] != 0) return Error(playerid, "You can't spectate from a DM area!");
	if(doingStunt[playerid] == 70)  return Error(playerid, "You can't spectate while watching an event, type /stopwatch!");
	if(doingStunt[playerid] == 18 || doingStunt[playerid] == 19) return Error(playerid, "You can't spectate while in fallout or derby!");
	if(RaceParticipant[playerid] != 0) return Error(playerid, "You can't spectate while in a race!");

	if(pAdmin[playerid] == 0 && p_Forced[playerid] == false)
	{
		if(doingStunt[playerid] != 0) return Error(playerid, "You can't spectate from this area!");
		if(InDM[playerid] != 0) return Error(playerid, "You can't spectate from a deathmatch!!");
		if(InDuel[playerid] != -1) return Error(playerid, "You can't spectate when in a duel.");
	}

	if(sscanf(params, "k<player_name>", otherid)) return Usage(playerid, "/spec <ID/Name>");
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	if(otherid == playerid) return Error(playerid, "You can't spectate yourself bro..");

	if(specOFF[otherid] == 1)
	{
		if(pAdmin[otherid] > pAdmin[playerid])
		{
			format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has spectating disabled.", pName[otherid], otherid);
			SendClientMessage(playerid, COLOR_GREY, str);
			format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has tried to spectate you!", pName[playerid], playerid);
			SendClientMessage(otherid, COLOR_GREY, str);
			return true;
		}
	}
	if(GetPVarInt(otherid, "pickedUpMB") && pAdmin[playerid] == 0)
	{
		format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%i) has just picked up a moneybag. you must wait before spectating.", pName[otherid], otherid);
		SendClientMessage(playerid, COLOR_GREY, str);
		return true;
	}
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(pSpectating[otherid] != -1)
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY2_E"%s(%i) is currently in spectate mode!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_GREY2, str);
		return true;
	}
	if(pSpawned[otherid] == 0)
	{
		format(str, sizeof(str), "ERROR: "GREY_E"%s(%i) isn't spawned!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(pSpectating[playerid] == -1)
	{
		SavePlayerPosition(playerid);
	}
	playerSpectated[otherid]++;
	pSpectating[playerid] = otherid;
	SetPlayerInterior(playerid, GetPlayerInterior(otherid));
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(otherid));
	TogglePlayerSpectating(playerid, 1);


	if(IsPlayerInAnyVehicle(otherid))
	{
		vID = GetPlayerVehicleID(otherid);

		PlayerSpectateVehicle(playerid, vID);

		if(GetPlayerState(otherid) == PLAYER_STATE_DRIVER)
		{
			format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"You are now spectating %s(%i) who is driving a %s(%d).", giveplayer, otherid, GetVehicleModel(vID) ? (vehName[GetVehicleModel(vID) - 400]) : "no car", vID);
		}
		else
		{
			format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"You are now spectating %s(%i) who is a passenger in %s(%d).", giveplayer, otherid, GetVehicleModel(vID) ? (vehName[GetVehicleModel(vID) - 400]) : "no car", vID);
		}
	}
	else
	{
		PlayerSpectatePlayer(playerid, otherid);
		format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"You are now spectating %s(%i) who is on foot.", giveplayer, otherid);
	}
	SendClientMessage(playerid, COLOR_WHITEP, str);

	format(str, sizeof(str), "~g~~h~~h~You are now spectating %s(%d).~n~Type /specoff to end spectating.", giveplayer, otherid);
	InfoTD_MSG(playerid, 4000, str);


	new speccers;
	foreach(new ii : Player)
	{
		if(pSpectating[ii] == otherid)
		{
			speccers = speccers + 1;
		}
	}
	speccers --; // exclude you
	if(speccers != 0)
	{
		if(speccers == 1)
		{
			format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"%s(%i) is also spectated by another High-Ranked members (/spectators)", giveplayer, otherid);
		}
		else
		{
			format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"%s(%i) is also spectated by %d other High-Ranked members (/spectators)", giveplayer, otherid, speccers);
		}
		SendClientMessage(playerid, COLOR_WHITEP, str);
	}
	if(pAdmin[otherid] == 6)
	{
		format(str, sizeof(str), "- AS - "ORANGE_E"%s(%i) has started spectating you.", pName[playerid], playerid);
		SendClientMessage(otherid, COLOR_YELLOW, str);
	}
	if(InDM[otherid] == 13)
	{
		format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"%s(%i) is currently playing CNR, your objects have been disabled while spectating.", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_WHITEP, str);
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 0);
	}
	if(p_Forced[playerid]) SendClientMessage(playerid, COLOR_YELLOW, "- AS - "GREY_E"You was forced to use /spec by an Administrator");
	SendClientMessage(playerid, COLOR_YELLOW, "- AS - "GREY_E"Type '/specoff' to stop spectating");
	if(p_Forced[playerid]) p_Forced[playerid] = false;
	return true;
}

CMD:specoff(playerid, params[])
{
	if(pAdmin[playerid] == 0)
		if(pPremium[playerid] == 0)
			if(Helper[playerid] == 0)
				return Error(playerid, "You are not authorized to use this command!");

	if(pSpectating[playerid] == -1)
		return Error(playerid, "You aren't spectating anyone!");


	GetPlayerName(pSpectating[playerid], giveplayer, sizeof(giveplayer));
	format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"You have stopped spectating %s(%i).", giveplayer, pSpectating[playerid]);
	SendClientMessage(playerid, COLOR_WHITEP, str);
	if(pAdmin[pSpectating[playerid]] == 5)
	{
		format(str, sizeof(str), "- AS - "GREY2_E"%s(%i) has stopped spectating you.", pName[playerid], playerid);
		SendClientMessage(pSpectating[playerid], COLOR_YELLOW, str);
	}

	playerSpectated[pSpectating[playerid]]--;
	TogglePlayerSpectating(playerid, false);
	if(InDM[playerid] != 13) Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	return true;
}

CMD:forcespec(playerid, params[])
{
	if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "k<player_name>", otherid)) return Usage(playerid, "/forcespec <ID/name>");
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	if(pAdmin[otherid] != 0) return Error(playerid, "Player is an admin!");
	if(pSpectating[otherid] != -1) return Error(playerid, "That player is already in spectating.");

	p_Forced[otherid] = true;
	valstr(str, playerid);
	cmd_spec(otherid, str);

	format(str, sizeof(str), "- AS - "GREY2_E"force spec request has been sent.");
	SendClientMessage(playerid, COLOR_YELLOW, str);
	return true;
}

CMD:fullhide(playerid, params[])
{
	if(pAdmin[playerid] < 3) return Error(playerid, "You are not authorized to use this command!");
	if((pHidden[playerid] != 0 || pmhidden[playerid] != 0) && GetPVarInt(playerid, "FullHidden") == 0) return Error(playerid, "You are already hidden by using another command.");
	if(GetPVarInt(playerid, "FullHidden") == 1)
	{
		GetPVarString(playerid, "OldNick", pName[playerid], sizeof(pName[]));

		SetPlayerName(playerid, pName[playerid]);
		SetPVarInt(playerid, "FullHidden", 0);
		pScore[playerid] = GetPVarInt(playerid, "OldScore");
		SetPlayerScore(playerid, GetPVarInt(playerid, "OldScore"));

		cmd_hide(playerid);

		return true;
	}

	if(sscanf(params, "s[24]", query)) return Usage(playerid, "/fullhide <nickname>");
	if(GetPlayerID(query) != INVALID_PLAYER_ID) return Error(playerid, "This nickname seems to be already used.");
	if(strlen(query) < 4 || strlen(query) > 24 || SetPlayerName(playerid, query) != 1)
		return Error(playerid, "You must use a valid nick name! (4-24 length)");

	format(query, sizeof(query), "%d %s", playerid, query);

	SetPVarString(playerid, "OldNick", pName[playerid]);
	SetPVarInt(playerid, "OldScore", pScore[playerid]);

	pScore[playerid] = 0;
	SetPlayerScore(playerid, 0);

	SetPVarInt(playerid, "FullHidden", 1);

	SetPVarString(playerid, "OldNick", pName[playerid]);
	new newname[24];
	GetPlayerName(playerid, newname, sizeof(newname));
	pName[playerid] = newname;

	cmd_hide(playerid);

	return true;
}

CMD:forcespecoff(playerid, params[])
{
	if(pAdmin[playerid] == 0) return Error(playerid, "You are not authorized to use this command!");
	if(sscanf(params, "k<player_name>", otherid)) return Usage(playerid, "/forcespecoff <ID/name>");
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	if(pAdmin[otherid] != 0) return Error(playerid, "Player is an admin!");
	if(pSpectating[otherid] == -1) return Error(playerid, "That player is not spectating.");

	format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"%s(%i) has forced you to stop spectating %s(%i).", pName[playerid], playerid, pName[pSpectating[otherid]], pSpectating[otherid]);
	SendClientMessage(otherid, COLOR_WHITEP, str);
	format(str, sizeof(str), ""YELLOW_E"SPEC: "WHITEP_E"You have forced %s(%i) to stop spectating %s(%i).", pName[otherid], otherid, pName[pSpectating[otherid]], pSpectating[otherid]);
	if(pAdmin[pSpectating[otherid]] == 5)
	{
		format(str, sizeof(str), "- AS - "GREY2_E"%s(%i) has been forced to stop spectating you.", pName[otherid], otherid);
		SendClientMessage(pSpectating[otherid], COLOR_YELLOW, str);
	}

	playerSpectated[pSpectating[otherid]]--;
	pSpectating[playerid] = -1;
	TogglePlayerSpectating(otherid, false);
	return true;
}


CMD:togspec(playerid)
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(specOFF[playerid]== 1)
	{
		specOFF[playerid] = 0;
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREY_E"Players will now be able to spectate you!");
	}
	else
	{
		specOFF[playerid] = 1;
		SendClientMessage(playerid, COLOR_RED,""SERVER_INITIALS" "GREY_E"Players will no longer be able to spectate you!");
	}
	format(query, sizeof(query), "UPDATE players SET specoff=%d WHERE reg_id=%d", specOFF[playerid], pRegID[playerid]);
	MySQL_updateQuery(query);
	return 1;
}

CMD:spectators(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new speccers;
	foreach(new ii : Player)
	{
		if(pSpectating[ii] != -1 && !(pAdmin[playerid] < 4 && pAdmin[ii] >= 4 && pHidden[ii]))
		{
			speccers = speccers + 1;
		}
	}

	if(speccers == 0)
		return SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There isn't anyone spectating!");

	if(speccers == 1)
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Displaying a list of 1 player spectating:");
	}
	else
	{
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"Displaying a list of %d players spectating:", speccers);
		SendClientMessage(playerid, COLOR_GREY, str);
	}

	speccers = 0;

	foreach(new ii : Player)
	{
		if(pSpectating[ii] != -1 && !(pAdmin[playerid] < 4 && pAdmin[ii] >= 4 && pHidden[ii]))
		{
			speccers = speccers + 1;
			GetPlayerName(pSpectating[ii], giveplayer, sizeof(giveplayer));
			format(str, sizeof(str), "  %d. %s(%i) spectating %s(%i).", speccers, pName[ii], ii, giveplayer, pSpectating[ii]);
			SendClientMessage(playerid, COLOR_GREY, str);
		}
	}
	return true;
}
CMD:removerb(playerid,params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	for(new iit = 0; iit < sizeof(block); iit++)
	{
		DestroyDynamicObject(block[iit][playerid]);
		block[iit][playerid] = INVALID_OBJECT_ID;
	}
	pblock[playerid] = 0;
	format(str,sizeof (str),"{%06x}%s(%i) "YELLOW_E"has removed all of their roadblocks.", pColor[playerid], pName[playerid], playerid);
	SendClientMessageToAll(COLOR_YELLOW, str);
	return 1;
}

CMD:rb(playerid, params[]) return cmd_roadblock(playerid, params);
CMD:roadblock(playerid,params[])
{
	if(pAdmin[playerid] < 2) return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "d", otherid))
	{
		SendClientMessage(playerid,COLOR_LB,"USAGE: /rb <1/2/3/4>");
		SendClientMessage(playerid,COLOR_LB,"| 1: Small Roadblock");
		SendClientMessage(playerid,COLOR_LB,"| 2: Barrier");
		SendClientMessage(playerid,COLOR_LB,"| 3: Traffic cone");
		SendClientMessage(playerid,COLOR_LB,"| 4: Detour sign");
		return 1;
	}
	if(pblock[playerid] > 9)
	{
		Error(playerid, "You can't place more than 10 roadblocks!");
		return 1;
	}

	new Float:X, Float:Y, Float:Z, Float:ang;
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, ang);
	new atrb = pblock[playerid];
	switch(otherid)
	{
		case 1:
		{
			ang = GetPosInFrontOfPlayer(playerid,  X, Y, GetRBDistance(playerid));
			block[atrb][playerid] = CreateDynamicObject(1459, X, Y, Z, 0, 0, ang, GetPlayerVirtualWorld(playerid));
			GameTextForPlayer(playerid,"~w~Roadblock ~b~Placed!", 3000, 1);
		}
		case 2:
		{
			ang = GetPosInFrontOfPlayer(playerid,  X, Y, GetRBDistance(playerid));
			block[atrb][playerid] = CreateDynamicObject(978, X, Y, Z, 0, 0, ang, GetPlayerVirtualWorld(playerid));
			GameTextForPlayer(playerid,"~w~Roadblock ~b~Placed!", 3000, 1);
		}
		case 3:
		{
			ang = GetPosInFrontOfPlayer(playerid,  X, Y, GetRBDistance(playerid));
			block[atrb][playerid] = CreateDynamicObject(1238, X, Y, Z, 0, 0, ang, GetPlayerVirtualWorld(playerid));
			GameTextForPlayer(playerid,"~w~Cone ~b~Placed!", 3000, 1);
		}
		case 4:
		{
			ang = GetPosInFrontOfPlayer(playerid,  X, Y, GetRBDistance(playerid));
			block[atrb][playerid] = CreateDynamicObject(1425, X, Y, Z, 0, 0, ang, GetPlayerVirtualWorld(playerid));
			GameTextForPlayer(playerid,"~w~Sign ~b~Placed!", 3000, 1);
		}
	}
	pblock[playerid]++;
	Info(playerid, ""RED_E"Remember to /removerb once you are done!");
	return 1;
}

CMD:dragplayer(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");
	if (sscanf(params, "k<player_name>", otherid)) {
		Usage(playerid, "/dragplayer <ID/Name>");
		SendClientMessage(playerid, COLOR_ORANGE, "FUNCTION: Will teleport the specified player into your vehicle.");
		return 1;
	}
	if(otherid == playerid) return Error(playerid, "You can't get yourself in your own vehicle!");
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	if(InDM[otherid] == 1) return Error(playerid, "Player is currently in a DM zone!");

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(!IsVehicleOneSeater(playerid, GetPlayerVehicleID(playerid)))
		{
			if(IsPlayerInAnyVehicle(otherid)) RemovePlayerFromVehicle(otherid);
			format(str,sizeof(str),"Server: You have teleported %s into your vehicle.", pName[otherid]);
			SendClientMessage(playerid, COLOR_YELLOW, str);
			format(str,sizeof(str),"Server: Administrator %s has teleport you inside their vehicle.", pName[playerid]);
			SendClientMessage(otherid, COLOR_YELLOW, str);

			PutPlayerInVehicle(otherid, GetPlayerVehicleID(playerid), 1);
			SetPlayerInterior(otherid, GetPlayerInterior(playerid));
			SetPlayerVirtualWorld(otherid, GetPlayerVirtualWorld(playerid));
			SetVehicleVirtualWorld(GetPlayerVehicleID(otherid), GetPlayerVirtualWorld(playerid));
		}
		else Error(playerid, "Your using a one seat vehicle!");
	}
	else Error(playerid, "You aren't in a vehicle!");
	return 1;
}

CMD:getin(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new seat;
	if(sscanf(params, "k<player_name>d", otherid, seat))
	{
		Usage(playerid, "/getin <ID/Name> <seat id>");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(!IsPlayerInAnyVehicle(otherid))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) is not in any vehicle!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(IsVehicleOneSeater(otherid,GetPlayerVehicleID(otherid)))
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) is currently driving a one seat vehicle!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(seat < 0 || seat > 3)
	{
		Error(playerid, "You can choose seat from 0 - 3!");
		return true;
	}

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	vID = GetPlayerVehicleID(otherid);
	vv = GetVehicleModel(vID);
	foreach(new ii : Player)
	{
		if(!IsPlayerInVehicle(ii, vID)) continue;
		if(GetPlayerVehicleSeat(ii) == seat)
		{
			format(str, sizeof(str), "ERROR: "GREY2_E"Seat %d in %s(%i)'s %s(%d) is occupied by %s(%i).", seat, giveplayer, otherid, vehName[vv - 400], vID, pName[ii], ii);
			SendClientMessage(playerid, COLOR_RED, str);
			return true;
		}
	}

	SetPlayerInterior(playerid, GetPlayerInterior(otherid));
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(otherid));
	PutPlayerInVehicle(playerid, vID, seat);
	doingStunt[playerid] = 0;

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) teleported into your %s(%d) to seat %d.", pName[playerid], playerid, vehName[vv - 400], vID, seat);
	SendClientMessage(otherid, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You teleported into %s(%i)'s %s(%d) to seat %d.", giveplayer, otherid, vehName[vv - 400], vID, seat);
	SendClientMessage(playerid, COLOR_GREY, str);

	format(str, sizeof(str), "4Server:3 %s(%i) teleported into %s(%i)'s %s(%d) to seat %d.", pName[playerid], playerid, giveplayer, otherid, vehName[vv - 400], vID, seat);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:gotoxyz(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "fff", POS[0], POS[1], POS[2]))
	{
		Usage(playerid, "/gotoxyz <X> <Y> <Z>");
		return true;
	}
	if(POS[0] <= 0.0 || POS[2] <= 0.0 || POS[2] <= 0) return Error(playerid, "Teleporting to this position will end up with you crashing.");

	if(!IsPlayerInAnyVehicle(playerid))
	{
		SetPlayerPosition(playerid, POS[0], POS[1], POS[2], 0);
	}
	else SetPlayerVehiclePosition(playerid, POS[0], POS[1], POS[2], 0);
	doingStunt[playerid] = 0;

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have teleported yourself to %f %f %f!", POS[0], POS[1], POS[2]);
	SendClientMessage(playerid, COLOR_GREY, str);
	return true;
}

CMD:telep(playerid, params[])
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	new p1, p1name[24],
		p2, p2name[24];

	if(sscanf(params, "k<player_name>k<player_name>", p1, p2))
	{
		Usage(playerid, "/telep <teleportee> <other player>");
		return true;
	}

	if(!IsPlayerConnected(p1))
		return Error(playerid, "Invalid teleportee ID!");
	if(!IsPlayerConnected(p2))
		return Error(playerid, "Invalid destination ID!");

	GetPlayerName(p1, p1name, sizeof(p1name));
	GetPlayerName(p2, p2name, sizeof(p2name));


	if(!IsPlayerInAnyVehicle(p2))
	{
		GetPlayerPos(p2, POS[0], POS[1], POS[2]);
		GetPlayerFacingAngle(p2, A);
	}
	else
	{
		GetVehiclePos(GetPlayerVehicleID(p2), POS[0], POS[1], POS[2]);
		GetVehicleZAngle(GetPlayerVehicleID(p2), A);
	}

	if(!IsPlayerInAnyVehicle(p1))
	{
		SetPlayerPosition(p1, POS[0], POS[1], POS[2], A);
	}
	else
	{
		SetPlayerVehiclePosition(p1, POS[0], POS[1], POS[2], A);
	}
	doingStunt[p1] = 0;
	doingStunt[p2] = 0;

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have teleported %s(%i) to %s(%i).", p1name, p1, p2name, p2);
	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has teleported %s(%i) to you.", pName[playerid], playerid, p1name, p1);
	SendClientMessage(p2, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) has teleported you to %s(%i).", pName[playerid], playerid, p2name, p2);
	SendClientMessage(p1, COLOR_GREY, str);

	format(str, sizeof(str), "4Server:3 %s(%i) has teleported %s(%i) to %s(%i)", pName[playerid], playerid, p1name, p1, p2name, p2);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "**[Admin]** %s(%i) has teleported %s(%i) to %s(%i)", pName[playerid], playerid, p1name, p1, p2name, p2);
	//DCC_SendChannelMessage(Channel_Echo, str);
	return true;
}
CMD:makeallsendpm(playerid,params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");
	new mesg[128];
	if(sscanf(params, "k<player_name>s[128]", otherid,mesg))
	{
		Usage(playerid, "/makeallsendpm <ID/Name> <message>");
		return true;


	}
	foreach(new i : Player)
	{
		SendPlayerPM(i, otherid, mesg);
	}
	return true;

}

CMD:getrekt(playerid, params[])
{
	if(pAdmin[playerid] < 4)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/getrekt <ID/Name>");

		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(rektPlayers[otherid] == 1){
		SetPlayerTime(otherid,12,0);
		SetPlayerWeather(otherid,0);
		SetPlayerDrunkLevel(otherid, 0);

		rektPlayers[otherid] = 0;
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E" %s is not getting rekt anymore.", giveplayer, otherid);

	}
	else{
		rektPlayers[otherid] = 1;
		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E" %s is now getting rekt.", giveplayer, otherid);
	}

	SendClientMessage(playerid, COLOR_GREY, str);

	return true;
}

CMD:getrektall(playerid) {
	if(pAdmin[playerid] < 6)
		return Error(playerid, "You are not authorized to use this command!");

	foreach(new i : Player) {
		if(i != playerid) {
			format(str, sizeof(str), "%i", i);
			cmd_getrekt(playerid, str);
		}

	}
	return 1;
}

CMD:explode(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/explode <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have exploded %s(%i).", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	GetPlayerPos(otherid, POS[0], POS[1], POS[2]);
	CreateExplosion(POS[0], POS[1], POS[2], 7, 5.0);
	return true;
}

CMD:asay(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "s[128]", tmp))
	{
		Usage(playerid, "/asay <message>");
		return true;
	}

	new tmp3[25];
	switch(pAdmin[playerid])
	{
		case 1..3: tmp3 = "Admin";
		case 4: tmp3 = "Lead Admin";
		case 5: tmp3 = "Manager";
		case 6: tmp3 = "Owner";
	}

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""RED_E"[%s] {%06x}%s(%i): "WHITEP_E"%s", tmp3, pColor[playerid], pName[playerid], playerid, tmp);
	else
		format(str, sizeof(str), ""WHITEP_E"* Admin: %s", tmp);

	SendClientMessageToAll(COLOR_WHITEP, str);
	return true;
}
CMD:vsay(playerid, params[])
{
	if(pPremium[playerid] != 3)
		return Error(playerid, "You are not authorized to use this command!");

	if(pMute[playerid] > 0)
	{
		format(str, sizeof(str), "* You can't use /vsay while muted, mute will be lifted in %d seconds.", pMute[playerid]);
		SendClientMessage(playerid, COLOR_ORANGE, str);
		GameTextForPlayer(playerid, "~r~You are muted~y~!", 3000, 3);
		return false;
	}
	if(gettime() > vSayTick[playerid])
	{
		if(sscanf(params, "s[128]", tmp))
		{
			Usage(playerid, "/vsay <message>");
			return true;
		}
		vSayTick[playerid] = gettime()+120;
		format(str, sizeof(str), "[VIP] {%06x}%s(%i): "WHITEP_E"%s", pColor[playerid], pName[playerid], playerid, tmp);
		SendClientMessageToAll(COLOR_LIGHTGREEN, str);
	}
	else
	{
	    format(str, sizeof(str), ""RED_E"ERROR: "GREY3_E"Please wait %d seconds before using /vsay again", vSayTick[playerid]-gettime());
	    SendClientMessage(playerid,-1,str);
	}
	return true;
}
CMD:hsay(playerid, params[])
