function CheckAdminTime()
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "INSERT INTO `UpdateAdminCheck` (`LastTime`) VALUES (%d)", gettime());
		MySQL_updateQuery(str);
		MySQL_updateQuery("UPDATE `players` SET `admOnTime` = 0;");
		return 1;
	}
	new updatetime = cache_get_field_content_int(0, "LastTime");
	if(updatetime + (86405 * 7) < gettime()  || (((gettime() - 345600) % 604800)/86400) == 0.000000000) //reset every monday
	{
		format(str, sizeof(str), "UPDATE `UpdateAdminCheck` SET `LastTime` = %d;", gettime());
		MySQL_updateQuery(str);
		MySQL_updateQuery("UPDATE `players` SET `admOnTime` = 0;");

		foreach(new i : Player)
		{
			if(pAdmin[i] > 0 || Helper[i] > 0)
			{
				admOnTime[i] = 0;
			}
		}
	}
	return 1;
}

CMD:checkweeklytime(playerid)
{
	if(!pAdmin[playerid] && !Helper[playerid]) return Error(playerid, "You are not authorized to use this command!");
	new
	hours,
	minutes = admOnTime[playerid];

	while(minutes > 59)
	{
		minutes -= 60;
		hours++;
	}
	format(str, sizeof(str), ""PINK_E"*You were online for %d Hours, %d minutes on this week.", hours, minutes);
	SendClientMessage(playerid, -1, str);
	return 1;
}

CMD:activity(playerid, params[])
{
	if(pAdmin[playerid] < 5) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params)) return Usage(playerid, "/activity [helpers/admins]");
	if(!strcmp(params, "Helpers", true, 6)) 
		return MySQL_query("SELECT Name, adminlevel, helper, admOnTime FROM `players` WHERE `helper` > 0 AND `adminlevel` = 0 ORDER BY `admOnTime` DESC", true, "CheckActivity", "i", playerid);

	else if(!strcmp(params, "Admins", true, 6)) 
		return MySQL_query("SELECT Name, adminlevel, admOnTime FROM `players` WHERE `adminlevel` > 0 ORDER BY `admOnTime` DESC", true, "CheckActivity", "i", playerid);

	else Usage(playerid, "/activity [helpers/admins]");
	return 1;
}

function CheckActivity(playerid)
{
	if(!MySQL_rowCount()) return Error(playerid, "There's no staff/helper member at the moment.");

	new string[3000] = "";
	new rows = MySQL_rowCount();
	for(new i = 0; rows > i; i++)
	{
		new name[37], level, time, hours;

		cache_get_field_content(i, "Name", name);
		level = cache_get_field_content_int(i, "adminlevel");
		time = cache_get_field_content_int(i, "admOnTime");

		while(time > 59)
		{
			time -= 60;
			hours++;
		}
		if(GetPlayerID(name) == INVALID_PLAYER_ID) format(name, sizeof(name), "%s "RED_E"(Offline)", name);
		else format(name, sizeof(name), "%s "GREEN_E"(Online)", name);

		format(string, sizeof(string), "%s\n%s\t%d\t%d\t%d", string, name, level, hours, time);
	}
	format(string, sizeof(string), "Name\tLevel\tHours\tMinutes%s", string);
	ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_TABLIST_HEADERS, ""RED_E"server: "WHITE_E"Activity", string, "OK", "");
	return 1;
}

function CheckUpdate()
{
	MySQL_query("SELECT * FROM `UpdateAdminCheck`", true, "CheckAdminTime", "", 0);
	return 1;
}

