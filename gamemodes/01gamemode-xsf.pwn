CMD:setname(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>s[20]", otherid, tmp))
	{
		Usage(playerid, "/setname <ID/Name> <newname>");
		return true;
	}
	if(pLogged[otherid] == false)
		return Error(playerid, "Player is not logged in!");

	if(!IsPlayerConnected(otherid))
		return Error(playerid, "Player not connected!");
	if(AFK[otherid] == 1) return Error(playerid, "Player is currently AFK!");
	if(strlen(tmp) < 3) return Error(playerid, "New name can't be shorter than 4 characters!");
	if(strlen(tmp) > 20) return Error(playerid, "New name can't be longer than 20 characters!");

	if(!IsValidName(tmp)) return Error(playerid, "Name contains invalid characters, please doublecheck!");

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE name='%e'", tmp);
	MySQL_query(query, true, "a_ChangePlayerName", "iis", otherid, playerid, tmp);
	return true;
}
// SetName Callback
function a_ChangePlayerName(otherplayer, playerid, nname[])
{
	if(!MySQL_rowCount())
	{
		new oldname[24], newname[24];
		GetPlayerName(otherplayer, oldname, sizeof(oldname));
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET name='%e' WHERE reg_id=%d", nname, pRegID[otherplayer]);
		MySQL_updateQuery(query);
		format(str, sizeof(str), "4Server:3 %s(%d) has changed %s's name to '%s'", pName[playerid], playerid, oldname, nname);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
		format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"%s(%d) has changed your name to \"%s\".", pName[playerid], playerid, nname);
		SendClientMessage(otherplayer, COLOR_LB, str);
		Info(otherplayer, "Make sure you log in with this new name on your next connect!");
		format(str, sizeof(str), "- AS - "LB2_E"You have changed %s(%d) name to \"%s\".", oldname, otherplayer, nname);
		SendClientMessage(playerid, COLOR_YELLOW, str);
		SetPlayerName(otherplayer, nname);
		GetPlayerName(otherplayer, newname, sizeof(newname));
		pName[otherplayer] = newname;
		// Private Vehicle
  		if(CountMaterials(otherplayer) > 0)
  		{
 			for(new i = 0; i < MAX_MATERIALS; i++)
			{
				if(strcmp(GetName(otherplayer),matInfo[i][MatOwner] , true) == 0)
				{
  					format(matInfo[i][MatOwner],MAX_PLAYER_NAME+1,newname);
				}
			}
		}
		if(BoughtVehicle[otherplayer][0] == true)
		{
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 1", newname, oldname);
			MySQL_updateQuery(query);
			format(PlayerInfoVeh[otherplayer][0][Owner], 24, newname);
		}
		if(BoughtVehicle[otherplayer][1] == true)
		{
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 2", newname, oldname);
			MySQL_updateQuery(query);
			format(PlayerInfoVeh[otherplayer][1][Owner], 24, newname);
		}
		// House
		/*foreach(new h : Houses)
		{
			if(!strcmp(hInfo[h][HouseOwner], oldname, CASE_SENSETIVE))
			{
				// Has House
				format(hInfo[h][HouseOwner], 24, "%s", newname);
				format(query, sizeof(query), "UPDATE houses SET howner='%e' WHERE house_id=%d", newname, hInfo[h][HouseID]);
				MySQL_updateQuery(query);
				UpdateHouseText(h);
			}
		}*/
		if(PurchasedToy[otherplayer] == true)
		{
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE toys SET Name='%e' WHERE Name='%e'", newname, oldname);
			MySQL_updateQuery(query);
		}
		// Update group founder
		if(pGroupRank[otherplayer] == 7)
		{
			format(query, sizeof(query), "UPDATE groups SET gFounder='%e' WHERE gFounder='%e'", newname, oldname);
			MySQL_updateQuery(query);
		}
	 	if(pGroupID[otherplayer] != -1)
	 	{
			format(query, sizeof(query), "SELECT gfounder FROM groups WHERE gID=%d LIMIT 1", pGroupID[otherplayer]);
			MySQL_updateQuery(query);
			new rows = MySQL_rowCount();
			if(rows)
			{
				new founder[24];
				cache_get_row(0, 0, founder);
				if(!strcmp(founder, oldname))
				{
					format(query, sizeof(query), "UPDATE groups SET gFounder='%e' WHERE gFounder='%e'", newname, oldname);
					MySQL_updateQuery(query);
				}
			}
		}
		
	}
	else
	{
		// Name Exists
		format(str, sizeof(str), ""GREY2_E"ERROR: "GREY_E"The name "DARK_E"'%s' "GREY_E"already exists in the database, please use a different name!", nname);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
	return true;
}

CMD:nick(playerid, params[]) return cmd_changename(playerid, params);
CMD:newname(playerid, params[]) return cmd_changename(playerid, params);
CMD:changename(playerid, params[])
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be logged in to change your name!");

	if(pTotalHours[playerid] < 3)
		return Error(playerid, "You must have at least 3 hours ingame to change your nick!");
	if(AFK[playerid] == 1) return Error(playerid, "You can't change your name while AFK, type /back to return.");
	if(sscanf(params, "s[20]", tmp))
	{
		Usage(playerid, "/changename <newname>");
		return true;
	}
	if(strlen(tmp) < 3) return Error(playerid, "New name can't be shorter than 4 characters!");
	if(strlen(tmp) > 20) return Error(playerid, "New name can't be longer than 20 characters!");
	if(!IsValidName(tmp)) return Error(playerid, "Name contains invalid characters, please doublecheck!");

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE name='%e'", tmp);
	MySQL_query(query, true, "ChangePlayerName", "is", playerid, tmp);
	return true;
}
function ChangePlayerName(playerid, nname[])
{
	if(!MySQL_rowCount())
	{
		// Proceed to check if players name has been changed today
		mysql_format(g_SQL_handle, query, sizeof(query), "SELECT namechange_date FROM players WHERE name='%e'", pName[playerid]);
		MySQL_query(query, true, "ChangePlayerName2", "is", playerid, nname);
	}
	else
	{
		// Name Exists
		format(str, sizeof(str), ""GREY2_E"ERROR: "GREY_E"The name "DARK_E"'%s' "GREY_E"already exists in the database, please use a different name!", nname);
		SendClientMessage(playerid, COLOR_GREY, str);
	}
}

function ChangePlayerName2(playerid, nname[])
{
	if(MySQL_rowCount())
	{
		new cNameDate = cache_get_field_content_int(0,"namechange_date");

		if(cNameDate < gettime())
		{
			if(pPremium[playerid] > 0)
			{
				iTemp = gettime() + 86400 * 7;
			}
			else iTemp = gettime() + 86400 * 14;
			new oldname[24], newname[24];
			GetPlayerName(playerid, oldname, sizeof(oldname));

			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET name='%e', namechange_date=%d WHERE reg_id=%d", nname, iTemp, pRegID[playerid]);
			MySQL_updateQuery(query);

			format(str, sizeof(str), "4Server:3 %s(%d) has changed their name to %s.", pName[playerid], playerid, nname);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str), ""LB_E"Server: "LIME_E"%s(%d) has changed their name to '%s'.", pName[playerid], playerid, nname);
			SendClientMessageToAll(COLOR_WHITEP, str);

			format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"You have changed your name to '%s'", nname);
			SendClientMessage(playerid, COLOR_LB, str);
			Info(playerid, "Make sure you log in with this new name on your next connect!");

			SetPlayerName(playerid, nname);
			GetPlayerName(playerid, newname, sizeof(newname));
			pName[playerid] = newname;
		    if(CountMaterials(playerid) > 0)
		    {
		    	for(new i = 0; i < MAX_MATERIALS; i++)
		  		{
		  	    	if(strcmp(GetName(playerid),matInfo[i][MatOwner] , true) == 0)
		  			{
		  			    format(matInfo[i][MatOwner],MAX_PLAYER_NAME+1,newname);
		  			}
				}
			}
			// Private Vehicle
			if(BoughtVehicle[playerid][0] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 1", newname, oldname);
				MySQL_updateQuery(query);
				format(PlayerInfoVeh[playerid][0][Owner], 24, newname);
			}
			if(BoughtVehicle[playerid][1] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 2", newname, oldname);
				MySQL_updateQuery(query);
				format(PlayerInfoVeh[playerid][1][Owner], 24, newname);
			}
			// House
			/*foreach(new h : Houses)
			{
				if(!strcmp(hInfo[h][HouseOwner], oldname, CASE_SENSETIVE))
				{
					// Has House
					format(hInfo[h][HouseOwner], 24, "%s", newname);
					mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE houses SET howner='%e' WHERE house_id=%d", newname, hInfo[h][HouseID]);
					MySQL_updateQuery(query);
					UpdateHouseText(h);
				}
			}*/
			if(PurchasedToy[playerid] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE toys SET Name='%e' WHERE Name='%e'", newname, oldname);
				MySQL_updateQuery(query);
			}
			// Update group founder
			if(pGroupRank[playerid] == 7)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE groups SET gFounder='%e' WHERE gFounder='%e'", newname, oldname);
				MySQL_updateQuery(query);
			}
		 	if(pGroupID[playerid] != -1)
		 	{
				format(query, sizeof(query), "SELECT gfounder FROM groups WHERE gID=%d LIMIT 1", pGroupID[playerid]);
				MySQL_updateQuery(query);
				new rows = MySQL_rowCount();
				if(rows)
				{
					new founder[24];
					cache_get_row(0, 0, founder);
					if(!strcmp(founder, oldname))
					{
						format(query, sizeof(query), "UPDATE groups SET gFounder='%e' WHERE gFounder='%e'", newname, oldname);
						MySQL_updateQuery(query);
					}
				}
			}
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE racetimes SET holder='%e' WHERE holder='%e'", newname, oldname);
			MySQL_updateQuery(query);

			// Log the namechange
			mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO namechanges(reg_id,oldname,newname,time) VALUES(%d,'%e','%e',UNIX_TIMESTAMP())", pRegID[playerid], newname, oldname);
			MySQL_updateQuery(query);
		}
		else
		{
			localtime(cNameDate, tmParam);
			strftime(tmp, sizeof(tmp), "%d/%m/%Y", tmParam);
			if(pPremium[playerid] == 0)
			{
				format(str, sizeof(str), ""RED_E"Server: "GREY_E"You can only change your name once every 2 weeks! Wait until %s to change your name again.", tmp);
			}
			else format(str, sizeof(str), ""RED_E"Server: "GREY_E"You can only change your name once a week! Wait until %s to change your name again.", tmp);
			SendClientMessage(playerid, COLOR_GREY, str);
		}
	}
	return true;
}

function ChangePlayerName_cShop(playerid, nname[])
{
	if(!MySQL_rowCount())
	{
			new oldname[24], newname[24];
			GetPlayerName(playerid, oldname, sizeof(oldname));
			format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased a name change for 650 cookies!", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_WHITEP, str);
			format(str, sizeof(str), "4Server:3 %s(%d) has changed their name to %s.", pName[playerid], playerid, nname);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str), ""LB_E"Server: "LIME_E"%s(%d) has changed their name to '%s'.", pName[playerid], playerid, nname);
			SendClientMessageToAll(COLOR_WHITEP, str);

			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET name='%e' WHERE reg_id=%d", nname, pRegID[playerid]);
			MySQL_updateQuery(query);
			format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"You have changed your name to '%s'", nname);
			SendClientMessage(playerid, COLOR_LB, str);
			Info(playerid, "Make sure you log in with this new name on every connect!");

			SetPlayerName(playerid, nname);
			GetPlayerName(playerid, newname, sizeof(newname));
			pName[playerid] = newname;
		    if(CountMaterials(playerid) > 0)
		    {
		    	for(new i = 0; i < MAX_MATERIALS; i++)
		  		{
		  	    	if(strcmp(GetName(playerid),matInfo[i][MatOwner] , true) == 0)
		  			{
		  			    format(matInfo[i][MatOwner],MAX_PLAYER_NAME+1,newname);
		  			}
				}
			}
			// Private Vehicle
			if(BoughtVehicle[playerid][0] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 1", newname, oldname);
				MySQL_updateQuery(query);
				format(PlayerInfoVeh[playerid][1][Owner], 24, newname);
			}
			if(BoughtVehicle[playerid][1] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE vehicles SET Owner='%e' WHERE Owner='%e' AND VehicleCount = 2", newname, oldname);
				MySQL_updateQuery(query);
				format(PlayerInfoVeh[playerid][1][Owner], 24, newname);
			}
			// House
			/*foreach(new h : Houses)
			{
				if(!strcmp(hInfo[h][HouseOwner], oldname, CASE_SENSETIVE))
				{
					// Has House
					format(hInfo[h][HouseOwner], 24, "%s", newname);
					mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE houses SET howner='%e' WHERE house_id=%d", newname, hInfo[h][HouseID]);
					MySQL_updateQuery(query);
					UpdateHouseText(h);
				}
			}*/
			if(PurchasedToy[playerid] == true)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE toys SET Name='%e' WHERE Name='%e'", newname, oldname);
				MySQL_updateQuery(query);
			}
			// Update group founder
			if(pGroupRank[playerid] == 6)
			{
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE groups SET gFounder='%e' WHERE gFounder='%e'", newname, oldname);
				MySQL_updateQuery(query);
			}
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE racetimes SET holder='%e' WHERE holder='%e'", newname, oldname);
			MySQL_updateQuery(query);

			// Log the namechange
			mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO namechanges(reg_id,oldname,newname,time) VALUES(%d,'%e','%e',UNIX_TIMESTAMP())", pRegID[playerid], newname, oldname);
			MySQL_updateQuery(query);
			pCookies[playerid] -= 650;
	}
	else
	{
		// Name Exists
		format(str, sizeof(str), ""GREY2_E"ERROR: "GREY_E"The name "DARK_E"'%s' "GREY_E"already exists in the database, please use a different name!", nname);
		SendClientMessage(playerid, COLOR_GREY, str);
		ShowPlayerDialog(playerid, COOKIE_DIALOG+4, DIALOG_STYLE_INPUT, ""WHITE_E"Change Name", "Enter your new name:", "Enter", "Exit");
	}
}

CMD:mute(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	new reason[60], timeSec;
	if(sscanf(params, "k<player_name>D(180)S(*)[40]", otherid, timeSec, reason))
	{
		Usage(playerid, "/mute <ID/Name> (optional: <time in seconds> <reason>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(pMute[otherid] > 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) is already muted (mute lifted in %d seconds)", giveplayer, otherid, pMute[otherid]);
		SendClientMessage(playerid, COLOR_RED, str);
		SendClientMessage(playerid, COLOR_WHITE, "HINT: /unmute <ID/Name> to unmute");
		return true;
	}

	if(reason[0] != '*' && strlen(reason) > 40)
	{
		Error(playerid, "Reason too long! Must be smaller than 40 characters!");
		return true;
	}
	if(timeSec < 10 || timeSec > 600)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Mute time must remain between 10 and 600 seconds");
			return true;
		}
	}

	pMute[otherid] = timeSec;

	if(reason[0] == '*')
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) muted %s(%i) for %d seconds.", pName[playerid], playerid, giveplayer, otherid, timeSec);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been muted by an Administrator for %d seconds.", giveplayer, otherid, timeSec);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) muted %s(%i) (%d seconds)", pName[playerid], playerid, giveplayer, otherid, timeSec);
	}
	else
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) muted %s(%i) for %d seconds. "GREY2_E"[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been muted by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", giveplayer, otherid, timeSec, reason);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) muted %s(%i) for %d seconds. [Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);
	}
	SendClientMessageToAll(COLOR_RED, str);
	SavePlayerStats(otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	AdminCommandLog("MUTE", playerid, otherid, reason);
	return true;
}

CMD:changemutetime(playerid, params[]) {
	if(pAdmin[playerid] < 1)
			//if(Helper[playerid] == 0)
			if((Helper[playerid] !=1 && Helper[playerid] != 3))
				return Error(playerid, "You are not authorized to use this command!");

	new timeSec;
	if(sscanf(params, "k<player_name>D(180)", otherid, timeSec))
	{
		Usage(playerid, "/changemutetime <ID/Name> <time in seconds>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(timeSec < 10 || timeSec > 600)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Mute time must remain between 10 and 600 seconds");
			return true;
		}
	}

	pMute[otherid] = timeSec;

	if(pHidden[playerid]) format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"An administrator has changed %s(%i)'s mute time to %d seconds.", pName[otherid], otherid, timeSec);
	else format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has changed %s(%i)'s mute time to %d seconds.", pName[playerid], playerid, pName[otherid], otherid, timeSec);

	SendClientMessageToAll(COLOR_GREY, str);

	return 1;
}

CMD:omute(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new player[24];
	if(sscanf(params, "s[24]ds[50]", player, datez, tmp))
	{
		Usage(playerid, "/omute <name> <time in seconds)> <reason>");
		SendClientMessage(playerid, COLOR_YELLOW2, "FUNCTION: Will mute a player while they're offline. Time will start when they come in game.");
		return true;
	}
	if(strlen(tmp) > 50) return Error(playerid, "Reason must be shorter than 50 characters.");
	if(datez < 10 || datez > 1000)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Mute time must remain between 10 and 1000 seconds");
			return true;
		}
	}
	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);

		if(strfind(PlayerName, player, true) != -1)
		{
			Error(playerid, "Player is online, you can use /mute on them.");
			return true;
		}
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id FROM players WHERE name='%e'", player);
	MySQL_query(query, true, "OnOMuteQueryData", "issi", playerid, player, tmp, datez);
	return true;
}

function OnOMuteQueryData(adminid, NameToMute[], muteReason[], muteTime)
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "[ERROR] "GREY_E"Account '%s' does not exist.", NameToMute);
		SendClientMessage(adminid, COLOR_WHITE, str);
	}
	else
	{
		new RegID;
		RegID = cache_get_field_content_int(0, "reg_id");
		format(str, sizeof(str), "- AS - "RED_E"You have muted %s for %d seconds. (Mute will take affect as soon as player logs in)", NameToMute, muteTime);
		SendClientMessage(adminid, COLOR_YELLOW, str);
		format(str, sizeof(str), "4Server:3 %s(%i) has offline muted %s for %d seconds (Reason: %s)", pName[adminid], adminid, NameToMute, muteTime, muteReason);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

		if(pHidden[adminid] == 0)
			format(str, sizeof(str), "- AS - "RED_E"%s(%i) has offline muted %s for %d seconds. "GREY2_E"[Reason: %s]", pName[adminid], adminid, NameToMute, muteTime, muteReason);
		else
			format(str, sizeof(str), "- AS - "RED_E"%s has been offline muted by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", NameToMute, muteTime, muteReason);
		SendClientMessageToAll(COLOR_YELLOW, str);

		format(query, sizeof(query), "UPDATE players SET Muted=%d WHERE reg_id=%d", muteTime, RegID);
		MySQL_updateQuery(query);
	}
	return true;
}

CMD:blockcmds(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new reason[60], timeSec;
	if(sscanf(params, "k<player_name>D(180)S(*)[40]", otherid, timeSec, reason))
	{
		Usage(playerid, "/blockcmds <ID/Name> (optional: <time in seconds> <reason>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(pBlocked[otherid] > 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) has already had their commands blocked (block lifted in %d seconds)", giveplayer, otherid, pBlocked[otherid]);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}

	if(reason[0] != '*' && strlen(reason) > 40)
	{
		Error(playerid, "Reason too long! Must be smaller than 40 characters!");
		return true;
	}
	if(timeSec < 10 || timeSec > 600)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Block time must remain between 10 and 600 seconds");
			return true;
		}
	}

	pBlocked[otherid] = timeSec;

	if(reason[0] == '*')
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has blocked %s(%i)'s commands for %d seconds.", pName[playerid], playerid, giveplayer, otherid, timeSec);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i)'s commands have been blocked by an Administrator for %d seconds.", giveplayer, otherid, timeSec);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) blocked %s(%i)'s commands (%d seconds)", pName[playerid], playerid, giveplayer, otherid, timeSec);
	}
	else
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has blocked %s(%i)'s commands for %d seconds. "GREY2_E"[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) commands have been blocked by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", giveplayer, otherid, timeSec, reason);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) blocked %s(%i)'s commands for %d seconds. [Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);
	}
	SendClientMessageToAll(COLOR_RED, str);

	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	AdminCommandLog("BLOCKCMDS", playerid, otherid, reason);
	return true;
}

CMD:unblockcmds(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/unblockcmds <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(pBlocked[otherid] == 0)
		return Error(playerid, "The player commands aren't blocked!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	pBlocked[otherid] = 0;

	format(str, sizeof(str), "DELETE FROM `CommandsBlock` WHERE `Name` = '%e'", pName[otherid]);
	MySQL_updateQuery(str);

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has unblocked %s's(%i) commands.", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s's(%i) commands have been unblocked by an Administrator", giveplayer, otherid);

	SendClientMessageToAll(COLOR_RED, str);
	format(str, sizeof(str), "4Server: 2%s(%i) has unblocked %s's(%i) commands", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:unmute(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/unmute <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(pMute[otherid] == 0)
		return Error(playerid, "The player isn't muted!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	pMute[otherid] = 0;

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has unmuted %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been un-muted by an Administrator", giveplayer, otherid);

	SendClientMessageToAll(COLOR_RED, str);
	format(str, sizeof(str), "4Server: 2%s(%i) has unmuted %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:muteall(playerid)
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	foreach(new ii : Player)
	{
		pMute[ii] = 60;
	}
	format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has muted all players.", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has muted all players.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}
CMD:unmuteall(playerid)
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	foreach(new ii : Player)
	{
		pMute[ii] = 0;
	}
	format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has un-muted all players.", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has un-muted all players.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}

CMD:killall(playerid)
{
	if(pAdmin[playerid] < 6)
		return Error(playerid, "You are not authorized to use this command!");

	foreach(new ii : Player)
	{
		SetPlayerHealth(ii, 0);
	}
	format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has killed all players.", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	format(tmp, sizeof(tmp), "4Server: 2%s(%i) has killed all players.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	return true;
}
CMD:jail(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	new reason[60], timeSec;
	if(sscanf(params, "k<player_name>D(180)S(*)[60]", otherid, timeSec, reason))
	{
		Usage(playerid, "/jail <ID/Name> (optional: <time in seconds> <reason>)");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(pJail[otherid] > 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) is already jailed (gets out in %d seconds)", giveplayer, otherid, pJail[otherid]);
		SendClientMessage(playerid, COLOR_RED, str);
		SendClientMessage(playerid, COLOR_WHITE, "HINT: /unjail <ID/Name> to unjail.");
		return true;
	}
	if(pSpawned[otherid] == 0)
	{
		format(str, sizeof(str), "ERROR: "GREY2_E"%s(%i) isn't spawned!", giveplayer, otherid);
		SendClientMessage(playerid, COLOR_RED, str);
		return true;
	}
	if(reason[0] != '*' && strlen(reason) > 60)
	{
		Error(playerid, "Reason too long! Must be smaller than 60 characters!");
		return true;
	}
	if(timeSec < 10 || timeSec > 600)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Jail time must remain between 10 and 600 seconds");
			return true;
		}
	}
	if(InDuel[otherid] != -1)
	{
		format(str, sizeof(str), ""DUEL" "GREY_E"%s (%d) has been eliminated.", pName[otherid], otherid);
		SendClientMessageToAll(COLOR_GREY, str);
		EndDuel(otherid);
	}
	else if(doingStunt[otherid] == 19) // Derby
	{
		RemoveFromDerby(otherid);
	}
	else if(doingStunt[otherid] == 18) // Fallout
	{
		RemoveFromFallout(otherid);
	}
	else if(doingStunt[otherid] == 33) // LMS
	{
		RemoveFromLMS(otherid);
	}
	ResetPlayerWeapons(otherid);
	pJail[otherid] = timeSec;
	SetPlayerPosition(otherid, 405.1100,2474.0784,35.7369,360.0000);
	SetPlayerWorldBounds(otherid, 20000.0, -20000.0, 20000.0, -20000.0);
	SetPlayerVirtualWorld(otherid, 9999);
	pLastVehicle[otherid] = 0;
	SetPVarInt(otherid, "JailedByAdmin", 1);
	ShowPlayerDialog(otherid, -1, DIALOG_STYLE_LIST, "Close", "Close", "Close", "Close");

	if(reason[0] == '*')
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) jailed %s(%i) for %d seconds.", pName[playerid], playerid, giveplayer, otherid, timeSec);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been jailed by an Administrator for %d seconds.", giveplayer, otherid, timeSec);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) jailed %s(%i) for %d seconds.", pName[playerid], playerid, giveplayer, otherid, timeSec);

		if(pLogged[otherid]) {
			format(query, sizeof(query), "UPDATE players SET JailedReason = 'N/A' WHERE reg_id = %i", pRegID[otherid]);
			MySQL_updateQuery(query);
		}
		SetPVarString(otherid, "JailedReason", "N/A");
	}
	else
	{
		if(pHidden[playerid] == 0)
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) jailed %s(%i) for %d seconds. "GREY2_E"[Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);
		else
			format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been jailed by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", giveplayer, otherid, timeSec, reason);

		format(tmp, sizeof(tmp), "4Server: 2%s(%i) jailed %s(%i) for %d seconds. [Reason: %s]", pName[playerid], playerid, giveplayer, otherid, timeSec, reason);

		if(pLogged[otherid]) {
			
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET JailedReason = '%e' WHERE reg_id = %i", reason, pRegID[otherid]);
			MySQL_updateQuery(query);
		}
		SetPVarString(otherid, "JailedReason", reason);
	}
	SendClientMessageToAll(COLOR_RED, str);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
	AdminCommandLog("JAIL", playerid, otherid, reason);
	SetPlayerHealth(otherid, 9999); //avoid killing
	return true;
}

CMD:ojail(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	new player[24];
	if(sscanf(params, "s[24]ds[50]", player, datez, tmp))
	{
		Usage(playerid, "/ojail <name> <time in seconds)> <reason>");
		SendClientMessage(playerid, COLOR_YELLOW2, "FUNCTION: Will jail a player while they're offline. Time will start when they're in game.");
		return true;
	}
	if(strlen(tmp) > 50) return Error(playerid, "Reason must be shorter than 50 characters.");
	if(datez < 10 || datez > 1000)
	{
		if(pAdmin[playerid] < 5)
		{
			Error(playerid, "Jail time must remain between 10 and 1000 seconds");
			return true;
		}
	}
	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, MAX_PLAYER_NAME);

		if(strfind(PlayerName, player, true) != -1)
		{
			Error(playerid, "Player is online, you can use /jail on them.");
			return true;
		}
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id FROM players WHERE name='%e'", player);
	MySQL_query(query, true, "OnOJailQueryData", "issi", playerid, player, tmp, datez);
	return true;
}

forward OnOJailQueryData(adminid, NameToJail[], jailReason[], jailTime);
public OnOJailQueryData(adminid, NameToJail[], jailReason[], jailTime)
{
	if(!MySQL_rowCount())
	{
		format(str, sizeof(str), "[ERROR] "GREY_E"Account '%s' does not exist.", NameToJail);
		SendClientMessage(adminid, COLOR_WHITE, str);
	}
	else
	{
		new RegID;
		RegID = cache_get_field_content_int(0, "reg_id");
		format(str, sizeof(str), "- AS - "RED_E"You have jailed %s for %d seconds. (Time will take affect as soon as player logs in)", NameToJail, jailTime);
		SendClientMessage(adminid, COLOR_YELLOW, str);
		format(str, sizeof(str), "4Server:3 %s(%i) has offline jailed %s for %d seconds. [Reason: %s]", pName[adminid], adminid, NameToJail, jailTime, jailReason);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

		if(pHidden[adminid] == 0)
			format(str, sizeof(str), "- AS - "RED_E"%s(%i) has offline jailed %s for %d seconds. "GREY2_E"[Reason: %s]", pName[adminid], adminid, NameToJail, jailTime, jailReason);
		else
			format(str, sizeof(str), "- AS - "RED_E"%s has been offline jailed by an Administrator for %d seconds. "GREY2_E"[Reason: %s]", NameToJail, jailTime, jailReason);
		SendClientMessageToAll(COLOR_YELLOW, str);

		format(query, sizeof(query), "UPDATE players SET Jailed=%d WHERE reg_id=%d", jailTime, RegID);
		MySQL_updateQuery(query);
	}
	return true;
}

CMD:unjail(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/unjail <ID/Name>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	if(pJail[otherid] == 0)
		return Error(playerid, "The player isn't in jail!");


	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	pJail[otherid] = 0;
	SetPlayerHealth(otherid, 97);
	SetPlayerInterior(otherid, 0);
	SetPlayerVirtualWorld(otherid, 0);
	SpawnPlayer(otherid);

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has unjailed %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been un-jailed by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);
	format(str, sizeof(str), "4Administrator%s(%i) has unjailed %s(%i)", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

CMD:ann(playerid, params[]) return cmd_announce(playerid, params);
CMD:announce(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(isnull(params))
	{
		Usage(playerid, "/announce <msg>");
		return true;
	}
	// Check for special trouble-making input
	if(strfind(params, "~x~", true) != -1)
		return Error(playerid, "~x~ is not allowed in announce.");
	if(strfind(params, "#k~", true) != -1)
		return Error(playerid, "The constant key is not allowed in announce.");
	if(strfind(params, "/q", true) != -1)
		return Error(playerid, "You are not allowed to type /q in announcement!");

	// Count tildes (uneven number = faulty input)
	iTemp = 0;
	for(new i = (strlen(params)-1); i != -1; i--)
	{
		if(params[i] == '~')
			iTemp ++;
	}
	if(iTemp % 2 == 1)
		return Error(playerid, "You either have an extra ~ or one is missing in the announcement!");


	if(pAdmin[playerid] == 1)
	{
		if(GetPVarInt(playerid, "UsedAnn") ==1)
		{
			Error(playerid, "Moderators can only make 1 announcements per 2 minutes, sorry!");
			return true;
		}
		SetPVarInt(playerid, "UsedAnn", 1);
		SetTimerEx("ResetAnn", 120000, false, "i", playerid);
	}
	format(str, sizeof(str), "~w~%s", params);
	foreach(new i : Player)
	{
	    if(TogAnn[i]) GameTextForPlayer(i,str,6500,3);
	}

	format(str, sizeof(str), "4Announcement:3 %s(%i) announced '%s'", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	AdminCommandLog("ANN", playerid, _, params);
	return true;
}

CMD:pann(playerid, params[]) return cmd_pannounce(playerid, params);
CMD:pannounce(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>s", otherid, tmp))
	{
		Usage(playerid, "/pann <ID/Name> <msg>");
		return true;
	}
	// Check for special trouble-making input
	if(strfind(tmp, "~x~", true) != -1)
		return Error(playerid, "~x~ is not allowed in announce.");
	if(strfind(tmp, "#k~", true) != -1)
		return Error(playerid, "The constant key is not allowed in announce.");
	// Count tildes (uneven number = faulty input)
	iTemp = 0;
	for(new i = (strlen(tmp)-1); i != -1; i--)
	{
		if(tmp[i] == '~')
			iTemp ++;
	}
	if(iTemp % 2 == 1)
		return Error(playerid, "You either have an extra ~ or one is missing in the announcement!");

	format(str, sizeof(str), "~w~%s", tmp);
	GameTextForPlayer(otherid, str, 6500, 3);
	format(str, sizeof(str), ""YELLOW_E"- AS - "GREY_E"You have announced '%s' to %s(%i)", tmp, pName[otherid], otherid);
	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), "4Player Announcement to %s(%d):3 %s(%i) announced '%s'", pName[otherid], otherid, pName[playerid], playerid, tmp);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	AdminCommandLog("pANN", playerid, otherid, params);
	return true;
}

CMD:cnrann(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");

	if(isnull(params))
	{
		Usage(playerid, "/cnrann <msg>");
		return true;
	}
	// Check for special trouble-making input
	if(strfind(params, "~x~", true) != -1)
		return Error(playerid, "~x~ is not allowed in announce.");
	if(strfind(params, "#k~", true) != -1)
		return Error(playerid, "The constant key is not allowed in announce.");
	// Count tildes (uneven number = faulty input)
	iTemp = 0;
	for(new i = (strlen(params)-1); i != -1; i--)
	{
		if(params[i] == '~')
			iTemp ++;
	}
	if(iTemp % 2 == 1)
		return Error(playerid, "You either have an extra ~ or one is missing in the announcement!");


	if(pAdmin[playerid] == 1)
	{
		if(GetPVarInt(playerid, "UsedAnn") ==1)
		{
			Error(playerid, "Moderators can only make 1 announcements per 2 minutes, sorry!");
			return true;
		}
		SetPVarInt(playerid, "UsedAnn", 1);
		SetTimerEx("ResetAnn", 120000, false, "i", playerid);
	}

	format(str, sizeof(str), "~w~%s", params);
	foreach(new ii : Player) if(InDM[ii] == 13) GameTextForPlayer(ii, str, 6500, 3);
	format(str, sizeof(str), ""YELLOW_E"- AS - "GREY_E"You have announced '%s' in the CnR minigame", params);
	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), "4CnR Announcement:3 %s(%i) announced '%s'", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	return true;
}

