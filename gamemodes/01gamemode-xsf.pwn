GivePlayerCash(playerid, cashgiven)
{
	if(2000000000 - pCash[playerid] < cashgiven)
	{
	    Error(playerid,"Your hand cash is exceeding the SAMP limit, Money not recieved");
	    return 0;
	}
	pCash[playerid] += cashgiven;
	SetPlayerMoney(playerid, pCash[playerid]);

	///if(pCash[playerid] > 2000000000)
	if(pCash[playerid] > 20000000)
	{
		if(pAch11[playerid] == 0)
		{
			pAch11[playerid] = 1;
			pAch3[playerid] = 1;
			format(query, sizeof(query), "UPDATE achievements SET a3=1,a11=1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			GivePlayerAchievement(playerid, "Filthy Rich", "Congrats you earned $20,000,000!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
		}
	}
	else if(pCash[playerid] > 5000000)
	{
		if(pAch3[playerid] == 0)
		{
			pAch3[playerid] = 1;
			format(query, sizeof(query), "UPDATE achievements SET a3=1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			GivePlayerAchievement(playerid, "You're Rich", "Congrats you earned $5,000,000!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
		}
	}

	if(pLogged[playerid]) {
		new str_query[100]; // We don't need a 4080 query size, now do we?
		format(str_query, sizeof(query), "UPDATE players SET money = %d WHERE reg_id = %d", pCash[playerid], pRegID[playerid]);
		MySQL_updateQuery(str_query);
	}
	return 1;
}

SetPlayerMoney(playerid, amount)
{
	ResetPlayerMoney(playerid);
	GivePlayerMoney(playerid, amount);
}
forward GiveRefund(playerid,score,money,bank,kills,deaths,reactions,maths,winderby,winrace,winfallout,duelwins,time);
public GiveRefund(playerid,score,money,bank,kills,deaths,reactions,maths,winderby,winrace,winfallout,duelwins,time)
{
    pScore[playerid] = 0;
    GivePlayerScore(playerid,score);
	ResetPlayerCash(playerid);
	GivePlayerCash(playerid,money);
	BankMoney[playerid] = bank;
	pInfo[playerid][pKills] = kills;
	pInfo[playerid][pDeaths] = deaths;
	reactionsWon[playerid] = reactions;
	mathsWon[playerid] = maths;
	pDerbys[playerid] = winderby;
	pInfo[playerid][pRacesWon] = winrace;
	pFallouts[playerid] = winfallout;
	pDuelsWon[playerid] = duelwins;
	pTotalHours[playerid] = time;
    SendClientMessage(playerid,-1, ""RED_E":: "WHITEP_E"server "RED_E":: "LB2_E"You've been succesfully refunded!");
}

ResetPlayerCash(playerid)
{
	pCash[playerid] = 0;
	ResetPlayerMoney(playerid);
}

// == Score ==
GivePlayerScore(playerid, score)
{
	pScore[playerid] += score;
	if(pLogged[playerid])
	{
	    new str_query[100]; // We don't need a 4080 query size, now do we?
		format(str_query, sizeof(str_query), "UPDATE players SET score = %d WHERE reg_id = %d", pScore[playerid], score);
		MySQL_updateQuery(str_query);
	}
	SetPlayerScore(playerid, pScore[playerid]);
}
