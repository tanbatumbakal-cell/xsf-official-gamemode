	}
	else if(pBCurrentCheckpoints < 1)
	{
		Error(playerid, "No checkpoint to delete!");
		return 1;
	}
	for(new ii = pBSelectedCheckpoint; ii < pBCurrentCheckpoints; ii++)
	{
		pBRaceCheckpoints[ii][0] = pBRaceCheckpoints[ii + 1][0];
		pBRaceCheckpoints[ii][1] = pBRaceCheckpoints[ii + 1][1];
		pBRaceCheckpoints[ii][2] = pBRaceCheckpoints[ii + 1][2];
	}
	pBCurrentCheckpoints --;
	pBSelectedCheckpoint--;
	if(pBCurrentCheckpoints < 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
		pBSelectedCheckpoint= 0;
		return 1;
	}
	else if(pBSelectedCheckpoint < 0)
	{
		pBSelectedCheckpoint= 0;
	}
	pBActiveCP(playerid, pBSelectedCheckpoint);
	SendClientMessage(playerid, COLOR_GREEN, ""SERVER_INITIALS" Checkpoint deleted!");
	return 1;
}

