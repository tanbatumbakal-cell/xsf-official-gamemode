CMD:tram(playerid, params[])
{
	new vehicleID = GetPlayerVehicleID(playerid);
	if(vehicleID == 0)
	{
		new vehicle;
		GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
		GetVehicleWithinDistance(POS[0], POS[1], POS[2], 18.0, vehicle);
		if(IsVehicleRcTram(vehicle))
		{
			if(!hasDriver(vehicleID)) PutPlayerInVehicle(playerid, vehicle, 0);
		}
		else Error(playerid, "There are no trams near you!");
	}
	else Error(playerid, "You need to be on foot to use this command!");
	return 1;
}


GetVehicleWithinDistance(Float:x1, Float:y1, Float:z1, Float:dist, &veh)
{
	new Float:x2, Float:y2, Float:z2, Float:d;
	for(new i = 1; i < MAX_VEHICLES; i++)
	{
		if(GetVehicleModel(i) > 0)
		{
			GetVehiclePos(i, x2, y2, z2);
			x2 -= x1; y2 -= y1; z2 -= z1;
			d = x2*x2 + y2*y2 + z2*z2;
			if(d < dist)
			{
				veh = i;
				dist = d;
			}
		}
	}
}

// Private Vehicle Command
CMD:mypv(playerid, params[])
{
	if(RaceParticipant[playerid] != 0)
	{
		Error(playerid, "You cannot switch vehicles during a race!");
		return true;
	}
	if(BoughtVehicle[playerid][0] == false && BoughtVehicle[playerid][1] == false) return Error(playerid, "You don't have a private vehicle! Purchase one at /pvshop!");
	if(pAdmin[playerid] != 6)
	{
		if(InDM[playerid] != 0)
		{
			Error(playerid, "You can't spawn your private vehicle while in a deathmatch!");
			return true;
		}
		if(doingStunt[playerid] != 0 || isCbug[playerid])
		{
			Error(playerid, "You can't spawn your private vehicle in this area!");
			return true;
		}
	}
	if(RaceParticipant[playerid] != 0)
	{
		if(raceVehicles == true)
		{
			SpawnPlayerVehicle(playerid, raceVehicleName);
			format(str, sizeof(str), "ERROR: "GREY2_E"You can't spawn vehicles for a custom vehicle race! You have auto-spawned a %s.", vehName[raceVehicleName - 400]);
			SendClientMessage(playerid, COLOR_RED, str);
			return true;
		}
	}
	if(pSpectating[playerid] != -1) return Error(playerid, "You can't spawn vehicles while spectating!");
	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1) return Error(playerid, "You can't spawn vehicles in an event!");
	if(GetPlayerVehicleID(playerid) == PlayerVehicle[playerid][0] || GetPlayerVehicleID(playerid) == PlayerVehicle[playerid][1]) return Error(playerid, "You are already in your private vehicle!");
	new id;
	if(sscanf(params, "i", id)) return Usage(playerid, "/mypv <0-1>");
	if(id > 1 || id < 0) return Error(playerid, "Invalid private vehicle id.");
	if(BoughtVehicle[playerid][id] == false) return Error(playerid, "You don't have the specified private vehicle! Purchase one at /pvshop!");
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	if(IsPlayerInAnyVehicle(playerid))
	{
		GetVehicleZAngle(GetPlayerVehicleID(playerid), A);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	}
	else GetPlayerFacingAngle(playerid, A);
	if(PlayerVehicle[playerid][id] != -1)
	{
		DestroyDynamic3DTextLabel(PV_3DLabel[playerid][id]);
		DestroyVehicle(PlayerVehicle[playerid][id]);
		PlayerVehicle[playerid][id] = -1;
	}
	RemoveComponents(playerid);
	if(pSpawnVehicle[playerid] != -1)
	{
		DestroyVehicle(pSpawnVehicle[playerid]);
		pSpawnVehicle[playerid] = -1;
	}
	//justSpawnedVehicle[playerid] = true;
	new vlabel[90];
	format(vlabel, sizeof(vlabel), "{%06x}%s's\n"WHITE_E"Vehicle", pColor[playerid], pName[playerid]);

	PlayerVehicle[playerid][id] = CreateVehicle(PlayerInfoVeh[playerid][id][Model], POS[0], POS[1], POS[2], A, PlayerInfoVeh[playerid][id][Color1], PlayerInfoVeh[playerid][id][Color2], -1);
	PV_3DLabel[playerid][id] = CreateDynamic3DTextLabel(vlabel, -1, 0.0, 0.0, 0.0, 30.0, INVALID_PLAYER_ID, PlayerVehicle[playerid][id], 0, -1, -1, -1, 45.0);

	SetVehicleNumberPlate(PlayerVehicle[playerid][id], PlayerInfoVeh[playerid][id][Plate]);
	SetVehicleToRespawn(PlayerVehicle[playerid][id]);
	LinkVehicleToInterior(PlayerVehicle[playerid][id], GetPlayerInterior(playerid));
	SetVehicleVirtualWorld(PlayerVehicle[playerid][id], GetPlayerVirtualWorld(playerid));
	PutPlayerInVehicle(playerid, PlayerVehicle[playerid][id], 0);
	format(tmp, sizeof(tmp), "~w~You have spawned your ~y~~h~~h~%s~w~!", vehName[GetVehicleModel(PlayerVehicle[playerid][id]) - 400]);
	InfoTD_MSG(playerid, 3800, tmp);
	format(PlayerInfoVeh[playerid][id][Owner], 24, pName[playerid]);

/*	if(pAdmin[playerid] == 5 && GetVehicleModel(GetPlayerVehicleID(playerid)) == 415)
	{
		SetPVarInt(playerid, "CustomCar", 1);
		// Cheetah
		sObjects[0][playerid] = CreateDynamicObject(2985,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[0][playerid], PlayerVehicle[playerid][id], -0.450000,0.824999,-0.599999,-27.000003,-0.000000,-269.999877);
		sObjects[1][playerid] = CreateDynamicObject(2985,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[1][playerid], PlayerVehicle[playerid][id], 0.524999,0.824999,-0.674999,21.599998,-0.000000,-269.999877);
		sObjects[2][playerid] =  CreateDynamicObject(18647,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[2][playerid], PlayerVehicle[playerid][id], -1.049999,-0.150000,-0.524999,0.000000,0.000000,0.000000);
		sObjects[3][playerid] = CreateDynamicObject(18647,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[3][playerid], PlayerVehicle[playerid][id], 1.049999,-0.150000,-0.524999,0.000000,0.000000,0.000000);
		sObjects[4][playerid] = CreateDynamicObject(1254,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[4][playerid], PlayerVehicle[playerid][id], -0.000000,2.100000,0.000000,67.500007,0.000000,0.000000);
		sObjects[5][playerid] = CreateDynamicObject(19314,0,0,-1000,0,0,0);
		AttachDynamicObjectToVehicle(sObjects[5][playerid], PlayerVehicle[playerid][id], -0.000000,0.000000,0.599999,70.200004,89.099983,0.000000);
	}*/
	//SetTimerEx("spawnedV", 3000, false, "i", playerid);
	return true;
}

CMD:forceend(playerid)
{
	if(pAdmin[playerid] < 2)
		return Error(playerid, "You are not authorized to use this command!");

	IsDerbyRunning = false;
	DerbyGameTime = DEFAULT_DERBY_TIME;
	KillTimer(tDerbyTimer);
	KillTimer(tDerbyFallOver);
	ClearDerbySpawns();
	ClearDerbyVotes();
	ExecDerbyVotingTimer();

	bDerbyPlayers = 0;
	CurrentDerbyPlayers = 0;
	foreach(new ii : Player)
	{
		if(doingStunt[ii] == 19)
		{
			if(pSpawnVehicle[ii] != -1)
			{
				DestroyVehicle(pSpawnVehicle[ii]);
				pSpawnVehicle[ii] = -1;
			}
			DerbyWinner[ii] = false;
			TogglePlayerControllable(ii, false);
			SetPlayerDerbyStaticMeshes(ii);
			ShowDerbyVotingDialog(ii);
			CurrentDerbyPlayers++;
		}
	}
	UpdateDMText();

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""DERBY" "LB_E"%s(%d) has ended the current round!", pName[playerid], playerid);
	else
		format(str, sizeof(str), ""DERBY" "LB_E"The current round has been ended by an Administrator.");
	SendClientMessageToAll(COLOR_WHITEP, str);
	return true;
}
CMD:forcemap(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this command!");

	if(IsDerbyRunning)
		return Error(playerid, "There is a derby currently in progress! To end it use /forceend.");

	if(sscanf(params, "i", otherid))
	{
		Usage(playerid, "/forcemap <1-11>");
		return true;
	}
	KillTimer(tDerbyVoting);
	derbycd = 5;
	if(derbyCountdown != -1)
	{
		KillTimer(derbyCountdown);
		derbyCountdown = -1;
	}
	if(otherid > 11)
		return Error(playerid, "Map can't be higher than 10");
	if(otherid < 1)
		return Error(playerid, "Map can't be lower than 1!");
	switch(otherid)
	{
		case 1:
		{
			derbyCountdown = SetTimer("derbyCD", 1000, true);
			if(!pHidden[playerid]) format(str, sizeof(str), ""DERBY" "LB_E"%s(%d) has set the map to: Sport Car Madness!", pName[playerid], playerid);
			else format(str, sizeof(str), ""DERBY" "LB_E"An administrator has set the map to: Sport Car Madness!");
		}
		case 2:
		{
			derbyCountdown = SetTimer("derbyCD2", 1000, true);
			if(!pHidden[playerid]) format(str, sizeof(str), ""DERBY" "LB_E"%s(%d) has set the map to: Skyscraper!", pName[playerid], playerid);
			else format(str, sizeof(str), ""DERBY" "LB_E"An administrator has set the map to: Skyscraper!");
		}
		case 3:
		{
			derbyCountdown = SetTimer("derbyCD3", 1000, true);
			if(!pHidden[playerid]) format(str, sizeof(str), ""DERBY" "LB_E"%s(%d) has set the map to: Rocky Roads!", pName[playerid], playerid);
			else format(str, sizeof(str), ""DERBY" "LB_E"An administrator has set the map to: Rocky Roads!");
		}
		case 4:
		{
