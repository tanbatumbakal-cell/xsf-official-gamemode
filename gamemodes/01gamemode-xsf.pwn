		    if(!IsPlayerConnected(id))
		    {
		    	Error(playerid, "This player isn't connected.");
		    	ShowPlayerDialog(playerid, DIALOG_KTP, DIALOG_STYLE_INPUT, ""RED_E"server Events: "WHITE_E"Kill The President", "Please choose a player to be the president", "Next", "Back");
		    	return 1;
		    }

		    President = id;
		    ShowPlayerDialog(playerid, DIALOG_KTP2, DIALOG_STYLE_INPUT, ""RED_E"server Events: "WHITE_E"Kill The President", "Cool, Now Please insert 3 ids of guards\n Ex: 2 3 4", "Next", "Back");
		    return 1;
		}
