	strcat(longstr, ""YELLOW_E"3) "WHITE_E"Spawn a /jetpack and able to hide your name/health using /nametag!\n\
	"YELLOW_E"4) "WHITE_E"Heal yourself and other players outside DM zones at anytime (/heal).\n\
	"YELLOW_E"5) "WHITE_E"Increase your speedboost parameter up to 1.8.\n");
	strcat(longstr, ""YELLOW_E"6) "WHITE_E"No limit on player teleporting and ability to start global countdown (/cd).");


	strcat(longstr, "\n\n"GREY2_E"Level 2 "PINK_E"(Permanent = €7) "RED_E"|| "PINK_E"(Temporary = €4 per month):\n\
	"YELLOW_E"1) "WHITE_E"Ability to play as "BLUE_E"swat"WHITE_E" \n");
	strcat(longstr, ""YELLOW_E"3) "WHITE_E"Access to /vipisland and /vipclub and ability to purchase houses there.\n\
	"YELLOW_E"4) "WHITE_E"Spawn with 50 percent armour on spawn and in DM zones.");

	strcat(longstr, "\n"YELLOW_E"5) "WHITE_E"Ability to purchase up to 2 houses and free interiors.\n\
	"YELLOW_E"6) "WHITE_E"/vtune - Ability to add any compatible vehicle component to your vehicle.\n\
	"YELLOW_E"7) "WHITE_E"Double cash during robberies and 20 percent extra cash for moneybag pickups.\n");
	strcat(longstr, ""YELLOW_E"8) "WHITE_E"Purchase weapons for free at anytime (/weapons) and toggle armour (/armour)\n\
	"YELLOW_E"9) "WHITE_E"All features of Premium Level 1 including "GREEN_E"$"WHITE_E"1,000,000 in your bank account.");

	strcat(longstr, "\n\n"GREY2_E"VIP "RED_E"(Permanent = €12) "WHITE_E"|| "RED_E"(Temporary = €6 per month):\n\
	"YELLOW_E"1) "WHITE_E"Spawn with 100 percent armour on spawn and DMs including CnR.\n\
	"YELLOW_E"2) "WHITE_E"Get 50 percent armour on all events and 100 percent armour on godmode.\n\
	"YELLOW_E"3) "WHITE_E"Ability to spawn tank, hydra and hunter (/tank /hydra /hunter)");
	strcat(longstr, "\n"YELLOW_E"4) "WHITE_E"Purchase up to 3 houses and 2 private vehicles (/pv).\n\
	"YELLOW_E"5) "WHITE_E"Ability to request a player to teleport to you using /bring.\n\
	"YELLOW_E"6) "WHITE_E"Ability to change your weapon set for free (/weaponset)\n\
	"YELLOW_E"7) "WHITE_E"VIP Rank on our forums + Spawn with 'VIP' 3D Text Label.");
	strcat(longstr, "\n"YELLOW_E"8) "WHITE_E"You are not frozen during event countdowns.\n\
	"YELLOW_E"9) "WHITE_E"Create up to 3 text labels anywhere around the server. (/vlabel /mylabels)");
	strcat(longstr, "\n"YELLOW_E"10) "WHITE_E"Ability to start server events (/event) and start races (/loadrace)\n\
	"YELLOW_E"11) "WHITE_E"Ability to set a custom chat color using RGB codes - /chatcolor\n\
	"YELLOW_E"12) "WHITE_E"All features of Premium Level 1 and 2 including "GREEN_E"$"WHITE_E"5,000,000 in your bank account\n\
	"YELLOW_E"13) "WHITE_E"Ability to send a special message to all connected players (/vsay)\n\
	"YELLOW_E"14) "WHITE_E"Ability to create 3D Text (Materials) anywhere around SA (/createmat)");
	strcat(longstr, "\n\n"LB_E"All premium members will be able to access premium chat "LB2_E"(/p) "LB_E"and listed on "LB2_E"/premiums.\n\
	"YELLOW_E"For information on how to buy premium/vip membership visit serverserver.com!");
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "PINK_E"Premium", longstr, "Close", "");
