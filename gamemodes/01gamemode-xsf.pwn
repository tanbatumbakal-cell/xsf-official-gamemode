CMD:cancel(playerid) return cmd_cduel(playerid);
CMD:cduel(playerid)
{
	if(GetPVarInt(playerid, "duelInvited") == 0)
		if(GetPVarInt(playerid, "sellingCookies") == 0)
			return Error(playerid, "You have no reason to use this command at the moment..");

	if(GetPVarInt(playerid, "duelInvited") != 0)
	{
		new otherplayer = GetPVarInt(playerid, "duelPlayer");
		SendClientMessage(playerid, COLOR_GREY, ""DUEL" "GREY_E"You have canceled your duel invite, you can now use /duel <ID> to duel a new player.");
		format(str, sizeof(str), ""DUEL" "GREY_E"%s(%d) has canceled their duel invite.",pName[playerid], playerid);
		SendClientMessage(otherplayer, COLOR_GREY, str);
		ClosePlayerDialog(otherplayer);
		DeletePVar(playerid, "duelInvited");
		DeletePVar(playerid, "duelPlayer");
	}
	else
	{
		foreach(new i : Player)
		{
			if(GetPVarInt(i, "cookieSeller") == playerid)
			{
				SetPVarInt(i, "cookieSeller", -1);
				DeletePVar(i, "cookieAmount");
				DeletePVar(i, "cookiePrice");
				format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%d) has canceled their offer for the cookies.",pName[playerid], playerid);
				SendClientMessage(i, COLOR_GREY, str);
			}
		}
		DeletePVar(playerid, "sellingCookies");
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have canceled your cookie offer, you can now make a new transaction.");
	}
	return 1;
}

CMD:dgod(playerid, params[]) return cmd_disablegod(playerid, params);
CMD:disablegod(playerid, params[])
{
	if(pAdmin[playerid] < 3)
	    return Error(playerid, "You do not have permission to use this command!");

	new id;
	if(sscanf(params, "k<player_name>", id))
	    return Usage(playerid, "/disablegod <playerid>");

	else if(!IsPlayerConnected(id))
	    return Error(playerid, "This player is not connected.");

	else if(pAdmin[id] > pAdmin[playerid])
	{
		format(str, sizeof(str), "** "RED_E"%s(%i) has just tried to disable your godmode!", pName[playerid], playerid);
		SendClientMessage(id, COLOR_GREY2, str);
		Error(playerid, "You are not able to disable an admin's godmode with a higher level than you!");
		return true;
	}

	new cantgod = GetPVarInt(id, "cantgod");
	if(cantgod) { // Their godmode is disabled.
	    DeletePVar(id, "cantgod");
	    if(!pHidden[playerid])
	        format(str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"%s(%i) has enabled your godmode.", pName[playerid], playerid);
		else
		    format(str, sizeof(str), ""YELLOW_E"- AS - "GREEN_E"An administrator has enabled your god mode.");

		SendClientMessage(id, COLOR_GREY2, str);

		format(str, sizeof(str), ""YELLOW_E" - AS - "GREEN_E"You have enabled %s(%i)'s godmode.", pName[id], id);
		SendClientMessage(playerid, COLOR_GREY2, str);
		SetPVarInt(id, "cantgod", 0);
		if(!GOD[id]) SetPlayerHealth(id, 9999);
		GOD[id] = 1;
		GodModeLabel(id, true);
	}
	else // Else its not
	{
		SetPVarInt(id, "cantgod", 1);
		if(GOD[id]) SetPlayerHealth(id, 97);
		GOD[id] = 0;
		GodModeLabel(id, false);

		TextDrawHideForPlayer(id, godTD);
	    if(!pHidden[playerid])
	        format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has disabled your godmode.", pName[playerid], playerid);
		else
		    format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E" An administrator has disabled your god mode.");

		SendClientMessage(id, COLOR_GREY2, str);

		format(str, sizeof(str), ""YELLOW_E" - AS - "RED_E"You have disabled %s(%i)'s godmode.", pName[id], id);
		SendClientMessage(playerid, COLOR_GREY2, str);
	}
	return 1;
}

CMD:nametag(playerid) return cmd_nametags(playerid);
CMD:nametags(playerid)
{
	if(pPremium[playerid] == 0) return Error(playerid, "You must be a premium member to use this command, check /premium for more info.");

	if(InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1)
		return Error(playerid, "You can't disable your nametag in events!");
	if(InDM[playerid] != 0)
		return Error(playerid, "You can't disable your nametag in DMs!");

	if(GetPVarInt(playerid, "nameTagOFF") == 0)
	{
		foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, false);
		SetPVarInt(playerid, "nameTagOFF", 1);
		SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"You have disabled your nametag, other players will not be able to see your name/health/armour.");
	}
	else
	{
		foreach(new ii : Player) ShowPlayerNameTagForPlayer(ii, playerid, true);
		DeletePVar(playerid, "nameTagOFF");
		SendClientMessage(playerid, COLOR_WHITEP, ""SERVER_INITIALS" "WHITEP_E"You have enabled your nametag, other players will now to able to see your name.");
	}
	return 1;
}

enum e_top_kdr
{
	E_playerid,
	Float:E_kdr
}
// Tops
CMD:topkdr(playerid)
{
	new maths[MAX_PLAYERS][e_top_kdr],
		finstring[2048];

	foreach(new i : Player)
	{
		if(pHidden[i] == 0)
		{
			new death = pInfo[i][pDeaths];
			death = (death == 0) ? (1) : (death);
			maths[i][E_playerid] = i;
			maths[i][E_kdr] = floatdiv(pInfo[i][pKills], death);
		}
	}

	SortDeepArray(maths, E_kdr, .order = SORT_DESC);

	for(new i = 0; i < 20; i++)
	{
		if(maths[i][E_kdr] != 0)
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) "WHITEP_E"%s(%d) "RED_E"|| "LB_E"KDR: %0.2f\n", i + 1, pName[maths[i][E_playerid]], maths[i][E_playerid], maths[i][E_kdr]);
			strcat(finstring, tmp);
		}
		else
		{
			format(tmp, sizeof(tmp), ""WHITE_E"%i) ----\n", i + 1);
			strcat(finstring, tmp);
		}
	}
	ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server - "WHITE_E"Top KDR", finstring, "Close", "");
	return 1;
}
