CMD:helpers(playerid)
{
	if(pLogged[playerid] == false)
		return Error(playerid, "You must be registered to use this command! (/register)");

	new count;
	foreach(new ii : Player)
	{
	    if(IsPlayerConnected(ii))
	    {
	    	if(Helper[ii] == 1)
    		{
    		    count++;
    		}
    	}
	}

	if(count == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"There are no helpers online!");
		return true;
	}

	new line3[900], displayed;

	format(str, sizeof(str), ""WHITEP_E"Helpers Online: "WHITE_E"%d", count);
	format(line3, sizeof(line3), ""WHITE_E"There are %d helpers online:\n", count);

	foreach(new ii : Player)
	{
		GetPlayerName(ii, PlayerName, sizeof(PlayerName));

		if(Helper[ii] == 1)
		{
			if(displayed == 0)
			{
				if(cAFK[ii] > 20)
				{
					format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) %s "WHITE_E"(AFK)", line3, pColor[ii], PlayerName, ii);
				}
				else format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i)", line3, pColor[ii], PlayerName, ii);
			}
			else
			{
				if(cAFK[ii] > 20)
				{
					format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i) "WHITE_E"(AFK)", line3, pColor[ii], PlayerName, ii);
				}
				else format(line3, sizeof(line3), "%s\n{%06x}%s (ID: %i)", line3, pColor[ii], PlayerName, ii);
			}

			displayed += 1;
		}
	}
	format(line3, sizeof(line3), "%s\n\n\n"WHITE_E"Type /ask to ask any of our helpers/staff members a question!", line3);

	ShowPlayerDialog(playerid, 16, DIALOG_STYLE_MSGBOX, str, line3, "Close", "");

	return true;
}
