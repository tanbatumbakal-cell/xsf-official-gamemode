CMD:p(playerid, params[])
{
	if(pPremium[playerid] == 0)
		if(!pAdmin[playerid])
			return Error(playerid, "You are not authorized to use this command!");

	if(pMute[playerid] > 0)
	{
		format(str, sizeof(str), "* You can't speak while muted, mute will be lifted in %d seconds.", pMute[playerid]);
		SendClientMessage(playerid, COLOR_ORANGE, str);
		GameTextForPlayer(playerid, "~r~You are muted~y~!", 3000, 3);
		return false;
	}
	if(isnull(params))
	{
		Usage(playerid, "/p <text>");
		return true;
	}

	// Decide about multi-line msgs
	new i = -1;
	if(strlen(params) > 70)
	{
		i = strfind(params, " ", false, 60);
		if(i > 80 || i == -1) i = 70;

		// store the second line text
		line = " ";
		strcat(line, params[i]);

		// delete the rest from msg
		params[i] = EOS;
	}

	if(strcmp("XeonTM", pName[playerid]) && strcmp("Xeon[rK]", pName[playerid])) format(str, sizeof(str), ""YELLOW_E"[Premium Chat] "SBLUE_E"%s(%i): "WHITEP_E"%s", pName[playerid], playerid, params);
	else format(str, sizeof(str), ""YELLOW_E"[Premium Chat] "SBLUE_E"Xeon™(%i): "WHITEP_E"%s", playerid, params);
	foreach(new ii : Player) if(pPremium[ii] > 0 || pAdmin[ii]) if(GetPVarInt(ii, "BadSports") == 0) SendClientMessage(ii, COLOR_WHITEP, str);
	if(i != -1) foreach(new ii : Player) if(pPremium[ii] > 0 || pAdmin[ii]) if(GetPVarInt(ii, "BadSports") == 0) SendClientMessage(ii, COLOR_WHITEP, line);
	format(str, sizeof(str), "4[Premium Chat]3 %s(%i): 2%s", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	if(i != -1) IRC_GroupSay(ircGroup, IRC_aCHANNEL, line);
	//format(str, sizeof(str), "**[Premium Chat]** %s(%i): %s", pName[playerid], playerid, params);
	//DCC_SendChannelMessage(Channel_Staff, str);
	//DCC_SendChannelMessage(Channel_VIP, str);
	return true;
}
CMD:h(playerid, params[])
{
	new str8[240];
	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");
	new helpermsg[191];
	if(sscanf(params, "s[190]",helpermsg))
		return Usage(playerid, "/h <text>    or   * <text>");

	

	format(str8, sizeof(str8), "2[Helper Chat]3 %s(%i):2 %s", pName[playerid], playerid, helpermsg);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str8);

	foreach(new ii : Player) 
	{
		if(pAdmin[ii] > 0 || Helper[ii] == 1 || Helper[ii] == 3)
	
		{
		    if(oldHColors[ii] == 1)  
		    {
				format(str8, sizeof(str8), "[Helper Chat] {FFE4C4}%s(%i):{FFFFFF} %s", pName[playerid], playerid, helpermsg);
		    	SendClientMessage(ii, 0x56A4E4FF, str8);
		    }
		    else
		    { 
				format(str8, sizeof(str8), "[Helper Chat] {00FF00}%s(%i):{FFFFFF} %s", pName[playerid], playerid, helpermsg);
		    	SendClientMessage(ii, 0x002FC9FF, str8);
		    }
		}
	}

	return true;
}
