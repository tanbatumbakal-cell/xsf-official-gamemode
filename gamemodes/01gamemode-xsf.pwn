	SendClientMessage(playerid, COLOR_GREY, str);
	format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"%s(%i) set your cookies to %s", pName[playerid], playerid, ToCurrency(cookies));
	SendClientMessage(otherid, COLOR_GREY, str);

	format(str, sizeof(str), "4Server:3 %s(%i) set %s(%i)'s cookies to %s", pName[playerid], playerid, giveplayer, otherid, ToCurrency(cookies));
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	format(tmp, sizeof(tmp), "%d", cookies);
	AdminCommandLog("SETCOOKIES", playerid, otherid, tmp);
	return true;
}

CMD:setgroupscore(playerid, params[])
{
	if(pAdmin[playerid] != 6)
		if(!IsPlayerAdmin(playerid))
			return Error(playerid, "You are not authorized to use this command!");

	new score;
	if(sscanf(params, "s[25]d", tmp, score))
	{
		Usage(playerid, "/setgroupscore <Group Name> <Score>");
		return true;
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT gID FROM groups WHERE gName='%e'", tmp);
	MySQL_query(query, false, "UpdateGScore", "isi", playerid, tmp, score);
	return true;
}

function UpdateGScore(playerid, gName[], gScore)
{
	if(!MySQL_rowCount())
	{
		Error(playerid, "This group does not exist.");
	}
	else
	{

		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE groups SET gScore=%d WHERE gName='%e'", gScore, gName);
		MySQL_updateQuery(query);

		format(str, sizeof(str), ""SERVER_INITIALS" "GREY_E"You have set %s's group score to %d.", gName, gScore);
		SendClientMessage(playerid, COLOR_GREY, str);


		format(str, sizeof(str), "4Server:3 %s(%i) set %s's group score to %d", pName[playerid], playerid, gName, gScore);
		IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	}
	return 1;
}
