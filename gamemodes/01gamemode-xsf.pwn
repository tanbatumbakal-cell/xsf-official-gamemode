			}
			if(EventGoingOn == 2) {
				EventDialogPlayer = false;
				return Error(playerid, "There is a derby going on now, if you want to force end it, use: /endderby.");
			}
			if(!response) {
				EventDialogPlayer = false;
				KillTimer(EventDialogTimer);
				return true;
