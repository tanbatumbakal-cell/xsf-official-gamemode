		AttachPlayerToys(playerid);
		SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"You have enabled your toys!");
	}
	else
	{
		SetPVarInt(playerid, "toysDisabled", 1);
		RemoveItems(playerid);
		SendClientMessage(playerid, COLOR_RED,""SERVER_INITIALS" "RED_E"You have disabled your toys!");
	}
	return 1;
}

