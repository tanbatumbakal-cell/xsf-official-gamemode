CMD:updates(playerid) return cmd_new(playerid);
CMD:new(playerid)
{
	new dialogstring[2198];
	format(dialogstring, sizeof(dialogstring), "\n\
	"WHITE_E"- Re-added CnR / Deathmatch notices, Players can temporarily disable it using /notices.\n\
	"WHITE_E"- Players will get 2 group score while Robbing/Arresting.\n\
	"WHITE_E"- if there is an IP in a name, the name will not be shown in the deathlog neither on chat.\n\
	"WHITE_E"- Added custom group ranks name (/grankname)\n\
	"WHITE_E"- Added (/delgtag) to permanently hide/delete your group tag.\n\
	"WHITE_E"- Added a damage informer as soon as you shot someone.\n\
	"WHITE_E"- Now you don't need to be near a player in order to /ginvite.\n\
	"WHITE_E"- Now you can't farm time by going ALT+Tabbed.\n\
	"WHITE_E"- You can now ype the answer to the Math quiz in the chat directly.\n\
	"WHITE_E"- Added /DMPlayers that shows you the list of players according to the Deathmatch they are playing.\n\
	"WHITE_E"- Group leaders can't kick/demote/okick the Group Founder/Owner.\n\
	"WHITE_E"- Added /PMSound, which can simply prevent from hearing the PM Notification sound.\n\
	"WHITE_E"- Added /TogAnn, by which you'll no longer see any Announcement (by admins)\n\
	"WHITE_E"- Added /toghcolors to enable/disable old helper chat colors.\n\
	"WHITE_E"- Now you can't use any animation in Skydives/Parkour/Hayclimb.\n\
	"WHITE_E"- Now you can't use /para in Hayclimb/Parkour.\n\
	"WHITE_E"- Added custom spawn place, To set one use /Spawnplace > Custom Spawn\n\
	"WHITE_E"* Added /chstats (Challenge Statistics) for the list of All Personal Challenges Statistics.\n\
	"WHITE_E"* \n\
	"WHITE_E"* Fixed many typos.\n\
	"WHITE_E"- Fixed a critical bug of /settempname.\n\
	"WHITE_E"- Fixed a bug where /togtag was not getting saved.\n\
	"WHITE_E"- Fixed vehicle collision problem.\n\
	"WHITE_E"- Fixed a bug in /race, Where if you click on Special Vehicles your dialog get canceled.\n\
	"WHITE_E"- Fixed a bug in /skydive, Whenever you finish it you are teleported to some random location with a parachute.\n\
	"WHITE_E"- Thanks to Altair, Naranja, Akira, Nerve, Chris, Lilkapaa, and d00m for existing. Oh sec - someone named altair too? hmm\n\
	"RED_E"NOTE: Check forum to view the full list of updates");

	ShowPlayerDialog(playerid, 369, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "WHITE_E"Build "BUILD"",dialogstring ,"Exit", "");

	return true;
}

CMD:hidetds(playerid, params[])
{
	if(pAdmin[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params)) return Usage(playerid, "/hidetds <playerid>");
	if(!IsPlayerConnected(strval(params))) return Error(playerid, "Invalid playerid.");
	new id = strval(params);
	new countt = 0;
	for (new i = 0; i < MAX_TEXT_DRAWS; i++)
	{
		if(Text:i != Text:0xFFFF)
		{
			TextDrawHideForPlayer(id, Text:i);
			PlayerTextDrawHide(id, PlayerText:i);
			countt++;
		}
	}
	format(str, sizeof(str), ""RED_E"*%d textdraws has been successfully hidden for %s (Id: %d).", countt, pName[id], id);
	SendClientMessage(playerid, -1, str);
	return 1;
}

CMD:hgchat(playerid, params[])
{
	if(GetPVarInt(playerid, "ParticipatingHG") == 0) return Error(playerid, "You are not authorized to use this command!");

	if(isnull(params))
	{
		Usage(playerid, "/hgchat <text>");
		return true;
	}

	// Decide about multi-line msgs
	new i = -1;
	if(strlen(params) > 70)
	{
		i = strfind(params, " ", false, 60);
		if(i > 80 || i == -1) i = 70;

		// store the second line text
		line = " ";
		strcat(line, params[i]);

		// delete the rest from msg
		params[i] = EOS;
	}

	format(str, sizeof(str), ""RED_E"[HG Chat] "WHITEP_E"%s(%i): "LB_E"%s", pName[playerid], playerid, params);
	foreach(new ii : Player) if(GetPVarInt(ii, "ParticipatingHG")) SendClientMessage(ii, COLOR_LB, str);
	if(i != -1) foreach(new ii : Player) if(GetPVarInt(ii, "ParticipatingHG")) SendClientMessage(ii, COLOR_LB, line);
	format(str, sizeof(str), "2[HG Chat]3 %s(%i): 2%s", pName[playerid], playerid, params);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	if(i != -1) IRC_GroupSay(ircGroup, IRC_CHANNEL, line);
	return true;
}

function HappyHour()
{
	if(IsHappyHour)
	{
		SendClientMessageToAll(-1, ""SERVER_INITIALS" "GREY_E"Happy Hour mode is on! Have fun with +50% of what you earn of score & cash.");
		return 1;
	}
	return 1;
}


