CMD:oldtimes22(playerid, params[]) return MySQL_query("SELECT * FROM `racetimes` ORDER BY `Time` DESC", true, "OnRaceDataQuery", "i", playerid);

forward OnRaceDataQuery(playerid);
public OnRaceDataQuery(playerid)
{
	if(!MySQL_rowCount())
	{
		SendClientMessage(playerid, -1, ""SERVER_INITIALS" "RED_E"There is no records declared at the moment.");
		return true;
	}

	new string[3000];
	new rows = MySQL_rowCount();
	for(new i = 0; rows > i; i++)
	{
		if(i == 10) break;

		new
			times,
			date,
			y, d, m, h, time_min, s,
			time,
			race[51]
		;

		times =cache_get_field_content_int(i, "ms"); //ms
		date = cache_get_field_content_int(i, "time"); //time
		cache_get_field_content(i, "race", race); //race
		cache_get_field_content(i, "holder", tmp); //name

		while(times > 59)
		{
			times -= 60;
			time++;
		}

		TimestampToDate(date, y, m, d, h, time_min, s, 0);
		format(string, sizeof(string), "%s%s\t%s\t%01d:%01d\t%02d-%02d-%02d %02d:%02d:%02d\n", string, tmp, race, time, times, y, m, d, h, time_min, s);
	}
	format(string, sizeof(string), "Name\tRace\tTime\tDate\n%s", string);
	ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_TABLIST_HEADERS, ""RED_E"server: "WHITE_E"Race Records", string, "OK", "");
	return true;
}

IsLeapYear(time_year)
{
	if(time_year % 4 == 0) return 1;
	else return 0;
}

TimestampToDate(Timestamp, &time_year, &time_month, &time_day, &time_hour, &time_minute, &time_second, HourGMT, MinuteGMT = 0)
{
	new time_tmp = 2;
	time_year = 1970;
	time_month = 1;
	Timestamp -= 172800; // Delete two days from the current timestamp. This is necessary, because the timestamp retrieved using gettime() includes two too many days.
	for(;;)
	{
		if(Timestamp >= 31536000)
		{
				time_year++;
				Timestamp -= 31536000;
				time_tmp++;
				if(time_tmp == 4)
				{
						if(Timestamp >= 31622400)
						{
								time_tmp = 0;
								time_year ++;
								Timestamp -= 31622400;
						}
						else break;
				}
		}
		else break;
	}
	for(new i = 0; i < 12; i ++)
	{
		if(Timestamp >= MonthTimes[i][2 + IsLeapYear(time_year)])
		{
            time_month ++;
            Timestamp -= MonthTimes[i][2 + IsLeapYear(time_year)];
		}
		else break;
	}
	time_day = 1 + (Timestamp / 86400);
	Timestamp %= 86400;
	time_hour = HourGMT + (Timestamp / 3600);
	Timestamp %= 3600;
	time_minute = MinuteGMT + (Timestamp / 60);
	time_second = (Timestamp % 60);
	if(time_minute > 59)
	{
		time_minute = 0;
		time_hour ++;
	}
	if(time_hour > 23)
	{
		time_hour -= 24;
		time_day ++;
	}
	if(time_day > MonthTimes[time_month][IsLeapYear(time_year)])
	{
		time_day = 1;
		time_month ++;
	}
	if(time_month > 12)
	{
		time_month = 1;
		time_year ++;
    }
    return 1;
}

/*
#define DIALOG_SPECIAL_SKINS 3456
CMD:specialskins(playerid)
