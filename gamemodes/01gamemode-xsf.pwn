MySQL_CreatePlayerToy(playerid)
{
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `toys` (`Name`) VALUES ('%e');", pName[playerid]);
	MySQL_updateQuery(query);
	PurchasedToy[playerid] = true;

	for(new i = 0; i < 6; i++)
	{
		pToys[playerid][i][toy_model] = 0;
		pToys[playerid][i][toy_bone] = 1;
		pToys[playerid][i][toy_x] = 0.0;
		pToys[playerid][i][toy_y] = 0.0;
		pToys[playerid][i][toy_z] = 0.0;
		pToys[playerid][i][toy_rx] = 0.0;
		pToys[playerid][i][toy_ry] = 0.0;
		pToys[playerid][i][toy_rz] = 0.0;
		pToys[playerid][i][toy_sx] = 1.0;
		pToys[playerid][i][toy_sy] = 1.0;
		pToys[playerid][i][toy_sz] = 1.0;
	}
}

AttachPlayerToys(playerid)
{
	if(!PurchasedToy[playerid]) return true;

	for(new i = 0; i < 6; i++)
	{
		if(pToys[playerid][i][toy_model] != 0)
		{
			SetPlayerAttachedObject(playerid,
				i,
				pToys[playerid][i][toy_model],
				pToys[playerid][i][toy_bone],
				pToys[playerid][i][toy_x],
				pToys[playerid][i][toy_y],
				pToys[playerid][i][toy_z],
				pToys[playerid][i][toy_rx],
				pToys[playerid][i][toy_ry],
				pToys[playerid][i][toy_rz],
				pToys[playerid][i][toy_sx],
				pToys[playerid][i][toy_sy],
				pToys[playerid][i][toy_sz]);
		}
	}
	return true;
}
SavePlayerChallengeStats(playerid)
{
	format(query, sizeof(query), "SELECT * FROM `ChallengeStats` WHERE Name='%e'", GetName(playerid));
 	mysql_query(g_SQL_handle, query);
	if(!cache_num_rows())
	{
		mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO ChallengeStats (Name) VALUES ('%e')",GetName(playerid));
		MySQL_updateQuery(query);
	}
	new savestr[300] , savestr2[1000];
	format(savestr,sizeof(savestr),"UPDATE `ChallengeStats` SET HayclimbChallenge = %d, ParkourChallenge = %d, MonsterChallenge = %d," , HayclimbChallenge[playerid] , ParkourChallenge[playerid] , MonsterChallenge[playerid]);
	strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"QuadChallenge = %d,Bike1Challenge = %d,Skydive1Challenge = %d,Skydive2Challenge = %d,BMXChallenge = %d,Skydive3Challenge = %d,MultiPChallenge = %d," , QuadChallenge[playerid],Bike1Challenge[playerid],Skydive1Challenge[playerid],Skydive2Challenge[playerid],BMXChallenge[playerid],Skydive3Challenge[playerid],MultiPChallenge[playerid]);
	strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"BP1Challenge = %d,BP2Challenge = %d,BP3Challenge = %d,BP4Challenge = %d,Parkour2Challenge = %d,BC2Challenge = %d,Parkour3Challenge = %d,Skydive4Challenge = %d,Hayclimb2Challenge = %d,Hayclimb3Challenge = %d,BP5Challenge = %d,",BP1Challenge[playerid] , BP2Challenge[playerid] , BP3Challenge[playerid] , BP4Challenge[playerid] , Parkour2Challenge[playerid] , BC2Challenge[playerid] , Parkour3Challenge[playerid] , Skydive4Challenge[playerid] , Hayclimb2Challenge[playerid] , Hayclimb3Challenge[playerid] , BP5Challenge[playerid]);
    strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"BP6Challenge = %d,BP7Challenge = %d,Hayclimb4Challenge = %d,Quad2Challenge = %d,BP8Challenge = %d,Hayclimb5Challenge = %d,Hayclimb6Challenge = %d,Hayclimb7Challenge = %d, SanchezChallenge = %d," , BP6Challenge[playerid] , BP7Challenge[playerid] , Hayclimb4Challenge[playerid] , Quad2Challenge[playerid] , BP8Challenge[playerid] , Hayclimb5Challenge[playerid] , Hayclimb6Challenge[playerid] , Hayclimb7Challenge[playerid] , SanchezChallenge[playerid]);\
	strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"Sanchez2Challenge = %d, BC3Challenge = %d,Parkour4Challenge = %d,Skydive5Challenge = %d, Parkour5Challenge = %d,Skydive6Challenge = %d," , Sanchez2Challenge[playerid] , BC3Challenge[playerid] , Parkour4Challenge[playerid] , Skydive5Challenge[playerid] , Parkour5Challenge[playerid] , Skydive6Challenge[playerid]);
	strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"Parkour6Challenge = %d,Parkour7Challenge = %d,BP9Challenge = %d,BC4Challenge = %d,Parkour8Challenge = %d,BP10Challenge = %d,Quad3Challenge = %d,Hayclimb8Challenge = %d,Sanchez3Challenge = %d,Skydive7Challenge = %d,MC2Challenge = %d,");
    strcat(savestr2,savestr);
	format(savestr,sizeof(savestr),"BC5Challenge = %d WHERE `Name` = '%e'" , BC5Challenge[playerid] , GetName(playerid));
 	strcat(savestr2,savestr);
 	MySQL_updateQuery(savestr2);
}
