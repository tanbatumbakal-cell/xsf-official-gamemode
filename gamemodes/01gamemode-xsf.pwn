//========================================================[COMMANDS]=====================================================================]
CMD:placemusicbox(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this function!");
	if(GetPVarType(playerid, "Music")) return Error(playerid,"You've already placed a Musicbox!");
	foreach(new i : Player)
	{
 		if(GetPVarType(i, "Music"))
   		{
  			if(IsPlayerInRangeOfPoint(playerid, 30.0, GetPVarFloat(i, "MusicX"), GetPVarFloat(i, "MusicY"), GetPVarFloat(i, "MusicZ")))
			{
   				return Error(playerid,"You cannot place Musicbox closer to another!");

			}
		}
	}
 	new Float:x, Float:y, Float:z, Float:a;
 	GetPlayerPos(playerid, x, y, z);
 	GetPlayerFacingAngle(playerid, a);
 	ApplyAnimation(playerid,"BOMBER","BOM_Plant_Crouch_In", 4.0, 0, 0, 0, 0, 0, 1);
 	x += (2 * floatsin(-a, degrees));
	y += (2 * floatcos(-a, degrees));
	z -= 1.0;
	new string[128];
	SetPVarInt(playerid, "Music", CreateDynamicObject(2232, x, y, z+0.5, 0.0, 0.0, 0.0, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
	SetPVarFloat(playerid, "MusicX", x); SetPVarFloat(playerid, "MusicY", y); SetPVarFloat(playerid, "MusicZ", z);
	format(string, sizeof(string), ""ORANGE_E"Musicbox Owner:{FFFFFF} %s\n"ORANGE_E"Currently Playing: {FFFFFF}None", GetName(playerid));
	SetPVarInt(playerid, "MusicLabel", _:CreateDynamic3DTextLabel(string, COLOR_WHITE, x, y, z+0.8, 5.0, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "MusicArea", CreateDynamicSphere(x, y, z, 30.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "MusicInt", GetPlayerInterior(playerid));
	SetPVarInt(playerid, "MusicVW", GetPlayerVirtualWorld(playerid));
 	if(GetPVarType(playerid, "MusicArea"))
 	{
		format(string, sizeof(string), ""SERVER_INITIALS" %s has placed a Musicbox!", GetName(playerid));
		foreach(new i : Player)
		{
  			if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "MusicArea")))
  			{
				SendClientMessage(i,-1,string);
			}
		}
	}
	return 1;
}

CMD:musicbox(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this function!");
	if(GetPVarType(playerid, "Music"))
	{
		ShowPlayerDialog(playerid,DIALOG_MUSICBOX,DIALOG_STYLE_LIST,""LB_E"Music Box","Input a MP3 Link\nPickup Musicbox\nTurn Off","Select", "Cancel");
    }
    else return Error(playerid, "You don't have a Musicbox placed, use /Placemusicbox!");
	return 1;
}
CMD:pickupmusicbox(playerid, params[])
{
	if(pAdmin[playerid] < 3)
		return Error(playerid, "You are not authorized to use this function!");
	if(GetPVarType(playerid, "Music"))
	{
	    DestroyDynamicObject(GetPVarInt(playerid, "Music"));
	    DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "MusicLabel"));
	    DeletePVar(playerid, "Music"); DeletePVar(playerid, "MusicStation"); DeletePVar(playerid, "MusicLabel");
	    DeletePVar(playerid, "MusicX"); DeletePVar(playerid, "MusicY"); DeletePVar(playerid, "MusicZ");
	    if(GetPVarType(playerid, "MusicArea"))
	    {
	        new string[128];
			format(string, sizeof(string), ""SERVER_INITIALS" %s has picked up his Musicbox.", GetName(playerid));
	        foreach(new i : Player)
			{
	            if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "MusicArea")))
	            {
	                StopAudioEx(i);
	                SendClientMessage(i, COLOR_PURPLE, string);
				}
			}
	        DeletePVar(playerid, "MusicArea");
		}
		SendClientMessage(playerid, COLOR_WHITE, ""SERVER_INITIALS"You've picked up your Musicbox!");
	}
	else
	{
	    foreach(new i : Player)
		{
	        if(GetPVarType(i, "Music"))
	        {
				if(GetPVarInt(i, "MusicVW") == GetPlayerVirtualWorld(playerid) && GetPVarInt(i, "MusicInt") == GetPlayerInterior(playerid) && IsPlayerInRangeOfPoint(playerid, 5.0, GetPVarFloat(i, "MusicX"), GetPVarFloat(i, "MusicY"), GetPVarFloat(i, "MusicZ")))
				{
					DestroyDynamicObject(GetPVarInt(i, "Music"));
				    DestroyDynamic3DTextLabel(Text3D:GetPVarInt(i, "MusicLabel"));

				    DeletePVar(i, "Music");
					DeletePVar(i, "MusicStation");
					DeletePVar(i, "MusicLabel");
				    DeletePVar(i, "MusicX");
					DeletePVar(i, "MusicY");
					DeletePVar(i, "MusicZ");
					DeletePVar(i, "MusicInt");
					DeletePVar(i, "MusicVW");

				    new string[128];
				    if(GetPVarType(i, "MusicArea"))
				    {
				        for(new x=0; x<MAX_PLAYERS; x++)
						{
				            if(IsPlayerInDynamicArea(x, GetPVarInt(x, "MusicArea")))
				            {
				                StopAudioEx(x);
				                SendClientMessage(x, COLOR_PURPLE, string);
							}
						}
				        DeletePVar(i, "MusicArea");
					}
					return 1;
				}
			}
	    }
	    SendClientMessage(playerid, COLOR_WHITE, ""SERVER_INITIALS"You don't have a Musicbox or you are not near one to be pickup");
	}
	return 1;
}


CMD:notices(playerid)
{
	if(!pSpawned[playerid]) return Error(playerid, "You can't use this command while being in spectate mode/not spawned.");
	if(MessagesNotices[playerid])
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have disabled DM, CNR, LMS notifications.");
		MessagesNotices[playerid] = false;
	}
	else
	{
		SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have enabled DM, CNR, LMS notifications.");
		MessagesNotices[playerid] = true;
	}
	return 1;
}

CMD:ipinfo(playerid, params[])
{
	if(pAdmin[playerid] < 1)
		return Error(playerid, "You are not authorized to use this command!");


	if(sscanf(params, "k<player_name>",otherid ))
	{
		Usage(playerid, "/ipinfo <username/id>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID || !IsPlayerConnected(otherid))
    return SendClientMessage(playerid, COLOR_RED, "This player is not connected");

    new country[50],isps[128];
    GetPlayerCountry(otherid,country);

    GetPlayerCity(otherid,isps);
	format(str, sizeof(str), "Server: "WHITE_E"%s is from "ORANGE_E"%s"WHITE_E" and their ISP is "ORANGE_E"%s",pName[otherid],country,isps);
	SendClientMessage(playerid, COLOR_RED, str);
	return true;
}


CMD:blockadip(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	new ipadr[24];
	if(sscanf(params, "s[24]",ipadr ))
	{
		Usage(playerid, "/blockadip <ip address>");
		return true;
	}
	mysql_format(g_SQL_handle, query, sizeof(query), "INSERT INTO `BlackListedIPs`(`ip`) VALUES ('%e')", ipadr);
	MySQL_updateQuery(query);

	loadAntiAdvertise();
	SendClientMessage(playerid, COLOR_RED, "Ip address added to the blacklist!");
	return true;
}

CMD:unblockadip(playerid, params[]) {
	if(pAdmin[playerid] < 5)
	return Error(playerid, "You are not authorized to use this command!");

	new ipadr[24];
	if(sscanf(params, "s[24]",ipadr ))
	{
		Usage(playerid, "/unblockadip <ip address>");
		return true;
	}
	mysql_format(g_SQL_handle, query, sizeof(query), "DELETE FROM BlackListedIPs WHERE ip = '%e'", ipadr);
	MySQL_updateQuery(query);

	loadAntiAdvertise();
	SendClientMessage(playerid, COLOR_RED, "Ip removed from the blacklist!");
	return true;
}
CMD:commands(playerid) return cmd_cmds(playerid);
CMD:c(playerid) return cmd_cmds(playerid);
CMD:cmd(playerid) return cmd_cmds(playerid);
CMD:cmds(playerid)
{
	ShowPlayerDialog(playerid, 222, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Commands", ""dot"Player Commands\t"DARK_E"(/pcmds)\n"dot"Vehicle Commands\t"DARK_E"(/vcmds)\n"dot"Group Commands\t"DARK_E"(/gcmds)\n"dot"Premium Commands\t"DARK_E"(/premium)\n"dot"Teleports\t\t"DARK_E"(/teles)", "Select", "Exit");
	return true;
}
CMD:buyhouse(playerid)// Purchase House
{
	if(IsInHouse{playerid} == 0) return ShowInfoBoxEx(playerid, COLOR_SYSTEM, E_NOT_IN_HOUSE);

	new h = GetPVarInt(playerid, "LastHouseCP");
	if(hInfo[h][HouseForSale] == 0) return ShowInfoBoxEx(playerid, COLOR_SYSTEM, "This house is not for sale!");
	if(pCash[playerid] < hInfo[h][HouseForSale]) return Error(playerid, "You don't have enough money to purchase this house!");

	if(pAdmin[playerid] != 6)
	{
		if(pPremium[playerid] >= 2)
		{
			if(GetPVarInt(playerid, "tempPremium") == 1 || premiumExpired[playerid] != 0)
			{
				if(GetOwnedHouses(playerid) >= MAX_HOUSES_OWNED)
				{
					Error(playerid, "You can't purchase more than 1 house with temporary premium!");
					return 1;
				}
			}
			if(pPremium[playerid] != 3)
			{
				if(GetOwnedHouses(playerid) >= 2)
				{
					ShowInfoBox(playerid, E_MAX_HOUSES_OWNED, 2);
					return 1;
				}
			}
			else if(GetOwnedHouses(playerid) >= 3)
			{
				ShowInfoBox(playerid, E_MAX_HOUSES_OWNED, 3);
				return 1;
			}
		}
		else
		{
			if(GetOwnedHouses(playerid) >= MAX_HOUSES_OWNED)
			{
				ShowInfoBox(playerid, E_MAX_HOUSES_OWNED, MAX_HOUSES_OWNED);
				return 1;
			}
		}
	}

	format(tmp, sizeof(tmp), ""WHITEP_E"Are you sure you want to buy this house for "GREEN_E"$"WHITE_E"%s?",ToCurrency(hInfo[h][HouseForSale]));
	ShowPlayerDialog(playerid, HOUSEMENU+52, DIALOG_STYLE_MSGBOX, ""GREEN_E"Buy House", tmp, "Buy", "Cancel");
	return 1;
}

CMD:snow(playerid) // xMAS
{
	if(!snowOn[playerid]) {
		CreateSnow(playerid);
		SendClientMessage(playerid, COLOR_WHITE, ""SERVER_INITIALS" "WHITE_E"Let it snow, let it snow, let it snow!");
	}
	else {
		DeleteSnow(playerid);
		SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "RED_E"You stopped the snow.");
	}
	return 1;
}


function RichestPlayer()
{
	format(query, sizeof(query), "SELECT name,money,bmoney FROM players WHERE reg_id ORDER BY money DESC LIMIT 1;");
	MySQL_query(query, true, "ShowRichestPlayer", "", "");
	return true;
}
function ShowRichestPlayer()
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new playername[24];
		new playercash, playerbcash;

		cache_get_field_content(0,"name", playername);
		playercash  = cache_get_field_content_int(0, "money");
		playerbcash  = cache_get_field_content_int(0, "bmoney");

		new ptotalCash = playercash + playerbcash;
		if(ptotalCash > 1900000000)
		{
			format(str, sizeof(str), "Most wealthiest player on the server is %s with "LG_E"$"WHITE_E"2,000,000,000+!", playername);
		}
		else format(str, sizeof(str), "Most wealthiest player on the server is %s with "LG_E"$"WHITE_E"%s!", playername, ToCurrency(ptotalCash));
		SendBotMsg(str);
	}
	return 1;
}
