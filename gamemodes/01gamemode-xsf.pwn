function TopCookies()
{
	format(query, sizeof(query), "SELECT name,cookies FROM players WHERE reg_id ORDER BY cookies DESC LIMIT 1;");
	MySQL_query(query, true, "ShowTopCookies", "", "");
	return true;
}
function ShowTopCookies()
{
	new rows = MySQL_rowCount();
	if(rows)
	{
		new playername[24];
		new playercookies;

		cache_get_field_content(0,"name", playername);
		playercookies  = cache_get_field_content_int(0, "cookies");

		format(str, sizeof(str), ""WHITEP_E"%s "WHITE_E"has the most cookies on the server with %d cookies!", playername, playercookies);
		SendBotMsg(str);
	}
	return 1;
}


