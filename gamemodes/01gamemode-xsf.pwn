				switch(random(6))
				{
					case 0: SetPlayerPosition(playerid, -3885.0474,-1821.1643,6.0326,229.0381);
					case 1: SetPlayerPosition(playerid, -3805.0457,-1996.5420,7.0384,0.7233);
					case 2: SetPlayerPosition(playerid, -3820.9314,-1947.9642,6.4922,14.6439);
					case 3: SetPlayerPosition(playerid, -3851.8311,-1910.5450,5.3357,220.4583);
					case 4: SetPlayerPosition(playerid, -3902.4136,-1946.0337,19.8012,84.7973);
					case 5: SetPlayerPosition(playerid, -3934.0161,-1958.4374,36.0812,54.9787);
					case 6: SetPlayerPosition(playerid, -3886.4236,-1897.3579,36.9600,232.9351);
				}
				if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				TogglePlayerControllable(playerid, false);
				SetTimerEx("unfreezePlayer", 2000, false, "i", playerid);
				InDM[playerid] = 21;
				GivePlayerWeapon(playerid, 3, 1);
				GivePlayerWeapon(playerid, 24, 9999);
				GivePlayerWeapon(playerid, 25, 9999);
				GivePlayerWeapon(playerid, 28, 9999);
				GivePlayerWeapon(playerid, 30, 9999);
				GivePlayerWeapon(playerid, 33, 9999);
				GivePlayerWeapon(playerid, 39, 2);
				GivePlayerWeapon(playerid, 17, 10);
				GivePlayerWeapon(playerid, 10, 1);
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in Castle DM.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /leave to exit the deathmatch.");
			}
			case 50: //deagle sniper shotgun dm
			{

				switch(random(6))
				{
					case 0: SetPlayerPosition(playerid, 197.2191, 168.4493, 1003.0234, 269.4380);
					case 1: SetPlayerPosition(playerid, 229.5185, 182.0526, 1003.0313, 132.5100);
					case 2: SetPlayerPosition(playerid, 231.2098, 142.4823, 1003.0234, 319.5483);
					case 3: SetPlayerPosition(playerid, 288.3676, 169.2407, 1007.1719, 21.2755);
					case 4: SetPlayerPosition(playerid, 210.4103, 142.1617, 1003.0234, 269.3911);
					case 5: SetPlayerPosition(playerid, 213.6087, 174.1557, 1003.0234, 182.5971);
				}
				if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				SetPlayerVirtualWorld(playerid, 285721);
				SetPlayerInterior(playerid, 3);
				InDM[playerid] = 50;
				GivePlayerWeapon(playerid, 24, 9999);
				GivePlayerWeapon(playerid, 25, 9999);
				GivePlayerWeapon(playerid, 34, 9999);
				SetPlayerHealth(playerid, 97);


				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in DSS DM.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /leave to exit the deathmatch.");

			}
			case 800: // SniperDM2
			{
				RemoveItems(playerid);
				switch(random(5))
				{
					case 0: SetPlayerPosition(playerid, -1472.2592,429.7998,46.1251,177.0982);
					case 1: SetPlayerPosition(playerid, -1463.6813,375.0258,30.0859,355.4099);
					case 2: SetPlayerPosition(playerid, -1364.2543,428.6967,46.1251,89.3874);
					case 3: SetPlayerPosition(playerid, -1361.5446,352.2527,46.1251,83.7475);
					case 4: SetPlayerPosition(playerid, -1413.1674,346.3238,30.0820,354.7834);
				}
                if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				GivePlayerWeapon(playerid, 34, 9999);
				SetPlayerVirtualWorld(playerid, 87463);
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in Sniper DM2.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /leave to exit the deathmatch.");
			}
			case SawnDM::ID: //deagle sniper shotgun dm
			{
				new randIdx = random(sizeof SawnDM::spawns);
                if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				#define s[%0] __sdm_spawns[randIdx][%0]
				SetPlayerPosition(playerid, s[spawnX], s[spawnY], s[spawnZ], s[spawnA]);
				#undef s

				InDM[playerid] = SawnDM::ID;

				SetPlayerInterior(playerid, SawnDM::INTERIOR);
				GivePlayerWeapon(playerid, 26, 9999);
				SetPlayerHealth(playerid, 97);
				SetPlayerVirtualWorld(playerid, SawnDM::VIRTUAL_WORLD);

				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in the Sawnoff DM.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /exit to leave the deathmatch.");
			}
			case DeagleDM::ID: //deagle sniper shotgun dm
			{
			    if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
				new randIdx = random(sizeof DeagleDM::spawns);
				#define s[%0] __ddm_spawns[randIdx][%0]
				SetPlayerPosition(playerid, s[spawnX], s[spawnY], s[spawnZ], s[spawnA]);
				#undef s
				SetPlayerInterior(playerid, DeagleDM::INTERIOR);
				SetPlayerVirtualWorld(playerid, DeagleDM::VIRTUAL_WORLD);

				//Give them only a deagle, set their health and virtual world
				GivePlayerWeapon(playerid, 24, 9999);
				SetPlayerHealth(playerid, 97);


				//Make sure we know that they're here!
				InDM[playerid] = DeagleDM::ID;

				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "RED_E"You have respawned in the Deagle DM.");
				SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY2_E"Type /exit to leave the deathmatch.");
			}
		}
		if(pSpectating[playerid] != -1)
		{
			pSpectating[playerid] = -1;
			LoadPlayerPositionEx(playerid);
			SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"You have been put back to your old position.");
		}
		return true;
}

RemovePlayerFromDM(playerid)
{
	if(eInfo[playerid][inPUBG] == 1)
	{
		return cmd_leavepubg(playerid,"");
	}
	CheckDM(playerid);
	if(InDM[playerid] == 13)
	{
		SetPlayerSkin(playerid, GetPVarInt(playerid, "dSkin"));
		if(pColor[playerid] != 0)
		{
			SetPlayerColor(playerid, GetPVarInt(playerid, "oldColor"));
		}
		else SetPlayerColor(playerid, PlayerColors[playerid]);
		pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
		RemoveItems(playerid);
		DeletePVar(playerid, "Cop");
		DeletePVar(playerid, "Robber");
		DeletePVar(playerid, "InStore");
		SetPlayerTeam(playerid, 255);
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
		TextDrawHideForPlayer(playerid, cnrTD);
		TextDrawHideForPlayer(playerid, cnrTD2);
		//TextDrawShowForPlayer(playerid, TeleTD);
		TextDrawShowForPlayer(playerid, Server_TD[0]);
		TextDrawShowForPlayer(playerid, Server_TD[1]);
		TextDrawShowForPlayer(playerid, Server_TD[2]);
		TextDrawShowForPlayer(playerid, Server_TD[3]);
		TextDrawShowForPlayer(playerid, Server_TD[4]);
		TextDrawShowForPlayer(playerid, Server_TD[5]);
		TextDrawShowForPlayer(playerid, Server_TD[6]);
		TextDrawShowForPlayer(playerid, SEv2Box);



		//TextDrawShowForPlayer(playerid, SEv2TD4);
		if(RobberyCount[playerid] != 0)
		{
			KillTimer(RobberyTimer[playerid]);
			GameTextForPlayer(playerid, " ", 1000, 3);
			RemovePlayerAttachedObject(playerid, 8);
			RobberyCount[playerid] = 0;
		}
	}
	else if(InDM[playerid] == SawnDM::ID)
	{
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	}
	else if(GetPVarInt(playerid, "inTDM") != 0)
	{
		SetPlayerSkin(playerid, GetPVarInt(playerid, "dSkin"));
		if(pColor[playerid] != 0)
		{
			SetPlayerColor(playerid, GetPVarInt(playerid, "oldColor"));
		}
		else SetPlayerColor(playerid, PlayerColors[playerid]);
		pColor[playerid] = StripAlpha(GetPlayerColor(playerid));
		DeletePVar(playerid, "inTDM");
		SetPlayerTeam(playerid, 255);
		/*if(GetPVarInt(playerid, "RedTeam") == 1) RedCount--;
		else if(GetPVarInt(playerid, "BlueTeam") == 1) BlueCount--;*/
		DeletePVar(playerid, "BlueTeam"), DeletePVar(playerid, "BlueTeam2");
		DeletePVar(playerid, "RedTeam"), DeletePVar(playerid, "RedTeam2");
	}

	ResetPlayerWeapons(playerid);
	SetPlayerHealth(playerid, 98);
	SetPlayerArmour(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0); //this little thing will help with AFK'ers
	if(IsPlayerInAnyVehicle(playerid))
		RemovePlayerFromVehicle(playerid);
	SetPlayerWorldBounds(playerid, 20000.0, -20000.0, 20000.0, -20000.0);
	SetPlayerWantedLevel(playerid, 0);
	InDM[playerid] = 0;

	if(GetPVarInt(playerid, "toysDisabled") != 1)
	{
	    AttachPlayerToys(playerid); // Attach player Toys.
	}

	DeletePVar(playerid, "BFWeaps");
	canUseKey[playerid] = true;
	GodModeLabel(playerid, true);
	ShowPlayerMSGBox(playerid);
	UpdateDMText();
	if(GetPVarInt(playerid, "HadGod") == 1)
	{
		GOD[playerid] = 1;
		SetPlayerHealth(playerid, 9999);
		if(GetPVarInt(playerid, "TDDisabled")) TextDrawShowForPlayer(playerid, godTD);
		if(god3D[playerid] == Text3D:-1) god3D[playerid] = CreateDynamic3DTextLabel("Godmode {41FF00}ON", 0xFFFF8288, 0, 0, 0.42, 16.0, playerid, INVALID_VEHICLE_ID, 1);
		if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour")) SetPlayerArmour(playerid, 97);
	}
	else
	{
		InfoTD_MSG(playerid, 4000, "~y~~h~You have ~r~disabled ~y~~h~godmode!");
		SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "GREY_E"You have disabled god-mode. You can now lose health in stunt zones.");
		SendClientMessage(playerid, COLOR_RED, "> "YELLOW_E"You can now freely use weapons.");
		GOD[playerid] = 0;
		SetPlayerHealth(playerid, 98);
		TextDrawHideForPlayer(playerid, godTD);
		if(doingStunt[playerid] == 0)
		{
			GiveSpawnWeapons(playerid);
		}
		DestroyDynamic3DTextLabel(god3D[playerid]);
		god3D[playerid] = Text3D:-1;
		
	}
	return 1;
}

RemovePlayerFromEvent(playerid)
{
	if(InDerby[playerid] >= 1)
	{
		OnPlayerExitVehicle(playerid, GetPlayerVehicleID(playerid));
		DeletePVar(playerid, "DerbyVeh");
		SetTimer("EndDerbyCheck", 2000, 0);
		DerbyPlayers--;
		InDerby[playerid] = 0;
	}
	else if(InEvent[playerid] >= 1 && InDerby[playerid] == 0)
	{
		SetTimer("EndEventCheck", 2000, 0);
		NumEventPlayers--;
		killStreak[playerid]=0;//KSreset
	}
	GameTextForPlayer(playerid, " ", 500, 6);
	TextDrawHideForPlayer(playerid, raceCT);
	TogglePlayerControllable(playerid, 1);
	doingStunt[playerid] = 0;
	InEvent[playerid] = 0;
	InDM[playerid] = 0;
	canUseKey[playerid] = true;
	ResetPlayerWeapons(playerid);
	LoadPlayerPosition(playerid);
	if(CSEvent) SetPlayerColor(playerid, GetPVarInt(playerid, "oldColor"));
}

IsBikeModel(modelid)
{
	switch(modelid)
	{
		case 581, 509, 481, 462, 521, 463, 510, 522, 461, 448, 471, 468, 586: return true;
	}
	return false;
}

IsValidName(const name[])
{
	new len = strlen(name);

	for(new ch = 0; ch != len; ch++)
	{
		switch(name[ch])
		{
			case 'A' .. 'Z', 'a' .. 'z', '0' .. '9', ']', '[', '(', ')', '_', '.': continue;
			default: return false;
		}
	}
	return true;
}
/*
IsValidPassword(const name[])
{
	new len = strlen(name);

	for(new ch = 0; ch != len; ch++)
	{
		switch(name[ch])
		{
			case 'A' .. 'Z', 'a' .. 'z', '0' .. '9', ']', '[', '(', ')', '_', '.', '@', '#', '-': continue;
			default: return false;
		}
	}
	return true;
}*/
IsValidChar(const name[])
{
	new len = strlen(name);

	for(new ch = 0; ch != len; ch++)
	{
		switch(name[ch])
		{
			case 'A' .. 'Z', 'a' .. 'z', '0' .. '9', ']', '[', '(', ')', '_', '.', '@', '#', ' ', '-': continue;
			default: return false;
		}
	}
	return true;
}

GetPlayerAdminLevelName(playerid)
{
	new lvlstr[25];
	switch(pAdmin[playerid])
	{
		case 0:
		{
			if(pPremium[playerid] != 0)
			{
				if(pPremium[playerid] == 3) lvlstr = "VIP member";
				else
				lvlstr = "Premium Member";
			}
			else lvlstr = "Regular Player";
		}
  		case 1..3: lvlstr = "Admin";
		case 4: lvlstr = "Lead Admin";
		case 5: lvlstr = "Manager";
		case 6: lvlstr = "Owner";
	}
	return lvlstr;
}


