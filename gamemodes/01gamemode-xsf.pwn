stock GetHGPlayers() {
	new playersX = 0;
	foreach(new i : Player) {
	    if(GetPVarInt(i, "ParticipatingHG") == 1) {
	        playersX++;
		 }
	}
	return playersX;
}

#define FOOTER_ITEM_COUNT 13

enum modconfig {
	modName[10],
	modPlayers
}

new modesValues[FOOTER_ITEM_COUNT][modconfig] =
{
	{"CNR"},
	{"HG"},
	{"DERBY"},
	{"FALLOUT"},
	{"BF"},
	{"WAR"},
	{"TDM"},
	{"FDM"},
	{"MINI"},
	{"ODM"},
	{"DSS"},
	{"DDM"},
	{"SDM"}
};

UpdateDMText()
{

    modesValues[0][modPlayers] = CnR;
    modesValues[1][modPlayers] = GetHGPlayers();
    modesValues[2][modPlayers] = CurrentDerbyPlayers;
    modesValues[3][modPlayers] = CurrentFalloutPlayers;
    modesValues[4][modPlayers] = BattleField;
    modesValues[5][modPlayers] = WarDM;
    modesValues[6][modPlayers] = TDM;
    modesValues[7][modPlayers] = FieldDM;
    modesValues[8][modPlayers] = Mini;
    modesValues[9][modPlayers] = OneShotDM;
    modesValues[10][modPlayers] = DssDM;
    modesValues[11][modPlayers] = DeagleDM::playerCount;
    modesValues[12][modPlayers] = SawnDM::playerCount;

	new resultStr[256], areaText[32];
	for(new i = 0; i < sizeof modesValues; i++)
	{
        new color[4], appendStr[2];
		areaText = "";
		color = (!modesValues[i][modPlayers]) ? ("~r~") : ("~b~");
		appendStr = (i < sizeof modesValues - 1) ? (" ") : ("");
		format(areaText, sizeof areaText, "~y~/%s: %s~h~%i%s", modesValues[i][modName], color, modesValues[i][modPlayers], appendStr);
		strcat(resultStr, areaText);
	}
	TextDrawSetString(DMTextdraw, resultStr);
}

CheckDM(playerid)
{
	switch(InDM[playerid])
	{
		case 1: BattleField--;
		case 4: Rocket--;
		case 5: WarDM--;
		case 7: Mini--;
		case 10: TDM--;
		case 13: CnR--;
		case 15: FieldDM--;
		case 16: OneShotDM--;
		case 50: DssDM--;
		case DeagleDM::ID: DeagleDM::playerCount--;
		case SawnDM::ID: SawnDM::playerCount--;
	}
	if(BattleField < 0) BattleField = 0;
	if(Rocket < 0) Rocket = 0;
	if(WarDM < 0) WarDM = 0;
	if(Mini < 0) Mini = 0;
	if(TDM < 0) TDM = 0;
	if(CnR < 0) CnR = 0;
	if(FieldDM < 0) FieldDM = 0;
	if(OneShotDM < 0) OneShotDM = 0;
	if(DssDM < 0) DssDM = 0;
	if(DeagleDM::playerCount < 0) DeagleDM::playerCount = 0;
	if(SawnDM::playerCount < 0) SawnDM::playerCount = 0;
	killStreak[playerid]=0;//KSreset
}
