CheckPlayerAchievementCompleted(playerid)
{
	if(pAch1[playerid] == 1 && pAch2[playerid] == 1 && pAch3[playerid] == 1 && pAch4[playerid] == 1 && pAch5[playerid] == 1 && pAch6[playerid] == 1 && pAch7[playerid] == 1 && pAch8[playerid] == 1 && pAch9[playerid] == 1 &&
	   pAch10[playerid] == 1 && pAch11[playerid] == 1 && pAch12[playerid] == 1 && pAch13[playerid] == 1 && pAch14[playerid] == 1 && pAch15[playerid] == 1 && pAch16[playerid] == 1 && pAch17[playerid] == 1 && pAch18[playerid] == 1 &&
	   pAch19[playerid] == 1 && pAch20[playerid] == 1 && pAch21[playerid] == 1 && pAch22[playerid] == 1 && pAch23[playerid] == 1 && pAch24[playerid] == 1&& pAch25[playerid] == 1 && pAch26[playerid] == 1 && pAch27[playerid] == 1 && pAch28[playerid] == 1)
	{
		InfoTD_MSG(playerid, 5000, "~g~Congratulations, you completed all achievements! ~w~+~g~~h~2000 cookies!");
		format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "GREEN_E"has completed all their achievements and received 2000 cookies!", pColor[playerid], pName[playerid], playerid);
		SendClientMessageToAll(COLOR_GREEN, str);
		SendClientMessage(playerid, COLOR_GREEN, ""RED_E"*** "GREEN_E"Congratulations, you have completed all your achievements and received 2000 cookies!");
		pCookies[playerid] += 2000;
	}

}

DisplayAch(playerid, player2)
{
	new tmp3[20], tmp4[20], tmp5[20], tmp6[20], tmp7[20], tmp8[20], tmp9[20], tmp10[20],tmp11[20], tmp12[20], tmp13[20], tmp14[20], tmp15[20], tmp16[20], tmp17[20];
	new line3[1800];
	if(pAch1[player2] == 1)
		tmp = ""GREEN_E"•";
	else tmp = ""RED_E"•";
	if(pAch2[player2] == 1)
		tmp3 = ""GREEN_E"•";
	else tmp3 = ""RED_E"•";
	if(pAch3[player2] == 1)
		tmp4 = ""GREEN_E"•";
	else tmp4 = ""RED_E"•";
	if(pAch4[player2] == 1)
		tmp5 = ""GREEN_E"•";
	else tmp5 = ""RED_E"•";
	if(pAch5[player2] == 1)
		tmp6 = ""GREEN_E"•";
	else tmp6 = ""RED_E"•";
	if(pAch6[player2] == 1)
		tmp7 = ""GREEN_E"•";
