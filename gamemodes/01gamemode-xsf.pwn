CMD:togcountry(playerid, params[])
{
	if(pTogCountry[playerid] == 0)
	{
		pTogCountry[playerid] = 1;
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE `players` SET `togcorty`=1 WHERE `Name` = '%e'", pName[playerid]);
		MySQL_updateQuery(query);
		SendClientMessage(playerid, COLOR_GREY, "You have disabled showing country on /stats.");
	}
	else
	{
		pTogCountry[playerid] = 0;
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE `players` SET `togcorty`=0 WHERE `Name` = '%e'", pName[playerid]);
		MySQL_updateQuery(query);
		SendClientMessage(playerid, COLOR_GREY, "You have enabled showing country on /stats.");
	}
	return 1;
}


CMD:queb(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		SetPlayerVehiclePosition(playerid, -1522.4664,2633.7900,55.4118,52.7635);
	}
	else
	{
		SetPlayerPosition(playerid, -1483.3549,2645.6074,58.7281,0.7429);
	}
	TeleMSG(playerid, "El Quebrados (/queb)");
	return true;
}

CMD:aldea(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		SetPlayerVehiclePosition(playerid, -1297.3662,2446.0081,87.6036,3.8918);
	}
	else
	{
		SetPlayerPosition(playerid, -1299.1270,2495.7993,87.0027,328.4943);
	}
	TeleMSG(playerid, "Aldea Malvada (/aldea)");
	return true;
}

CMD:barra(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		SetPlayerVehiclePosition(playerid, -829.2484,1434.4557,13.4872+1.0,92.4744);
	}
	else
	{
		SetPlayerPosition(playerid, -729.9825, 1524.2955, 40.3000, 134.208);
