		case 198: //Change password
		{
			if(!response && GetPVarInt(playerid, "PasswordChange") == 0) return KickEx(playerid);
			if(response)
			{
				if(!(5 < strlen(inputtext) < 30))
				{
					Error(playerid, "Please insert a valid password! Must be between 6-30 characters.");
					cmd_changepass(playerid);
					return true;
				}
				/*if(!IsValidPassword(inputtext))
				{
					Error(playerid, "Password can contain only A-Z, a-z, 0-9, _, [ ], ( )");
					cmd_changepass(playerid);
					InfoTD_MSG(playerid, 3000, "~r~~h~Error changing password!~n~~w~Invalid character(s) in password.");
					return true;
				}*/

				// Escaping the string should not be necessary as we have IsValidPassword!
				mysql_format(g_SQL_handle, query, sizeof(query), "SELECT reg_id FROM players WHERE reg_id=%d AND pass=SHA1('%e')", pRegID[playerid], inputtext);
				MySQL_query(query, true, "PassChange_OnPassCheck", "i", playerid);
			}
			return true;
		}
		case 199: // Change password
		{
			if(!response && GetPVarInt(playerid, "PasswordChange") == 0) return KickEx(playerid);
			if(response)
			{
				/*if(!IsValidPassword(inputtext))
				{
					Error(playerid, "Password can contain only A-Z, a-z, 0-9, _, [ ], ( )");
					ShowPlayerDialog(playerid, 199, DIALOG_STYLE_INPUT, ""WHITE_E"Change your password", "Enter your new password!\n\n"dot"All passwords are hashed on our database.\n"dot"All passwords are case-sensitive.\n"dot"Remember your password, you will need it for your next login.\n", "Enter", "Exit");
					InfoTD_MSG(playerid, 3000, "~r~~h~Error changing password!~n~~w~Invalid character(s) in password.");
					return true;
				}*/
				if(!(3 < strlen(inputtext) < 18))
				{
					Error(playerid, "Please insert a valid password! Must be between 4-18 characters.");
					ShowPlayerDialog(playerid, 199, DIALOG_STYLE_INPUT, ""WHITE_E"Change your password", "Enter your new password!\n\n"dot"All passwords are hashed on our database.\n"dot"All passwords are case-sensitive.\n"dot"Remember your password, you will need it for your next login.\n", "Enter", "Exit");
					return true;
				}

				if(GetPVarInt(playerid, "PasswordChange") == 0)
				{
					mysql_format(g_SQL_handle,query, sizeof(query), "SELECT NULL FROM players WHERE reg_id=%d AND pass=SHA1('%e')", pRegID[playerid], inputtext);
					MySQL_query(query, true, "PassChange_OnForcedPassCheck", "is", playerid, inputtext);
				}
				else
				{
					mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET pass=SHA1('%e'), passchanged = 1 WHERE reg_id=%d", inputtext, pRegID[playerid]);
					MySQL_updateQuery(query);
					format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your password has been changed to '"LB2_E"%s'!", inputtext);
					SendClientMessage(playerid, COLOR_YELLOW, str);
					SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "YELLOW_E"Please note your password and remember it for your next login.");
					format(str, sizeof(str), "~w~Password changed to ~r~%s", inputtext);
					InfoTD_MSG(playerid, 3000, str);
				}
			}
			return true;
		}
		case EMAIL_DIALOG: // Change Email
		{
			if(response)
			{
				if(isnull(inputtext))
				{
					Error(playerid, "This field cannot be left empty, use 'exit' to close the dialog.");
					cmd_email(playerid);
					return true;
				}
				if(!(2 < strlen(inputtext) < 40))
				{
					Error(playerid, "Please insert a valid email! Must be between 3-40 characters.");
					cmd_email(playerid);
					return true;
				}
				if(!IsValidChar(inputtext))
				{
					Error(playerid, "Email can contain only A-Z, a-z, 0-9, _, [ ], ( )  and @");
					cmd_email(playerid);
					return true;
				}
				if(strfind("@", inputtext) == -1)
				{
					Error(playerid, "This isn't a valid email.");
					cmd_email(playerid);
				}
				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET email='%e' WHERE reg_id=%d", inputtext, pRegID[playerid]);
				MySQL_updateQuery(query);
				format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your e-mail has been set to '"LB2_E"%s"YELLOW_E"'!", inputtext);
				SendClientMessage(playerid, COLOR_YELLOW, str);
				format(pEmail[playerid], 40, inputtext);
				format(str, sizeof(str), "~w~Email changed to ~b~~h~%s", inputtext);
				InfoTD_MSG(playerid, 4000, str);
			}
		}
		case DESCRIPTION_DIALOG: // Change Description
		{
			if(response)
			{
				cmd_description(playerid);
			}
			return 1;
		}
		case DESCRIPTION_DIALOG+1: // Change Description
		{
			if(response)
			{
				if(isnull(inputtext))
				{
					Error(playerid, "This field cannot be left empty, use 'exit' to close the dialog.");
					cmd_description(playerid);
					return true;
				}
				if(strlen(inputtext) > 40)
				{
					Error(playerid, "Please insert a valid description! Must be between below 40 characters.");
					cmd_description(playerid);
					return true;
				}
				if(strfind(inputtext, "%", true) != -1)
				{
					Error(playerid, "Invalid characters in description!");
					cmd_description(playerid);
					return true;
				}

				mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET description='%e' WHERE reg_id=%d", inputtext, pRegID[playerid]);
				MySQL_updateQuery(query);
				format(pDescription[playerid], 40, "%s", inputtext);
				format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your description has been set to '"LB2_E"%s"YELLOW_E"'", inputtext);
				SendClientMessage(playerid, COLOR_YELLOW, str);
			}
			return 1;

		}
