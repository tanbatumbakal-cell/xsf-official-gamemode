public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	if(GetPVarInt(playerid, "BadSports")) return 1;
	if(pSpectating[playerid] != -1) return true;
	if(InDM[playerid] == 13 || doingStunt[playerid] != 0)
	{
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE); // Removes Jetpack
		SetTimerEx("DelayRemoveJetpack", 2000, false, "i", playerid);
	}

	switch(pickupid)
	{
		case parachute_1, parachute_2, parachute_3:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerWeapon(playerid) == 46) return true;
			GivePlayerWeapon(playerid, 46, 1);
			InfoTD_MSG(playerid, 2000, "~g~~h~Parachute!");
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "YELLOW_E"You have received a paracute!");
		}
		case BarPC, BarPC2:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(GetPVarInt(playerid, "ShowBarDialog") == 0)
			{
				SetPVarInt(playerid, "ShowBarDialog", 1);
				SetTimerEx("ResetBarDialog", 3500, false, "i", playerid);
				ShowPlayerDialog(playerid, 66, DIALOG_STYLE_LIST, ""ORANGE_E"Regular Players Club Bar.", ""GREY2_E"Purchase Beer\n"GREY2_E"Purchase Wine\n"GREY2_E"Purchase Soda\n"GREY2_E"Purchase Cigar", "Select", "Exit");
			}
		}
		case mbPC:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(MoneyBagFound == 1) return true;
			if(GetPVarInt(playerid, "UnablePickMB") == 1) 
				return SendClientMessage(playerid, -1, "ERROR: You have used map teleportation and is therefore unable to pick up.");
			
			datez = GetTickCount() - MoneyBagStart;
			hour = datez;
			second = datez / 1000;
			datez = datez - second * 1000;
			foreach(new ii : Player)
			{
				SetPVarInt(ii, "UnablePickMB", 0);
			}
			MoneyBagFound = 1;
			MoneyBagStart = 0;
			new money = MoneyBagCash;
			format(str, sizeof(str), ""MB" "LB2_E"%s(%i) has found the moneybag worth $%s in %2d.%02d seconds, located in %s.", pName[playerid], playerid, ToCurrency(money), second, datez, MoneyBagLocation);
			SendClientMessageToAll(COLOR_LB, str);
			format(str, sizeof(str), "4Moneybag: 2%s(%i) has found the money bag worth $%s in %2d.%03d seconds, located in %s.", pName[playerid], playerid, ToCurrency(money), second, datez, MoneyBagLocation);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str),  ""SERVER_INITIALS" "LG_E"You have found the moneybag! You have received $%s and 1 score!", ToCurrency(money));
			SendClientMessage(playerid, COLOR_WHITE, str);
			format(str, sizeof(str), "~g~~h~Congrats you found the moneybag~w~!~n~~w~+~g~$~w~%s and +1 score", ToCurrency(money));
			InfoTD_MSG(playerid, 4000, str);
			GivePlayerCash(playerid, money);

			if(pPremium[playerid] >= 2)
			{
				new procent = ReturnProcent(money, 20);
				GivePlayerCash(playerid, procent);
				new totalmoney = money+procent;
				format(str, sizeof(str),  "** "LB2_E"As a premium member you have received 20 percent more cash for this moneybag pickup! Total: "LG_E"$%s", ToCurrency(totalmoney));
				SendClientMessage(playerid, COLOR_ORANGE, str);

			}
			GivePlayerScore(playerid, 1);
			pInfo[playerid][pMBFound]++;
			format(query, sizeof(query), "UPDATE players SET mb_found=mb_found+1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_X, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_Y, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_Z, 2140.0);
			ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
			SetPVarInt(playerid, "pickedUpMB", 1);
			SetTimerEx("ResetMBPickup", 10000, false, "i", playerid);
			
			if(pInfo[playerid][pMBFound] >= 100)
			{
				if(pAch7[playerid] == 0)
				{
					pAch7[playerid] = 1;
					format(query, sizeof(query), "UPDATE achievements SET a7=1 WHERE reg_id=%d", pRegID[playerid]);
					MySQL_updateQuery(query);
					GivePlayerAchievement(playerid, "Moneybag Hunter", "Congrats you found 100 moneybags!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
				}
			}
			SetTimer("MoneyBag", 1000*60*5, false);
		}
		case cjPC:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(CookieJarFound == 1) 
				return true;
			if(GetPVarInt(playerid, "UnablePickCJ") == 1) 
				return SendClientMessage(playerid, -1, "ERROR: You have used map teleportation and is therefore unable to pick up.");
			datez = GetTickCount() - CookieJarStart;
			hour = datez;
			second = datez / 1000;
			datez = datez - second * 1000;
			foreach(new ii : Player)
			{
				SetPVarInt(ii, "UnablePickCJ", 0);
			}
			CookieJarFound = 1;
			CookieJarStart = 0;
			new cookies = RandomEx(7, 40);
			format(str, sizeof(str), ""CJ" "GREEN_E"%s(%i) has found the cookie jar with %d cookies in %2d.%02d seconds, located in %s.", pName[playerid], playerid, cookies, second, datez, CookieJarLocation);
			SendClientMessageToAll(COLOR_GREEN, str);
			format(str, sizeof(str), "4CookieJar: 2%s(%i) has found the cookie jar with %d cookies in %2d.%03d seconds, located in %s.", pName[playerid], playerid, cookies, second, datez, CookieJarLocation);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
			format(str, sizeof(str),  ""SERVER_INITIALS" "LG_E"You have found the cookie jar! You have received %d cookies!", cookies);
			SendClientMessage(playerid, COLOR_WHITE, str);
			format(str, sizeof(str), "~g~~h~Congrats you found the cookie jar~w~!~n~~w~+%d cookies,", cookies);
			InfoTD_MSG(playerid, 4000, str);
			GivePlayerCookie(playerid, cookies);

			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, cjPC, E_STREAMER_X, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, cjPC, E_STREAMER_Y, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_PICKUP, cjPC, E_STREAMER_Z, 2140.0);
			ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
			pCookieJars[playerid]++;
			format(query, sizeof(query), "UPDATE players SET cookiejars=cookiejars+1 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			// Same Logic as MB, Apply it to Cookie Jar.
			SetPVarInt(playerid, "pickedUpMB", 1);
			SetTimerEx("ResetMBPickup", 10000, false, "i", playerid);
			
			if(pCookieJars[playerid] >= 150)
			{
				if(pAch28[playerid] == 0)
				{
					pAch28[playerid] = 1;
					format(query, sizeof(query), "UPDATE achievements SET a28=1 WHERE reg_id=%d", pRegID[playerid]);
					MySQL_updateQuery(query);
					GivePlayerAchievementNoReward(playerid, "CookieJar Hunter", "Congrats you found 150 cookiejars!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
				}
			}
		}
		case TelePC_1, TelePC_2, TelePC_3, TelePC_4, TelePC_5, TelePC_6, TelePC_7, TelePC_8, TelePC_9, TelePC_10, TelePC_11, TelePC_12:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(InDM[playerid] == 13) return Error(playerid, "You can't use any pickups while playing cops and robbers.");
			ShowTeleportMenu(playerid);
		}
		case vPC_1, vPC_2, vPC_3, vPC_4, vPC_5, vPC_6, vPC_7, vPC_8, vPC_9, vPC_10, vPC_11, vPC_12:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(InDM[playerid] == 13) return Error(playerid, "You can't use any pickups while playing cops and robbers.");
			ShowVehicleMenu(playerid);
		}
		case StuntPC_1, StuntPC_2, StuntPC_5, StuntPC_6, StuntPC_7, StuntPC_8:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			if(InDM[playerid] == 13) return Error(playerid, "You can't use any pickups while playing cops and robbers.");
			GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
			SetPlayerPos(playerid, POS[0], POS[1], POS[2] + 420.0);
			GivePlayerWeapon(playerid, 46, 1);
			InfoTD_MSG(playerid, 3500, "~g~~h~Enjoy your flight!");
		}
		case StuntPC_3:
		{
			if(doingStunt[playerid] == 6)
			{
				iTemp = GetTickCount();
				if((iTemp - pChallengeCompleted[playerid]) < 30000)
				{
					format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"Possible teleport hack detected on %s(%i).", pName[playerid], playerid);
					SendAdminMessage(COLOR_RED, str);
					Error(playerid, "You recently completed a challenge, please wait before completing another.");
					return true;
				}
				pChallengeCompleted[playerid] = iTemp;
				doingStunt[playerid] = 0;
				SetPlayerVirtualWorld(playerid, 0);
				GameTextForPlayer(playerid,"~r~~h~Congrats!~n~~w~You finished the hayclimb challenge.",6000,0);

				ChallengeCompleted(playerid);
				format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "PINK_E"has successfully completed /hayclimb.", pColor[playerid], pName[playerid], playerid);
				SendClientMessageToAll(COLOR_PINK, str);
				GivePlayerScore(playerid, 4);
				GivePlayerCash(playerid, 50000);
				GivePlayerWeapon(playerid, 46, 1);
				InfoTD_MSG(playerid, 5000, "~r~~h~Congratulations!~n~~w~You finished the hayclimb challenge~n~~r~~h~4 score and $50000!");
				HayclimbChallenge[playerid]++;
			}
		}
		case StuntPC_4:
		{
			if(doingStunt[playerid] == 7)
			{
				iTemp = GetTickCount();
				if((iTemp - pChallengeCompleted[playerid]) < 30000)
				{
					format(str, sizeof(str), "* ADMIN-MSG: "GREY_E"Possible teleport hack detected on %s(%i).", pName[playerid], playerid);
					SendAdminMessage(COLOR_RED, str);
					Error(playerid, "You recently completed a challenge, please wait before completing another.");
					return true;
				}
				pChallengeCompleted[playerid] = iTemp;
				doingStunt[playerid] = 0;
				SetPlayerVirtualWorld(playerid, 0);
				GameTextForPlayer(playerid,"~r~~h~Congrats!~n~~w~You finished the parkour challenge.",6000,0);

				ChallengeCompleted(playerid);
				format(str, sizeof(str), ""SERVER_INITIALS" {%06x}%s(%i) "PINK_E"has successfully completed /parkour1.", pColor[playerid], pName[playerid], playerid);
				SendClientMessageToAll(COLOR_PINK, str);
				GivePlayerScore(playerid, 4);
				GivePlayerCash(playerid, 50000);
				InfoTD_MSG(playerid, 5000, "~r~~h~Congratulations!~n~~w~You finished the parkour challenge~n~~r~~h~4 score and $50000!");

				ParkourChallenge[playerid]++;
			}
		}
		case LSAIR_PC1:
		{
			DestroyDynamicObject(GetPVarInt(playerid, "staticOBJ"));
			SetPVarInt(playerid, "staticOBJ", CreateDynamicObject(8356, 2401.13671875, -2546.95361328, 449.99508667, 0.0, 180.0, 0.0, -1, -1, playerid));

			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
				SetPlayerVehiclePosition(playerid, 2393.5361, -2546.0217, 452.0508, 87.4714);
			else
				SpawnPlayerVehicle(playerid, 411, false), SetPlayerVehiclePosition(playerid, 2393.5361, -2546.0217, 452.0508, 87.4714);
			InfoTD_MSG(playerid, 4000, "~b~~h~~h~Enjoy the ride!");
		}
		case LSAIR_PC2:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
				SetPlayerVehiclePosition(playerid, 1759.2035, -2672.5337, 54.2504, 50.0);
			else
				SpawnPlayerVehicle(playerid, 411, false), SetPlayerVehiclePosition(playerid, 1759.2035, -2672.5337, 54.2504, 50.0);

			InfoTD_MSG(playerid, 5000, "~g~~h~Launcher~n~~r~~h~~h~Enter the tube with a vehicle!");
		}
		case LSAIR_PC3:
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
				SetPlayerVehiclePosition(playerid, 1988.5815, -2661.8462, 62.2684, 270.0);
			else
				SpawnPlayerVehicle(playerid, 411, false), SetPlayerVehiclePosition(playerid, 1988.5815, -2661.8462, 62.2684, 270.0);

			InfoTD_MSG(playerid, 5000, "~g~~h~Booster~n~~r~~h~~h~Drive into the area to bounce!");
		}
		case 44..56: // Jetpack Pickups
		{
			if(InDM[playerid] == 13 || doingStunt[playerid] != 0)
			{
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE); // Removes Jetpack
				SetTimerEx("DelayRemoveJetpack", 2000, false, "i", playerid);
				Error(playerid, "You can't use jetpacks in this area!");
			}
			else
			{
				GameTextForPlayer(playerid, "~y~Jetpack!", 2200, 3);
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
			}
		}
		default: // House Pickup.
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return true;
			foreach(new h : Houses)
			{
				if(pickupid == HousePickupOut[h])
				{
					if(InDM[playerid] == 13 || doingStunt[playerid] != 0) 
						return Error(playerid, "You can't enter houses in this area, type /leave!");
					SetPVarInt(playerid, "LastHouseCP", h);
					if(hInfo[h][HouseOwner] == pRegID[playerid])
					{
						SetPlayerHouseInterior(playerid, h);
						ShowInfoBoxEx(playerid, COLOR_INFO, I_HMENU);
						if(GetPVarInt(playerid, "houseChecked") != h)
						{
							SetPVarInt(playerid, "houseChecked", h);
							format(query, sizeof(query), "UPDATE houses SET last_visited=UNIX_TIMESTAMP() WHERE house_id=%d", hInfo[h][HouseID]);
							MySQL_updateQuery(query);
						}
						break;
					}
					format(str, sizeof(str), "HouseKeys_%d", h);
					if(GetPVarInt(playerid, str) == 1)
					{
						SetPlayerHouseInterior(playerid, h);
						break;
					}
					//Prevents pickup dialog spam.
					if(GetPVarInt(playerid, "ShowHouseDialog") == 1) continue;
					SetPVarInt(playerid, "ShowHouseDialog", 1);
					SetTimerEx("ResetHouseDialog", 3500, false, "i", playerid);
					if(!!hInfo[h][HouseOwner])
					{
						new s[32];
						mysql_format(g_SQL_handle, query, 256, "SELECT name FROM players WHERE reg_id = %d", hInfo[h][HouseOwner]);
						mysql_query(g_SQL_handle, query, true);
						cache_get_field_content(0, "name", s);	
						switch(hInfo[h][HousePrivacy])
						{
							case 0:
							{
								format(line, sizeof(line), ""WHITE_E"This house belongs to "WHITEP_E"%s. "WHITE_E"It is currently locked by the owner.\n\n"GREY2_E"Commands:\n"RED_E"- "WHITE_E"Use /enter <password> to enter this house using a password.\n"RED_E"- "WHITE_E"Type /breakin to attempt to break into the house.", s);
								ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""ORANGE_E"server: "LB_E"Houses", line, "Close", "");
							}
							case 1:
							{
								format(str, sizeof(str), ""SERVER_INITIALS" "LB2_E"Welcome to "LB_E"%s! "LB2_E"This house is open for visitors.", hInfo[h][HouseName]);
								SendClientMessage(playerid, COLOR_LB, str);
								SetPlayerHouseInterior(playerid, h);
								if(hInfo[h][HouseForSale] != 0) Info(playerid, "This house is for sale, type /buyhouse to purchase it!");

							}
						}
						break;
					}
					if(hInfo[h][HouseOwner] == 0 && hInfo[h][HouseValue] > 0)
					{
						if(h == 202 || h == 41 || h == 301 || h == 302 || h == 303 || h == 304)
						{
							if(pPremium[playerid] < 2) return ShowInfoBoxEx(playerid, COLOR_SYSTEM, E_VIPHOUSE);
						}
						format(str, sizeof(str), HMENU_BUY_HOUSE, ToCurrency(hInfo[h][HouseValue]));
						ShowPlayerDialog(playerid, HOUSEMENU+4, DIALOG_STYLE_MSGBOX, INFORMATION_HEADER, str, "Buy", "Cancel");
						break;
					}
				}
				if(pickupid == HousePickupInt[h])
				{
					switch(GetPVarInt(playerid, "HousePreview"))
					{
						case 0: ClosePlayerDialog(playerid), ExitHouse(playerid, h);
						case 1:
						{
							GetPVarString(playerid, "HousePrevName", tmp, 50);
							if(pPremium[playerid] == 3)
							{
								format(str, sizeof(str), HMENU_BUY_HINTERIORFREE, tmp, GetPVarInt(playerid, "HousePrevValue"));
							}
							else format(str, sizeof(str), HMENU_BUY_HINTERIOR, tmp, GetPVarInt(playerid, "HousePrevValue"));
							ShowPlayerDialog(playerid, HOUSEMENU+17, DIALOG_STYLE_MSGBOX, INFORMATION_HEADER, str, "Buy", "Cancel");
						}
					}
					break;
				}
			}
		}
	}
	return true;
}

DisplayStats(playerid, p2)
{
	if(!IsPlayerConnected(p2) || !IsPlayerConnected(playerid)) return Error(playerid, "Player not connected!");
	if(!pLogged[p2] || GetPVarInt(p2, "FullHidden") == 1) return Error(playerid, "Player is not logged in!");
	GetPlayerName(p2, giveplayer, sizeof(giveplayer));

	new line4[750];
	new line3[2100];
	new str3[80], str4[80], str5[80], str7[80], str11[140];
