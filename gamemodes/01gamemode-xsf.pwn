CMD:pc(playerid) return cmd_parachute(playerid);
CMD:para(playerid) return cmd_parachute(playerid);
CMD:parachute(playerid)
{
	if(InDM[playerid] == 13)
		return Error(playerid, "You cannot spawn a parachute in CNR.");

	if(doingStunt[playerid] == 9)
		return Error(playerid, "You can't spawn a parachute while doing a skydive, type /leave.");
	if(doingStunt[playerid] == 6)
		return Error(playerid, "You can't spawn a parachute while doing a hayclimb, type /leave.");
	if(doingStunt[playerid] == 7)
		return Error(playerid, "You can't spawn a parachute while doing a parkour, type /leave.");
	GivePlayerWeapon(playerid, 46, 1);
	SendClientMessage(playerid, COLOR_YELLOW, "You have received a parachute!");
	return true;
}

CMD:camera(playerid)
{
	GivePlayerWeapon(playerid, 43, 1000);
	SendClientMessage(playerid, COLOR_YELLOW, "You have received a camera!");
	return true;
}
CMD:jetpack(playerid)
{
	
	if(pAdmin[playerid] != 6)
	{
        if(GetPVarInt(playerid, "ParticipatingHG") == 1)
	    	return Error(playerid, "You cannot use this command while in HG");

		if(InDM[playerid] != 0)
		{
			Error(playerid, "You can't spawn a jetpack in a deathmatch!");
			return true;
		}
		if(doingStunt[playerid] != 0)
		{
			Error(playerid, "You can't spawn a jetpack in this area!");
			return true;
		}
	}
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
	SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "LG_E"Jetpack created!");
	return true;
}

CMD:beer(playerid) return cmd_drinkbeer(playerid);
CMD:drinkbeer(playerid)
{
	if(doingStunt[playerid] == 9 || doingStunt[playerid] == 7 || doingStunt[playerid] == 6) return Error(playerid, "You can't use animations here");
	if(!CanPlayerTeleport(playerid)) return true;
	if(IsPlayerInAnyVehicle(playerid))
	{
		Error(playerid, "You can't drink and drive!");
		return true;
	}
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DRINK_BEER);
	SendClientMessage(playerid, COLOR_GREEN, "You're now drinking beer. I would like to just drink my bud light...");
	return true;
}

CMD:wine(playerid)
{
	if(doingStunt[playerid] == 9 || doingStunt[playerid] == 7 || doingStunt[playerid] == 6) return Error(playerid, "You can't use animations here");
	if(!CanPlayerTeleport(playerid)) return true;
	if(IsPlayerInAnyVehicle(playerid))
	{
		Error(playerid, "You can't drink and drive!");
		return true;
	}
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DRINK_WINE);
