		case 993:
		{
			if(response)
			{
				switch(listitem)
				{
					case 0:
					{
						pSpawnPlace[playerid] = 0;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to San Fierro.");
					}
					case 1:
					{
						pSpawnPlace[playerid] = 1;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to BaySide.");
					}
					case 2:
					{
						pSpawnPlace[playerid] = 2;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to Abandoned Airport.");
					}
					case 3:
					{
						pSpawnPlace[playerid] = 3;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to Las Venturas Airport");
					}
					case 4:
					{
						pSpawnPlace[playerid] = 4;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to HalfPipe.");
					}
					case 5:
					{
						pSpawnPlace[playerid] = 5;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to San Fierro Airport.");
					}
					case 6:
					{
						pSpawnPlace[playerid] = 7;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to Los Santos Airport.");
					}
					case 7:
					{
						pSpawnPlace[playerid] = 8;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to Abandoned Farm.");
					}
					case 8:
					{
						pSpawnPlace[playerid] = 9;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to Sherman Dam.");
					}
					case 9:
					{
						if(GetOwnedHouses(playerid) == 0) return Error(playerid, "You do not own a house!");

						pSpawnPlace[playerid] = 6;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to your house.");

					}
					case 10:
					{
					    if(pGroupID[playerid] != -1) {
							pSpawnPlace[playerid] = 11;
							SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to your group's spawnpoint.");
						}
						else Error(playerid, "You must be in a group in order to set its spawnpoint.");
					}
					case 11: //custom
					{
						GetPlayerPos(playerid,pSpawnPos[playerid][0] , pSpawnPos[playerid][1] , pSpawnPos[playerid][2]);
						GetPlayerFacingAngle(playerid, pSpawnPos[playerid][3]);
						pSpawnPlace[playerid] = 12;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to: Custom");
					}
					case 12:
					{
						pSpawnPlace[playerid] = -1;
						SendClientMessage(playerid, COLOR_GREY, ""SERVER_INITIALS" "ORANGE_E"You have set your spawnpoint to the default random spawnpoint.");
					}
				}
				Info(playerid, "This will be your permanent spawnpoint, type /spawnplace to change it at anytime.");
				format(query, sizeof(query), "UPDATE players SET spawnplace=%d WHERE reg_id=%d", pSpawnPlace[playerid], pRegID[playerid]);
				MySQL_updateQuery(query);
			}
			return 1;
		}
		case EVENTDERBY:
		{
			if(response)
			{
				if(DerbyEvent == 1)
				{
					if(PlayersJoined >= 30)
					{
						SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "GREY_E"Sorry you can no longer join the derby, it has reached its max players!");
						return 1;
					}
					if(EventGoingOn == 0) return Error(playerid, "There is no event active!");
					if(EventStarted == 1) return Error(playerid, "The event has already started, wait for the next one!");
					if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
					DerbyPlayers ++;
					PlayersJoined ++;
					SavePlayerPosition(playerid);
					InDM[playerid] = 0;
					InEvent[playerid] = 1;
					InDerby[playerid] = 1;
					doingStunt[playerid] = 10;
					canUseKey[playerid] = false;
					if(GOD[playerid]) cmd_god(playerid);
					SetPlayerHealth(playerid, 98);
					SetPlayerArmour(playerid, 0);
					if(pPremium[playerid] == 3 && GetPVarInt(playerid, "togArmour"))
					{
