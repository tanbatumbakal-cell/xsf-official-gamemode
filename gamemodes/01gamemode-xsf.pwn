CMD:minigame(playerid) return cmd_minigames(playerid);
CMD:mg(playerid) return cmd_minigames(playerid);
CMD:minigames(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	new line7[400], line3[800];
	new pderby, pfallout, pcnr, ptdm, ptdm2, plms;
	foreach(new ii : Player)
	{
		if(doingStunt[ii] == 19) pderby++;
		if(doingStunt[ii] == 18) pfallout++;
		if(InDM[ii] == 13) pcnr++;
		if(InDM[ii] == 10) ptdm++;
		if(InDM[ii] == 19) ptdm2++;
		if(doingStunt[ii] == 33) plms++;
	}
	format(line7, 500, ""YELLOW_E"Derby\t\t\t"LB_E"[/derby]\t\t\t"WHITE_E"(Players: %i)\n"YELLOW_E"\t\t\t"LB_E"[/fallout]\t\t\t"WHITE_E"(Players: %i)\n"YELLOW_E"Cops and Robbers\t"LB_E"[/cnr]\t\t\t"WHITE_E"(Players: %i)\n"YELLOW_E"Team Deathmatch\t"LB_E"[/tdm]\t\t\t"WHITE_E"(Players: %i)", pderby, pfallout, pcnr, ptdm);
	strcat(line3, line7);
	format(line7, 500, "\n"YELLOW_E"Team Deathmatch 2\t"LB_E"[/tdm2]\t\t\t"WHITE_E"(Players: %i)\n"YELLOW_E"Last Man Standing\t"LB_E"[/lms]\t\t\t"WHITE_E"(Players: %i)\n"RED_E"Back", ptdm2, plms);
	strcat(line3, line7);


	ShowPlayerDialog(playerid, 33, DIALOG_STYLE_LIST, ""ORANGE_E"server: "WHITE_E"Minigames", line3, "Select", "Back");
	return true;
}

