CMD:buycookie(playerid, params[]) return cmd_buycookies(playerid, params);
CMD:buycookies(playerid, params[])
{
	if(!GetPVarInt(playerid, "cookieAmount"))
		return Error(playerid, "You haven't been offered any cookies..");

	new cookies = GetPVarInt(playerid, "cookieAmount");
	new price = GetPVarInt(playerid, "cookiePrice");
	otherid = GetPVarInt(playerid, "cookieSeller");

	if(pCash[playerid] < price)
		return Error(playerid, "You dont have enough money to make this transaction.");

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "The player that offered you cookies is no longer connected!");

	format(tmp, sizeof(tmp), ""WHITEP_E"Are you sure you want to buy "LB_E"%d "WHITEP_E"cookies for "LG_E"%s?", cookies, ToCurrency(price));
	ShowPlayerDialog(playerid, COOKIE_DIALOG+3, DIALOG_STYLE_MSGBOX, ""ORANGE_E"Buy Cookies", tmp, "Buy", "Cancel");
	return 1;
}

CMD:deny(playerid)
{
	if(!GetPVarInt(playerid, "cookieAmount"))
		return Error(playerid, "You haven't been offered any cookies..");

	otherid = GetPVarInt(playerid, "cookieSeller");

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "The player that offered you cookies is no longer connected!");

	format(str, 128, ""SERVER_INITIALS" "RED_E"%s(%d) has denied your offer.", pName[playerid], playerid);
	SendClientMessage(otherid, COLOR_WHITE, str);

	format(str, 128, ""SERVER_INITIALS" "WHITE_E"You have denied %s's offer.", pName[otherid]);
	SendClientMessage(playerid, COLOR_WHITE, str);

	DeletePVar(otherid, "sellingCookies");
	SetPVarInt(playerid, "cookieSeller", -1);
	DeletePVar(playerid, "cookieAmount");
	DeletePVar(playerid, "cookiePrice");
	return 1;
}
CMD:cookies(playerid, params[])
{
	if (sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/cookies <ID/Name>");
		SendClientMessage(playerid, COLOR_ORANGE, "FUNCTION: Will show the amount of cookies the selected player has.");
		return 1;
	}
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");

	if(!pHidden[otherid]) format(str, 128, ""SERVER_INITIALS" %s's cookies: %d", pName[otherid], pCookies[otherid]);
	else format(str, 128, ""SERVER_INITIALS" %s's cookies: 0", pName[otherid]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	return 1;
}
CMD:rps(playerid, params[])
{
	if (sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/rps <ID/Name>");
		return 1;
	}
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	format(str, 128, ""SERVER_INITIALS" %s's reward points: %d", pName[otherid], pReportPoints[otherid]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	return 1;
}
CMD:killstreak(playerid, params[]) return cmd_ks(playerid, params);
CMD:ks(playerid, params[])
{
	if (sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/ks <ID/Name>");
		SendClientMessage(playerid, COLOR_ORANGE, "FUNCTION: Will show the current/highest killstreak of the player.");
		return 1;
	}
	if(otherid == INVALID_PLAYER_ID) return Error(playerid, "Player not connected!");
	format(str, 128, ""SERVER_INITIALS" %s's current killstreak: %d", pName[otherid], killStreak[otherid]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	format(str, 128, ""SERVER_INITIALS" %s's highest killstreak: %d", pName[otherid], TotalKillStreak[otherid]);
	SendClientMessage(playerid, COLOR_YELLOW, str);
	return 1;
}
CMD:giveallcookie(playerid, params[])
{
	if(pAdmin[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params) || !IsNumeric(params)) return Usage(playerid, "/giveallcookie <amount>");
	if(strval(params) <= 0) return Error(playerid, "Value must be higher than 0.");
	if(strval(params) >= 6 && pAdmin[playerid] < 5) return Error(playerid, "You cannot give more than 5 cookies!");

	new amount = strval(params);
	format(str, 128, "* %s(%i) has given everyone %i %s!", pName[playerid], playerid, amount, (amount == 1) ? ("cookie") : ("cookies"));
	SendClientMessageToAll(COLOR_GREEN, str);
	format(str, 128, "~g~%s ~h~for ~h~Everyone!", (amount == 1) ? ("Cookie") : ("Cookies"));
	GameTextForAll(str, 3200, 3);
	//GameTextForAll("~r~H~b~a~g~p~p~p~w~y ~r~H~b~o~g~l~p~i~w~d~r~a~b~y~p~s", 3200, 3);
	foreach(new ii : Player)
	{
		if(pLogged[ii] == true)
		{
			GivePlayerCookie(ii, amount);
		}
	}
	return 1;
}
CMD:giveallscore(playerid, params[])
{
	if(pAdmin[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");
	if(isnull(params) || !IsNumeric(params)) return Usage(playerid, "/giveallscore <amount>");
	if(strval(params) <= 0) return Error(playerid, "Value must be higher than 0.");
	if(strval(params) >= 6 && pAdmin[playerid] < 5) return Error(playerid, "You cannot give more than 5 score!");

	new score = strval(params);
	format(str, 128, "* %s(%i) has given everyone %i score!", pName[playerid], playerid, score);
	SendClientMessageToAll(COLOR_SBLUE, str);
	GameTextForAll("~b~Score ~h~for ~h~Everyone!", 3200, 3);
	//GameTextForAll("~r~H~b~a~g~p~p~p~w~y ~r~H~b~o~g~l~p~i~w~d~r~a~b~y~p~s", 3200, 3);
	foreach(new ii : Player)
	{
		if(pLogged[ii] == true)
		{
			GivePlayerScore(ii, score);
		}
	}
	return 1;
}
CMD:tutorial(playerid) return cmd_tour(playerid);
CMD:tour(playerid)
{

	if(!CanPlayerTeleport(playerid)) return true;
	SavePlayerPosition(playerid);
	SetPlayerInterior(playerid, 14);
	SetPlayerPos(playerid, -1484.6588,1640.4684,1060.6719);
	Streamer_UpdateEx(playerid, -1484.6588,1640.4684,1060.6719);
	SetPlayerCameraPos(playerid,-1484.6588,1640.4684,1060.6719);
	SetPlayerCameraLookAt(playerid,-1425.3961,1598.7845,1052.5313);
	TogglePlayerControllable(playerid, 0);
	TextDrawShowForPlayer(playerid, letterbox[0]);
	TextDrawShowForPlayer(playerid, letterbox[1]);
	new newline[450];
	strcat(newline, "Welcome to the server ::  A stunt server, with loads of fun stuff to do.\nThe main goal is to have fun, accomplish the best stunts and earn score.\nYou can earn it by killing people in DM zones, winning events/races and doing stunt challenges.");
	strcat(newline, "\nAll your statistics are saved upon registering, Type /help to see what you can do with your money and score.\n"LB2_E"Type "RED_E"/endtour "LB2_E"to end this tour at anytime.");
	ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "Part 1: "LB2_E"Introduction", newline, "Next", "");
	return 1;
}
CMD:endtour(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	SetPlayerInterior(playerid, 0);
	TogglePlayerControllable(playerid, 1);
	SetCameraBehindPlayer(playerid);
	TextDrawHideForPlayer(playerid, letterbox[0]);
	TextDrawHideForPlayer(playerid, letterbox[1]);
	LoadPlayerPosition(playerid);
	SendClientMessage(playerid, COLOR_WHITEP, "* You have exited the server tour.");
	return 1;
}

