	if(dialogid == 9674)
    {
        if(response)
        {
        	new item_index_id = ItemIDFromPlayerInventory(playerid, invMenuData[playerid][listitem]), Float:health, Float:armour;
        	GetPlayerHealth(playerid, health);
        	GetPlayerArmour(playerid, armour);
        	if(item_index_id == 0)
        	{
        	    if(health <= 50) { // bandage
        	        SetPlayerHealth(playerid, health+25);
        	        RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
				}
				else SendClientMessage(playerid, -1, "{FF0000} You cannot use a bandage with the current health you have got.");
        	}
        	else if(item_index_id == 1) { // m4
        	    GivePlayerWeapon(playerid, 31, 15);
        	    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
			}
			else if(item_index_id == 2) { // sniper
			    GivePlayerWeapon(playerid, 34, 5);
			    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
			}
			else if(item_index_id == 3) {// medkit
			    if(health <= 50) {
			        SetPlayerHealth(playerid, health+50);
			        RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
				}
				else if(health > 50) {
				    SetPlayerHealth(playerid, 97);
				    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
				}

			}
			else if(item_index_id == 4) {//armor
				if(armour <= 25) {
				    SetPlayerArmour(playerid, armour+25);
				    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
				}
				else SendClientMessage(playerid, -1, "{FF0000} You cannot wear armour as you currently got more than enough.");
			}
			else if(item_index_id == 5) {// pizza
                if(health <= 95) {
        	        SetPlayerHealth(playerid, health+5);
        	        RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
				}
				else SendClientMessage(playerid, -1, "{FF0000} You cannot eat pizza as you are already full.");
			}
			else if(item_index_id == 6) {// colt
				GivePlayerWeapon(playerid, 22, 25);
			    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
			}
			else if(item_index_id == 7) {// shotgun
                GivePlayerWeapon(playerid, 25, 10);
			    RemoveInventoryItem(playerid, invMenuData[playerid][listitem]);
			}
		}
        return 1;
    }

	switch(dialogid)
	{

        case 994:
		{
			if(response)
			{
				otherid = GetPVarInt(playerid, "gcPlayer");
				new money = GetPVarInt(playerid, "gcAmount");

				if(otherid == -1 || money == -1) {
					format(str, sizeof(str), ""GREY2_E"REPORT: "RED_E"%s(%i) has tried to spoof money and give it to a player!", pName[playerid], playerid);
			 		foreach(new ii : Player) if(pAdmin[ii] > 0 || Helper[ii] == 1 || Helper[ii] == 3) SendClientMessage(ii, COLOR_RED, str);
			 		return 1;
				}

				if(otherid == INVALID_PLAYER_ID || !IsPlayerConnected(otherid))
					return Error(playerid, "Player not connected!");
				if(2000000000 - pCash[otherid] < money)
				{
				    Error(playerid,"Player's hand cash is exceeding the SAMP limit, Money not sent");
				    return 0;
				}
				GivePlayerCash(otherid, money);
				GivePlayerCash(playerid, -money);

				format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"You have sent %s(%i) "GREEN_E"$%s", pName[otherid], otherid, ToCurrency(money));
				SendClientMessage(playerid, COLOR_GREY, str);
				format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"%s(%i) has sent you "GREEN_E"$%s", pName[playerid], playerid, ToCurrency(money));
				SendClientMessage(otherid, COLOR_GREY, str);
				InfoTD_MSG(playerid, 3500, "~g~~h~Money Sent!");
				InfoTD_MSG(otherid, 3500, "~g~~h~Money received!");
				format(str, sizeof(str), "4Server:3 %s(%i) has sent %s(%i) $%s", pName[playerid], playerid, pName[otherid], otherid, ToCurrency(money));
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				SetPVarInt(playerid, "gcPlayer", -1);
				SetPVarInt(playerid, "gcAmount", -1);
			}
		}

		case 995:
		{
			if(response)
			{
				otherid = GetPVarInt(playerid, "cookieSellee");
				new cookies = GetPVarInt(playerid, "cookieAmountx");
				new price = GetPVarInt(playerid, "cookiePricex");

				if(otherid == INVALID_PLAYER_ID)
					return Error(playerid, "Player not connected!");
				if(cookies == 1)
				{
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"%s(%d) has offered you 1 cookie for "LG_E"$%s"WHITE_E"! ", pName[playerid], playerid, ToCurrency(price));
					SendClientMessage(otherid, COLOR_WHITE, str);
					SendClientMessage(otherid, COLOR_WHITE, ""SERVER_INITIALS" "WHITE_E"Type /buycookie to accept this offer or /deny to decline the offer.");
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"You have offered %s(%d) 1 cookie for $%s. wait for the player to accept your offer.", pName[otherid], otherid, ToCurrency(price));
					SendClientMessage(playerid, COLOR_WHITE, str);
				}
				else
				{
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"%s(%d) has offered you %d cookies for "LG_E"$%s"WHITE_E"! ", pName[playerid], playerid, cookies, ToCurrency(price));
					SendClientMessage(otherid, COLOR_WHITE, str);
					SendClientMessage(otherid, COLOR_WHITE, ""SERVER_INITIALS" "WHITE_E"Type /buycookies to accept this offer or /deny to decline the offer.");
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"You have offered %s(%d) %d cookies for $%s. wait for the player to accept your offer.", pName[otherid], otherid, cookies, ToCurrency(price));
					SendClientMessage(playerid, COLOR_WHITE, str);
				}
				SetPVarInt(playerid, "sellingCookies", 1);
				SetPVarInt(otherid, "cookieSeller", playerid);
				SetPVarInt(otherid, "cookieAmount", cookies);
				SetPVarInt(otherid, "cookiePrice", price);
				InfoTD_MSG(playerid, 3500, "~g~~h~Cookies offered!");
				//InfoTD_MSG(otherid, 3500, "~g~~h~Cookies received!");
				format(str, sizeof(str), "4Server:3 %s(%i) has sent %s(%i) %d cookies for $%s", pName[playerid], playerid, pName[otherid], otherid, cookies,ToCurrency(price));
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				DeletePVar(playerid, "cookieSellee");
				DeletePVar(playerid, "cookieAmountx");
				DeletePVar(playerid, "cookiePricex");

			}
		}
		case EDITOBJ_DIALOG:
		{
			if(response)
			{
				if(!strlen(inputtext)) return Error(playerid, "You must enter the ID");
				myzobject = strval(inputtext);
				if(IsValidDynamicObject(myzobject)) return SendClientMessage(playerid, COLOR_RED, "ERROR: Invalid Object");
				ShowPlayerDialog(playerid, EDITOBJ_DIALOG+1, DIALOG_STYLE_INPUT, "Enter Text", "Enter Text\nFor Colour use:\n {FF0000}{ FF0000 } -  Red\n{00FF00}{ 00FF00 } -  Green\n{FF9933}{ FF9933 } - Orange\n{00FF33}{ 00FF33 } - Lime Green\n{33FFFF}{ 33FFF} - Cyan\n{FF66CC}{ FF66CC }Pink\n", "Enter", "Cancel");

			}
		}

		case EDITOBJ_DIALOG+1:
		{
			if(response)
			{
				new Float:X, Float:Y, Float:Z, Float:Ang;
				GetPlayerFacingAngle(playerid, Ang);
				GetPlayerPos(playerid, X, Y, Z);
				if(!strlen(inputtext)) return Error(playerid, "You must enter the some text");
				new myrobject = CreateDynamicObject(myzobject,  X+3, Y, Z+1, 0.0, 0.0, Ang); //create the object

				SetDynamicObjectMaterialText(myrobject, 0, inputtext, OBJECT_MATERIAL_SIZE_256x128, "Arial", 28, 1, COLOR_RED, 0xFF000000, OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
				format(str, sizeof(str), "The Object is been created with ID %d", myrobject);  //-> The number is 42.
				SendClientMessage(playerid, COLOR_RED, str);
			}
		}
		case COOKIE_DIALOG:
		{
			if(!response) return true;
			switch(listitem)
			{
				case 0: // Heal
				{
					if(5 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(InDM[playerid] == 16 || InDM[playerid] == 18) return Error(playerid, "You can't purchase health in OneShot DM!");

					pCookies[playerid] -= 10;
					SetPlayerHealth(playerid, 98);
					SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"Your health have been 50percent refiled");
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased half health for 5 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
				}
				case 1: // Heal
				{
					if(10 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(InDM[playerid] == 16 || InDM[playerid] == 18) return Error(playerid, "You can't purchase health in OneShot DM!");

					pCookies[playerid] -= 10;
					SetPlayerHealth(playerid, 98);
					SendClientMessage(playerid, COLOR_GREEN,""SERVER_INITIALS" "GREEN_E"You have healed yourself!");
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased health for 10 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
				}
				case 2: // Armour
				{
					if(20 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(InDM[playerid] == 16 || InDM[playerid] == 18) return Error(playerid, "You can't armour health in OneShot DM!");
					pCookies[playerid] -= 20;
					SetPlayerArmour(playerid, 97.0);
					SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "LG_E"Armour Purchased!");
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased Armour for 20 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
				}
				case 3: // Jetpack
				{
					if(20 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(pAdmin[playerid] != 6)
					{
						if(InDM[playerid] != 0)
						{
							Error(playerid, "You can't spawn a jetpack in a deathmatch!");
							return true;
						}
						if(doingStunt[playerid] != 0)
						{
							Error(playerid, "You can't spawn a jetpack in this area!");
							return true;
						}
					}
					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
					SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "LG_E"Jetpack Purchased!");
					pCookies[playerid] -= 20;
				}
				case 4: // Name Change
				{
					if(650 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					ShowPlayerDialog(playerid, COOKIE_DIALOG+4, DIALOG_STYLE_INPUT, ""WHITE_E"Change Name", "Enter your new name:", "Enter", "Exit");
				}
				case 5: // Reset KDR
				{
					if(1500 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					ShowPlayerDialog(playerid, COOKIE_DIALOG+5, DIALOG_STYLE_INPUT, ""WHITE_E"Reset KDR", ""WHITE_E"Are you sure you want to reset your kills and deaths?\n\n"RED_E"Warning: "WHITE_E"This action is irreversible!", "Continue", "Exit");
				}
				case 6: // Premium Level 1
				{
					if(300 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(pPremium[playerid] > 0) return Error(playerid, "You are already a premium member!");
					pPremium[playerid] = 1;
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased Temporary Premium Level 1 for 300 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
					Info(playerid, "You have purchased Premium Level 1 for 300 cookies, type /premium to view your commands!");
					Info(playerid, "Your premium is only temporary and will be removed once you exit the game!");
					SetPVarInt(playerid, "tempPremium", 1);
					pCookies[playerid] -= 300;
				}
				case 7: // Premium Level 2
				{
					if(pPremium[playerid] > 1) return Error(playerid, "You are already a premium member!");
					if(500 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					pPremium[playerid] = 2;
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased Temporary Premium Level 2 for 500 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
					Info(playerid, "You have purchased Premium Level 2 for 500 cookies, type /premium to view your commands!");
					Info(playerid, "Your premium is only temporary and will be removed once you exit the game!");
					SetPVarInt(playerid, "tempPremium", 1);
					pCookies[playerid] -= 500;
				}
				case 8: // VIP
				{
					if(pPremium[playerid] > 2) return Error(playerid, "You are already a VIP member!");
					if(1200 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					pPremium[playerid] = 3;
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased Temporary VIP for 1200 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
					Info(playerid, "You have purchased VIP for 1200 cookies, type /premium to view your commands!");
					Info(playerid, "Your VIP is only temporary and will be removed once you exit the game!");
					SetPVarInt(playerid, "tempPremium", 1);
					pCookies[playerid] -= 1200;
				}
				case 9: // Premium Level 2 (7 Days)
				{
					if(4000 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					if(pPremium[playerid] > 1) return Error(playerid, "You are already a premium member!");
					pPremium[playerid] = 2;
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased Premium Level 2 (7 Days) for 4000 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
					Info(playerid, "You have purchased Premium Level 2 (7 Days) for 4000 cookies, type /premium to view your commands!");
					Info(playerid, "Your premium is only temporary and will last for 7 days!");

					iTemp = gettime() + 86400 * 7;
					format(query, sizeof(query), "UPDATE players SET premium=2,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
					MySQL_updateQuery(query);
					premiumExpired[playerid] = iTemp;
					pCookies[playerid] -= 4000;
				}
				case 10: // VIP (7 Days)
				{
					if(pPremium[playerid] > 2) return Error(playerid, "You are already a VIP member!");
					if(12000 > pCookies[playerid]) return Error(playerid, "You don't have enough cookies to make this transaction.");
					pPremium[playerid] = 3;
					format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has purchased VIP (7 Days) for 12000 cookies!", pName[playerid], playerid);
					SendClientMessageToAll(COLOR_WHITEP, str);
					Info(playerid, "You have purchased VIP for 12000 cookies, type /premium to view your commands!");
					Info(playerid, "Your VIP is only temporary and will last for 7 days!");

					iTemp = gettime() + 86400 * 7;
					format(query, sizeof(query), "UPDATE players SET premium=3,v_expired=%d WHERE reg_id=%d", iTemp, pRegID[playerid]);
					MySQL_updateQuery(query);
					premiumExpired[playerid] = iTemp;
					pCookies[playerid] -= 12000;
				}
			}
			return true;
		}
		case COOKIE_DIALOG+2:
		{
			if(!response) return true;

			if(!(2 < strlen(inputtext) < 30))
			{
				Error(playerid, "Please insert a valid country! Must be between 3-30 characters.");
				ShowPlayerDialog(playerid, COOKIE_DIALOG+2, DIALOG_STYLE_INPUT, ""WHITE_E"Change country", "Enter your new country name(can be viewed in /stats):", "Enter", "Exit");
				return true;
			}
			if(strfind(inputtext, "%", true) != -1)
			{
				Error(playerid, "Invalid characters in country!");
				ShowPlayerDialog(playerid, COOKIE_DIALOG+2, DIALOG_STYLE_INPUT, ""WHITE_E"Change country", "Enter your new country name(can be viewed in /stats):", "Enter", "Exit");
				return true;
			}
			
			mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET country='%e' WHERE reg_id=%d", inputtext, pRegID[playerid]);
			MySQL_updateQuery(query);
			format(pCountry[playerid], 44, inputtext);
			format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your country has been set to '"LB2_E"%s"YELLOW_E"'!", inputtext);
			SendClientMessage(playerid, COLOR_YELLOW, str);
			format(str, sizeof(str), "~w~Country changed to ~b~~h~%s", inputtext);
			InfoTD_MSG(playerid, 4000, str);
			format(str, sizeof(str), "4Server:3 %s(%i) has changed their country to %s.", pName[playerid], playerid, inputtext);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has bought a country name change for 200 cookies!", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_WHITEP, str);
			pCookies[playerid] -= 200;
			return true;
		}
		case COOKIE_DIALOG+3:
		{
			if(response)
			{
				new cookies = GetPVarInt(playerid, "cookieAmount");
				new price = GetPVarInt(playerid, "cookiePrice");
				otherid = GetPVarInt(playerid, "cookieSeller");

				if(pCash[playerid] < price)
					return Error(playerid, "You don't have enough money to complete this transaction.");

				if(pCookies[otherid] < cookies)
					return Error(playerid, "The seller doesnt have enough cookies to complete this transaction");

				if(!IsPlayerConnected(otherid))
					return Error(playerid, "The seller is no longer ingame");

				format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"You have successfully purchased "LG_E"%d "WHITE_E"cookies for "LG_E"$%s!", cookies, ToCurrency(price));
				SendClientMessage(playerid, COLOR_WHITE, str);

				format(str, sizeof(str), ""SERVER_INITIALS" "WHITE_E"You have successfully sold "LG_E"%d "WHITE_E"cookies to %s(%d) for "LG_E"$%s!", cookies, pName[playerid], playerid, ToCurrency(price));
				SendClientMessage(otherid, COLOR_WHITE, str);

				pCookies[playerid] += cookies;
				pCookies[otherid] -= cookies;
				GivePlayerCash(playerid, -price);
				GivePlayerCash(otherid, price);

				DeletePVar(otherid, "sellingCookies");
				SetPVarInt(playerid, "cookieSeller", -1);
				DeletePVar(playerid, "cookieAmount");
				DeletePVar(playerid, "cookiePrice");
			}
			else
			{
				cmd_deny(playerid);
			}
			return true;
		}
		case COOKIE_DIALOG+4: // Name Change
		{
			if(response)
			{
				if(strlen(inputtext) < 4) return Error(playerid, "New name can't be shorter than 4 characters!"),  ShowPlayerDialog(playerid, COOKIE_DIALOG+4, DIALOG_STYLE_INPUT, ""WHITE_E"Change Name", "Enter your new name:", "Enter", "Exit");
				if(strlen(inputtext) > 20) return Error(playerid, "New name can't be longer than 20 characters!"),  ShowPlayerDialog(playerid, COOKIE_DIALOG+4, DIALOG_STYLE_INPUT, ""WHITE_E"Change Name", "Enter your new name:", "Enter", "Exit");
				if(!IsValidName(inputtext))
				{
					Error(playerid, "Name contains invalid characters, please doublecheck!");
					ShowPlayerDialog(playerid, COOKIE_DIALOG+4, DIALOG_STYLE_INPUT, ""WHITE_E"Change Name", "Enter your new name:", "Enter", "Exit");
					return 1;
				}

				mysql_format(g_SQL_handle, query, sizeof(query), "SELECT name FROM players WHERE name='%e'", inputtext);
				MySQL_query(query, true, "ChangePlayerName_cShop", "is", playerid, inputtext);
			}
		}
		case COOKIE_DIALOG+5: // KDR Reset
		{
			if(!response) return true;
			format(query, sizeof(query), "UPDATE players SET kills=0,deaths=0 WHERE reg_id=%d", pRegID[playerid]);
			MySQL_updateQuery(query);
			pInfo[playerid][pKills] = 0;
			pInfo[playerid][pDeaths] = 0;

			format(str, sizeof(str), "4Server:3 %s(%i) has reset their kills and deaths for 1500 cookies", pName[playerid], playerid);
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			format(str, sizeof(str), ""SERVER_INITIALS" "WHITEP_E"%s(%d) has bought a KDR Reset for 1500 cookies!", pName[playerid], playerid);
			SendClientMessageToAll(COLOR_WHITEP, str);
			pCookies[playerid] -= 1500;

			InfoTD_MSG(playerid, 4000, "~g~~h~KDR Reset!");
			SendClientMessage(playerid, COLOR_YELLOW, ""SERVER_INITIALS" "YELLOW_E"Your have successfully reset your kills and deaths!");
		}
		case GROUP_DIALOG:
		{
			if(!response) return true;
			if(pTotalHours[playerid] < 24) return Error(playerid, "You need 24 hours of total online time to create a group!");
			if(5000000 > pCash[playerid]) return Error(playerid, "You must have at least $5,000,000 to create a group!");
			if(strlen(inputtext) < 2) return Error(playerid, "Group name can't be shorter than 2 characters!"), cmd_gcreate(playerid);
			if(strlen(inputtext) > 20) return Error(playerid, "Group name can't be longer than 20 characters!"), cmd_gcreate(playerid);

			if(!strcmp(pName[playerid], inputtext, true))
			{
				Error(playerid, "You can't set your name as your group name.");
				cmd_gcreate(playerid);
				return 1;
			}
			if(strfind(inputtext, "admin", false) != -1)
			{
				Error(playerid, "Group name can't contain the word admin.");
				cmd_gcreate(playerid);
				return 1;
			}
			if(!IsValidChar(inputtext))
			{
				Error(playerid, "Group names can contain only A-Z, a-z, 0-9, _, [ ], ( )");
				cmd_gcreate(playerid);
				return true;
			}
			format(pGroupName[playerid], 25, inputtext);

			mysql_format(g_SQL_handle, query, sizeof(query), "SELECT gID FROM groups WHERE gName = '%e'",pGroupName[playerid]);
			MySQL_query(query, true, "MySQL_GroupExist", "is", playerid, pGroupName[playerid]);
		}
		case GROUP_DIALOG+1:
		{
			if(!response) return true;
			if(3000000 > pCash[playerid]) return Error(playerid, "You must have at least $3,000,000 to change your group name!");
			if(1000 > pScore[playerid]) return Error(playerid, "You must have at least 1000 score to change your group name!");
			if(strlen(inputtext) < 2) return Error(playerid, "Group name can't be shorter than 2 characters!"), cmd_gname(playerid);
			if(strlen(inputtext) > 20) return Error(playerid, "Group name can't be longer than 20 characters!"), cmd_gname(playerid);
			if(!strcmp(pName[playerid], inputtext, true))
			{
				Error(playerid, "You can't set your name as your group name.");
				cmd_gname(playerid);
				return 1;
			}
			if(strfind(inputtext, "admin", false) != -1)
			{
				Error(playerid, "Group name can't contain the word admin.");
				cmd_gname(playerid);
				return 1;
			}
			if(!IsValidChar(inputtext))
			{
				Error(playerid, "Group names can contain only A-Z, a-z, 0-9, _, [ ], ( )");
				cmd_gname(playerid);
				return true;
			}
			format(pGroupName[playerid], 25, inputtext);
			mysql_format(g_SQL_handle, query, sizeof(query), "SELECT gID FROM groups WHERE gName = '%e'", pGroupName[playerid]);
			MySQL_query(query, true, "MySQL_GroupExist2", "is", playerid, pGroupName[playerid]);
		}
		case 333:
		{
			if(response)
			{
				if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
				{
					SetPlayerVehiclePosition(playerid, sPOS3_X[playerid], sPOS3_Y[playerid], sPOS3_Z[playerid], 0);
