    if(InDM[playerid] != 0 || InEvent[playerid] != 0 || ParticipatingWar[playerid] == 1 || RaceParticipant[playerid] != 0)
        return Error(playerid, "You cannot use this command in activity");
	if(IsPlayerInAnyVehicle(playerid))
	{
		Error(playerid, "You can't perform animations in your vehicle.");
		return true;
	}
	SetPVarInt(playerid, "UsingAnim", 1);
	ApplyAnimation(playerid,"FOOD", "EAT_Burger",4.1,1,1,1,1,1,1);
	return true;
}

