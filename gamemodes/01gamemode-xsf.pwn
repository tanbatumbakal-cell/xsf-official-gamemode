CMD:stopanim(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	if(InDM[playerid] != 0) return 1;
	if(InEvent[playerid] != 0) return 1;
	if(GetPVarInt(playerid, "cuffedTime")) return 1;
	if(doingStunt[playerid]) return 1;
	DeletePVar(playerid, "UsingAnim");
	ClearAnimations(playerid);
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	return true;
}

