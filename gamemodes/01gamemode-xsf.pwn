CMD:skydive(playerid)
{
	if(!CanPlayerTeleport(playerid)) return true;
	SetPlayerPositionEx(playerid, 3887.5874,3891.2942,2018.7869,91.8075);
	TeleMSG(playerid, "Sky Dive! (/skydive)");
	SetPlayerVirtualWorld(playerid, SKYDIVE_WORLD);
	GivePlayerWeapon(playerid, 46, 1);
	if(GetPVarInt(playerid, "HideObjects"))
	{
		DeletePVar(playerid, "HideObjects");
		Streamer_ToggleItemUpdate(playerid, STREAMER_TYPE_OBJECT, 1);
	}
	Info(playerid, "Zoom out your camera and perform slow maneuvers! Good luck!");
	if(GOD[playerid] == 1) SetPVarInt(playerid, "HadGod", 1); else SetPVarInt(playerid, "HadGod", 0);
	doingStunt[playerid] = 9;
	return true;
}
