SendBotMsg(msgz[])
{
	format(line, sizeof(line), ""ORANGE_E"ChumLee: "WHITE_E"%s", msgz);
	SendClientMessageToAll(COLOR_WHITE, line);
	format(line, sizeof(line), "2ChumLee3[-1]1: %s", msgz);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, line);

	format(str, sizeof(str), "**[Chat]** ChumLee(-1): %s.", msgz);
	//DCC_SendChannelMessage(Channel_Echo, str);
}

SendBotMsgToPlayer(playerid, msgz[])
{
	format(line, sizeof(line), ""ORANGE_E"ChumLee: "WHITE_E"%s", msgz);
	SendClientMessage(playerid, COLOR_WHITE, line);
}

function ChangeColors(playerid)
{
	if(pInfo[playerid][pRainbow] == 1)
	{
		ChangeVehicleColor(GetPlayerVehicleID(playerid), randomColors[random(23)], randomColors[random(23)]);
	}
	return true;
}

/*-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
==============================[|Global Timers|]=================================
=--=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=*/

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
	if(passenger_seat > 0)
	{
		new Float:X, Float:Y, Float:Z;
		GetPlayerPos(playerid, X, Y, Z);
		SetPlayerPos(playerid, X, Y, Z+5);
		SendClientMessage(playerid, COLOR_GREY2, "You have been slapped out of the vehicle because it has no driver.");
	}
}

function AntiCheat()
{
	/*switch(changeHostname)
	{
		case 0:
		{
			SendRconCommand("hostname \t       "HOSTNAME_1"");

			changeHostname = 1;
		}
		case 1:
		{
			SendRconCommand("hostname \t       "HOSTNAME_2"");

			changeHostname = 0;
		}
	}*/
	foreach(new ii : Player)
	{
		if(pSpawned[ii])
		{
			SpamCount[ii] = 0;
			// Money AC
			if(GetPlayerMoney(ii) > pCash[ii])
			{
				ResetPlayerMoney(ii);
				SetPlayerMoney(ii, pCash[ii]);
				//format(str, sizeof(str), "* ADMIN-MSG: "GREY2_E"Possible money hacks detected on %s(%i). Check on this player. "LG_E"($%d)", pName[ii], ii, GetPlayerMoney(ii) - pCash[ii]);
				//SendOwnerMessage(COLOR_RED, str);
			}
			if(InDM[ii] == 13)
			{
				if(GetPVarInt(ii, "Cop") != 0)
				{
					if(IsPlayerInDynamicArea(ii, 1) || IsPlayerInDynamicArea(ii, 9))
					{
						new Float:Health;
						GetPlayerHealth(ii, Health);
						SetPlayerHealth(ii, Health-15);
						GameTextForPlayer(ii, "~w~get out of robbers base~y~!~n~~r~-15 health", 4000, 5);
						SetPlayerArmedWeapon(ii, 0);
					}
				}
			}
			if(doingStunt[ii] != 0 || InDM[ii] != 0)
			{
				if(GetPlayerSpecialAction(ii) == SPECIAL_ACTION_USEJETPACK)
				{
					SetPlayerSpecialAction(ii, SPECIAL_ACTION_NONE);
					Error(ii, "You can't use a jetpack in this area!");
				}
			}
			// Weapon/Armour Anti-Cheat
			GetPlayerArmour(ii, A);
			if(A > 98 && !GetPVarInt(ii, "BadSports"))
			{
				GetPlayerName(ii, PlayerName, sizeof(PlayerName));
				GetPlayerIp(ii, PlayerIP, sizeof(PlayerIP));
				format(str, sizeof(str), ""GREY_E"Anti-Cheat: "RED_E"%s(%i) has been auto banned for armour hacks (7 Days)!", PlayerName, ii);
				SendClientMessageToAllEx(ii, COLOR_RED, str);
				BanPlayerMSG(ii, ii, "Armour Hacks", true);
				format(query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%s', '%s', 'Server Ban', 'Armour Hacks', UNIX_TIMESTAMP(), '%i')", PlayerName, PlayerIP , gettime() + (7 * 86400));
				MySQL_updateQuery(query);
				KickEx(ii);
				return true;
			}
			switch(GetPlayerWeapon(ii))
			{
				case 35, 36, 37, 38, 39:
				{
						if(InDM[ii] == 0 && cAFK[ii] == 0 && pAdmin[ii] == 0 && !GetPVarInt(ii, "givenByAdmin") && !GetPVarInt(ii, "BadSports"))
						{
							GetWeaponName(GetPlayerWeapon(ii), tmp, sizeof(tmp));
							new hwarns = GetPVarInt(ii, "hackWarns") + 1;
							SetPVarInt(ii, "hackWarns", hwarns);
							ResetPlayerWeapons(ii);
							SetPlayerArmedWeapon(ii, 0);
							if(GetPVarInt(ii, "hackWarns") == 3 && GetPlayerWeapon(ii) != 38)
							{
								GetPlayerName(ii, PlayerName, sizeof(PlayerName));
								GetPlayerIp(ii, PlayerIP, sizeof(PlayerIP));
								format(str, sizeof(str), ""GREY_E"Anti-Cheat: "RED_E"%s(%i) has been auto banned for weapon hacks (7 Days)!", PlayerName, ii);
								SendClientMessageToAllEx(ii, COLOR_RED, str);
								BanPlayerMSG(ii, ii, "Weapon Hacks", true);
								format(query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%s', '%s', 'Server Ban', 'Weapon Hacks', UNIX_TIMESTAMP(), '%i')", PlayerName, PlayerIP , gettime() + (7 * 86400));
								MySQL_updateQuery(query);
								KickEx(ii);
								return true;
							}
							GetPlayerName(ii, PlayerName, sizeof(PlayerName));
							format(str, sizeof(str), ""RED_E"* ADMIN-MSG: "GREY2_E"Possible weapon hacks detected on %s(%i). "LB2_E"(%s) "RED_E"Check on this player.", PlayerName, ii, tmp);
							SendAdminMessage(COLOR_GREY, str);

							format(str, sizeof(str), "4Anti-Cheat 3Possible weapon hacks detected on %s(%d). 2(%s)", PlayerName, ii, tmp);
							IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
							format(tmp, sizeof(tmp), "**[Anti-Cheat]** Possible weapon hacks detected on %s(%d)", PlayerName, ii, tmp);
							//DCC_SendChannelMessage(Channel_Staff, tmp);
							return true;
						}
				}
			}
		}
	}
	return true;
}

function onlineTimer()
{

	CheckUpdate();
	// Increase server uptime
	up_seconds ++;
	if(up_seconds == 60)
	{
		up_seconds = 0, up_minutes ++;
		if(up_minutes == 60)
		{
			up_minutes = 0, up_hours ++;
			if(up_hours == 24) up_hours = 0, up_days ++;

			format(str, sizeof(str), ""BLUE_E"UPTIME: "WHITE_E"The server has been online for %s.", Uptime());
			SendClientMessageToAll(COLOR_WHITE, str);

			format(str, sizeof(str), "4UPTIME: 3The server has been up for 10%s2.", Uptime());
			IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
			// Sync Server
			SyncFooter();
			//MySQL_updateQuery("OPTIMIZE TABLE `players`,`groups`,`houses`,`toys`,`vehicles`");
			SetTimer("changeWeather", 10000, false);
		}
	}
	// Update AA Object Material
	format(str, sizeof(str), ""RED_E"server :: "HOSTNAME_1"\n"ORANGE_E"Build "BUILD" "RED_E"- www.serverserver.com\n\n"RED_E"Players Online: %d", Iter_Count(Player));
	SetDynamicObjectMaterialText(StatsObject, 0, str, OBJECT_MATERIAL_SIZE_256x128, "Arial", 22, 0, 0xFF0000FF, 9, 0);

	// Derby
	if(IsDerbyRunning)
	{
		DerbyGameTime--;
		switch(CurrentDerbyMap)
		{
			case 1: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Sport Car Madness", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 2: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Skyscraper", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 3: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Rocky Roads", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 4: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Tropical Roads", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 5: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Mine Madness", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 6: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Egypt", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 7: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Ramp Tower", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 8: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Waterfall", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 9: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Sports Car Madness 2", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 10: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~Flatline Park", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
			case 11: format(tmp, sizeof(tmp), "~w~Players Left: ~b~~h~%d  ~w~Time Left: ~b~~h~%s  ~n~~w~Map: ~b~~h~WaterFall 2", bDerbyPlayers, GameTimeConvert(DerbyGameTime));
		}
		TextDrawSetString(DerbyTD1, tmp);
	}
	else
	{
		TextDrawSetString(DerbyTD1, "~w~Players Left: ~b~~h~--  ~w~Time Left: ~b~~h~--  ~n~~w~Map: ~b~~h~Voting");
	}
	if(g_FalloutStatus != e_Fallout_Inactive)
	{
		switch(g_FalloutStatus)
		{
			case e_Fallout_Startup:
			{
				format(tmp, sizeof(tmp), "~w~Players: ~b~~h~%d  ~w~Time Left: ~b~~h~--", CurrentFalloutPlayers);
			}
			case e_Fallout_Running:
			{
				FalloutGameTime--;
				format(tmp, sizeof(tmp), "~w~Players: ~b~~h~%d  ~w~Time Left: ~b~~h~%s", CurrentFalloutPlayers, GameTimeConvert(FalloutGameTime));
			}
		}
		TextDrawSetString(FalloutTD1, tmp);
	}
	foreach(new ii : Player)
	{
		new n = -1;
		if(IsPlayerInRangeOfPoint(ii,10.0,1530.496,768.535,12.471)) n = 1;
		else if(IsPlayerInRangeOfPoint(ii,10.0,1455.928,768.524,12.491)) n = 2;
		if(n != -1)
		{
		    if(!GarageStatus[n])
		    {
		        if(n == 1) MoveDynamicObject(Garage[n-1],1530.496,768.535,12.471+3,1.0);
		        else MoveDynamicObject(Garage[n-1],1455.928,768.524,12.491+3,1.0);
		        SetTimerEx("closeGarage", 3000 , false, "i",n);
		        GarageStatus[n] = true;

			}
		}
	   	new drunknew;
		drunknew = GetPlayerDrunkLevel(ii);
		if (drunknew < 100)
		{
			SetPlayerDrunkLevel(ii, 2000);
		}
		else
		{
			if (pDrunkLevelLast[ii] != drunknew)
			{
				new wfps = pDrunkLevelLast[ii] - drunknew;
				if ((wfps > 0) && (wfps < 200))
				pFPS[ii] = wfps;
				pDrunkLevelLast[ii] = drunknew;
			}
		}
	
		if(IsValidDynamic3DTextLabel(admin3D[ii]))
		{
		    new label[50];
	        GetDynamic3DTextLabelText(admin3D[ii],label);
	        if(pPremium[ii] == 0 && pAdmin[ii] == 0 && Helper[ii] == 0 && pDeveloper[ii] == 0)
	        {
	            DestroyDynamic3DTextLabel(admin3D[ii]);
	        }
	   		if(strcmp(label, "{62e100}Developer", false) == 0 && pDeveloper[ii] == 0 && Helper[ii] < 3)
			{
		  		DestroyDynamic3DTextLabel(admin3D[ii]);
			}
			if(strcmp(label, "{00f9ff}VIP", false) == 0 && pPremium[ii] == 0)
			{
		  		DestroyDynamic3DTextLabel(admin3D[ii]);
			}
			if(strcmp(label, "{e600f4}Admin", false) == 0 && pAdmin[ii] == 0)
			{
		  		DestroyDynamic3DTextLabel(admin3D[ii]);
			}
		}
		if(rektPlayers[ii] == 1)
    	{
			new Float:x, Float:y, Float:z;
			PlayerPlaySound(ii, 3200, x, y, z);
			SetPlayerVelocity(ii, random(5)+0.2,random(5)+0.2,random(5)+0.2); // Forces the player to jump (Z velocity + 0.2)
			//CreateExplosion(x, y, z, 1, 10.0);
			SetPlayerTime(ii, random(24), random(60));
			SetPlayerDrunkLevel (ii, random(50000));

			switch(random(3))
			{
					case 0: PlayerPlaySound(ii, 3200, x, y, z);
					case 1: PlayerPlaySound(ii, 3200, x, y, z);
					case 2: PlayerPlaySound(ii, 3200, x, y, z);
					case 3: PlayerPlaySound(ii, 3200, x, y, z);


			}
    	}
		vID = GetPlayerVehicleID(ii);
		//if(canUseKey[ii] == true)
		if(InDM[ii] == 0 && InEvent[ii] == 0)
		{
			if(GOD[ii] == 1)
				SetPlayerHealth(ii, 9999); // Infinith Health

			if(vID != 0 && GetPlayerState(ii) != PLAYER_STATE_PASSENGER)
			{
				if(pAutoFix[ii] == 1 && doingStunt[ii] != 19)
					RepairVehicle(vID);
			}
		}
		// Speedometer
		if(vID != 0 && Speedo[ii] != 0)
		{
			new Float:SPD, svalue, Float:vx, Float:vy, Float:vz;
			GetVehicleVelocity(GetPlayerVehicleID(ii), vx,vy,vz);

			SPD = floatmul(floatsqroot(floatadd(floatadd(floatpower(vx, 2), floatpower(vy, 2)),  floatpower(vz, 2))), 100.0);
			svalue = floatround(floatdiv(SPD, 0.75), floatround_floor);
			format(tmp, sizeof(tmp),"%d ~y~~h~KMH", svalue);
			PlayerTextDrawSetString(ii, vSpeed[ii], tmp);

			/*// Race Anti-Cheat
			if(RaceParticipant[ii] != 0 && svalue > 320)
			{
				// Speedhacks
				new sWarns = GetPVarInt(ii, "speedHacks") + 1;
				SetPVarInt(ii, "speedHacks", sWarns);
				format(str, sizeof(str), "* ADMIN-MSG: "GREY2_E"Possible speed hacks detected on %s(%i) "GREY_E"(Speed: %d KMH)", pName[ii], ii, svalue);
				SendAdminMessage(COLOR_RED, str);
				if(GetPVarInt(ii, "speedHacks") == 3)
				{
					GetPlayerName(ii, PlayerName, sizeof(PlayerName));
					GetPlayerIp(ii, PlayerIP, sizeof(PlayerIP));
					format(str, sizeof(str), ""GREY_E"Anti-Cheat: "RED_E"%s(%i) has been auto kicked for speed hacks!", PlayerName, ii);
					SendClientMessageToAllEx(ii, COLOR_RED, str);
					format(tmp, sizeof(tmp), "4AUTO-BAN: 3%s(%i) has been banned for speed hacks!", PlayerName, ii);
					IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
					SendClientMessage(ii, COLOR_RED, "You have been kicked from the server for speed hacks!");
					//BanPlayerMSG(ii, ii, "Speed Hacks", true);
					//format(query, sizeof(query), "INSERT INTO bans(user_banned, bIP, user_banner, ban_reason, ban_timestamp, ban_time) VALUES ('%s', '%s', 'Server Ban', 'Speed Hacks', UNIX_TIMESTAMP(), 0)", PlayerName, PlayerIP);
					//MySQL_updateQuery(query);
					KickEx(ii);
				}
			}*/
		}
		/*// Server Flood Checker
		if(NetStats_MessagesRecvPerSecond(ii) > MAX_MESSAGE_RATE)  MessageInfractions[ii]++;
		else MessageInfractions[ii] = 0;
		if(MessageInfractions[ii] == MAX_MESSAGE_INFRACTIONS)
		{
			format(str, sizeof(str), ""GREY_E"Anti-Cheat: "RED_E"%s(%i) has been kicked for flooding the server!", pName[ii], ii);
			SendClientMessageToAll(COLOR_RED, str);
			Kick(ii);
		}*/

		if(pMute[ii] > 0)
		{
			pMute[ii]--;
			if(pMute[ii] == 0)
			{
				SendClientMessage(ii, COLOR_GREY, ""RED_E"Server: "YELLOW_E"You have been unmuted by the server. "RED_E"Do not spam or you will be kicked.");
				format(str, sizeof(str), "4Server3 %s(%i) has been unmuted by the server.", pName[ii], ii);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been automatically unmuted by the server.", pName[ii], ii);
				SendClientMessageToAll(-1, str);
				format(tmp, sizeof(tmp), "**[Server]** %s(%i) has been unmuted by the server.", pName[ii], ii);
				//DCC_SendChannelMessage(Channel_Staff, tmp);
			}
		}
		if(pBlocked[ii] > 0)
		{
			pBlocked[ii]--;
			if(pBlocked[ii] == 0)
			{
				SendClientMessage(ii, COLOR_GREY, ""RED_E"Server: "YELLOW_E"Your commands are now un-blocked.");
				format(str, sizeof(str), "4Server3 %s(%i)'s commands have been unblocked by the server.", pName[ii], ii);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) commands are automatically unblocked by the server.", pName[ii], ii);
				SendClientMessageToAll(-1, str);
				format(tmp, sizeof(tmp), "**[Server]** %s(%i)'s commands have been unblocked by the server.", pName[ii], ii);
				//DCC_SendChannelMessage(Channel_Staff, tmp);
				if(GetPVarInt(ii, "OfflineBlocked") == 1)
				{
					mysql_format(g_SQL_handle, str, sizeof(str), "DELETE FROM `CommandsBlock` WHERE `Name` = '%e'", pName[ii]);
					MySQL_updateQuery(str);
					SetPVarInt(ii, "OfflineBlocked", 0);
				}
			}
		}

		if(pJail[ii] > 0)
		{
			pJail[ii]--;
			if(GetPVarInt(ii, "Arrester") == 0)
			{
				if(InDM[ii] == 13)
				{
					format(str, sizeof(str), "~b~~h~You will be released in %d seconds.~n~Type /escape to attempt to escape.", pJail[ii]);
				}
				else format(str, sizeof(str), "~b~~h~You will be released in ~w~%d ~b~~h~seconds.", pJail[ii]);
				InfoTD_MSG(ii, 1000, str);
			}
			if(pJail[ii] == 0)
			{
				pJail[ii] = 0;
				DeletePVar(ii, "JailedByAdmin");
				DeletePVar(ii, "HasEscaped");
				SetPlayerHealth(ii, 97);
				SpawnPlayer(ii);
				SetPlayerSpecialAction(ii, SPECIAL_ACTION_NONE);
				SendClientMessage(ii, COLOR_GREY, ""RED_E"Server: "GREY_E"You have been un-jailed by the server. (times up)");
				format(str, sizeof(str), "4Server3 %s(%i) has been automatically unjailed by the server.", pName[ii], ii);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
				if(InDM[ii] != 13)
				{
					format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been automatically unjailed by the server.", pName[ii], ii);
					SendClientMessageToAll(-1, str);
				}
				//format(tmp, sizeof(tmp), "**[Server]** %s(%i) has been auto-unjailed by the server.", pName[ii], ii);
				//DCC_SendChannelMessage(Channel_Staff, tmp);
			}
		}


		if(GetPVarInt(ii, "TempNickChangeTime") != 0 && GetPVarInt(ii, "TempNickChangeTime") < gettime()) {
			GetPVarString(ii, "OldNick", pName[ii], MAX_PLAYER_NAME);
			SetPlayerName(ii, pName[ii]);
			SendClientMessage(ii, COLOR_GREY, ""SERVER_INITIALS" "GREY_E"Your name has now been changed back.");
			DeletePVar(ii, "OldNick");
			DeletePVar(ii, "TempNickChangeTime");
		}
		if(GetPVarInt(ii, "cuffedTime") != 0 && GetPVarInt(ii, "cuffedTime") < gettime()) {
			SetPlayerSpecialAction(ii, SPECIAL_ACTION_NONE);
			SendClientMessage(ii, COLOR_GREY2, ""YELLOW_E"- AS - "GREEN_E"You have been automatically uncuffed.");
			DeletePVar(ii, "cuffedTime");
		}
		if(RaceParticipant[ii] != 0)
		{
			if(RaceStart == 1 && RaceParticipant[ii] >= 4)
			{
				new raceTime = GetTickCount() - race_StartTick;
				minute = raceTime / 60000;
				second = (raceTime /1000) - (minute*60);

				format(tmp, sizeof(tmp), "  ~w~Position: ~b~~h~%d/%d  ~w~Checkpoint: ~b~~h~%d/%d  ~w~Race: ~g~~h~%s  ~w~Time: ~g~~h~%d:%d", RacePosition[ii], Participants, CurrentCheckpoint[ii], LCurrentCheckpoint+1, CRaceName, minute, second);
			}
			else if(RaceActive == 1) format(tmp, sizeof(tmp), "~w~Position: ~b~~h~-/-  ~w~Checkpoint: ~b~~h~-/-  ~w~Race: ~g~~h~%s  ~w~Time: ~g~~h~-:-", CRaceName);
			PlayerTextDrawSetString(ii, RaceTD1[ii], tmp);
		}
		if(ParkourParticipant[ii] != 0)
		{
			if(ParkourStart == 1 && ParkourParticipant[ii] >= 4)
			{
				new ParkourTime = GetTickCount() - Parkour_StartTick;
				minute = ParkourTime / 60000;
				second = (ParkourTime /1000) - (minute*60);

				format(tmp, sizeof(tmp), "  ~w~Position: ~b~~h~%d/%d  ~w~Checkpoint: ~b~~h~%d/%d  ~w~Race: ~g~~h~%s  ~w~Time: ~g~~h~%d:%d", ParkourPosition[ii], pParticipants, pCurrentCheckpoint[ii], pLCurrentCheckpoint+1, CParkourName, minute, second);
			}
			else if(ParkourActive == 1) format(tmp, sizeof(tmp), "~w~Position: ~b~~h~-/-  ~w~Checkpoint: ~b~~h~-/-  ~w~Race: ~g~~h~%s  ~w~Time: ~g~~h~-:-", CParkourName);
			PlayerTextDrawSetString(ii, ParkourTD1[ii], tmp);
		}

		// Online Timer
		if(pLogged[ii] == true && cAFK[ii] == 0)
		{
			pTotalSeconds[ii] ++, pCurrSeconds[ii] ++;
			if(pTotalSeconds[ii] == 60)
			{
				pTotalMinutes[ii] ++, pCurrMinutes[ii] ++;
				if(Helper[ii] > 0 || pAdmin[ii] > 0)
				{
				    if(AFK[ii] == 0 && cAFK[ii] == 0) {
						admOnTime[ii]++;
					}
				}
				pTotalSeconds[ii] = 0, pCurrSeconds[ii] = 0;

				switch(pTotalMinutes[ii])
				{
					case 10, 20, 30, 40, 50:
					{
						GivePlayerCash(ii, 2000);
						GivePlayerScore(ii, 2);

						if(pTotalHours[ii] != 0)
						{
							format(tmp, sizeof(tmp), "~y~You have been online for ~r~~h~%d~y~ hours and ~r~~h~%d~y~ minutes.", pTotalHours[ii], pTotalMinutes[ii]);
							format(str, sizeof(str), ""RED_E"*** {FFE4C4}You have been online for %d hours and %d minutes.", pTotalHours[ii], pTotalMinutes[ii]);
						}
						else
						{
							format(tmp, sizeof(tmp), "~y~You have been online for ~r~~h~%d~y~ minutes.", pTotalMinutes[ii]);
							format(str, sizeof(str), ""RED_E"*** {FFE4C4}You have been online for %d minutes.", pTotalMinutes[ii]);
						}
						InfoTD_MSG(ii, 10000, tmp);
						SendClientMessage(ii, 0xFFE4C4FF, str);
						PlayerPlaySound(ii, 1138, 0.0, 0.0, 0.0);
						if(pScore[ii] >= 2000)
						{
							if(pAch8[ii] == 0)
							{
								pAch8[ii] = 1;
								format(query, sizeof(query), "UPDATE achievements SET a8=1 WHERE reg_id=%d", pRegID[ii]);
								MySQL_updateQuery(query);
								GivePlayerAchievement(ii, "Score Whore", "Congrats you've reached 2000 score!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
							}
						}
					}
					case 60:
					{
						GivePlayerCash(ii, 4000);
						GivePlayerScore(ii, 3);

						pTotalHours[ii] ++;
						pTotalMinutes[ii] = 0;
						//SavePlayerStats(ii);
						PlayerPlaySound(ii, 1139, 0.0, 0.0, 0.0);

						/*if(BankMoney[ii] >= 100000000) {
							new _firstBalance = BankMoney[ii];
							new Float:bnkInterest = (_firstBalance*0.25)/100;
							new _bnkInterest = floatround(bnkInterest, floatround_floor);

	                        BankMoney[ii] += _bnkInterest;
	                        format(tmp, sizeof(tmp), "{FF0000}[BANK] {FFFFFF}Old balance: %s | New balance (with interest): %s", ToCurrency(_firstBalance), ToCurrency(BankMoney[ii]));
	                        SendClientMessage(ii, -1, tmp);
                        }
                        else {
                        
                            new _firstBalance = BankMoney[ii];
							new Float:bnkInterest = (_firstBalance*0.5)/100;
							new _bnkInterest = floatround(bnkInterest, floatround_floor);
                            if(BankMoney[ii] >= 2000000000)
							{
							    return 0;
							}
	                        BankMoney[ii] += _bnkInterest;
	                        format(tmp, sizeof(tmp), "{FF0000}[BANK] {FFFFFF}Old balance: %s | New balance (with interest): %s", ToCurrency(_firstBalance), ToCurrency(BankMoney[ii]));
	                        SendClientMessage(ii, -1, tmp);
						}
						format(query, sizeof(query), "UPDATE players SET bmoney=%d WHERE reg_id=%d", BankMoney[ii], pRegID[ii]);
						MySQL_updateQuery(query);*/

						if(pTotalHours[ii] != 1)
						{
							format(tmp, sizeof(tmp), "~y~You have been online for ~r~~h~%d~y~ hours.", pTotalHours[ii]);
							format(str, sizeof(str), ""RED_E"*** {FFE4C4}You have been online for %d hours.", pTotalHours[ii]);
						}
						else
						{
							format(tmp, sizeof(tmp), "~y~You have been online for ~r~~h~one~y~ hour.");
							format(str, sizeof(str), ""RED_E"*** {FFE4C4}You have been online for an hour.");
						}
						InfoTD_MSG(ii, 10000, tmp);
						SendClientMessage(ii, 0xFFE4C4FF, str);
						format(str, sizeof(str), "13,1%s(%i)3,0 has been online for %d hours.", pName[ii], ii, pTotalHours[ii]);
						IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
						format(str, sizeof(str), "**[Online]** %s (%i) was online for %d hours", pName[ii], ii, pTotalHours[ii]);
						//DCC_SendChannelMessage(Channel_Echo, str);
						if(pTotalHours[ii] >= 200)
						{
							if(pAch5[ii] == 0)
							{
								pAch4[ii] = 1;
								pAch5[ii] = 1;
								format(query, sizeof(query), "UPDATE achievements SET a4=1,a5=1 WHERE reg_id=%d", pRegID[ii]);
								MySQL_updateQuery(query);
								GivePlayerAchievement(ii, "No Lifer", "Congrats you played for a total of 200 hours!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
							}
						}
						else if(pTotalHours[ii] >= 24)
						{
							if(pAch4[ii] == 0)
							{
								pAch4[ii] = 1;
								format(query, sizeof(query), "UPDATE achievements SET a4=1 WHERE reg_id=%d", pRegID[ii]);
								MySQL_updateQuery(query);
								GivePlayerAchievement(ii, "Official Player", "Congrats you played for a total of 24 hours!~n~~y~+$100000 and 5 score!~n~~w~Type /ach to view your achievements.");
							}
						}
					}
				}
				if(pCurrMinutes[ii] == 60)
				{
					pCurrMinutes[ii] = 0;
					pCurrHours[ii] ++;
				}
			}
		}
		if(pSpawned[ii])
		{
			new pPing = GetPlayerPing(ii);
			if(pPing > 1200 && pPing != 65535)
			{
				format(str, sizeof(str), ""RED_E"Server: "GREY_E"%s(%d) has been kicked for exceeding the ping limit. (Ping: %d) ", pName[ii], ii, pPing);
				SendClientMessageToAll(COLOR_GREY, str);
				format(tmp, sizeof(tmp), "4Server: 2%s(%i) has been kicked for exceeding the ping limit (Ping: %d)", pName[ii], ii, pPing);
				IRC_GroupSay(ircGroup, IRC_CHANNEL, tmp), IRC_GroupSay(ircGroup, IRC_aCHANNEL, tmp);
				SendClientMessage(ii, COLOR_RED, ""YELLOW_E"> "RED_E"You have been kicked for high ping. Fix your ping and relog!");
				KickEx(ii);
				return true;
			}
	
			if(GetLevel(pScore[ii]) != pLevel[ii] && GetLevel(pScore[ii]) != 0 && GetPVarInt(ii, "FullHidden") != 1)
			{
			    new tmpStr[24];
				if(GetLevel(pScore[ii]) > pLevel[ii]) 
				{ 
					GivePlayerLevelRewards(ii, GetLevel(pScore[ii]));
					InfoTD_MSG(ii, 3000, "~w~New rank rewards ~r~Received."); 
					tmpStr = "ranked up";
				}
				else if(GetLevel(pScore[ii]) < pLevel[ii]) tmpStr = "ranked down";

				pLevel[ii] = GetLevel(pScore[ii]);
				new tmpstr[240];
				format(tmpstr, sizeof(tmpstr), ""SERVER_INITIALS" "YELLOW_E"%s(%i) has %s to %s rank! Congratulations %s!", pName[ii], ii, tmpStr, GetLevelName(ii), pName[ii]);
				SendClientMessageToAll(-1, tmpstr);
			}

			cAFK[ii]++;
			if(cAFK[ii] >= 13)
			{
				// AFK Detected
				//Attach3DTextLabelToPlayer(AFK3D[ii], ii, 0.0, 0.0, -0.1);
				if(InDuel[ii] != -1)
				{
					format(str, sizeof(str), ""DUEL" "GREY2_E"%s(%d) has been removed from the duel for pausing.", pName[ii], ii);
					SendClientMessageToAll(COLOR_GREY2, str);
					EndDuel(ii);
				}
				else if(InEvent[ii] != 0)
				{
					RemovePlayerFromEvent(ii);
					format(str, sizeof(str), ""RED_E"Server: "GREY2_E"%s(%d) has been removed from the event for pausing.", pName[ii], ii);
					SendEventMessage(COLOR_GREY2, str);
				}
				else if(doingStunt[ii] == 18) // Fallout
				{
					format(str, sizeof(str), ""FALLOUT" "GREY2_E"%s(%d) has been removed from the minigame for pausing.", pName[ii], ii);
					SendFalloutMessage(COLOR_GREY2, str);
					RemoveFromFallout(ii);
				}
				else if(doingStunt[ii] == 19) // Derby
				{
					if(IsDerbyRunning)
					{
						format(str, sizeof(str), ""DERBY" "GREY2_E"%s(%d) has been removed from the derby for pausing.", pName[ii], ii);
						SendDerbyMessage(COLOR_GREY2, str);
						RemoveFromDerby(ii);
					}
				}
				else if(InDM[ii] > 0 && InDM[ii] != 13)
				{
					ResetPlayerWeapons(ii);
					RemovePlayerFromDM(ii);
					SendClientMessage(ii, COLOR_GREY, ""RED_E"Server: "GREY2_E"You have been removed from the deathmatch for pausing.");
					SetPlayerPosOnSpawn(ii);
				}
			}
		}
	}
	return true;
}
forward closeGarage(gid);
public closeGarage(gid)
{
	if(GarageStatus[gid])
	{
		new don = true;
		if(gid == 1)
		{
			foreach(new ii : Player)
			{
				if(IsPlayerInRangeOfPoint(ii,10.0,1530.496,768.535,12.471))
				{
					don = false;
				}
			}
	        if(don) MoveDynamicObject(Garage[0],1530.496,768.535,12.471-0.4,1.0) , GarageStatus[gid] = false;
	        else SetTimerEx("closeGarage", 2000 , false, "i",gid);
		}
		else if(gid == 2)
		{
			foreach(new ii : Player)
			{
				if(IsPlayerInRangeOfPoint(ii,10.0,1455.928,768.524,12.491))
				{
					don = false;
				}
			}
	        if(don) MoveDynamicObject(Garage[1],1455.928,768.524,12.491-0.4,1.0) , GarageStatus[gid] = false;
	        else SetTimerEx("closeGarage", 2000 , false, "i",gid);
		}
	}
}

public OnPlayerEnterDynamicArea(playerid, areaid)
{

	switch(areaid)
	{
		case 1: // Robbers CNR Area
		{
			if(InDM[playerid] == 13 && GetPVarInt(playerid, "Cop") != 0)
			{
				SendClientMessage(playerid, COLOR_RED, ""YELLOW_E"*** "RED_E"You are not authorized to enter this area, please exit!");
			}
		}
		case 2: // LSAir Bounce
		{
			if((vID = GetPlayerVehicleID(playerid)) != 0)
			{
				GetVehicleVelocity(vID, POS[0], POS[1], POS[2]);
				SetVehicleVelocity(vID, POS[0] * 0.6, POS[1] * 0.6, 1.2);
				SetVehicleAngularVelocity(vID, 0.0, 0.3, 0.0);
			}
		}
		case 3: // LSAir Launcher
		{
			if((vID = GetPlayerVehicleID(playerid)) != 0)
			{
				SetVehicleZAngle(vID, 0.0);
				SetVehicleVelocity(vID, 0.0, 2.5, 0.0);
			}
		}
		case 4: // Marko's House
		{
			MoveDynamicObject(Gate[6], -2017.27, 478.68, 36.95, 5);
			SetTimer("CloseMarkoGate", 3500, false);
		}
		case 5: // Robber's Gate
		{
			cmd_opengate(playerid);
		}
		case 6: // Cop's Gate
		{
			cmd_opencopgate(playerid);
		}
		case 7: // ReV's Gate
		{
			cmd_openrevgate(playerid);
		}
		case 8: // AA Launcher
		{
			if((vID = GetPlayerVehicleID(playerid)) != 0)
			{
				SetVehicleZAngle(vID, 270.0);
				SetVehicleVelocity(vID, 2.5, 0.0, 0.0);
			}
		}
		case 10: // Robber's Gate 2
		{
			cmd_opengate2(playerid);
		}
	}
	PUBG_OnPlayerEnterDynamicArea(playerid, areaid);
}

function ReactionTest()
{
	if(Iter_Count(Player) == 0)
		return false;

	if(reactionActive == true)
	{
		format(str, sizeof(str), ""RED_E"ReactionTest :: "LB_E"No-one has yet typed '"PINK_E"%s"LB_E"' ("YELLOW_E"worth 2 score & "LG_E"$%d"LB_E")", xChars, reactionAward);
		SendClientMessageToAll(COLOR_LB, str);
		format(str, sizeof(str), "**[Reaction]** No-one has yet typed **%s**, that worth 2 score & $%d.", xChars, reactionAward);
		//DCC_SendChannelMessage(Channel_Echo, str);
		reactionTimeStart = GetTickCount();
		return true;
	}
	reactionAward = 0;

	new xLength = random(6) + 5;

	format(xChars, sizeof(xChars), "");
	for(new ii = 0; ii != xLength; ii++) format(xChars, sizeof(xChars), "%s%s", xChars, xCharacters[random(sizeof(xCharacters))][0]);

/*««
»»
››
›
•
·
·*/

	reactionAward = strlen(xChars) * 1000;
	format(str, sizeof(str), ""RED_E"ReactionTest :: (%d) "LB_E"The first one to type '"YELLOW_E"%s"LB_E"' wins 2 score and "LG_E"$%d!",random(100), xChars, reactionAward);
	SendClientMessageToAll(COLOR_LB, str);
	format(str, sizeof(str), "3,1ReactionTest:4 The first one to type '%s' wins 2 score and $%d!", xChars, reactionAward);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
	format(str, sizeof(str), "**[Reaction]** The first one to type **%s** wins 2 score and $%d!", xChars, reactionAward);
	//DCC_SendChannelMessage(Channel_Echo, str);

	reactionActive = true;
	reactionTimeStart = GetTickCount();
	return true;
}

function MoneyBag()
{
	if(!MoneyBagFound)
	{
		format(str, sizeof(str), ""MB" "GREEN_E"The Money Bag has still not been found! "LB2_E"Location: %s.", MoneyBagLocation);
		SendClientMessageToAll(COLOR_GREEN, str);
		SendClientMessageToAll(COLOR_GREEN, ""YELLOW_E"*** "GREEN_E"A new moneybag hunt will start soon!");
		SetTimer("EndMBHunt", random(600000-60000)+60000, false); // 1 - 10 minutes
	}
	else if(MoneyBagFound)
	{
		MoneyBagFound = 0;
		new brk = 0;
		while(!brk) {
			MoneyBagPos[0] = random(MAX_COORD_MB - MIN_COORD_MB) + MIN_COORD_MB;
			MoneyBagPos[1] = random(MAX_COORD_MB - MIN_COORD_MB) + MIN_COORD_MB;
			MapAndreas_FindZ_For2DCoord(MoneyBagPos[0], MoneyBagPos[1], MoneyBagPos[2]);
			if(MoneyBagPos[2] >= 5.0) {
				brk = 1;
				break;
			}
		}

		format(MoneyBagLocation, sizeof(MoneyBagLocation), "%s", GetPositionLocation(MoneyBagPos[0], MoneyBagPos[1]));
		format(str, sizeof(str), ""MB" "GREEN_E"The Money Bag hunt has started, find it for a prize! "ORANGE_E"Location: %s!", MoneyBagLocation);
		SendClientMessageToAll(COLOR_GREEN, str);
		MoneyBagStart = GetTickCount();
		format(str, sizeof(str), "~g~Money bag hunt has started! ~y~Location: ~r~%s", MoneyBagLocation);
		TextDrawSetString(InfoTD2, str);
		foreach(new ii : Player)
		{
			if(Speedo[ii] == 1) PlayerTextDrawHide(ii, vSpeed[ii]), TextDrawHideForPlayer(ii, vSpeedBox);
		}
		TextDrawShowForAll(InfoTD2);
		SetTimer("HideInfoTD", 6000, false);
		// Update the pickup location
		Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_X, MoneyBagPos[0]);
		Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_Y, MoneyBagPos[1]);
		Streamer_SetFloatData(STREAMER_TYPE_PICKUP, mbPC, E_STREAMER_Z, MoneyBagPos[2]+1.0);
		format(str, sizeof(str), "4Moneybag: 2The Money Bag hunt has started, find it for a prize! Location: %s!", MoneyBagLocation);
		IRC_GroupSay(ircGroup, IRC_CHANNEL, str);
		format(str, sizeof(str), "**[MoneyBag]** The money bag hunt has been started, find it for a prize! Location: %s!", MoneyBagLocation);
		//DCC_SendChannelMessage(Channel_Echo, str);
	}
	return 1;
}
