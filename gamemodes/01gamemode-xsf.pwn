CMD:report(playerid, params[])
{
	if(pAdmin[playerid] > 0)
		return Error(playerid, "This command is not designed for admins to use!");

	if(sscanf(params, "k<player_name>s[75]", otherid, tmp))
	{
		Usage(playerid, "/report <ID> <REASON>");
		return true;
	}

	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");
	if(otherid == playerid)
		return Error(playerid, "You can't report yourself!");
	if(pAdmin[otherid] > 0 && pHidden[otherid] == 0)
		return Error(playerid, "You can't report an administrator!");
	if(strlen(tmp) > 70)
	{
		Error(playerid, "Reason can't be longer than 70 characters!");
		return true;
	}
	if(GetPVarInt(playerid, "ReportedPlayer") == otherid)
	{
		Error(playerid, "You have already reported that player, please wait for the admins to handle it!");
		return true;
	}
	if(GetPVarInt(playerid, "ReportedPlayer")) SetTimerEx("ResetReport", 30000, false, "i", playerid);
	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	new count = 0;
	format(str, sizeof(str), ""GREY2_E"REPORT: "RED_E"%s(%i) reported %s(%i) for: "GREY_E"%s", pName[playerid], playerid, giveplayer, otherid, tmp);

	foreach(new ii : Player)
	{
		if(pAdmin[ii] >= 1 || Helper[ii] == 1 || Helper[ii] == 3)
		{
		    SendClientMessage(ii, COLOR_RED, str);
		    InfoTD_MSG(ii, 3000, "~r~~h~New Report~w~!~n~Type /reports to view previous reports.");
		    count++;

		    PlayerPlaySound(ii, 1057, 0.0, 0.0, 0.0);
		}
	}

	SetPVarInt(playerid, "ReportedPlayer", otherid);
	format(str, sizeof(str), "5,9REPORT:3,0 %s(%i) reported %s(%i) for: 4%s", pName[playerid], playerid, giveplayer, otherid, tmp);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), "%s(%i) reported %s(%i) - Reason: %s", pName[playerid], playerid, giveplayer, otherid, tmp);

	for(new ir = 1; ir < MAX_REPORTS - 1; ir++)
	{
		Reports[ir] = Reports[ir + 1];
	}
	Reports[MAX_REPORTS - 1] = str;

	format(str, sizeof(str), ""SERVER_INITIALS" "YELLOW_E"Your report on %s(%i) has been saved and sent to administrators online.", giveplayer, otherid);
	SendClientMessage(playerid, COLOR_YELLOW, str);

	format(str, sizeof(str), "**[Report]** %s(%i) reported %s(%i) - Reason: %s", pName[playerid], playerid, giveplayer, otherid, tmp);
	//DCC_SendChannelMessage(Channel_Staff, str);
	//DCC_SendChannelMessage(Channel_Helper, str);
	return true;
}

CMD:checkreports(playerid) return cmd_reports(playerid);
CMD:reports(playerid)
{
	if(pAdmin[playerid] < 1 && Helper[playerid] != 1 && Helper[playerid] != 3)
		return Error(playerid, "You are not authorized to use this command!");
	new bigStr[600], ReportCount;
	strcat(bigStr, ""RED_E"Recent Reports:\n\n"WHITE_E"");
	for(new i = 1; i < MAX_REPORTS; i++)
	{
		if(strcmp(Reports[i], "none", false) != 0)
		{
			ReportCount++;
			format(str, sizeof(str), "%s\n", Reports[i]);
			strcat(bigStr, str);
		}
	}
	if(ReportCount == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "There hasn't been any reports!");
	}
	else ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, ""WHITE_E"Recent Reports", bigStr, "OK", "");
	return 1;
}

CMD:connectbots(playerid)
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");
	format(str, sizeof(str), "4Server: 2%s(%i) has re-connected all IRC bots.", pName[playerid], playerid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) re-connected all IRC bots.", pName[playerid], playerid);
	SendClientMessageToAll(COLOR_RED, str);
	IRC_QuitBots(); // Disconnect Old bots

	ConnectIRCBots();
	SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "GREY2_E"You have re-connected all IRC bots!");
	return 1;
}

stock ConnectIRCBots()
{

	// Set the IRC names
	ircName[0] = IRC_BOT_1_NAME;
	ircName[1] = IRC_BOT_2_NAME;
	ircName[2] = IRC_BOT_3_NAME;
	ircName[3] = IRC_BOT_4_NAME;
	ircName[4] = IRC_BOT_5_NAME;
	SetTimerEx("IRC_ConnectDelay", 2000, 0, "d", 1); // Connect the first bot with a one-second delay
	SetTimerEx("IRC_ConnectDelay", 3000, 0, "d", 2); // Connect the second bot with a two-second delay
	SetTimerEx("IRC_ConnectDelay", 4000, 0, "d", 3); // Connect the third bot with a three-second delay
	SetTimerEx("IRC_ConnectDelay", 5000, 0, "d", 4); // Connect the 4th bot with a four-second delay
	SetTimerEx("IRC_ConnectDelay", 6000, 0, "d", 5); // Connect the 5th bot with a five-second delay

	// Create the IRC groups
	ircGroup = IRC_CreateGroup();
	//SendClientMessage(playerid, COLOR_RED, ""SERVER_INITIALS" "GREY2_E"You have re-connected all IRC bots!");
	return 1;
}

CMD:setpassword(playerid, params[])
{
	if(pAdmin[playerid] < 5)
		return Error(playerid, "You are not authorized to use this command!");

	new cnamee[21];
	if(sscanf(params, "s[21]s[20]", cnamee, tmp))
	{
		Usage(playerid, "/setpassword <name> <new password>");
		Info(playerid, "Make sure you enter the players name and not ID!");
		return true;
	}

	mysql_format(g_SQL_handle, query, sizeof(query), "SELECT pass FROM players WHERE name='%e'", cnamee);
	MySQL_query(query, true, "ChangePlayerPassword", "iss", playerid, cnamee, tmp);
	return true;
}


// SetPassword Callback
forward ChangePlayerPassword(admin, cPlayer[], newpass[]);
public ChangePlayerPassword(admin, cPlayer[], newpass[])
{
	if(MySQL_rowCount())
	{
		format(str, sizeof(str), "- AS - "GREY2_E"Password for %s has been set to \"%s\"", cPlayer, newpass);
		SendClientMessage(admin, COLOR_YELLOW, str);
		mysql_format(g_SQL_handle, query, sizeof(query), "UPDATE players SET pass=SHA1('%e'), passchanged = 1 WHERE name='%e'", newpass, cPlayer);
		MySQL_updateQuery(query);
	}
	else
	{
		// Name Exists
		format(str, sizeof(str), ""GREY2_E"ERROR: "GREY_E"The name "DARK_E"'%s' "GREY_E"doesn't exist in the database!", cPlayer);
		SendClientMessage(admin, COLOR_GREY, str);
	}
	return true;
}

CMD:forcerules(playerid, params[])
{

	if(pAdmin[playerid] < 1)
		//if(Helper[playerid] == 0)
		if((Helper[playerid] !=1 && Helper[playerid] != 3))
			return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid))
	{
		Usage(playerid, "/forcerules <ID>");
		SendClientMessage(playerid, COLOR_ORANGE, "FUNCTION: Forces a player to read the rules dialog.");
		return true;
	}
	if(otherid == INVALID_PLAYER_ID)
		return Error(playerid, "Player not connected!");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));

	if(pHidden[playerid] == 0)
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has forced %s(%i) to read the rules.", pName[playerid], playerid, giveplayer, otherid);
	else
		format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been forced to read the rules by an Administrator.", giveplayer, otherid);
	SendClientMessageToAll(COLOR_RED, str);

	format(str, sizeof(str), "4Server: 2%s(%i) has forced %s(%i) to read the rules.", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_CHANNEL, str), IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);
	Info(otherid, "You have been forced to read the rules, obey them or receive punishment.");
	PlayerPlaySound(otherid, 1186, 0.0, 0.0, 0.0);
	cmd_rules(otherid);
	SetPVarInt(playerid, "RULESFORCED", 1);
	SetTimerEx("ForceRules", 5*1000, false, "i", playerid);

	AdminCommandLog("FORCERULES", playerid, otherid);
	return 1;
}

forward public ForceRules(playerid);
public ForceRules(playerid)
{
	SetPVarInt(playerid, "RULESFORCED", 0);
}

CMD:fr(playerid, params[]) return cmd_forcerespawn(playerid, params);
CMD:forcerespawn(playerid, params[])
{
	if(pAdmin[playerid] < 1 && Helper[playerid] < 1) return Error(playerid, "You are not authorized to use this command!");

	if(sscanf(params, "k<player_name>", otherid)) return Usage(playerid, "/forcerespawn <ID>");
	if(otherid == INVALID_PLAYER_ID || !IsPlayerConnected(playerid)) return Error(playerid, "Player not connected!");
	if(RaceParticipant[otherid] == 3 && RaceStart == 1) return Error(playerid, "You can't spawn this player. (Race Count down in progress)");

	GetPlayerName(otherid, giveplayer, sizeof(giveplayer));
	if(RaceParticipant[otherid] || InDM[otherid] != 0 || doingStunt[otherid] != 0) cmd_leave(otherid);
	SpawnPlayer(otherid);

	if(pHidden[playerid] == 0) format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has respawned %s(%i).", pName[playerid], playerid, giveplayer, otherid);
	else if(pHidden[playerid] == 1) format(str, sizeof(str), ""YELLOW_E"- AS - "RED_E"%s(%i) has been respawned by an Administrator.", giveplayer, otherid);

	SendClientMessageToAll(-1, str);

	format(str, sizeof(str), "4Server: 2%s(%i) has respawned %s(%i).", pName[playerid], playerid, giveplayer, otherid);
	IRC_GroupSay(ircGroup, IRC_aCHANNEL, str);

	SendClientMessage(otherid, -1, "You have been forced to respawn.");
	return 1;
}

// List commands
CMD:jl(playerid, params[]) return cmd_jailedlist(playerid, params);
CMD:jailedlist(playerid, params[]) {
	if(pAdmin[playerid] < 1)
		if(Helper[playerid] < 1)
			return Error(playerid, "You are not authorized to use this command!");

	new jail_list[512], count = 0;
	format(jail_list, sizeof(jail_list), "Player\tTime (in seconds)\n");
	foreach(new i : Player) {
	    if(pJail[i] > 0) {
	    	format(jail_list, sizeof(jail_list), "%s%s\t%i\n", jail_list, pName[i], pJail[i]);
			count++;
		}
	}

	if(count == 0)
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, "Jailed list", "ERROR: There's nobody jailed online.", "Ok", "");
	else
	    ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_TABLIST_HEADERS, "Jailed list", jail_list, "Ok", "");

	return 1;
}
CMD:ml(playerid, params[]) return cmd_mutedlist(playerid, params);
CMD:mutedlist(playerid, params[]) {
	if(pAdmin[playerid] < 1)
		if(Helper[playerid] < 1)
			return Error(playerid, "You are not authorized to use this command!");

	new muted_list[512], count = 0;
	format(muted_list, sizeof(muted_list), "Player\tTime (in seconds)\n");
	foreach(new i : Player) {
	    if(pMute[i] > 0) {
	    	format(muted_list, sizeof(muted_list), "%s%s\t%i\n", muted_list, pName[i], pMute[i]);
			count++;
		}
	}

	if(count == 0)
		ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_MSGBOX, "Muted list", "ERROR: There's nobody muted online.", "Ok", "");
	else
	    ShowPlayerDialog(playerid, NO_DIALOG, DIALOG_STYLE_TABLIST_HEADERS, "Muted list", muted_list, "Ok", "");

	return 1;
}


