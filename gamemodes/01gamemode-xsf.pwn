		case 4: SetPlayerPosition(playerid, -1413.1674,346.3238,30.0820,354.7834);
	}
	InDM[playerid] = 800;
	GivePlayerWeapon(playerid, 34, 500);
	canUseKey[playerid] = false;
	SetPlayerHealth(playerid, 98);

	IsInHouse{playerid} = 0;
	doingStunt[playerid] = 0;
	SetPlayerVirtualWorld(playerid, 87463);
	GodModeLabel(playerid, false);
	UpdateMinigameBox(playerid, 1, "/Sniper2");

	if(GetDMMembers(800) == 1)
	{
	    new stri[128];
