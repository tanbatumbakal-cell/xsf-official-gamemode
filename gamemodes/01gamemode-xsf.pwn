			if(pmin == 1)
			{
				format(str, sizeof(str), ""PARKOUR" Parkour record is %d minute and %02d.%03d seconds by "YELLOW_E"'%s' "LIME_E"made on %s", pmin, psec, pms, TopParkourName, tmp);
				SendClientMessageToAll(COLOR_LIME, str);
