					premiumExpired[playerid] = iTemp;

					pPremium[playerid] = 3;
					SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a a VIP LEVEL!!!!!!! GRATZ");
					format(str,sizeof(str),""GREEN_E"[xMasGift]: "RED_E"%s(%d) just got a VIP from the gift, Congratulations!" , GetName(playerid) , playerid);
					SendClientMessageToAll(-1,str);
				}
				else SendClientMessage(playerid, -1, ""RED_E"[xMasGift]: "GREEN_E"Sad your gift was a vip level but since you already have it, you will be refunded with some random cash.");
			}
			else return OnPlayerPickUpGift(playerid, 0);
		}
		case 5:
		{
			rand = RandomEx(1000, 10000);
			GivePlayerCash(playerid, rand);
			rand = RandomEx(10, 100);
			pCookies[playerid] += rand;
			SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized cash & cookies.");

		}
		case 6:
		{
			rand = RandomEx(1000, 10000);
			GivePlayerCash(playerid, rand);
			rand = RandomEx(1, 10);
			SetPlayerScore(playerid, GetPlayerScore(playerid)+rand);
			SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Congratulations! Your gift is a randomized cash & score");
		}
	}
	DestroyPickup(GiftsPickup[giftid]);
	GiftsPickup[giftid] = -1;

	giftx = 0;
	for(new i = 0; sizeof(GiftsPickup) > i; i++)
	{
		if(GiftsPickup[i] == -1) continue;
		giftx++;
	}
	format(str, sizeof(str), ""GREEN_E"[xMasGift]: "RED_E"%s (Id: %d) has found another gift! HURRY UP there's only %d gifts left.", pName[playerid], playerid, giftx);
	SendClientMessageToAll(-1, str);
	SendClientMessage(playerid, -1, ""GREEN_E"[xMasGift]: "RED_E"Gratz you've found a gift!");
	return 1;
}

